	for i = 1, 4 do
		ui.CrossLines[i] = UIKit.New("Frame", { BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), Parent = ch }, {
