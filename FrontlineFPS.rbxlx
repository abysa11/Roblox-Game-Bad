}

MapData.LobbyLighting = {
	ClockTime = 17.4, -- golden hour: bright enough to read the whole hub, still moody
	Brightness = 2.6,
	Ambient = Color3.fromRGB(120, 118, 132),
	OutdoorAmbient = Color3.fromRGB(150, 146, 162),
	FogColor = Color3.fromRGB(170, 150, 170),
	FogEnd = 1600,
	AtmosphereDensity = 0.28,
	AtmosphereColor = Color3.fromRGB(225, 195, 190),
	AtmosphereDecay = Color3.fromRGB(140, 110, 140),
	Tint = Color3.fromRGB(255, 248, 240),
}

function MapData.Get(id)
	return MapData.Maps[id]
end

function MapData.IsValid(id)
	return type(id) == "string" and MapData.Maps[id] ~= nil
end

return MapData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--[[
	Net
	Single place that declares every RemoteEvent / RemoteFunction.
	The server creates them in ReplicatedStorage.Remotes; clients wait for them.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local EVENTS = {
	-- server -> client
	"MatchState", -- match phase, timer, team counts
	"Notify", -- toast messages
	"WeaponState", -- loadout + equipped slot + ammo
	"AmmoUpdate", -- authoritative ammo for one slot
	"ShotFx", -- other players' shots (tracers, sounds)
	"HitConfirm", -- hit marker for the shooter
	"Damaged", -- damage direction for the victim
	"KillFeed",
	"Died", -- death screen info
	"Spawned",
	"Results", -- podium + rankings
	"PostMatchPrompt",
	"ProfileUpdate",
	"OpenSkinShop",
	"LobbyState",
	-- client -> server
	"EquipSlot",
	"Fire",
	"Reload",
	"Melee",
	"PostMatchChoice",
	"ScopeState",
}

local FUNCTIONS = {
	"GetProfile",
	"SetLoadout",
	"BuySkin",
	"EquipSkin",
	"SaveSettings",
}

local folder: Folder

if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
		end
	end
	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteFunction")
			r.Name = name
			r.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

local cache = {}

function Net.Event(name: string): RemoteEvent
	local r = cache[name]
	if not r then
		r = folder:WaitForChild(name, 30)
		assert(r and r:IsA("RemoteEvent"), "Unknown RemoteEvent " .. name)
		cache[name] = r
	end
	return r
end

function Net.Function(name: string): RemoteFunction
	local r = cache[name]
	if not r then
		r = folder:WaitForChild(name, 30)
		assert(r and r:IsA("RemoteFunction"), "Unknown RemoteFunction " .. name)
		cache[name] = r
	end
	return r
end

-- Fire an event to a list of players (used for per-match broadcasts).
function Net.FireList(name: string, players: { Player }, ...)
	local r = Net.Event(name)
	for _, p in ipairs(players) do
		if p.Parent then
			r:FireClient(p, ...)
		end
	end
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--[[
	Signal
	Tiny pure-Lua signal used for client-side state changes.
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	local entry = { fn = fn, connected = true }
	table.insert(handlers, entry)
	return {
		Disconnect = function()
			entry.connected = false
			local i = table.find(handlers, entry)
			if i then
				table.remove(handlers, i)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, entry in ipairs(table.clone(self._handlers)) do
		if entry.connected then
			task.spawn(entry.fn, ...)
		end
	end
end

return Signal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">SkinData</string><ProtectedString name="Source"><![CDATA[--[[
	SkinData
	Purely cosmetic weapon finishes. A skin only recolours / re-materials the parts of the
	procedural weapon model tagged "Body" and "Accent" (see WeaponModels). No stats live here.
]]

local SkinData = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

SkinData.Rarities = {
	Common = { Order = 1, Color = rgb(176, 195, 217) },
	Rare = { Order = 2, Color = rgb(75, 105, 255) },
	Epic = { Order = 3, Color = rgb(136, 71, 255) },
	Legendary = { Order = 4, Color = rgb(235, 75, 75) },
	Mythic = { Order = 5, Color = rgb(255, 196, 46) },
}

-- Skin definitions grouped by weapon. Ids are globally unique and are what gets saved.
local defs = {
	USP = {
		{ "USP_Desert", "Desert Haze", 40, "Common", rgb(196, 170, 120), rgb(120, 98, 70), "SmoothPlastic" },
		{ "USP_Cortex", "Cortex", 120, "Rare", rgb(30, 34, 44), rgb(0, 210, 255), "SmoothPlastic", true },
		{ "USP_Royal", "Royal Guard", 260, "Epic", rgb(28, 40, 110), rgb(230, 190, 70), "Metal" },
		{ "USP_KillConfirmed", "Night Ink", 480, "Legendary", rgb(16, 16, 18), rgb(255, 40, 60), "Glass", true },
	},
	Glock = {
		{ "Glock_Sand", "Sand Dune", 40, "Common", rgb(214, 190, 140), rgb(90, 80, 60), "SmoothPlastic" },
		{ "Glock_Candy", "Candy Pop", 110, "Rare", rgb(255, 120, 200), rgb(120, 230, 255), "SmoothPlastic" },
		{ "Glock_Fade", "Sunset Fade", 250, "Epic", rgb(255, 120, 40), rgb(160, 60, 255), "Metal", true },
		{ "Glock_Gold", "Gilded", 520, "Legendary", rgb(255, 200, 70), rgb(120, 80, 20), "Foil" },
	},
	Deagle = {
		{ "Deagle_Urban", "Urban Grey", 50, "Common", rgb(120, 125, 130), rgb(60, 62, 66), "Concrete" },
		{ "Deagle_Blaze", "Blaze", 160, "Rare", rgb(240, 90, 20), rgb(255, 210, 60), "SmoothPlastic", true },
		{ "Deagle_Ocean", "Deep Ocean", 300, "Epic", rgb(10, 70, 120), rgb(0, 255, 200), "Metal", true },
		{ "Deagle_Pharaoh", "Pharaoh", 600, "Legendary", rgb(230, 180, 60), rgb(20, 90, 160), "Foil" },
	},
	AK47 = {
		{ "AK47_Jungle", "Jungle Camo", 60, "Common", rgb(80, 105, 60), rgb(60, 50, 35), "Fabric" },
		{ "AK47_Redline", "Redline", 180, "Rare", rgb(25, 25, 28), rgb(220, 30, 40), "SmoothPlastic" },
		{ "AK47_Vulkan", "Volcano", 340, "Epic", rgb(40, 20, 15), rgb(255, 110, 20), "Basalt", true },
		{ "AK47_Neon", "Neon Rider", 650, "Legendary", rgb(30, 10, 60), rgb(255, 0, 230), "Glass", true },
		{ "AK47_Gold", "Golden Age", 1200, "Mythic", rgb(255, 205, 80), rgb(255, 245, 200), "Foil", true },
	},
	M4A1S = {
		{ "M4_Arctic", "Arctic", 60, "Common", rgb(225, 232, 240), rgb(140, 150, 165), "SmoothPlastic" },
		{ "M4_Cyrex", "Cyber Red", 190, "Rare", rgb(200, 30, 40), rgb(230, 230, 235), "SmoothPlastic" },
		{ "M4_Hyper", "Hyper Beast", 360, "Epic", rgb(0, 160, 140), rgb(255, 60, 120), "Metal", true },
		{ "M4_Ice", "Glacier", 680, "Legendary", rgb(150, 220, 255), rgb(255, 255, 255), "Ice", true },
	},
	SCAR = {
		{ "SCAR_Forest", "Woodland", 60, "Common", rgb(70, 90, 55), rgb(110, 85, 55), "Fabric" },
		{ "SCAR_Carbon", "Carbon", 170, "Rare", rgb(22, 24, 28), rgb(90, 95, 105), "Slate" },
		{ "SCAR_Toxic", "Toxic", 330, "Epic", rgb(40, 50, 30), rgb(160, 255, 40), "SmoothPlastic", true },
		{ "SCAR_Brick", "Toy Brick", 620, "Legendary", rgb(230, 40, 40), rgb(255, 210, 0), "Plastic" },
	},
	AWP = {
		{ "AWP_Safari", "Safari", 80, "Common", rgb(190, 160, 100), rgb(100, 80, 50), "Fabric" },
		{ "AWP_Electric", "Electric Hive", 240, "Rare", rgb(20, 60, 140), rgb(80, 220, 255), "Metal", true },
		{ "AWP_Dragon", "Dragon Scale", 520, "Epic", rgb(120, 20, 20), rgb(255, 180, 40), "Slate", true },
		{ "AWP_Asiimov", "Starlight", 900, "Legendary", rgb(240, 240, 240), rgb(255, 120, 0), "SmoothPlastic", true },
		{ "AWP_Jade", "Jade Serpent", 1500, "Mythic", rgb(20, 140, 90), rgb(255, 215, 90), "Marble", true },
	},
	Knife = {
		{ "Knife_Stone", "Obsidian", 120, "Rare", rgb(20, 20, 24), rgb(90, 70, 160), "Slate" },
		{ "Knife_Fade", "Prism Fade", 400, "Epic", rgb(255, 80, 180), rgb(80, 200, 255), "Metal", true },
		{ "Knife_Gold", "Sun Blade", 800, "Legendary", rgb(255, 200, 60), rgb(255, 120, 20), "Foil", true },
		{ "Knife_Glacier", "Frostbite", 1400, "Mythic", rgb(170, 230, 255), rgb(255, 255, 255), "Ice", true },
	},
}

SkinData.ById = {}
SkinData.ByWeapon = {}

for weaponId, list in pairs(defs) do
	SkinData.ByWeapon[weaponId] = {}
	for _, d in ipairs(list) do
		local skin = {
			Id = d[1],
			Name = d[2],
			Price = d[3],
			Rarity = d[4],
			Body = d[5],
			Accent = d[6],
			Material = Enum.Material[d[7]],
			NeonAccent = d[8] == true,
			Weapon = weaponId,
		}
		SkinData.ById[skin.Id] = skin
		table.insert(SkinData.ByWeapon[weaponId], skin)
	end
	table.sort(SkinData.ByWeapon[weaponId], function(a, b)
		return a.Price < b.Price
	end)
end

function SkinData.Get(id)
	return SkinData.ById[id]
end

function SkinData.ForWeapon(weaponId)
	return SkinData.ByWeapon[weaponId] or {}
end

return SkinData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[--[[
	Sounds
	Every sound in the game is built from the 11 audio files that ship inside the Roblox client
	(content/sounds, checked against the client file manifest), so there is never a dead
	asset link. Each sound is one or more layers: a file, cut to a short slice (Start/Len),
	re-pitched and shaped with distortion / EQ / reverb. Layers can be delayed to build
	clicks, racks and jingles. The podium music is a sequenced track (melody, bass, drums)
	played from the same files.

	To use your own licensed audio instead, put ids in Config.Sounds.Overrides
	(e.g. Overrides = { AK_Shot = "rbxassetid://123" }) or Config.Sounds.PodiumMusicId.

	Client-only playback (sounds are cosmetic; the server never needs them).
]]

local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Config = require(script.Parent.Config)

local Sounds = {}

local S = "rbxasset://sounds/"
-- The complete list of built-in sounds available to games (tests fail on anything else).
Sounds.BuiltIn = {
	EXPLOSION = S .. "impact_explosion_03.mp3",
	LAND = S .. "action_jump_land.mp3",
	STEP = S .. "action_footsteps_plastic.mp3",
	GETUP = S .. "action_get_up.mp3",
	JUMP = S .. "action_jump.mp3",
	SWIM = S .. "action_swim.mp3",
	WATER = S .. "impact_water.mp3",
	FALL = S .. "action_falling.ogg",
	OOF = S .. "oof.ogg",
	OUCH = S .. "ouch.ogg",
	TICK = S .. "volume_slider.ogg",
}
local F = Sounds.BuiltIn

local function L(id, vol, speed, opts)
	local layer = { Id = id, Volume = vol, Speed = speed }
	if opts then
		for k, v in pairs(opts) do
			layer[k] = v
		end
	end
	return layer
end

-- semitones -> playback speed
local function st(n)
	return 2 ^ (n / 12)
end

--[[ Layer fields: Id, Volume, Speed, Start (seconds into the file), Len (real seconds to keep),
     Delay, Dist (distortion 0..1), Low / High (EQ gain dB), Reverb (bool) ]]
Sounds.Defs = {
	-- GUNSHOTS: the explosion sample cut short and pitched up gives a punchy report;
	-- every weapon gets its own pitch, length, saturation and tone.
	USP_Shot = { -- suppressed: dull "thup"
		L(F.EXPLOSION, 0.4, 3.3, { Len = 0.16, Low = 5, High = -20 }),
		L(F.LAND, 0.35, 2.6, { Len = 0.12, High = -8 }),
		L(F.STEP, 0.18, 2.4, { Len = 0.05, Delay = 0.03 }),
	},
	Glock_Shot = { -- light, snappy pistol
		L(F.EXPLOSION, 0.6, 2.75, { Len = 0.2, Dist = 0.45, High = 3 }),
		L(F.STEP, 0.25, 2.2, { Len = 0.05 }),
	},
	Deagle_Shot = { -- heavy hand cannon with a tail
		L(F.EXPLOSION, 1, 1.5, { Len = 0.55, Dist = 0.7, Low = 6, Reverb = true }),
		L(F.LAND, 0.6, 1.2, { Len = 0.25 }),
	},
	AK_Shot = { -- loud, gritty rifle
		L(F.EXPLOSION, 0.9, 1.95, { Len = 0.3, Dist = 0.65, Low = 4 }),
		L(F.STEP, 0.2, 1.8, { Len = 0.05 }),
	},
	M4_Shot = { -- suppressed rifle: muffled but deeper than the USP
		L(F.EXPLOSION, 0.5, 2.45, { Len = 0.2, Low = 4, High = -15 }),
		L(F.LAND, 0.32, 2, { Len = 0.12 }),
	},
	SCAR_Shot = { -- sharper, brighter rifle
		L(F.EXPLOSION, 0.8, 2.25, { Len = 0.25, Dist = 0.55, High = 4 }),
		L(F.STEP, 0.22, 2.4, { Len = 0.04 }),
	},
	AWP_Shot = { -- huge sniper boom with echo
		L(F.EXPLOSION, 1, 1.12, { Len = 1.3, Dist = 0.8, Low = 8, Reverb = true }),
		L(F.LAND, 0.7, 0.8, { Len = 0.4 }),
	},

	-- WEAPON HANDLING
	DryFire = { L(F.STEP, 0.5, 2.6, { Len = 0.06 }) },
	MagOut = { L(F.STEP, 0.6, 1.4, { Len = 0.12 }), L(F.GETUP, 0.25, 1.8, { Len = 0.2, Delay = 0.05 }) },
	MagIn = { L(F.LAND, 0.6, 2.4, { Len = 0.15 }), L(F.STEP, 0.45, 2, { Len = 0.07, Delay = 0.06 }) },
	BoltRack = { L(F.STEP, 0.7, 1.1, { Len = 0.1 }), L(F.STEP, 0.6, 1.6, { Len = 0.08, Delay = 0.14 }) },
	EquipGun = { L(F.GETUP, 0.45, 1.6, { Len = 0.3 }), L(F.STEP, 0.3, 2, { Len = 0.06, Delay = 0.2 }) },
	EquipKnife = { L(F.JUMP, 0.4, 2.2, { Len = 0.25, High = 4 }), L(F.STEP, 0.3, 3, { Len = 0.05, Delay = 0.12 }) },
