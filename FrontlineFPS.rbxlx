	Maya = {
		Id = "Maya",
		Name = "Temple of the Jaguar",
		Subtitle = "MAYA JUNGLE CITY",
		Description = "Stepped pyramids rising out of the jungle. Ball court in the middle, cenote tunnels below.",
		Color = Color3.fromRGB(40, 180, 140),
		Lighting = {
			ClockTime = 7.6,
