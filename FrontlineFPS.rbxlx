			Name = "L" .. i,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.cos(r) * 11, 0.5, math.sin(r) * 11),
			Size = UDim2.fromOffset(10, 2),
