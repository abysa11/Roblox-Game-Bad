}

local function makePart(shape, size)
	local p
	if shape == W then
		p = Instance.new("WedgePart")
	else
		p = Instance.new("Part")
		if shape == C then
			p.Shape = Enum.PartType.Cylinder
		end
	end
	p.Size = size
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

function WeaponModels.GetDefaults(weaponId)
	return DEFAULTS[weaponId]
end

-- Applies a skin (or the default finish when skinId is nil/unknown) to an existing model.
function WeaponModels.ApplySkin(model: Model, weaponId: string, skinId: string?)
	local skin = skinId and SkinData.Get(skinId)
	if skin and skin.Weapon ~= weaponId then
		skin = nil
	end
	local def = DEFAULTS[weaponId]
	local bodyColor = skin and skin.Body or def.Body
	local accentColor = skin and skin.Accent or def.Accent
	local bodyMat = skin and skin.Material or def.Material
	local neon = skin and skin.NeonAccent
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			local role = p:GetAttribute("Role")
			if role == "Body" then
				p.Color = bodyColor
				p.Material = bodyMat
				p.Reflectance = (bodyMat == Enum.Material.Foil or bodyMat == Enum.Material.Glass) and 0.15 or 0
			elseif role == "Accent" then
				p.Color = accentColor
				p.Material = bodyMat == Enum.Material.Wood and Enum.Material.SmoothPlastic or bodyMat
			elseif role == "Glow" then
				p.Color = accentColor
				p.Material = Enum.Material.Neon
				p.Transparency = neon and 0 or 1
			end
		end
	end
	model:SetAttribute("SkinId", skin and skin.Id or "")
end

function WeaponModels.Build(weaponId: string, skinId: string?): Model
	local geo = GEOMETRY[weaponId]
	assert(geo, "No geometry for weapon " .. tostring(weaponId))

	local model = Instance.new("Model")
	model.Name = weaponId

	local handle = makePart(B, Vector3.new(0.2, 0.2, 0.2))
	handle.Name = "Handle"
	handle.Transparency = 1
	handle.CFrame = CFrame.new()
	handle.Parent = model
	model.PrimaryPart = handle

	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = geo.muzzle
	muzzle.Parent = handle

	local left = Instance.new("Attachment")
	left.Name = "LeftHand"
	left.CFrame = geo.leftHand
	left.Parent = handle

	local mag
	for _, d in ipairs(geo.parts) do
		local role, shape, size, cf, name = d[1], d[2], d[3], d[4], d[5]
		local p = makePart(shape, size)
		p.Name = name or role
		p:SetAttribute("Role", role)
		if role == "Metal" then
			p.Color = METAL
			p.Material = Enum.Material.Metal
		elseif role == "Grip" then
			p.Color = GRIP
			p.Material = Enum.Material.SmoothPlastic
		end
		p.CFrame = cf
		p.Parent = model
		if name == "Mag" then
			mag = p
			local w = Instance.new("Weld")
			w.Name = "MagWeld"
			w.Part0 = handle
			w.Part1 = p
			w.C0 = cf
			w.Parent = p
		elseif name == "MagPart" and mag then
			local w = Instance.new("WeldConstraint")
			w.Part0 = mag
			w.Part1 = p
			w.Parent = p
		else
			local w = Instance.new("WeldConstraint")
			w.Part0 = handle
			w.Part1 = p
			w.Parent = p
		end
	end

	WeaponModels.ApplySkin(model, weaponId, skinId)
	return model
end

-- Re-anchors a built model for static display (ViewportFrames / lobby displays).
function WeaponModels.BuildStatic(weaponId: string, skinId: string?): Model
	local model = WeaponModels.Build(weaponId, skinId)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	return model
end

-- Approximate length of the weapon, used to frame preview cameras.
function WeaponModels.GetLength(weaponId: string): number
	local geo = GEOMETRY[weaponId]
	if not geo then
		return 2
	end
	return math.abs(geo.muzzle.Z) + 1.4
end

return WeaponModels
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000028"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000000F"><Properties><string name="Name">Builders</string></Properties><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Builder</string><ProtectedString name="Source"><![CDATA[--[[
	Builder
	Geometry toolkit used by the lobby, the five maps and the podium.
	All coordinates passed to a Builder are LOCAL to its origin CFrame, so a map can be built
	anywhere in the world (several maps can run side by side in one server).
]]

local Builder = {}
Builder.__index = Builder

local DEFAULT_MAT = Enum.Material.SmoothPlastic

function Builder.new(parent: Instance, origin: CFrame)
	local self = setmetatable({}, Builder)
	self.Folder = parent
	self.Origin = origin
	self.Count = 0
	self.Root = self
	return self
end

-- Child builder that puts its parts into a sub-folder (same origin).
function Builder:Sub(name: string, className: string?)
	local f = Instance.new(className or "Folder")
	f.Name = name
	f.Parent = self.Folder
	local b = setmetatable({}, Builder)
	b.Folder = f
	b.Origin = self.Origin
	b.Count = 0
	b.Root = self.Root
	return b
end

function Builder:World(cf: CFrame | Vector3): CFrame
	if typeof(cf) == "Vector3" then
		return self.Origin * CFrame.new(cf)
	end
	return self.Origin * cf
end

function Builder:WorldPos(v: Vector3): Vector3
	return self.Origin:PointToWorldSpace(v)
end

local function applyProps(p: BasePart, props)
	if not props then
		return
	end
	for k, v in pairs(props) do
		if k == "Studs" then
			if v then
				p.TopSurface = Enum.SurfaceType.Studs
				p.BottomSurface = Enum.SurfaceType.Inlet
				p.Material = Enum.Material.Plastic
			end
		elseif k == "NoBullets" then
			if v then
				p.CanQuery = false
			end
		elseif k ~= "Class" then
			(p :: any)[k] = v
		end
	end
end

function Builder:Part(size: Vector3, cf: CFrame | Vector3, color: Color3?, material: Enum.Material?, props: any?): BasePart
	local className = props and props.Class or "Part"
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = self:World(cf)
	p.Color = color or Color3.fromRGB(160, 160, 160)
	p.Material = material or DEFAULT_MAT
	applyProps(p, props)
	p.Parent = self.Folder
	self.Root.Count += 1
	return p
end

-- Axis-aligned box from two local corners.
function Builder:Box(x0, y0, z0, x1, y1, z1, color, material, props): BasePart
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minY, maxY = math.min(y0, y1), math.max(y0, y1)
	local minZ, maxZ = math.min(z0, z1), math.max(z0, z1)
	local size = Vector3.new(math.max(maxX - minX, 0.05), math.max(maxY - minY, 0.05), math.max(maxZ - minZ, 0.05))
	return self:Part(size, Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2), color, material, props)
end

function Builder:Wedge(size: Vector3, cf: CFrame | Vector3, color, material, props): BasePart
	local p2 = props and table.clone(props) or {}
	p2.Class = "WedgePart"
	return self:Part(size, cf, color, material, p2)
end

-- Cylinder whose axis runs along local X of `cf`.
function Builder:Cyl(length: number, diameter: number, cf: CFrame | Vector3, color, material, props): BasePart
	local p2 = props and table.clone(props) or {}
	p2.Shape = Enum.PartType.Cylinder
	return self:Part(Vector3.new(length, diameter, diameter), cf, color, material, p2)
end

-- Vertical cylinder standing on `base` (local position of the bottom centre).
function Builder:Column(base: Vector3, height: number, diameter: number, color, material, props): BasePart
	return self:Cyl(height, diameter, CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, material, props)
end

function Builder:Ball(diameter: number, pos: Vector3, color, material, props): BasePart
	local p2 = props and table.clone(props) or {}
	p2.Shape = Enum.PartType.Ball
	return self:Part(Vector3.new(diameter, diameter, diameter), pos, color, material, p2)
end

-- Walkable plank from a -> b (points on the walking surface).
function Builder:Ramp(a: Vector3, b: Vector3, width: number, color, material, props, thickness: number?): BasePart
	local t = thickness or 1
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b) * CFrame.new(0, -t / 2, 0)
	return self:Part(Vector3.new(width, t, len), cf, color, material, props)
end

-- Visual steps plus an invisible collision ramp for smooth movement.
function Builder:Stairs(a: Vector3, b: Vector3, width: number, color, material, props)
	local rise = b.Y - a.Y
	local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local run = flat.Magnitude
	local dir = flat.Unit
	local steps = math.max(2, math.floor(math.abs(rise) / 1.2 + 0.5))
	local stepRun = run / steps
	local stepRise = rise / steps
	local folder = self:Sub("Stairs")
	for i = 0, steps - 1 do
		local top = a.Y + stepRise * (i + 1)
		local h = math.max(0.4, top - math.min(a.Y, b.Y) + 0.2)
		local centerFlat = Vector3.new(a.X, 0, a.Z) + dir * (stepRun * (i + 0.5))
		local center = Vector3.new(centerFlat.X, top - h / 2, centerFlat.Z)
		local cf = CFrame.lookAt(center, center + dir)
		local sp = props and table.clone(props) or {}
		sp.CanCollide = false
		folder:Part(Vector3.new(width, h, stepRun + 0.05), cf, color, material, sp)
	end
	local ramp = folder:Ramp(a + Vector3.new(0, 0.1, 0), b + Vector3.new(0, 0.1, 0), width, color, material, { Transparency = 1, CanQuery = false }, 0.6)
	ramp.Name = "StairRamp"
	return folder
end

-- Climbable ladder (TrussPart). base = local bottom centre.
function Builder:Ladder(base: Vector3, height: number, color)
	local h = math.max(2, math.floor(height / 2 + 0.5) * 2)
	return self:Part(Vector3.new(2, h, 2), base + Vector3.new(0, h / 2, 0), color or Color3.fromRGB(90, 70, 50), Enum.Material.Metal, { Class = "TrussPart" })
end

--[[ Wall along a -> b (base points). openings = { {c=centerDist, w=width, b=bottom, t=top}, ... } ]]
function Builder:Wall(a: Vector3, b: Vector3, height: number, thickness: number, color, material, openings, props)
	local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local length = flat.Magnitude
	if length < 0.05 then
		return
	end
	local dir = flat.Unit
	local function seg(s, e, y0, y1)
		if e - s < 0.05 or y1 - y0 < 0.05 then
			return
		end
		local center = a + dir * ((s + e) / 2) + Vector3.new(0, (y0 + y1) / 2, 0)
		local cf = CFrame.lookAt(center, center + dir)
		self:Part(Vector3.new(thickness, y1 - y0, e - s), cf, color, material, props)
	end
	local ops = {}
	for _, o in ipairs(openings or {}) do
		table.insert(ops, o)
	end
	table.sort(ops, function(x, y)
		return x.c < y.c
	end)
	local cursor = 0
	for _, o in ipairs(ops) do
		local left = math.clamp(o.c - o.w / 2, 0, length)
		local right = math.clamp(o.c + o.w / 2, 0, length)
		if left > cursor then
			seg(cursor, left, 0, height)
		end
		local lo = math.max(left, cursor)
		if (o.b or 0) > 0 then
			seg(lo, right, 0, o.b)
		end
		if (o.t or height) < height then
			seg(lo, right, o.t, height)
		end
		cursor = math.max(cursor, right)
	end
	seg(cursor, length, 0, height)
end

-- Horizontal slab (top at yTop) with up to several rectangular holes {x0,z0,x1,z1}.
function Builder:Slab(x0, z0, x1, z1, yTop, thickness, color, material, holes, props)
	local rects = { { math.min(x0, x1), math.min(z0, z1), math.max(x0, x1), math.max(z0, z1) } }
	for _, h in ipairs(holes or {}) do
		local hx0, hz0, hx1, hz1 = math.min(h[1], h[3]), math.min(h[2], h[4]), math.max(h[1], h[3]), math.max(h[2], h[4])
		local nextRects = {}
		for _, r in ipairs(rects) do
			local rx0, rz0, rx1, rz1 = r[1], r[2], r[3], r[4]
			if hx1 <= rx0 or hx0 >= rx1 or hz1 <= rz0 or hz0 >= rz1 then
				table.insert(nextRects, r)
			else
				local cx0, cx1 = math.max(rx0, hx0), math.min(rx1, hx1)
				if hz0 > rz0 then
					table.insert(nextRects, { rx0, rz0, rx1, hz0 })
				end
				if hz1 < rz1 then
					table.insert(nextRects, { rx0, hz1, rx1, rz1 })
				end
				local mz0, mz1 = math.max(rz0, hz0), math.min(rz1, hz1)
				if cx0 > rx0 then
					table.insert(nextRects, { rx0, mz0, cx0, mz1 })
				end
				if cx1 < rx1 then
					table.insert(nextRects, { cx1, mz0, rx1, mz1 })
				end
			end
		end
		rects = nextRects
	end
	for _, r in ipairs(rects) do
		self:Box(r[1], yTop - thickness, r[2], r[3], yTop, r[4], color, material, props)
	end
end

--[[
	Enterable multi-storey building.
	spec = {
		x0, z0, x1, z1, y, floors, floorH, wall, color, mat, floorColor, floorMat, trimColor,
		doors = { {side="N"|"S"|"E"|"W", at=0..1, w=6, h=8} },
		windows = { spacing=10, w=4, h=3.5, b=4, groundFloor=true },
		roof = true (accessible roof with parapet), glass = true,
		stairSide = "W" | "E"
	}
	N = -Z side, S = +Z side, W = -X side, E = +X side.
]]
function Builder:Building(spec)
	local b = self:Sub(spec.name or "Building", "Model")
	local x0, z0, x1, z1 = spec.x0, spec.z0, spec.x1, spec.z1
	local y = spec.y or 0
	local floors = spec.floors or 1
	local fh = spec.floorH or 12
	local wt = spec.wall or 1
	local color, mat = spec.color, spec.mat or Enum.Material.Concrete
	local floorColor = spec.floorColor or Color3.fromRGB(120, 120, 125)
	local floorMat = spec.floorMat or Enum.Material.SmoothPlastic
	local rampW = 5
	local run = math.min(fh * 1.7, (z1 - z0) - 6)
	local stairE = spec.stairSide == "E"
	local function lane(k)
		local i = k % 2
		if stairE then
			local right = x1 - wt - i * rampW
			return right - rampW, right
		end
		local left = x0 + wt + i * rampW
		return left, left + rampW
	end
	local rampZ0 = z0 + wt + 1.5
	local rampZ1 = rampZ0 + run
	local totalFloors = floors + ((spec.roof ~= false) and 1 or 0)
	local hasStairs = totalFloors > 1 and spec.stairs ~= false

	-- ground floor slab
	b:Box(x0, y - 1, z0, x1, y + 0.2, z1, floorColor, floorMat)

	for f = 0, floors - 1 do
		local fy = y + f * fh
		local doorsHere = (f == 0) and spec.doors or {}
		local wins = spec.windows
		local function openingsFor(side, length)
			local ops = {}
			for _, d in ipairs(doorsHere) do
				if d.side == side then
					table.insert(ops, { c = d.at * length, w = d.w or 6, b = 0, t = d.h or 8 })
				end
			end
			if wins and (f > 0 or wins.groundFloor) then
				local spacing = wins.spacing or 10
				local n = math.floor((length - 4) / spacing)
				for i = 1, n do
					local c = (length - (n - 1) * spacing) / 2 + (i - 1) * spacing
					local blocked = false
					for _, o in ipairs(ops) do
						if math.abs(o.c - c) < (o.w / 2 + (wins.w or 4) / 2 + 1) then
							blocked = true
						end
					end
					if not blocked then
						table.insert(ops, { c = c, w = wins.w or 4, b = wins.b or 4, t = (wins.b or 4) + (wins.h or 3.5) })
					end
				end
			end
			return ops
		end
		local h = fh
		local nOps = openingsFor("N", x1 - x0)
		local sOps = openingsFor("S", x1 - x0)
		local wOps = openingsFor("W", z1 - z0)
		local eOps = openingsFor("E", z1 - z0)
		b:Wall(Vector3.new(x0, fy, z0 + wt / 2), Vector3.new(x1, fy, z0 + wt / 2), h, wt, color, mat, nOps)
		b:Wall(Vector3.new(x0, fy, z1 - wt / 2), Vector3.new(x1, fy, z1 - wt / 2), h, wt, color, mat, sOps)
		b:Wall(Vector3.new(x0 + wt / 2, fy, z0 + wt), Vector3.new(x0 + wt / 2, fy, z1 - wt), h, wt, color, mat, wOps)
		b:Wall(Vector3.new(x1 - wt / 2, fy, z0 + wt), Vector3.new(x1 - wt / 2, fy, z1 - wt), h, wt, color, mat, eOps)

		if spec.glass and wins and (f > 0 or wins.groundFloor) then
			local glassCol = Color3.fromRGB(150, 200, 230)
			local function glassFor(ops, side)
				for _, o in ipairs(ops) do
					if o.b > 0 then
						local gy0, gy1 = fy + o.b, fy + o.t
						if side == "N" or side == "S" then
							local zz = side == "N" and z0 + wt / 2 or z1 - wt / 2
							b:Box(x0 + o.c - o.w / 2, gy0, zz - 0.1, x0 + o.c + o.w / 2, gy1, zz + 0.1, glassCol, Enum.Material.Glass, { Transparency = 0.6, CanQuery = false, CastShadow = false })
						else
							local xx = side == "W" and x0 + wt / 2 or x1 - wt / 2
							b:Box(xx - 0.1, gy0, z0 + wt + o.c - o.w / 2, xx + 0.1, gy1, z0 + wt + o.c + o.w / 2, glassCol, Enum.Material.Glass, { Transparency = 0.6, CanQuery = false, CastShadow = false })
						end
					end
				end
			end
			glassFor(nOps, "N")
			glassFor(sOps, "S")
			glassFor(wOps, "W")
			glassFor(eOps, "E")
		end

		-- ramp from this floor up to the next one
		if hasStairs and f < totalFloors - 1 then
			local lx0, lx1 = lane(f)
			local cx = (lx0 + lx1) / 2
			b:Ramp(Vector3.new(cx, fy + 0.2, rampZ0), Vector3.new(cx, fy + fh + 0.2, rampZ1), rampW, spec.trimColor or floorColor, floorMat)
		end

		-- slab above this floor
		local ceilY = fy + fh + 0.2
		local holes = {}
		if hasStairs and f < totalFloors - 1 then
			local lx0, lx1 = lane(f)
			table.insert(holes, { lx0, rampZ0 - 0.5, lx1, rampZ1 })
		end
		if f < floors - 1 or spec.roof ~= false then
			b:Slab(x0, z0, x1, z1, ceilY, 1.2, floorColor, floorMat, holes)
		else
			b:Box(x0, ceilY - 1.2, z0, x1, ceilY, z1, floorColor, floorMat)
		end
		-- guard rail along the stair hole on the upper floor
		if #holes > 0 then
			local hole = holes[1]
			local railX = stairE and hole[1] or hole[3]
			b:Box(railX - 0.2, ceilY, hole[2], railX + 0.2, ceilY + 3, hole[4], spec.trimColor or color, Enum.Material.Metal)
		end
	end

	local roofY = y + floors * fh + 0.2
	if spec.roof ~= false then
		local ph = spec.parapet or 3
		local tc = spec.trimColor or color
		b:Box(x0, roofY, z0, x1, roofY + ph, z0 + 0.8, tc, mat)
		b:Box(x0, roofY, z1 - 0.8, x1, roofY + ph, z1, tc, mat)
		b:Box(x0, roofY, z0, x0 + 0.8, roofY + ph, z1, tc, mat)
		b:Box(x1 - 0.8, roofY, z0, x1, roofY + ph, z1, tc, mat)
	end
	return b, roofY
end

-- Invisible boundary walls around a rectangle (players stay in, bullets pass out).
-- Walls only, no ceiling: nobody can jump this high, and a ceiling is something to get stuck on.
function Builder:Boundary(x0, z0, x1, z1, y0, height)
	local t = 4
	local props = { Transparency = 1, CanQuery = false, CastShadow = false }
	local f = self:Sub("Boundary")
	f:Box(x0 - t, y0, z0 - t, x1 + t, y0 + height, z0, nil, nil, props)
	f:Box(x0 - t, y0, z1, x1 + t, y0 + height, z1 + t, nil, nil, props)
	f:Box(x0 - t, y0, z0, x0, y0 + height, z1, nil, nil, props)
	f:Box(x1, y0, z0, x1 + t, y0 + height, z1, nil, nil, props)
end

function Builder:Light(pos: Vector3, color: Color3, range: number, brightness: number?, shadows: boolean?)
	local p = self:Part(Vector3.new(0.4, 0.4, 0.4), pos, color, Enum.Material.Neon, { Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false })
	p.Name = "LightSource"
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1
	l.Shadows = shadows == true
	l:SetAttribute("WantsShadows", shadows == true)
	l.Parent = p
	return p
end

-- Text on one face of a part.
function Builder.Label(part: BasePart, face: Enum.NormalId, text: string, textColor: Color3?, opts)
	opts = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.PixelsPerStud or 20
	gui.LightInfluence = opts.LightInfluence or 0
	gui.Brightness = opts.Brightness or 1.5
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.Font = opts.Font or Enum.Font.GothamBlack
	label.TextColor3 = textColor or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = opts.Stroke and 0.3 or 1
	label.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = label
	return label
end

-- TERRAIN ------------------------------------------------------------------------------
function Builder:TerrainBox(x0, y0, z0, x1, y1, z1, material: Enum.Material)
	local center = self:WorldPos(Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2))
	local size = Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0))
	workspace.Terrain:FillBlock(CFrame.new(center), size, material)
end

function Builder:TerrainBall(pos: Vector3, radius: number, material: Enum.Material)
	workspace.Terrain:FillBall(self:WorldPos(pos), radius, material)
end

function Builder:ClearTerrain(x0, y0, z0, x1, y1, z1)
	self:TerrainBox(x0, y0, z0, x1, y1, z1, Enum.Material.Air)
end

-- Local Y of the ground (terrain or map parts) at local x,z.
function Builder:GroundY(x: number, z: number, fromY: number?, terrainOnly: boolean?): number
	local top = self:WorldPos(Vector3.new(x, fromY or 200, z))
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = terrainOnly and { workspace.Terrain } or { workspace.Terrain, self.Root.Folder }
	params.IgnoreWater = true
	local hit = workspace:Raycast(top, Vector3.new(0, -((fromY or 200) + 300), 0), params)
	if hit then
		return self.Origin:PointToObjectSpace(hit.Position).Y
	end
	return 0
end

return Builder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">LobbyBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	LobbyBuilder
	Main hub: spawn plaza, five themed map-select pads (each with a live sign and a small
	diorama preview of its map) and the skin shop kiosk.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapData = require(ReplicatedStorage.Shared.MapData)
local Builder = require(script.Parent.Builder)
local MapLoader = require(script.Parent.MapLoader)
local WeaponModels = require(ReplicatedStorage.WeaponModules.WeaponModels)

local LobbyBuilder = {}

local DARK = Color3.fromRGB(70, 74, 86) -- floor
local DARKER = Color3.fromRGB(22, 24, 30) -- signs, trims
local WALL = Color3.fromRGB(52, 56, 68)
local GRID = Color3.fromRGB(104, 110, 128)
local ACCENT = Color3.fromRGB(255, 140, 40)

local PAD = 22
local RADIUS = 74
local CENTER = Vector3.new(0, 0, 34)

local function decorate(b, mapId: string, color: Color3)
	-- themed props around each pad (pad-local space: pad centre at origin, front = +Z toward plaza)
	if mapId == "Forest" then
		for _, p in ipairs({ { -13, -13 }, { 13, -13 }, { -13, 8 }, { 13, 8 } }) do
			b:Cyl(4, 1.2, CFrame.new(p[1], 2, p[2]) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(95, 66, 40), Enum.Material.Wood)
			for i = 0, 2 do
				b:Part(Vector3.new(5 - i * 1.4, 2.6, 5 - i * 1.4), Vector3.new(p[1], 4.6 + i * 2, p[2]), Color3.fromRGB(46, 110 + i * 15, 52), Enum.Material.Grass)
			end
		end
		b:Cyl(8, 1.4, CFrame.new(0, 0.9, -12) * CFrame.Angles(0, math.rad(20), 0), Color3.fromRGB(110, 76, 46), Enum.Material.Wood)
	elseif mapId == "ModernCity" then
		for _, p in ipairs({ { -13, -13 }, { 13, -13 }, { -13, 8 }, { 13, 8 } }) do
			b:Column(Vector3.new(p[1], 0, p[2]), 9, 0.5, Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
			b:Part(Vector3.new(1.6, 0.4, 1.6), Vector3.new(p[1], 9.2, p[2]), Color3.fromRGB(255, 240, 200), Enum.Material.Neon)
		end
		b:Box(-9, 0, -16, -5, 12, -12, Color3.fromRGB(70, 90, 120), Enum.Material.Glass, { Transparency = 0.2 })
		b:Box(5, 0, -16, 9, 8, -12, Color3.fromRGB(90, 96, 104), Enum.Material.Concrete)
	elseif mapId == "BrickCity" then
		local colors = { Color3.fromRGB(230, 40, 40), Color3.fromRGB(255, 205, 0), Color3.fromRGB(30, 110, 230), Color3.fromRGB(40, 170, 70) }
		for i, p in ipairs({ { -13, -13 }, { 13, -13 }, { -13, 8 }, { 13, 8 } }) do
			for k = 0, 2 do
				b:Part(Vector3.new(4, 1.6, 2), Vector3.new(p[1], 0.8 + k * 1.6, p[2] + (k % 2) * 0.6), colors[(i + k) % 4 + 1], Enum.Material.Plastic, { Studs = true })
			end
		end
	elseif mapId == "Egypt" then
		for _, x in ipairs({ -13, 13 }) do
			b:Box(x - 1.2, 0, -14.2, x + 1.2, 10, -11.8, Color3.fromRGB(214, 180, 120), Enum.Material.Sandstone)
			b:Part(Vector3.new(2.4, 1.6, 2.4), Vector3.new(x, 10.8, -13), Color3.fromRGB(255, 205, 80), Enum.Material.Foil)
		end
		b:Box(-13, 0, 6, 13, 0.4, 12, Color3.fromRGB(230, 200, 140), Enum.Material.Sand)
	elseif mapId == "Maya" then
		for i = 0, 3 do
			local s = 8 - i * 1.8
			b:Box(-s, i * 1.4, -16 - s / 2, s, (i + 1) * 1.4, -16 + s / 2, Color3.fromRGB(120, 128, 112), Enum.Material.Slate)
		end
		for _, p in ipairs({ { -13, 6 }, { 13, 6 } }) do
			b:Ball(4.5, Vector3.new(p[1], 2, p[2]), Color3.fromRGB(40, 120, 60), Enum.Material.Grass)
		end
	end
	return color
end

function LobbyBuilder.Build(parent: Instance)
	local model = Instance.new("Model")
	model.Name = "Lobby"
	model.Parent = parent
	local b = Builder.new(model, CFrame.new())

	-- floor + grid
	b:Box(-130, -2, -110, 130, 0, 150, DARK, Enum.Material.Concrete)
	for x = -120, 120, 24 do
		b:Box(x - 0.15, 0, -110, x + 0.15, 0.05, 150, GRID, Enum.Material.SmoothPlastic, { CastShadow = false })
	end
	for z = -100, 150, 24 do
		b:Box(-130, 0, z - 0.15, 130, 0.05, z + 0.15, GRID, Enum.Material.SmoothPlastic, { CastShadow = false })
	end
	-- outer walls
	for _, w in ipairs({ { -130, -110, 130, -106 }, { -130, 146, 130, 150 }, { -130, -110, -126, 150 }, { 126, -110, 130, 150 } }) do
		b:Box(w[1], 0, w[2], w[3], 18, w[4], WALL, Enum.Material.Concrete)
		b:Box(w[1], 17.6, w[2], w[3], 18.2, w[4], ACCENT, Enum.Material.Neon, { CastShadow = false })
	end
	b:Boundary(-126, -106, 126, 146, 0, 80)

	-- spawn plaza
	local spawnPos = CENTER + Vector3.new(0, 0, 18)
	b:Column(spawnPos - Vector3.new(0, 0, 0), 0.6, 30, Color3.fromRGB(36, 38, 48), Enum.Material.SmoothPlastic)
	b:Column(spawnPos, 0.7, 26, ACCENT, Enum.Material.Neon)
	b:Column(spawnPos, 0.8, 24, Color3.fromRGB(36, 38, 48), Enum.Material.SmoothPlastic)
	b:Light(spawnPos + Vector3.new(0, 14, 0), Color3.fromRGB(255, 200, 150), 40, 1.5, true)
	-- Safety net: Roblox's own default placement also lands on the spawn pad.
	-- Invisible and non-solid (the pad underneath is the floor); no default force field.
	local spawnLocation = b:Part(Vector3.new(8, 0.4, 8), spawnPos + Vector3.new(0, 0.5, 0), ACCENT, Enum.Material.SmoothPlastic, {
		Class = "SpawnLocation",
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
	})
	spawnLocation.Name = "LobbySpawn"
	local sl = spawnLocation :: SpawnLocation
	sl.Neutral = true
	sl.Duration = 0
	for _, d in ipairs(sl:GetChildren()) do
		if d:IsA("Decal") then
			d:Destroy()
		end
	end

	-- title sign
	local title = b:Box(-40, 22, -100, 40, 36, -99, DARKER, Enum.Material.SmoothPlastic)
	Builder.Label(title, Enum.NormalId.Back, Config.GameName, Color3.new(1, 1, 1), { PixelsPerStud = 6 })
	b:Box(-40, 21.6, -99.2, 40, 22, -98.8, ACCENT, Enum.Material.Neon)
	b:Box(-1, 0, -100, 1, 22, -99, DARKER, Enum.Material.Metal)

	-- map pads
	local zones = {}
	local n = #MapData.Order
	for i, mapId in ipairs(MapData.Order) do
		local map = MapData.Get(mapId)
		local angle = math.rad(-64 + (i - 1) * (128 / (n - 1)))
		local pos = CENTER + Vector3.new(math.sin(angle) * RADIUS, 0, -math.cos(angle) * RADIUS)
		-- pad faces the plaza centre: local +Z points toward CENTER
		local padCF = CFrame.lookAt(pos, Vector3.new(CENTER.X, 0, CENTER.Z)) * CFrame.Angles(0, math.pi, 0)
		local pb = Builder.new(model, padCF)
		local sub = pb:Sub("Pad_" .. mapId)

		sub:Box(-PAD / 2 - 1.5, 0, -PAD / 2 - 1.5, PAD / 2 + 1.5, 0.5, PAD / 2 + 1.5, DARKER, Enum.Material.SmoothPlastic)
		local surface = sub:Box(-PAD / 2, 0.5, -PAD / 2, PAD / 2, 0.8, PAD / 2, map.Color:Lerp(Color3.new(0, 0, 0), 0.55), Enum.Material.SmoothPlastic)
		surface.Name = "PadSurface"
		for _, e in ipairs({ { -PAD / 2, -PAD / 2, PAD / 2, -PAD / 2 + 0.6 }, { -PAD / 2, PAD / 2 - 0.6, PAD / 2, PAD / 2 }, { -PAD / 2, -PAD / 2, -PAD / 2 + 0.6, PAD / 2 }, { PAD / 2 - 0.6, -PAD / 2, PAD / 2, PAD / 2 } }) do
			sub:Box(e[1], 0.8, e[2], e[3], 0.95, e[4], map.Color, Enum.Material.Neon, { CastShadow = false })
		end
		local floorText = sub:Box(-8, 0.8, -3, 8, 0.82, 3, Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false })
		local ft = Builder.Label(floorText, Enum.NormalId.Top, "STEP IN TO QUEUE", map.Color, { PixelsPerStud = 12 })
		ft.Rotation = 180

		-- sign board behind the pad
		local sign = sub:Box(-12, 6, -PAD / 2 - 6.5, 12, 19, -PAD / 2 - 5.5, DARKER, Enum.Material.SmoothPlastic)
		sub:Box(-12, 5.6, -PAD / 2 - 6.4, 12, 6, -PAD / 2 - 5.4, map.Color, Enum.Material.Neon, { CastShadow = false })
		sub:Box(-11, 0, -PAD / 2 - 6.3, -10, 6, -PAD / 2 - 5.7, Color3.fromRGB(50, 52, 60), Enum.Material.Metal)
		sub:Box(10, 0, -PAD / 2 - 6.3, 11, 6, -PAD / 2 - 5.7, Color3.fromRGB(50, 52, 60), Enum.Material.Metal)
		local gui = Instance.new("SurfaceGui")
		gui.Name = "SignGui"
		gui.Face = Enum.NormalId.Back -- +Z, toward the plaza
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 24
		gui.LightInfluence = 0
		gui.Brightness = 1.4
		gui.Parent = sign
		local function line(name, y, h, text, font, color)
			local l = Instance.new("TextLabel")
			l.Name = name
			l.BackgroundTransparency = 1
			l.Position = UDim2.fromScale(0.05, y)
			l.Size = UDim2.fromScale(0.9, h)
			l.Font = font
			l.TextScaled = true
			l.TextColor3 = color
			l.Text = text
			l.Parent = gui
			return l
		end
		line("Subtitle", 0.05, 0.1, map.Subtitle, Enum.Font.GothamBold, map.Color)
		line("Title", 0.16, 0.2, map.Name, Enum.Font.GothamBlack, Color3.new(1, 1, 1))
		local desc = line("Desc", 0.4, 0.2, map.Description, Enum.Font.Gotham, Color3.fromRGB(190, 195, 205))
		desc.TextWrapped = true
		local count = line("Count", 0.64, 0.14, "WAITING: 0 / " .. Config.Match.MaxPlayers, Enum.Font.GothamBold, Color3.new(1, 1, 1))
		local status = line("Status", 0.8, 0.13, "Step onto the pad to queue", Enum.Font.GothamMedium, map.Color)

		-- diorama preview on a pedestal (left of the sign, so it is visible from the plaza)
		sub:Box(-PAD / 2 - 9, 0, -6, -PAD / 2 - 2, 3, 1, Color3.fromRGB(36, 38, 48), Enum.Material.SmoothPlastic)
		sub:Box(-PAD / 2 - 9.1, 2.9, -6.1, -PAD / 2 - 1.9, 3.1, 1.1, map.Color, Enum.Material.Neon, { CastShadow = false })
		local previewCF = padCF * CFrame.new(-PAD / 2 - 5.5, 3.1, -2.5)
		local ok, err = pcall(MapLoader.BuildPreview, mapId, model, previewCF)
		if not ok then
			warn("[Lobby] preview for " .. mapId .. " failed: " .. tostring(err))
		end

		decorate(sub, mapId, map.Color)
		sub:Light(Vector3.new(0, 10, 0), map.Color, 26, 1.2)

		zones[mapId] = {
			CFrame = padCF * CFrame.new(0, 5, 0),
			Size = Vector3.new(PAD, 10, PAD),
			Count = count,
			Status = status,
			Surface = surface,
		}
	end

	-- skin shop kiosk (behind spawn)
	local kioskCF = CFrame.new(0, 0, 118)
	local kb = Builder.new(model, kioskCF):Sub("SkinShop")
	kb:Box(-16, 0, -6, 16, 1, 8, DARKER, Enum.Material.SmoothPlastic)
	kb:Box(-16, 1, 6, 16, 16, 8, Color3.fromRGB(30, 32, 42), Enum.Material.SmoothPlastic)
	kb:Box(-16, 15, -6, 16, 16, 8, Color3.fromRGB(30, 32, 42), Enum.Material.SmoothPlastic)
	kb:Box(-16, 1, -6, -15, 15, 8, Color3.fromRGB(30, 32, 42), Enum.Material.SmoothPlastic)
	kb:Box(15, 1, -6, 16, 15, 8, Color3.fromRGB(30, 32, 42), Enum.Material.SmoothPlastic)
	kb:Box(-16, 14.6, -6.4, 16, 15, -6, Color3.fromRGB(136, 71, 255), Enum.Material.Neon)
	local header = kb:Box(-10, 16, -1, 10, 21, 0, DARKER, Enum.Material.SmoothPlastic)
	Builder.Label(header, Enum.NormalId.Front, "SKIN SHOP", Color3.fromRGB(200, 170, 255), { PixelsPerStud = 10 })
	local counter = kb:Box(-6, 1, -2, 6, 4.5, 0, Color3.fromRGB(50, 40, 80), Enum.Material.SmoothPlastic)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SkinShopPrompt"
	prompt.ActionText = "Open Skin Shop"
	prompt.ObjectText = "Weapon Skins"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = counter
	-- weapon showcase on the back wall
	local showcase = { "AK47", "AWP", "M4A1S", "Deagle", "Knife" }
	for i, id in ipairs(showcase) do
		local w = WeaponModels.BuildStatic(id, nil)
		local x = -12 + (i - 1) * 6
		w:PivotTo(kioskCF * CFrame.new(x, 9, 5.6) * CFrame.Angles(0, math.rad(90), math.rad(-60)))
		w.Parent = kb.Folder
	end
	kb:Light(Vector3.new(0, 12, 0), Color3.fromRGB(170, 120, 255), 30, 1.6)

	-- ambient lighting columns
	for _, p in ipairs({ { -90, -60 }, { 90, -60 }, { -100, 60 }, { 100, 60 }, { -60, 120 }, { 60, 120 } }) do
		b:Column(Vector3.new(p[1], 0, p[2]), 14, 2, Color3.fromRGB(36, 38, 48), Enum.Material.SmoothPlastic)
		b:Part(Vector3.new(2.4, 1, 2.4), Vector3.new(p[1], 14.5, p[2]), ACCENT, Enum.Material.Neon)
		b:Light(Vector3.new(p[1], 15, p[2]), Color3.fromRGB(255, 180, 120), 30, 1)
	end

	return {
		Model = model,
		SpawnCFrame = CFrame.lookAt(spawnPos + Vector3.new(0, 1, 0), CENTER + Vector3.new(0, 1, -40)),
		Zones = zones,
		SkinShopPrompt = prompt,
	}
end

return LobbyBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">MapKit</string><ProtectedString name="Source"><![CDATA[--[[
	MapKit
	Pieces shared by all five maps: team spawn bases (spawn points + shop zone), crates,
	barrels and sandbag cover. Map layouts use the same convention:
	  playable area x in [-120, 120], z in [-140, 140]
	  Red base at z = -125 facing +Z, Blue base at z = +125 facing -Z
	  podium floats high above the map at (0, 450, 0)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local MapKit = {}

MapKit.PODIUM = CFrame.new(0, 450, 0)
MapKit.BOUNDS = { x0 = -122, z0 = -142, x1 = 122, z1 = 142 }

--[[
	Team base. opts = { floorColor, floorMat, wallColor, wallMat, y }
	Returns spawn CFrames (local) and the spawn zone used for the weapon shop.
]]
function MapKit.SpawnBase(b, team: string, opts)
	opts = opts or {}
	local sign = team == "Red" and -1 or 1
	local zc = 125 * sign
	local y = opts.y or 0
	local teamColor = Config.Teams[team].Color
	local sub = b:Sub(team .. "Base")
	local floorColor = opts.floorColor or Color3.fromRGB(70, 70, 76)
	local floorMat = opts.floorMat or Enum.Material.Concrete
	local wallColor = opts.wallColor or Color3.fromRGB(90, 90, 96)
	local wallMat = opts.wallMat or Enum.Material.Concrete

	-- floor pad
	sub:Box(-22, y - 1, zc - 12, 22, y + 0.3, zc + 12, floorColor, floorMat)
	-- team stripe & spawn marker
	sub:Box(-22, y + 0.3, zc - 0.4 - 11.6 * sign, 22, y + 0.4, zc + 0.4 - 11.6 * sign, teamColor, Enum.Material.Neon, { CastShadow = false })
	for _, x in ipairs({ -12, 0, 12 }) do
		sub:Box(x - 3, y + 0.3, zc - 3, x + 3, y + 0.35, zc + 3, teamColor:Lerp(Color3.new(0, 0, 0), 0.4), Enum.Material.SmoothPlastic, { CastShadow = false })
	end
	-- back wall and side walls (protect the spawn from long sight lines)
	local backZ = zc + 12 * sign
	sub:Box(-24, y, backZ, 24, y + 14, backZ + 2 * sign, wallColor, wallMat)
	sub:Box(-24, y, zc - 12, -22, y + 9, zc + 12, wallColor, wallMat)
	sub:Box(22, y, zc - 12, 24, y + 9, zc + 12, wallColor, wallMat)
	-- front cover blocks with three exits (left, middle, right)
	local frontZ = zc - 12 * sign
	sub:Box(-16, y, frontZ - 1, -6, y + 4.5, frontZ + 1, wallColor, wallMat)
	sub:Box(6, y, frontZ - 1, 16, y + 4.5, frontZ + 1, wallColor, wallMat)
	-- team banner
	local banner = sub:Box(-8, y + 7, backZ - 0.2 * sign, 8, y + 13, backZ, teamColor, Enum.Material.SmoothPlastic)
	banner.Name = "TeamBanner"
	sub:Light(Vector3.new(0, y + 10, zc), teamColor, 30, 1)

	local spawns = {}
	local facing = Vector3.new(0, 0, -sign)
	for _, x in ipairs({ -14, -7, 0, 7, 14 }) do
		for _, dz in ipairs({ -4, 4 }) do
			local pos = Vector3.new(x, y + 0.5, zc + dz)
			table.insert(spawns, CFrame.lookAt(pos, pos + facing))
		end
	end
	local zone = { CFrame = CFrame.new(0, y + 6, zc), Size = Vector3.new(44, 12, 24) }
	return spawns, zone
end

function MapKit.Crate(b, pos: Vector3, size: number?, color: Color3?, rotY: number?)
	local s = size or 4
	local c = color or Color3.fromRGB(150, 110, 62)
	local cf = CFrame.new(pos + Vector3.new(0, s / 2, 0)) * CFrame.Angles(0, math.rad(rotY or 0), 0)
	b:Part(Vector3.new(s, s, s), cf, c, Enum.Material.WoodPlanks)
	-- frame edges
	local e = 0.25
	local dark = c:Lerp(Color3.new(0, 0, 0), 0.35)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			b:Part(Vector3.new(e * 2, s + 0.05, e * 2), cf * CFrame.new(sx * (s / 2 - e + 0.02), 0, sz * (s / 2 - e + 0.02)), dark, Enum.Material.Wood, { CastShadow = false })
		end
	end
end

function MapKit.CrateStack(b, pos: Vector3, color: Color3?)
	MapKit.Crate(b, pos, 4, color, 0)
	MapKit.Crate(b, pos + Vector3.new(4.2, 0, 0.5), 4, color, 8)
	MapKit.Crate(b, pos + Vector3.new(2, 4, 0.2), 4, color, -6)
end

function MapKit.Barrel(b, pos: Vector3, color: Color3?)
	b:Column(pos, 3.6, 2.6, color or Color3.fromRGB(60, 90, 140), Enum.Material.Metal)
	b:Column(pos + Vector3.new(0, 3.55, 0), 0.1, 2.7, Color3.fromRGB(40, 40, 44), Enum.Material.Metal)
end

function MapKit.Sandbags(b, a: Vector3, bLen: number, rotY: number, color: Color3?)
	local c = color or Color3.fromRGB(170, 150, 110)
	local cf = CFrame.new(a) * CFrame.Angles(0, math.rad(rotY), 0)
	local n = math.floor(bLen / 2.2)
	for row = 0, 2 do
		for i = 0, n - 1 - (row % 2) do
			local x = -bLen / 2 + 1.1 + i * 2.2 + (row % 2) * 1.1
			b:Part(Vector3.new(2.2, 1.1, 1.6), cf * CFrame.new(x, 0.55 + row * 1.05, 0), c, Enum.Material.Fabric)
		end
	end
end

return MapKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">MapLoader</string><ProtectedString name="Source"><![CDATA[--[[
	MapLoader
	Builds a map at a world origin, converts its local spawn data to world space and attaches
	a results podium. Map modules return local-space info:
	  { Spawns = {Red={CFrame}, Blue={CFrame}}, SpawnZones = {Red={CFrame,Size}, Blue=...},
	    Podium = CFrame, KillY = number, Bounds = {x0,y0,z0,x1,y1,z1} }
]]

local Builder = require(script.Parent.Builder)
local PodiumBuilder = require(script.Parent.PodiumBuilder)

local MapLoader = {}

local MODULES = {
	Forest = script.Parent.Maps.Forest,
	ModernCity = script.Parent.Maps.ModernCity,
	BrickCity = script.Parent.Maps.BrickCity,
	Egypt = script.Parent.Maps.Egypt,
	Maya = script.Parent.Maps.Maya,
}

local function mapsFolder()
	local f = workspace:FindFirstChild("Maps")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Maps"
		f.Parent = workspace
	end
	return f
end

function MapLoader.GetModule(mapId: string)
	local m = MODULES[mapId]
	return m and require(m)
end

function MapLoader.Load(mapId: string, origin: CFrame)
	local module = MapLoader.GetModule(mapId)
	assert(module, "Unknown map " .. tostring(mapId))
	local model = Instance.new("Model")
	model.Name = mapId
	model:SetAttribute("MapId", mapId)
	model.Parent = mapsFolder()
	local b = Builder.new(model, origin)
	local t0 = os.clock()
	local info = module.Build(b)
	print(string.format("[MapLoader] built %s with %d parts in %.2fs", mapId, b.Count, os.clock() - t0))

	local world = { Spawns = { Red = {}, Blue = {} }, SpawnZones = {}, Model = model, MapId = mapId, Origin = origin }
	for team, list in pairs(info.Spawns) do
		for _, cf in ipairs(list) do
			table.insert(world.Spawns[team], origin * cf)
		end
	end
	for team, zone in pairs(info.SpawnZones) do
		world.SpawnZones[team] = { CFrame = origin * zone.CFrame, Size = zone.Size }
	end
	world.KillY = origin.Position.Y + (info.KillY or -60)
	world.Podium = PodiumBuilder.new(model, origin * info.Podium)
	world.PodiumCFrame = origin * info.Podium

	function world.Destroy()
		world.Podium:Destroy()
		model:Destroy()
		local bd = info.Bounds
		if bd then
			b:ClearTerrain(bd[1], bd[2], bd[3], bd[4], bd[5], bd[6])
		end
	end
	return world
end

function MapLoader.BuildPreview(mapId: string, parent: Instance, cf: CFrame)
	local module = MapLoader.GetModule(mapId)
	if module and module.BuildPreview then
		local model = Instance.new("Model")
		model.Name = mapId .. "Preview"
		model.Parent = parent
		module.BuildPreview(Builder.new(model, cf))
		return model
	end
	return nil
end

return MapLoader
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000014"><Properties><string name="Name">Maps</string></Properties><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">BrickCity</string><ProtectedString name="Source"><![CDATA[--[[
	MAP 3 - BRICK CITY "Toybox Town"
	A giant toy world built from plastic building bricks (all original shapes, no logos).
	Point-symmetric layout:
	  * Centre: a brick castle with a raised courtyard, corner towers and a tight tunnel underneath
	  * West : "Tower Park" - stacked brick towers of different heights linked by plates
	  * East : "Toy Street" - bright toy houses with slope-brick roofs, toy cars, a toy train
	  * Oversized 2x4 bricks everywhere as cover, block trees and lollipop trees
]]

local MapKit = require(script.Parent.Parent.MapKit)

local BrickCity = {}

local RED = Color3.fromRGB(218, 36, 36)
local YELLOW = Color3.fromRGB(255, 205, 0)
local BLUE = Color3.fromRGB(20, 100, 220)
local GREEN = Color3.fromRGB(40, 165, 70)
local WHITE = Color3.fromRGB(245, 245, 245)
local ORANGE = Color3.fromRGB(255, 130, 20)
local LIME = Color3.fromRGB(150, 210, 40)
local PURPLE = Color3.fromRGB(140, 70, 200)
local BLACK = Color3.fromRGB(30, 30, 34)
local PALETTE = { RED, YELLOW, BLUE, GREEN, WHITE, ORANGE, LIME, PURPLE }

local PLASTIC = Enum.Material.Plastic
local STUD = 4 -- size of one oversized stud cell

-- Brick with big 3D studs on top. Axis-aligned, base at y.
local function brick(b, x0, y, z0, x1, z1, h, color, bigStuds)
	local p = b:Box(x0, y, z0, x1, y + h, z1, color, PLASTIC, { Studs = true })
	if bigStuds ~= false then
		local nx = math.max(1, math.floor(math.abs(x1 - x0) / STUD + 0.5))
		local nz = math.max(1, math.floor(math.abs(z1 - z0) / STUD + 0.5))
		if nx * nz <= 24 then
			local sx = (x1 - x0) / nx
			local sz = (z1 - z0) / nz
			for i = 0, nx - 1 do
				for k = 0, nz - 1 do
					b:Column(Vector3.new(x0 + sx * (i + 0.5), y + h, z0 + sz * (k + 0.5)), 1, 2.6, color, PLASTIC, { CastShadow = false })
				end
			end
		end
	end
	return p
end

-- 2x4 cover brick
local function coverBrick(b, x, z, rotated, color, y)
	if rotated then
		return brick(b, x - 4, y or 0, z - 8, x + 4, z + 8, 5, color)
	end
	return brick(b, x - 8, y or 0, z - 4, x + 8, z + 4, 5, color)
end

local function blockTree(b, x, z, rng)
	local t = b:Sub("BlockTree")
	brick(t, x - 1.5, 0, z - 1.5, x + 1.5, z + 1.5, 7, Color3.fromRGB(120, 70, 30), false)
	local g = rng:NextNumber() < 0.5 and GREEN or LIME
	brick(t, x - 6, 7, z - 6, x + 6, z + 6, 3, g, false)
	brick(t, x - 4, 10, z - 4, x + 4, z + 4, 3, g, false)
	brick(t, x - 2, 13, z - 2, x + 2, z + 2, 3, g, true)
end

local function lollipopTree(b, x, z, rng)
	b:Column(Vector3.new(x, 0, z), 9, 1.2, Color3.fromRGB(120, 70, 30), PLASTIC)
	b:Ball(8, Vector3.new(x, 12, z), PALETTE[rng:NextInteger(1, #PALETTE)], Enum.Material.SmoothPlastic, { CanCollide = false })
end

local function toyCar(b, x, z, rotY, color)
	local t = b:Sub("ToyCar")
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(rotY), 0)
	t:Part(Vector3.new(7, 2.4, 13), cf * CFrame.new(0, 2.6, 0), color, PLASTIC, { Studs = true })
	t:Part(Vector3.new(6, 3, 6), cf * CFrame.new(0, 5.3, 1), WHITE, PLASTIC, { Studs = true })
	t:Part(Vector3.new(5.6, 2, 0.4), cf * CFrame.new(0, 5.4, -2.1), Color3.fromRGB(120, 200, 255), Enum.Material.Glass, { Transparency = 0.3 })
	for _, wx in ipairs({ -3.8, 3.8 }) do
		for _, wz in ipairs({ -4.2, 4.2 }) do
			t:Cyl(1.6, 3.6, cf * CFrame.new(wx, 1.8, wz), BLACK, PLASTIC)
			t:Cyl(1.7, 1.6, cf * CFrame.new(wx, 1.8, wz), Color3.fromRGB(200, 200, 205), PLASTIC)
		end
	end
	t:Part(Vector3.new(1.4, 1, 0.3), cf * CFrame.new(-2.2, 3, -6.6), YELLOW, Enum.Material.Neon)
	t:Part(Vector3.new(1.4, 1, 0.3), cf * CFrame.new(2.2, 3, -6.6), YELLOW, Enum.Material.Neon)
end

local function toyHouse(b, x0, z0, x1, z1, wallColor, roofColor, doorSide)
	local sub, roofY = b:Building({
		name = "ToyHouse", x0 = x0, z0 = z0, x1 = x1, z1 = z1, y = 0.4,
		floors = 2, floorH = 10, wall = 2,
		color = wallColor, mat = PLASTIC,
		floorColor = Color3.fromRGB(200, 200, 200), floorMat = PLASTIC,
		trimColor = WHITE,
		doors = { { side = doorSide, at = 0.5, w = 6, h = 8 }, { side = doorSide == "N" and "S" or "N", at = 0.3, w = 5, h = 8 } },
		windows = { spacing = 8, w = 4, h = 4, b = 3, groundFloor = true },
		roof = true, parapet = 2.5,
	})
	-- chunky slope-brick roof edge (wedges) on the long sides
	local w = x1 - x0
	sub:Wedge(Vector3.new(w + 1, 3, 3), CFrame.new((x0 + x1) / 2, roofY + 1.5, z0 - 1), roofColor, PLASTIC)
	sub:Wedge(Vector3.new(w + 1, 3, 3), CFrame.new((x0 + x1) / 2, roofY + 1.5, z1 + 1) * CFrame.Angles(0, math.pi, 0), roofColor, PLASTIC)
	-- window frames in contrasting colour
	for _, p in ipairs(sub.Folder:GetDescendants()) do
		if p:IsA("BasePart") then
			p.TopSurface = Enum.SurfaceType.Studs
		end
	end
	return sub
end

local function brickTower(b, x, z, size, height, color)
	local sub = b:Sub("BrickTower")
	local layers = math.floor(height / 5)
	for i = 0, layers - 1 do
		local c = (i % 2 == 0) and color or color:Lerp(WHITE, 0.25)
		brick(sub, x - size / 2, i * 5, z - size / 2, x + size / 2, z + size / 2, 5, c, i == layers - 1)
	end
	-- ladder on one face
	sub:Ladder(Vector3.new(x, 0, z + size / 2 + 1), layers * 5, YELLOW)
	return layers * 5
end

local function plate(b, a: Vector3, c: Vector3, width, color)
	-- flat plate bridge between two tower tops
	return b:Ramp(a + Vector3.new(0, 1.6, 0), c + Vector3.new(0, 1.6, 0), width, color, PLASTIC, { Studs = true }, 1.2)
end

local function castle(b)
	local sub = b:Sub("Castle")
	local gray = Color3.fromRGB(160, 165, 172)
	local dark = Color3.fromRGB(110, 114, 122)
	-- raised courtyard platform (height 6); a tight N-S tunnel runs underneath at x in [-6, 6]
	local h = 6
	sub:Box(-26, 0, -20, -8, h, 20, gray, PLASTIC, { Studs = true })
	sub:Box(8, 0, -20, 26, h, 20, gray, PLASTIC, { Studs = true })
	sub:Box(-8, h - 1.2, -20, 8, h, 20, dark, PLASTIC, { Studs = true })
	sub:Box(-8, 0, -20, -6, h - 1.2, 20, dark, PLASTIC)
	sub:Box(6, 0, -20, 8, h - 1.2, 20, dark, PLASTIC)
	for _, z in ipairs({ -10, 10 }) do
		b:Light(Vector3.new(0, h - 2, z), Color3.fromRGB(255, 220, 120), 14, 1)
	end
	-- stairs up to the courtyard from both teams' sides
	for _, s in ipairs({ -1, 1 }) do
		sub:Stairs(Vector3.new(-17, 0.2, 30 * s), Vector3.new(-17, h + 0.1, 20 * s), 6, RED, PLASTIC)
		sub:Stairs(Vector3.new(17, 0.2, 30 * s), Vector3.new(17, h + 0.1, 20 * s), 6, BLUE, PLASTIC)
	end
	-- crenellated walls on the courtyard
	for _, s in ipairs({ -1, 1 }) do
		for _, x in ipairs({ -24, -6, 6, 24 }) do
			do
				brick(sub, x - 2, h, 19.5 * s - 0.5, x + 2, 19.5 * s + 0.5, 4, gray, false)
			end
		end
	end
	-- four round corner towers
	for _, p in ipairs({ { -26, -20 }, { 26, -20 }, { -26, 20 }, { 26, 20 } }) do
		for i = 0, 4 do
			sub:Column(Vector3.new(p[1], i * 5, p[2]), 5, 10, (i % 2 == 0) and gray or dark, PLASTIC)
		end
		sub:Column(Vector3.new(p[1], 25, p[2]), 1, 11, YELLOW, PLASTIC)
		sub:Wedge(Vector3.new(2, 4, 4), CFrame.new(p[1], 28, p[2]), RED, PLASTIC)
	end
	-- courtyard cover
	coverBrick(sub, 0, 0, false, YELLOW, h)
	coverBrick(sub, -14, 10, true, BLUE, h)
	coverBrick(sub, 14, -10, true, RED, h)
	-- flag
	sub:Column(Vector3.new(0, h + 5, 0), 12, 0.8, WHITE, PLASTIC)
	sub:Box(0.4, h + 13, -0.2, 6, h + 17, 0.2, ORANGE, PLASTIC)
end

function BrickCity.Build(b)
	local B = MapKit.BOUNDS
	local rng = Random.new(2024)

	-- baseplates
	b:Box(B.x0 - 40, -2, B.z0 - 40, B.x1 + 40, 0, B.z1 + 40, GREEN, PLASTIC, { Studs = true })
	-- grey road plates
	b:Box(-12, 0, B.z0, 12, 0.4, B.z1, Color3.fromRGB(110, 114, 120), PLASTIC, { Studs = true })
	b:Box(B.x0, 0, -52, B.x1, 0.4, -40, Color3.fromRGB(110, 114, 120), PLASTIC, { Studs = true })
	b:Box(B.x0, 0, 40, B.x1, 0.4, 52, Color3.fromRGB(110, 114, 120), PLASTIC, { Studs = true })
	for z = -130, 130, 12 do
		if math.abs(z) > 24 then
			b:Box(-0.6, 0.4, z - 3, 0.6, 0.5, z + 3, YELLOW, PLASTIC)
		end
	end

	castle(b)

	for _, s in ipairs({ -1, 1 }) do
		local function X(x)
			return x * s
		end
		local function Z(z)
			return z * s
		end
		local function rect(ax, az, bx, bz)
			return math.min(X(ax), X(bx)), math.min(Z(az), Z(bz)), math.max(X(ax), X(bx)), math.max(Z(az), Z(bz))
		end

		-- TOWER PARK (west for s=1, east for s=-1)
		local towers = {
			{ -96, -84, 10, 20, RED },
			{ -76, -70, 8, 15, YELLOW },
			{ -100, -58, 8, 10, BLUE },
			{ -86, -26, 10, 25, GREEN },
			{ -64, -24, 8, 10, ORANGE },
			{ -102, -6, 8, 15, PURPLE },
		}
		local tops = {}
		for i, t in ipairs(towers) do
			local top = brickTower(b, X(t[1]), Z(t[2]), t[3], t[4], t[5])
			tops[i] = Vector3.new(X(t[1]), top, Z(t[2]))
		end
		plate(b, tops[1] + Vector3.new(0, 0, 0), tops[2], 4, WHITE)
		plate(b, tops[2], tops[4], 4, WHITE)
		plate(b, tops[3], tops[6], 4, LIME)
		plate(b, tops[4], tops[5], 4, WHITE)
		for _, c in ipairs({ { -84, -100, false }, { -110, -74, true }, { -60, -88, true }, { -72, -12, false }, { -104, -30, true }, { -54, -62, false } }) do
			coverBrick(b, X(c[1]), Z(c[2]), c[3], PALETTE[rng:NextInteger(1, #PALETTE)])
		end

		-- TOY STREET (east for s=1, west for s=-1)
		local hx0, hz0, hx1, hz1 = rect(28, -100, 54, -76)
		toyHouse(b, hx0, hz0, hx1, hz1, s > 0 and BLUE or RED, YELLOW, s > 0 and "S" or "N")
		hx0, hz0, hx1, hz1 = rect(70, -100, 104, -70)
		toyHouse(b, hx0, hz0, hx1, hz1, YELLOW, RED, s > 0 and "S" or "N")
		hx0, hz0, hx1, hz1 = rect(30, -30, 60, -8)
		toyHouse(b, hx0, hz0, hx1, hz1, WHITE, BLUE, s > 0 and "N" or "S")
		hx0, hz0, hx1, hz1 = rect(76, -32, 106, -6)
		toyHouse(b, hx0, hz0, hx1, hz1, LIME, PURPLE, "W")
		toyCar(b, X(40), Z(-58), 90, RED)
		toyCar(b, X(84), Z(-46), 92, YELLOW)
		toyCar(b, X(20), Z(-20), 0, BLUE)
		-- toy train on a track along the cross street
		local tz = Z(-46)
		b:Box(X(-110), 0.4, tz - 2.5, X(-40), 0.7, tz + 2.5, Color3.fromRGB(80, 80, 86), PLASTIC)
		for i, color in ipairs({ RED, BLUE, YELLOW }) do
			local cx = X(-100 + (i - 1) * 16)
			b:Box(cx - 6.5, 0.7, tz - 3.5, cx + 6.5, 6, tz + 3.5, color, PLASTIC, { Studs = true })
			if i == 1 then
				b:Box(cx - 3, 6, tz - 3, cx + 3, 9.5, tz + 3, BLACK, PLASTIC, { Studs = true })
				b:Column(Vector3.new(cx + 4 * s, 6, tz), 3, 2, BLACK, PLASTIC)
			end
			for _, wx in ipairs({ -4, 4 }) do
				b:Cyl(1, 2.6, CFrame.new(cx + wx, 1.5, tz - 3.8), BLACK, PLASTIC)
				b:Cyl(1, 2.6, CFrame.new(cx + wx, 1.5, tz + 3.8), BLACK, PLASTIC)
			end
		end

		-- trees and scattered cover near the bases
		for _, p in ipairs({ { -40, -100 }, { 40, -96 }, { -60, -60 }, { 30, -66 }, { 62, -110 }, { -30, -70 } }) do
			if rng:NextNumber() < 0.5 then
				blockTree(b, X(p[1]), Z(p[2]), rng)
			else
				lollipopTree(b, X(p[1]), Z(p[2]), rng)
			end
		end
		coverBrick(b, X(-24), Z(-84), true, ORANGE)
		coverBrick(b, X(24), Z(-90), true, PURPLE)
		coverBrick(b, X(0), Z(-62), false, WHITE)
		coverBrick(b, X(-40), Z(-34), false, RED)
		coverBrick(b, X(38), Z(-38), true, GREEN)
		-- stacked brick staircase to a lookout plate over the avenue
		for i = 0, 3 do
			brick(b, X(-20) - 4, i * 3, Z(-30 - i * 6) - 3, X(-20) + 4, Z(-30 - i * 6) + 3, 3, PALETTE[(i % #PALETTE) + 1], i == 3)
		end
	end

	-- spawns
	local redSpawns, redZone = MapKit.SpawnBase(b, "Red", { floorColor = WHITE, floorMat = PLASTIC, wallColor = Color3.fromRGB(240, 70, 70), wallMat = PLASTIC })
	local blueSpawns, blueZone = MapKit.SpawnBase(b, "Blue", { floorColor = WHITE, floorMat = PLASTIC, wallColor = Color3.fromRGB(70, 130, 240), wallMat = PLASTIC })

	-- giant toy backdrop: letter blocks and crayons outside the play area
	local deco = b:Sub("Backdrop")
	local letters = { "A", "B", "C", "D", "E", "F", "G", "H" }
	for i = 1, 16 do
		local side = i % 2 == 0 and 1 or -1
		local x = side * rng:NextNumber(135, 165)
		local z = rng:NextNumber(-150, 150)
		local size = rng:NextNumber(18, 30)
		local cube = deco:Part(Vector3.new(size, size, size), CFrame.new(x, size / 2, z) * CFrame.Angles(0, rng:NextNumber() * 6, 0), PALETTE[rng:NextInteger(1, #PALETTE)], Enum.Material.SmoothPlastic, { CanQuery = false })
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }) do
			require(script.Parent.Parent.Builder).Label(cube, face, letters[rng:NextInteger(1, #letters)], WHITE, { PixelsPerStud = 2, Stroke = true })
		end
	end
	for i = 1, 8 do
		local side = i % 2 == 0 and 1 or -1
		local z = side * rng:NextNumber(150, 170)
		local x = rng:NextNumber(-110, 110)
		local c = PALETTE[rng:NextInteger(1, #PALETTE)]
		deco:Cyl(60, 8, CFrame.new(x, 4, z) * CFrame.Angles(0, rng:NextNumber() * 3, 0), c, Enum.Material.SmoothPlastic, { CanQuery = false })
	end

	b:Boundary(B.x0, B.z0, B.x1, B.z1, -2, 120)
	return {
		Spawns = { Red = redSpawns, Blue = blueSpawns },
		SpawnZones = { Red = redZone, Blue = blueZone },
		Podium = MapKit.PODIUM,
		KillY = -30,
	}
end

function BrickCity.BuildPreview(b)
	b:Box(-3, 0, -3, 3, 0.3, 3, GREEN, PLASTIC, { Studs = true })
	local cols = { RED, YELLOW, BLUE, WHITE, ORANGE, PURPLE }
	local i = 0
	for x = -2.4, 2.4, 1.6 do
		for z = -2.4, 2.4, 1.6 do
			i += 1
			if (i % 3) ~= 0 then
				local h = 0.4 + (i % 4) * 0.5
				b:Box(x - 0.6, 0.3, z - 0.6, x + 0.6, 0.3 + h, z + 0.6, cols[(i % #cols) + 1], PLASTIC, { Studs = true })
			end
		end
	end
	b:Box(-1, 0.3, -1, 1, 1.3, 1, Color3.fromRGB(160, 165, 172), PLASTIC, { Studs = true })
end

return BrickCity
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Egypt</string><ProtectedString name="Source"><![CDATA[--[[
	MAP 4 - ANCIENT EGYPT "Sands of Kemet"
	Point-symmetric layout:
	  * Centre: the Great Temple - pylon gateways, a dim hypostyle hall full of columns,
	    side doors and an accessible roof (high ground), obelisks and seated colossi outside
	  * Each team's left : a bustling market street with awnings, pottery and mud-brick houses
	    with roof terraces reached by outside stairs
	  * Each team's right: temple ruins with broken columns, a fallen obelisk, a sphinx and a
	    sunken courtyard (lower level) entered by ramps
	Decorative bands of carved relief motifs (ankh, eye, bird, water) run along temple walls.
]]

local Builder = require(script.Parent.Parent.Builder)
local MapKit = require(script.Parent.Parent.MapKit)

local Egypt = {}

local SAND = Color3.fromRGB(222, 192, 138)
local STONE = Color3.fromRGB(214, 180, 122)
local STONE_DARK = Color3.fromRGB(176, 142, 92)
local MUD = Color3.fromRGB(176, 136, 96)
local GOLD = Color3.fromRGB(240, 190, 70)
local LAPIS = Color3.fromRGB(30, 70, 150)
local RUST = Color3.fromRGB(170, 60, 40)
local SANDSTONE = Enum.Material.Sandstone

-- carved relief motif, drawn on a wall plane. `cf` = wall-surface frame (look = out of wall)
local function motif(b, cf: CFrame, kind: number, color: Color3)
	local d = 0.25
	local function bar(w, h, x, y, rot)
		b:Part(Vector3.new(w, h, d), cf * CFrame.new(x, y, -d / 2) * CFrame.Angles(0, 0, math.rad(rot or 0)), color, SANDSTONE, { CastShadow = false, CanCollide = false })
	end
	if kind == 1 then -- ankh
		bar(0.35, 2.2, 0, -0.4)
		bar(1.6, 0.35, 0, 0.5)
		bar(0.3, 1.0, -0.38, 1.25, -20)
		bar(0.3, 1.0, 0.38, 1.25, 20)
		bar(0.6, 0.3, 0, 1.7)
	elseif kind == 2 then -- eye
		bar(2.2, 0.3, 0, 0.6, -6)
		bar(1.6, 0.3, 0, -0.1, 4)
		bar(0.5, 0.5, 0, 0.25)
		bar(0.25, 1.1, 0.5, -0.65, 15)
		bar(1.0, 0.25, -0.9, -0.55, -30)
	elseif kind == 3 then -- bird
		bar(1.6, 0.6, 0, 0, 12)
		bar(0.5, 0.5, 0.95, 0.35)
		bar(0.9, 0.25, -1.1, -0.3, 30)
		bar(0.2, 0.8, 0.1, -0.7)
		bar(0.2, 0.8, -0.3, -0.7)
	else -- water zigzag
		for i = -2, 2 do
			bar(0.7, 0.22, i * 0.55, (i % 2 == 0) and 0.15 or -0.15, (i % 2 == 0) and 35 or -35)
		end
	end
end

-- band of motifs along a wall segment from a to c (local points at band height)
local function glyphBand(b, a: Vector3, c: Vector3, outward: Vector3)
	local dir = (c - a)
	local len = dir.Magnitude
	dir = dir.Unit
	local sub = b:Sub("Relief")
	-- painted stripes above/below the band
	local mid = (a + c) / 2
	local frame = CFrame.lookAt(mid, mid + outward)
	sub:Part(Vector3.new(len, 0.4, 0.15), frame * CFrame.new(0, 2.2, -0.05), LAPIS, Enum.Material.SmoothPlastic, { CanCollide = false })
	sub:Part(Vector3.new(len, 0.4, 0.15), frame * CFrame.new(0, -1.8, -0.05), RUST, Enum.Material.SmoothPlastic, { CanCollide = false })
	local count = math.floor(len / 3.2)
	for i = 0, count - 1 do
		local p = a + dir * (1.6 + i * 3.2)
		motif(sub, CFrame.lookAt(p, p + outward), (i % 4) + 1, STONE_DARK)
	end
end

local function column(b, x, z, h, d, broken)
	local sub = b:Sub("Column")
	sub:Column(Vector3.new(x, 0, z), 1.2, d + 1.2, STONE_DARK, SANDSTONE)
	local height = broken and h * (0.3 + math.random() * 0.4) or h
	sub:Column(Vector3.new(x, 1.2, z), height - 1.2, d, STONE, SANDSTONE)
	-- painted bands
	sub:Column(Vector3.new(x, height * 0.75, z), 0.6, d + 0.1, LAPIS, Enum.Material.SmoothPlastic)
	if not broken then
		-- papyrus capital
		sub:Column(Vector3.new(x, h, z), 1.2, d + 1.6, GOLD:Lerp(STONE, 0.5), SANDSTONE)
		sub:Box(x - d / 2 - 1, h + 1.2, z - d / 2 - 1, x + d / 2 + 1, h + 2, z + d / 2 + 1, STONE_DARK, SANDSTONE)
	else
		sub:Part(Vector3.new(d, d * 0.9, d), CFrame.new(x + d, d * 0.45, z + 1) * CFrame.Angles(0, 0.6, math.pi / 2), STONE, SANDSTONE)
	end
end

local function obelisk(b, x, z, h, fallen, rotY)
	local sub = b:Sub("Obelisk")
	if fallen then
		local cf = CFrame.new(x, 2, z) * CFrame.Angles(0, math.rad(rotY or 0), 0) * CFrame.Angles(0, 0, math.rad(4))
		sub:Part(Vector3.new(h * 0.7, 3.4, 3.4), cf, STONE, SANDSTONE)
		sub:Part(Vector3.new(h * 0.25, 3.0, 3.0), cf * CFrame.new(h * 0.52, -0.2, 1.2) * CFrame.Angles(0, 0.3, 0.2), STONE, SANDSTONE)
		return
	end
	sub:Box(x - 3, 0, z - 3, x + 3, 2, z + 3, STONE_DARK, SANDSTONE)
	local layers = 6
	for i = 0, layers - 1 do
		local w = 2.6 - i * 0.25
		sub:Box(x - w / 2, 2 + i * h / layers, z - w / 2, x + w / 2, 2 + (i + 1) * h / layers, z + w / 2, STONE, SANDSTONE)
	end
	local tip = 2.6 - layers * 0.25
	sub:Wedge(Vector3.new(tip, 2, tip / 2), CFrame.new(x, 2 + h + 1, z - tip / 4), GOLD, Enum.Material.Foil)
	sub:Wedge(Vector3.new(tip, 2, tip / 2), CFrame.new(x, 2 + h + 1, z + tip / 4) * CFrame.Angles(0, math.pi, 0), GOLD, Enum.Material.Foil)
end

-- original seated colossus statue (stylised, blocky)
local function colossus(b, x, z, facing)
	local sub = b:Sub("Colossus")
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(facing), 0)
	sub:Part(Vector3.new(8, 4, 10), cf * CFrame.new(0, 2, 0), STONE_DARK, SANDSTONE)
	sub:Part(Vector3.new(6, 6, 4), cf * CFrame.new(0, 7, 2.5), STONE_DARK, SANDSTONE) -- throne back
	sub:Part(Vector3.new(5, 5, 3), cf * CFrame.new(0, 6.5, 0.5), STONE, SANDSTONE) -- torso
	sub:Part(Vector3.new(5, 2, 4), cf * CFrame.new(0, 5, -2), STONE, SANDSTONE) -- lap
	sub:Part(Vector3.new(1.6, 4, 1.6), cf * CFrame.new(-1.4, 2, -3.8), STONE, SANDSTONE)
	sub:Part(Vector3.new(1.6, 4, 1.6), cf * CFrame.new(1.4, 2, -3.8), STONE, SANDSTONE)
	sub:Part(Vector3.new(2.6, 3, 2.6), cf * CFrame.new(0, 10.4, 0.5), STONE, SANDSTONE) -- head
	sub:Part(Vector3.new(4, 3.6, 2.4), cf * CFrame.new(0, 10.2, 1.1), LAPIS, Enum.Material.SmoothPlastic) -- headdress
	sub:Part(Vector3.new(0.5, 1.4, 0.5), cf * CFrame.new(0, 8.4, -0.9), GOLD, Enum.Material.Foil) -- beard
	sub:Part(Vector3.new(2.8, 0.5, 2.8), cf * CFrame.new(0, 12.1, 0.5), GOLD, Enum.Material.Foil)
end

local function sphinx(b, x, z, facing)
	local sub = b:Sub("Sphinx")
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(facing), 0)
	sub:Part(Vector3.new(8, 2, 24), cf * CFrame.new(0, 1, 0), STONE_DARK, SANDSTONE)
	sub:Part(Vector3.new(7, 5, 14), cf * CFrame.new(0, 4.5, 3), STONE, SANDSTONE) -- body
	sub:Part(Vector3.new(2, 2, 8), cf * CFrame.new(-2.4, 3, -7), STONE, SANDSTONE) -- paws
	sub:Part(Vector3.new(2, 2, 8), cf * CFrame.new(2.4, 3, -7), STONE, SANDSTONE)
	sub:Part(Vector3.new(5, 5, 5), cf * CFrame.new(0, 8, -4), STONE, SANDSTONE) -- chest
	sub:Part(Vector3.new(3.2, 3.4, 3.2), cf * CFrame.new(0, 11.6, -4.6), STONE, SANDSTONE) -- head
	sub:Part(Vector3.new(5.6, 4, 2.4), cf * CFrame.new(0, 11.2, -3.6), LAPIS:Lerp(STONE, 0.3), SANDSTONE) -- headdress
end

local function stall(b, x, z, rotY, cloth)
	local sub = b:Sub("Stall")
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(rotY), 0)
	for _, p in ipairs({ { -3, -2 }, { 3, -2 }, { -3, 2 }, { 3, 2 } }) do
		sub:Part(Vector3.new(0.5, 7, 0.5), cf * CFrame.new(p[1], 3.5, p[2]), Color3.fromRGB(120, 86, 54), Enum.Material.Wood)
	end
	sub:Part(Vector3.new(7.4, 0.3, 5.4), cf * CFrame.new(0, 7.2, 0) * CFrame.Angles(math.rad(8), 0, 0), cloth, Enum.Material.Fabric, { CanCollide = false })
	sub:Part(Vector3.new(6.4, 3, 2), cf * CFrame.new(0, 1.5, -1.4), Color3.fromRGB(140, 100, 64), Enum.Material.WoodPlanks)
	for i = -1, 1 do
		sub:Ball(1.2, (cf * CFrame.new(i * 1.8, 3.6, -1.4)).Position, Color3.fromRGB(180, 100, 60), Enum.Material.Slate, { CanCollide = false })
	end
	sub:Column((cf * CFrame.new(2.6, 0, 2.6)).Position, 2.4, 1.6, Color3.fromRGB(170, 96, 60), Enum.Material.Slate)
end

local function palm(b, x, z, rng)
	local sub = b:Sub("Palm")
	local h = 14 + rng:NextNumber() * 4
	local lean = rng:NextNumber(-0.15, 0.15)
	for i = 0, 5 do
		local y = i * h / 6
		sub:Part(Vector3.new(1.3 - i * 0.08, h / 6 + 0.2, 1.3 - i * 0.08), CFrame.new(x + lean * y, y + h / 12, z) * CFrame.Angles(0, 0, -lean), Color3.fromRGB(130, 100, 64), Enum.Material.Wood)
	end
	local top = Vector3.new(x + lean * h, h, z)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		sub:Part(Vector3.new(1.6, 0.2, 7), CFrame.new(top) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -3) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(70, 130, 50), Enum.Material.Grass, { CanCollide = false, NoBullets = true })
	end
end

local function greatTemple(b)
	local sub = b:Sub("GreatTemple")
	local H = 16
	local x0, x1, z0, z1 = -30, 30, -24, 24
	-- hall floor
	sub:Box(x0, 0, z0, x1, 0.6, z1, STONE_DARK, SANDSTONE)
	-- walls with side doors (E/W) and wide gate openings (N/S)
	sub:Wall(Vector3.new(x0, 0.6, z0 + 1), Vector3.new(x1, 0.6, z0 + 1), H, 2, STONE, SANDSTONE, { { c = 30, w = 10, b = 0, t = 11 } })
	sub:Wall(Vector3.new(x0, 0.6, z1 - 1), Vector3.new(x1, 0.6, z1 - 1), H, 2, STONE, SANDSTONE, { { c = 30, w = 10, b = 0, t = 11 } })
	sub:Wall(Vector3.new(x0 + 1, 0.6, z0 + 2), Vector3.new(x0 + 1, 0.6, z1 - 2), H, 2, STONE, SANDSTONE, { { c = 22, w = 6, b = 0, t = 8 }, { c = 8, w = 3, b = 7, t = 10 }, { c = 36, w = 3, b = 7, t = 10 } })
	sub:Wall(Vector3.new(x1 - 1, 0.6, z0 + 2), Vector3.new(x1 - 1, 0.6, z1 - 2), H, 2, STONE, SANDSTONE, { { c = 22, w = 6, b = 0, t = 8 }, { c = 8, w = 3, b = 7, t = 10 }, { c = 36, w = 3, b = 7, t = 10 } })
	-- roof with skylight slots (thin beams of light into the hall)
	local roofY = H + 0.6
	sub:Slab(x0, z0, x1, z1, roofY + 1.2, 1.2, STONE_DARK, SANDSTONE, { { -2, -14, 2, -6 }, { -2, 6, 2, 14 } })
	sub:Box(x0, roofY + 1.2, z0, x1, roofY + 3.4, z0 + 1, STONE, SANDSTONE)
	sub:Box(x0, roofY + 1.2, z1 - 1, x1, roofY + 3.4, z1, STONE, SANDSTONE)
	-- side parapets have a gap where the outside stairs arrive
	sub:Box(x0, roofY + 1.2, z0, x0 + 1, roofY + 3.4, 1, STONE, SANDSTONE)
	sub:Box(x0, roofY + 1.2, 7, x0 + 1, roofY + 3.4, z1, STONE, SANDSTONE)
	sub:Box(x1 - 1, roofY + 1.2, z0, x1, roofY + 3.4, -7, STONE, SANDSTONE)
	sub:Box(x1 - 1, roofY + 1.2, -1, x1, roofY + 3.4, z1, STONE, SANDSTONE)
	-- hypostyle columns inside
	for _, x in ipairs({ -20, -10, 10, 20 }) do
		for _, z in ipairs({ -12, 0, 12 }) do
			column(sub, x, z, H - 2, 3.4, false)
		end
	end
	-- central altar (cover)
	sub:Box(-4, 0.6, -3, 4, 4, 3, STONE_DARK, SANDSTONE)
	sub:Box(-4.4, 4, -3.4, 4.4, 4.6, 3.4, GOLD, Enum.Material.Foil)
	-- torches inside
	for _, p in ipairs({ { -27, -18 }, { 27, 18 }, { -27, 18 }, { 27, -18 } }) do
		local t = sub:Part(Vector3.new(0.6, 0.6, 0.6), Vector3.new(p[1], 7, p[2]), Color3.fromRGB(255, 160, 60), Enum.Material.Neon, { CanCollide = false })
		local f = Instance.new("Fire")
		f.Size = 2
		f.Heat = 4
		f.Parent = t
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(255, 160, 80)
		l.Range = 20
		l.Brightness = 1.6
		l.Parent = t
	end
	-- pylon gateways at both ends (tall battered towers flanking the gate) + roof access
	for _, s in ipairs({ -1, 1 }) do
		local zf = s * 24
		for _, sx in ipairs({ -1, 1 }) do
			local px0, px1 = sx * 5, sx * 22
			local pz0, pz1 = zf - 2 * s, zf + 4 * s
			sub:Box(px0, 0, pz0, px1, H + 8, pz1, STONE, SANDSTONE)
			sub:Box(px0, H + 8, pz0, px1, H + 9.5, pz1, STONE_DARK, SANDSTONE)
			glyphBand(sub, Vector3.new(px0, H - 2, pz1 + 0.05 * s), Vector3.new(px1, H - 2, pz1 + 0.05 * s), Vector3.new(0, 0, s))
		end
		-- lintel over the gate
		sub:Box(-5, 11, zf - 2 * s, 5, 14, zf + 4 * s, STONE_DARK, SANDSTONE)
		sub:Box(-5, 13, zf + 4 * s, 5, 13.6, zf + 4.3 * s, GOLD, Enum.Material.Foil)
		-- outside stairs up the long wall to the roof (high above the side door)
		sub:Stairs(Vector3.new(33 * s, 0.2, 20 * s), Vector3.new(33 * s, roofY + 1.3, -4 * s), 5, STONE_DARK, SANDSTONE)
		-- obelisks and colossi in front of each gate
		obelisk(b, -12, zf + 14 * s, 26, false)
		obelisk(b, 12, zf + 14 * s, 26, false)
		colossus(b, -9, zf + 7 * s, s > 0 and 180 or 0)
		colossus(b, 9, zf + 7 * s, s > 0 and 180 or 0)
	end
	-- relief bands along the long walls (outside)
	glyphBand(sub, Vector3.new(-30, 9, -24.05), Vector3.new(30, 9, -24.05), Vector3.new(0, 0, -1))
	glyphBand(sub, Vector3.new(-30.05, 9, -20), Vector3.new(-30.05, 9, 20), Vector3.new(-1, 0, 0))
	glyphBand(sub, Vector3.new(30.05, 9, -20), Vector3.new(30.05, 9, 20), Vector3.new(1, 0, 0))
end

local function mudHouse(b, x0, z0, x1, z1, doorSide, stairsAt)
	local sub, roofY = b:Building({
		name = "MudHouse", x0 = x0, z0 = z0, x1 = x1, z1 = z1, y = 0,
		floors = 1, floorH = 10, wall = 1.4,
		color = MUD, mat = Enum.Material.Sandstone,
		floorColor = Color3.fromRGB(160, 124, 86), floorMat = Enum.Material.Ground,
		doors = { { side = doorSide, at = 0.5, w = 5, h = 7.5 } },
		windows = { spacing = 7, w = 2.5, h = 2, b = 5, groundFloor = true },
		roof = true, parapet = 1, stairs = false,
	})
	-- outside stairs to the roof terrace
	if stairsAt then
		sub:Stairs(stairsAt[1], Vector3.new(stairsAt[2].X, roofY + 0.1, stairsAt[2].Z), 3.5, STONE_DARK, SANDSTONE)
	end
	-- awning pole decoration
	sub:Box(x0 + 1, roofY, z0 + 1, x0 + 1.4, roofY + 5, z0 + 1.4, Color3.fromRGB(120, 86, 54), Enum.Material.Wood)
	return sub
end

function Egypt.Build(b)
	local B = MapKit.BOUNDS
	local rng = Random.new(3301)

	-- ground with two sunken courtyards cut out (point-symmetric)
	local sunken = { { 62, -72, 98, -40 }, { -98, 40, -62, 72 } }
	b:Slab(B.x0 - 50, B.z0 - 50, B.x1 + 50, B.z1 + 50, 0, 3, SAND, Enum.Material.Sand, sunken)

	greatTemple(b)

	for _, s in ipairs({ -1, 1 }) do
		local function X(x)
			return x * s
		end
		local function Z(z)
			return z * s
		end
		local function P(x, y, z)
			return Vector3.new(X(x), y, Z(z))
		end
		local function rect(ax, az, bx, bz)
			return math.min(X(ax), X(bx)), math.min(Z(az), Z(bz)), math.max(X(ax), X(bx)), math.max(Z(az), Z(bz))
		end

		-- MARKET STREET (left of the team for s = 1, i.e. west of Red)
		local houses = {
			{ -110, -100, -86, -80, s > 0 and "E" or "W", { P(-108, 0.2, -101.8), P(-90, 0, -101.8) } },
			{ -110, -66, -88, -46, s > 0 and "E" or "W", nil },
			{ -110, -34, -90, -12, s > 0 and "E" or "W", { P(-108, 0.2, -35.8), P(-92, 0, -35.8) } },
			{ -64, -98, -44, -80, s > 0 and "W" or "E", nil },
			{ -62, -62, -42, -40, s > 0 and "W" or "E", { P(-60, 0.2, -63.8), P(-44, 0, -63.8) } },
		}
		for _, h in ipairs(houses) do
			local x0, z0, x1, z1 = rect(h[1], h[2], h[3], h[4])
			mudHouse(b, x0, z0, x1, z1, h[5], h[6])
		end
		local cloths = { Color3.fromRGB(200, 60, 50), Color3.fromRGB(40, 90, 170), Color3.fromRGB(230, 200, 90), Color3.fromRGB(60, 140, 90) }
		for i, z in ipairs({ -92, -74, -56, -38, -20 }) do
			stall(b, X(-74), Z(z), (s > 0 and 90 or -90) + rng:NextNumber(-8, 8), cloths[(i % #cloths) + 1])
		end
		MapKit.CrateStack(b, P(-80, 0, -66), Color3.fromRGB(170, 130, 80))
		MapKit.Crate(b, P(-68, 0, -30), 4, Color3.fromRGB(170, 130, 80), 20)
		-- water jars
		for i = 0, 3 do
			b:Column(P(-84 + i * 2.4, 0, -6), 3, 1.8, Color3.fromRGB(180, 100, 60), Enum.Material.Slate)
		end

		-- RUINS (right of the team for s = 1)
		local rx0, rz0, rx1, rz1 = rect(62, -72, 98, -40)
		-- sunken courtyard: floor at -6, retaining walls, ramps down from two sides
		b:Box(rx0, -9, rz0, rx1, -6, rz1, STONE_DARK, SANDSTONE)
		b:Ramp(P(80, 0.1, -72), P(80, -6, -61), 8, STONE_DARK, SANDSTONE)
		b:Ramp(P(80, 0.1, -40), P(80, -6, -51), 8, STONE_DARK, SANDSTONE)
		-- retaining walls (with gaps where the ramps arrive)
		local wallY = -6
		b:Wall(P(62, wallY, -72), P(76, wallY, -72), 6, 1, STONE, SANDSTONE)
		b:Wall(P(84, wallY, -72), P(98, wallY, -72), 6, 1, STONE, SANDSTONE)
		b:Wall(P(62, wallY, -40), P(76, wallY, -40), 6, 1, STONE, SANDSTONE)
		b:Wall(P(84, wallY, -40), P(98, wallY, -40), 6, 1, STONE, SANDSTONE)
		b:Wall(P(62, wallY, -72), P(62, wallY, -40), 6, 1, STONE, SANDSTONE)
		b:Wall(P(98, wallY, -72), P(98, wallY, -40), 6, 1, STONE, SANDSTONE)
		-- pool and columns in the courtyard
		local poolFrame = b:Box(X(74) - 0.01, -6, Z(-60), X(86), -5.6, Z(-52), Color3.fromRGB(60, 150, 200), Enum.Material.Glass, { Transparency = 0.3, CanCollide = false, NoBullets = true })
		poolFrame.Name = "Pool"
		for _, p in ipairs({ { 66, -68 }, { 94, -68 }, { 66, -44 }, { 94, -44 } }) do
			b:Column(P(p[1], -6, p[2]), 5, 2.4, STONE, SANDSTONE)
		end
		for _, p in ipairs({ { 70, -56 }, { 90, -56 } }) do
			b:Box(X(p[1]) - 2, -6, Z(p[2]) - 2, X(p[1]) + 2, -2.5, Z(p[2]) + 2, STONE_DARK, SANDSTONE)
		end
		-- broken colonnade, fallen obelisk and sphinx above ground
		for i, z in ipairs({ -100, -90, -80 }) do
			column(b, X(60), Z(z), 14, 3, i ~= 2)
			column(b, X(100), Z(z), 14, 3, i == 2)
		end
		obelisk(b, X(78), Z(-14), 30, true, s > 0 and 20 or 200)
		sphinx(b, X(46), Z(-100), s > 0 and 0 or 180)
		-- ruin wall fragments for cover
		b:Box(X(44) - 1, 0, Z(-66) - 6, X(44) + 1, 6, Z(-66) + 6, STONE, SANDSTONE)
		b:Box(X(108) - 6, 0, Z(-24) - 1, X(108) + 6, 4.5, Z(-24) + 1, STONE, SANDSTONE)
		b:Box(X(56) - 5, 0, Z(-30) - 1, X(56) + 5, 7, Z(-30) + 1, STONE, SANDSTONE)
		b:Part(Vector3.new(6, 3, 3), CFrame.new(X(64), 1.4, Z(-20)) * CFrame.Angles(0.1, 0.5, 0.2), STONE_DARK, SANDSTONE)
		-- palms by the courtyard and the market
		for _, p in ipairs({ { 104, -78 }, { 56, -86 }, { -100, -40 }, { -60, -74 }, { 40, -44 } }) do
			palm(b, X(p[1]), Z(p[2]), rng)
		end
		-- low walls near the centre lanes
		b:Box(X(-30) - 6, 0, Z(-46) - 1, X(-30) + 6, 4, Z(-46) + 1, STONE_DARK, SANDSTONE)
		b:Box(X(30) - 1, 0, Z(-48) - 5, X(30) + 1, 4, Z(-48) + 5, STONE_DARK, SANDSTONE)
	end

	-- spawns
	local redSpawns, redZone = MapKit.SpawnBase(b, "Red", { floorColor = STONE_DARK, floorMat = SANDSTONE, wallColor = STONE, wallMat = SANDSTONE })
	local blueSpawns, blueZone = MapKit.SpawnBase(b, "Blue", { floorColor = STONE_DARK, floorMat = SANDSTONE, wallColor = STONE, wallMat = SANDSTONE })

	-- backdrop: pyramids and dunes outside the play area
	local bd = b:Sub("Backdrop")
	local function pyramid(x, z, size)
		local layers = 24
		for i = 0, layers - 1 do
			local w = size * (1 - i / layers)
			bd:Box(x - w / 2, i * size / layers * 0.6, z - w / 2, x + w / 2, (i + 1) * size / layers * 0.6, z + w / 2, SAND:Lerp(STONE, 0.5), SANDSTONE, { CanQuery = false, CastShadow = i < 4 })
		end
		bd:Box(x - size / layers, size * 0.6, z - size / layers, x + size / layers, size * 0.6 + 2, z + size / layers, GOLD, Enum.Material.Foil, { CanQuery = false })
	end
	pyramid(-190, -60, 120)
	pyramid(200, 80, 150)
	pyramid(60, 230, 90)
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2
		local r = 210 + rng:NextNumber(0, 40)
		bd:Part(Vector3.new(80, 14, 40), CFrame.new(math.cos(a) * r, -2, math.sin(a) * r) * CFrame.Angles(0, -a, math.rad(rng:NextNumber(-6, 6))), SAND, Enum.Material.Sand, { CanQuery = false })
	end

	b:Boundary(B.x0, B.z0, B.x1, B.z1, -10, 120)
	return {
		Spawns = { Red = redSpawns, Blue = blueSpawns },
		SpawnZones = { Red = redZone, Blue = blueZone },
		Podium = MapKit.PODIUM,
		KillY = -40,
	}
end

function Egypt.BuildPreview(b)
	b:Box(-3, 0, -3, 3, 0.3, 3, SAND, Enum.Material.Sand)
	for i = 0, 5 do
		local w = 3 - i * 0.5
		b:Box(-w / 2 - 1, 0.3 + i * 0.35, -w / 2 - 1, w / 2 - 1, 0.65 + i * 0.35, w / 2 - 1, STONE, SANDSTONE)
	end
	b:Box(1, 0.3, 0.5, 2.6, 1.3, 2.6, STONE_DARK, SANDSTONE)
	b:Box(1.6, 0.3, -2.4, 1.9, 2.6, -2.1, STONE, SANDSTONE)
	b:Box(1.65, 2.6, -2.35, 1.85, 2.8, -2.15, GOLD, Enum.Material.Foil)
	local _ = Builder
end

return Egypt
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Forest</string><ProtectedString name="Source"><![CDATA[--[[
	MAP 1 - FOREST "Whispering Pines"
	Lanes (Red z=-125 -> Blue z=+125):
	  West  : a high wooded ridge (long sight lines broken by trees and boulders), rope bridge
	  Mid   : clearings, two abandoned cabins (two floors + attic), the main covered bridge
	  East  : a low ravine with a stream - close-quarters flank route, plank bridge above
	A river crosses the whole map at z = 0; it can be waded or crossed on three bridges.
	Watchtowers give elevated spots on both halves.
]]

local MapKit = require(script.Parent.Parent.MapKit)

local Forest = {}

local GRASS = Enum.Material.Grass
local WOOD = Color3.fromRGB(110, 78, 48)
local WOOD_DARK = Color3.fromRGB(74, 52, 34)
local ROCK = Color3.fromRGB(112, 114, 108)

local function gy(b, x, z)
	return b:GroundY(x, z, nil, true)
end

local function pine(b, x, z, rng, scale)
	local y = gy(b, x, z)
	local s = scale or (0.8 + rng:NextNumber() * 0.6)
	local h = 14 * s
	local t = b:Sub("Pine")
	t:Column(Vector3.new(x, y - 1, z), h * 0.55 + 1, 1.6 * s, Color3.fromRGB(92, 62, 40), Enum.Material.Wood)
	local tiers = 4
	for i = 0, tiers - 1 do
		local d = (9 - i * 2) * s
		local ty = y + h * 0.3 + i * 2.6 * s
		local green = Color3.fromRGB(34 + i * 6, 84 + i * 10 + rng:NextInteger(-8, 8), 46 + i * 4)
		t:Cyl(2.6 * s, d, CFrame.new(x, ty, z) * CFrame.Angles(0, rng:NextNumber() * 6, math.pi / 2), green, Enum.Material.Grass, { CanCollide = false, CastShadow = true })
	end
end

local function broadleaf(b, x, z, rng)
	local y = gy(b, x, z)
	local s = 0.9 + rng:NextNumber() * 0.5
	local t = b:Sub("Oak")
	t:Column(Vector3.new(x, y - 1, z), 9 * s, 2 * s, Color3.fromRGB(84, 60, 42), Enum.Material.Wood)
	for i = 1, 4 do
		local off = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(0, 3), rng:NextNumber(-3, 3)) * s
		t:Ball((7 + rng:NextNumber() * 3) * s, Vector3.new(x, y + 9 * s, z) + off, Color3.fromRGB(60, 120 + rng:NextInteger(-15, 15), 50), Enum.Material.Grass, { CanCollide = false })
	end
end

local function bush(b, x, z, rng)
	local y = gy(b, x, z)
	for _ = 1, 3 do
		b:Ball(3 + rng:NextNumber() * 2.5, Vector3.new(x + rng:NextNumber(-1.5, 1.5), y + 1, z + rng:NextNumber(-1.5, 1.5)),
			Color3.fromRGB(50, 110 + rng:NextInteger(-12, 12), 46), Enum.Material.Grass, { CanCollide = false, NoBullets = true, CastShadow = false })
	end
end

local function rock(b, x, z, rng, size)
	local y = gy(b, x, z)
	local s = size or (3 + rng:NextNumber() * 4)
	b:Part(Vector3.new(s * 1.3, s, s), CFrame.new(x, y + s * 0.3, z) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber() * 6, rng:NextNumber(-0.3, 0.3)), ROCK:Lerp(Color3.fromRGB(90, 96, 86), rng:NextNumber()), Enum.Material.Slate)
end

local function log(b, x, z, rot, len)
	local y = gy(b, x, z)
	b:Cyl(len or 12, 2.4, CFrame.new(x, y + 1, z) * CFrame.Angles(0, math.rad(rot), 0), Color3.fromRGB(96, 70, 46), Enum.Material.Wood)
end

local function bridge(b, x, width, length, height, covered, ramps)
	local sub = b:Sub("Bridge")
	local z0, z1 = -length / 2, length / 2
	sub:Box(x - width / 2, height - 0.8, z0, x + width / 2, height, z1, WOOD, Enum.Material.WoodPlanks)
	for _, sx in ipairs({ -1, 1 }) do
		local rx = x + sx * (width / 2 - 0.3)
		sub:Box(rx - 0.3, height, z0, rx + 0.3, height + 3.2, z0 + 0.6, WOOD_DARK, Enum.Material.Wood)
		sub:Box(rx - 0.3, height, z1 - 0.6, rx + 0.3, height + 3.2, z1, WOOD_DARK, Enum.Material.Wood)
		sub:Box(rx - 0.2, height + 2.6, z0, rx + 0.2, height + 3, z1, WOOD_DARK, Enum.Material.Wood)
		for z = z0 + 4, z1 - 4, 4 do
			sub:Box(rx - 0.2, height, z - 0.2, rx + 0.2, height + 2.6, z + 0.2, WOOD_DARK, Enum.Material.Wood)
		end
		-- support posts into the river bed
		for _, z in ipairs({ z0 + 2, z1 - 2 }) do
			sub:Box(rx - 0.6, -6, z - 0.6, rx + 0.6, height - 0.8, z + 0.6, WOOD_DARK, Enum.Material.Wood)
		end
	end
	if covered then
		local roofY = height + 9
		for _, sx in ipairs({ -1, 1 }) do
			for z = z0 + 1, z1 - 1, (length - 2) / 2 do
				sub:Box(x + sx * width / 2 - 0.4, height, z - 0.4, x + sx * width / 2 + 0.4, roofY, z + 0.4, WOOD_DARK, Enum.Material.Wood)
			end
		end
		sub:Part(Vector3.new(width / 2 + 1.5, 0.6, length + 2), CFrame.new(x - width / 4, roofY + 1.5, 0) * CFrame.Angles(0, 0, math.rad(25)), Color3.fromRGB(80, 60, 44), Enum.Material.WoodPlanks)
		sub:Part(Vector3.new(width / 2 + 1.5, 0.6, length + 2), CFrame.new(x + width / 4, roofY + 1.5, 0) * CFrame.Angles(0, 0, math.rad(-25)), Color3.fromRGB(80, 60, 44), Enum.Material.WoodPlanks)
	end
	if not ramps then
		return
	end
	-- approach ramps from the banks
	sub:Ramp(Vector3.new(x, 0.2, z0 - 8), Vector3.new(x, height, z0), width, WOOD, Enum.Material.WoodPlanks)
	sub:Ramp(Vector3.new(x, height, z1), Vector3.new(x, 0.2, z1 + 8), width, WOOD, Enum.Material.WoodPlanks)
end

local function cabin(b, cx, cz, flip)
	local w, d = 26, 20
	local x0, z0, x1, z1 = cx - w / 2, cz - d / 2, cx + w / 2, cz + d / 2
	local y = gy(b, cx, cz)
	local sub, roofY = b:Building({
		name = "Cabin",
		x0 = x0, z0 = z0, x1 = x1, z1 = z1, y = y + 0.5,
		floors = 2, floorH = 11, wall = 1,
		color = Color3.fromRGB(118, 84, 54), mat = Enum.Material.WoodPlanks,
		floorColor = Color3.fromRGB(96, 70, 46), floorMat = Enum.Material.WoodPlanks,
		trimColor = WOOD_DARK,
		doors = {
			{ side = flip and "S" or "N", at = 0.5, w = 6, h = 8 },
			{ side = "E", at = 0.3, w = 5, h = 8 },
			{ side = "W", at = 0.7, w = 5, h = 8 },
		},
		windows = { spacing = 8, w = 4, h = 3, b = 4, groundFloor = true },
		roof = true, parapet = 2.5,
		stairSide = flip and "E" or "W",
	})
	-- foundation so the cabin sits on slopes
	b:Box(x0 - 0.5, y - 4, z0 - 0.5, x1 + 0.5, y + 0.5, z1 + 0.5, Color3.fromRGB(90, 90, 86), Enum.Material.Cobblestone)
	-- broken roof boards and a chimney
	b:Box(x1 - 5, roofY, z0 + 3, x1 - 2, roofY + 6, z0 + 6, Color3.fromRGB(100, 96, 92), Enum.Material.Brick)
	b:Part(Vector3.new(10, 0.5, 3), CFrame.new(cx - 3, roofY + 0.8, cz) * CFrame.Angles(0, 0.4, 0.15), WOOD_DARK, Enum.Material.WoodPlanks)
	-- interior cover
	MapKit.Crate(b, Vector3.new(cx + 4, y + 0.7, cz + 2), 3.5)
	MapKit.Crate(b, Vector3.new(cx - 2, y + 11.7, cz - 3), 3.5)
	b:Box(cx + 6, y + 0.7, cz - 6, cx + 10, y + 3.7, cz - 4, WOOD_DARK, Enum.Material.Wood) -- table
	return sub
end

local function watchtower(b, cx, cz)
	local y = gy(b, cx, cz)
	local sub = b:Sub("Watchtower")
	local h = 16
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			sub:Box(cx + sx * 4 - 0.5, y - 2, cz + sz * 4 - 0.5, cx + sx * 4 + 0.5, y + h + 4, cz + sz * 4 + 0.5, WOOD_DARK, Enum.Material.Wood)
		end
	end
	sub:Box(cx - 5, y + h - 0.8, cz - 5, cx + 5, y + h, cz + 5, WOOD, Enum.Material.WoodPlanks)
	for _, side in ipairs({ { -5, -5, 5, -4.6 }, { -5, 4.6, 5, 5 }, { 4.6, -5, 5, 5 } }) do
		sub:Box(cx + side[1], y + h, cz + side[2], cx + side[3], y + h + 3, cz + side[4], WOOD, Enum.Material.WoodPlanks)
	end
	sub:Part(Vector3.new(12, 0.6, 12), CFrame.new(cx, y + h + 6, cz), Color3.fromRGB(84, 62, 42), Enum.Material.WoodPlanks)
	sub:Ladder(Vector3.new(cx - 6, y, cz), h, WOOD_DARK)
end

function Forest.Build(b)
	local rng = Random.new(1201)
	local terrain = workspace.Terrain
	local B = MapKit.BOUNDS

	-- ground
	b:TerrainBox(-170, -14, -190, 170, 0, 190, GRASS)
	-- west ridge (high ground), split by the river gorge
	for z = -78, 78, 12 do
		if math.abs(z) > 14 then
			b:TerrainBall(Vector3.new(-90 + rng:NextNumber(-4, 4), -6, z), 20 + rng:NextNumber(0, 3), GRASS)
			b:TerrainBall(Vector3.new(-104, -4, z), 16, Enum.Material.Rock)
		end
	end
	-- soft hills elsewhere for varied terrain
	for _, h in ipairs({ { 40, -70, 14 }, { -40, 70, 14 }, { 30, 95, 10 }, { -30, -95, 10 }, { -50, 0, 10 } }) do
		b:TerrainBall(Vector3.new(h[1], -h[3] + 5, h[2]), h[3], GRASS)
	end
	-- east ravine (low route)
	for z = -70, 70, 8 do
		b:TerrainBall(Vector3.new(84 + math.sin(z / 20) * 4, 3, z), 12, Enum.Material.Air)
	end
	b:TerrainBox(74, -12, -66, 94, -9, 66, Enum.Material.Mud)
	-- river across the map
	b:TerrainBox(-170, -6, -9, 170, 2, 9, Enum.Material.Air)
	b:TerrainBox(-170, -10, -9, 170, -6, 9, Enum.Material.Mud)
	b:TerrainBox(-170, -6, -8, 170, -2.4, 8, Enum.Material.Water)
	-- gorge through the ridge so the river and the rope bridge cut it cleanly
	b:TerrainBox(-118, 2, -12, -64, 50, 12, Enum.Material.Air)
	-- gentle river banks
	for x = -160, 160, 10 do
		b:TerrainBall(Vector3.new(x, -5, -10), 4, Enum.Material.Mud)
		b:TerrainBall(Vector3.new(x, -5, 10), 4, Enum.Material.Mud)
	end
	-- dirt paths
	local function path(x0, z0, x1, z1)
		local a = b:WorldPos(Vector3.new(math.min(x0, x1), -6, math.min(z0, z1)))
		local c = b:WorldPos(Vector3.new(math.max(x0, x1), 30, math.max(z0, z1)))
		terrain:ReplaceMaterial(Region3.new(a, c):ExpandToGrid(4), 4, GRASS, Enum.Material.Ground)
	end
	path(-6, -112, 6, -12)
	path(-6, 12, 6, 112)
	path(-96, -60, -84, 60)
	path(40, -110, 48, -12)
	path(-48, 12, -40, 110)

	-- spawns
	local redSpawns, redZone = MapKit.SpawnBase(b, "Red", { floorColor = Color3.fromRGB(96, 78, 58), floorMat = Enum.Material.WoodPlanks, wallColor = Color3.fromRGB(100, 72, 46), wallMat = Enum.Material.WoodPlanks })
	local blueSpawns, blueZone = MapKit.SpawnBase(b, "Blue", { floorColor = Color3.fromRGB(96, 78, 58), floorMat = Enum.Material.WoodPlanks, wallColor = Color3.fromRGB(100, 72, 46), wallMat = Enum.Material.WoodPlanks })

	-- bridges
	bridge(b, -90, 8, 28, 13, false, false) -- high bridge across the ridge gorge
	bridge(b, 0, 14, 24, 2.5, true, true) -- covered main bridge
	bridge(b, 46, 9, 22, 2, false, true)

	-- cabins and towers (point-symmetric for fairness)
	cabin(b, -30, -42, false)
	cabin(b, 30, 42, true)
	watchtower(b, 58, -78)
	watchtower(b, -58, 78)

	-- abandoned camp sites in the clearings
	local props = b:Sub("Props")
	for _, s in ipairs({ -1, 1 }) do
		MapKit.CrateStack(props, Vector3.new(14 * s, gy(b, 14 * s, 28 * s), 28 * s))
		MapKit.Barrel(props, Vector3.new(-12 * s, gy(b, -12 * s, 22 * s), 22 * s), Color3.fromRGB(90, 70, 50))
		MapKit.Sandbags(props, Vector3.new(0, gy(b, 0, 24 * s), 24 * s), 10, 0, Color3.fromRGB(130, 116, 90))
		log(props, 22 * s, -62 * s, 70, 14)
		log(props, -16 * s, -78 * s, 15, 12)
		log(props, 70 * s, 20 * s, 85, 10)
		-- campfire ring
		local cx, cz = 24 * s, 86 * s
		local gy = gy(b, cx, cz)
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			props:Part(Vector3.new(1.2, 0.8, 1.2), Vector3.new(cx + math.cos(a) * 2.2, gy + 0.3, cz + math.sin(a) * 2.2), ROCK, Enum.Material.Slate)
		end
		local fire = props:Part(Vector3.new(1, 0.6, 1), Vector3.new(cx, gy + 0.3, cz), Color3.fromRGB(80, 40, 20), Enum.Material.Wood, { CanCollide = false })
		local f = Instance.new("Fire")
		f.Size = 4
		f.Heat = 6
		f.Parent = fire
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(255, 150, 70)
		l.Range = 18
		l.Brightness = 2
		l.Parent = fire
	end

	-- boulders on the ridge for cover
	for z = -70, 70, 14 do
		if math.abs(z) > 16 then
			rock(props, -82 + rng:NextNumber(-3, 3), z + rng:NextNumber(-4, 4), rng, 5 + rng:NextNumber() * 3)
		end
	end
	-- ravine rocks
	for z = -60, 60, 16 do
		rock(props, 84 + rng:NextNumber(-5, 5), z, rng, 4)
	end

	-- trees: scatter avoiding lanes, bases, river and structures
	local function blocked(x, z)
		if math.abs(z) < 14 then
			return true -- river
		end
		if math.abs(z) > 108 and math.abs(x) < 30 then
			return true -- bases
		end
		if math.abs(x) < 8 then
			return true -- main path
		end
		if (math.abs(x + 30) < 18 and math.abs(z + 42) < 15) or (math.abs(x - 30) < 18 and math.abs(z - 42) < 15) then
			return true -- cabins
		end
		if (math.abs(x - 58) < 9 and math.abs(z + 78) < 9) or (math.abs(x + 58) < 9 and math.abs(z - 78) < 9) then
			return true
		end
		if math.abs(x - 84) < 9 and math.abs(z) < 66 then
			return true -- ravine floor
		end
		return false
	end
	local trees = b:Sub("Trees")
	local placed = 0
	local tries = 0
	while placed < 135 and tries < 1200 do
		tries += 1
		local x = rng:NextNumber(B.x0 + 4, B.x1 - 4)
		local z = rng:NextNumber(B.z0 + 4, B.z1 - 4)
		if not blocked(x, z) then
			if rng:NextNumber() < 0.75 then
				pine(trees, x, z, rng)
			else
				broadleaf(trees, x, z, rng)
			end
			placed += 1
			if rng:NextNumber() < 0.45 then
				bush(trees, x + rng:NextNumber(-5, 5), z + rng:NextNumber(-5, 5), rng)
			end
		end
	end
	-- dense backdrop outside the play area
	for i = 1, 70 do
		local side = i % 4
		local x, z
		if side == 0 then
			x, z = rng:NextNumber(-160, 160), rng:NextNumber(146, 175)
		elseif side == 1 then
			x, z = rng:NextNumber(-160, 160), rng:NextNumber(-175, -146)
		elseif side == 2 then
			x, z = rng:NextNumber(126, 160), rng:NextNumber(-170, 170)
		else
			x, z = rng:NextNumber(-160, -126), rng:NextNumber(-170, 170)
		end
		pine(trees, x, z, rng, 1.3 + rng:NextNumber() * 0.5)
	end

	b:Boundary(B.x0, B.z0, B.x1, B.z1, -20, 120)

	return {
		Spawns = { Red = redSpawns, Blue = blueSpawns },
		SpawnZones = { Red = redZone, Blue = blueZone },
		Podium = MapKit.PODIUM,
		KillY = -30,
		Bounds = { -172, -16, -192, 172, 40, 192 },
	}
end

function Forest.BuildPreview(b)
	b:Box(-3, 0, -3, 3, 0.4, 3, Color3.fromRGB(70, 130, 60), Enum.Material.Grass)
	b:Box(-3, 0.4, -0.35, 3, 0.45, 0.35, Color3.fromRGB(70, 140, 200), Enum.Material.Glass, { Transparency = 0.2 })
	b:Box(-0.6, 0.45, -0.6, 0.6, 0.6, 0.6, Color3.fromRGB(110, 78, 48), Enum.Material.WoodPlanks)
	local rng = Random.new(7)
	for _ = 1, 14 do
		local x, z = rng:NextNumber(-2.7, 2.7), rng:NextNumber(-2.7, 2.7)
		if math.abs(z) > 0.7 then
			b:Box(x - 0.06, 0.4, z - 0.06, x + 0.06, 0.9, z + 0.06, Color3.fromRGB(90, 60, 40), Enum.Material.Wood)
			b:Cyl(0.5, 0.7, CFrame.new(x, 1.1, z) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(40, 100, 50), Enum.Material.Grass)
			b:Cyl(0.4, 0.45, CFrame.new(x, 1.45, z) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(50, 120, 56), Enum.Material.Grass)
		end
	end
	b:Box(-2.6, 0.4, -2.4, -1.6, 0.9, -1.6, Color3.fromRGB(118, 84, 54), Enum.Material.WoodPlanks)
	b:Box(1.6, 0.4, 1.6, 2.6, 0.9, 2.4, Color3.fromRGB(118, 84, 54), Enum.Material.WoodPlanks)
end

return Forest
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Maya</string><ProtectedString name="Source"><![CDATA[--[[
	MAP 5 - MAYA JUNGLE CITY "Temple of the Jaguar"
	Mossy grey stepped architecture in a dense jungle (deliberately nothing like the smooth
	sandstone of the Egypt map):
	  * Centre : the Great Pyramid - six jumpable tiers, steep stairways facing both teams,
	             a shrine with a red roof comb on top and a dark tunnel through its base
	  * East   : the ball court - two long sloped platforms with stone rings, an open alley
	  * West   : the cenote - a flooded sinkhole with ramps to a stone island and a cave
	             tunnel that comes up in a trench at the pyramid's west tunnel mouth
	  * Each half: a three-tier side temple and overgrown ruins with carved stelae
]]

local MapKit = require(script.Parent.Parent.MapKit)

local Maya = {}

local STONE = Color3.fromRGB(128, 132, 118)
local STONE_LIGHT = Color3.fromRGB(156, 158, 142)
local STONE_DARK = Color3.fromRGB(96, 100, 90)
local MOSS = Color3.fromRGB(70, 110, 58)
local TEMPLE_RED = Color3.fromRGB(150, 52, 40)
local JADE = Color3.fromRGB(40, 150, 110)
local SLATE = Enum.Material.Slate
local COBBLE = Enum.Material.Cobblestone

local TIER_H = 4.5

local function gy(b, x, z)
	return b:GroundY(x, z, nil, true)
end

-- square carved glyph tile (stylised, original) on a wall frame
local function glyphTile(b, cf: CFrame, rng)
	b:Part(Vector3.new(1.8, 1.8, 0.2), cf * CFrame.new(0, 0, -0.1), STONE_DARK, SLATE, { CanCollide = false, CastShadow = false })
	for _ = 1, 3 do
		local w, h = rng:NextNumber(0.3, 1.2), rng:NextNumber(0.25, 0.9)
		b:Part(Vector3.new(w, h, 0.12), cf * CFrame.new(rng:NextNumber(-0.5, 0.5), rng:NextNumber(-0.5, 0.5), -0.25), STONE_LIGHT, SLATE, { CanCollide = false, CastShadow = false })
	end
end

local function stela(b, x, z, rotY, rng)
	local y = gy(b, x, z)
	local cf = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(rotY), 0)
	b:Part(Vector3.new(4, 1, 2.4), cf * CFrame.new(0, 0.3, 0), STONE_DARK, COBBLE)
	b:Part(Vector3.new(3, 9, 1.4), cf * CFrame.new(0, 5, 0), STONE, SLATE)
	for row = 0, 2 do
		glyphTile(b, cf * CFrame.new(0, 3 + row * 2.2, -0.7), rng)
	end
	b:Part(Vector3.new(3.2, 0.6, 1.6), cf * CFrame.new(0, 9.7, 0), MOSS, Enum.Material.Grass, { CanCollide = false })
end

local function jungleTree(b, x, z, rng)
	local y = gy(b, x, z)
	local t = b:Sub("JungleTree")
	local h = 16 + rng:NextNumber() * 10
	t:Column(Vector3.new(x, y - 1, z), h, 2 + rng:NextNumber(), Color3.fromRGB(96, 80, 60), Enum.Material.Wood)
	-- buttress roots
	for i = 0, 2 do
		local a = i / 3 * math.pi * 2 + rng:NextNumber()
		t:Part(Vector3.new(0.8, 3, 4), CFrame.new(x + math.cos(a) * 1.6, y + 1, z + math.sin(a) * 1.6) * CFrame.Angles(0, -a, 0), Color3.fromRGB(90, 74, 56), Enum.Material.Wood)
	end
	for _ = 1, 4 do
		local off = Vector3.new(rng:NextNumber(-5, 5), rng:NextNumber(-1.5, 1.5), rng:NextNumber(-5, 5))
		local s = 8 + rng:NextNumber() * 5
		t:Ball(s * 0.75, Vector3.new(x, y + h, z) + off, Color3.fromRGB(40 + rng:NextInteger(0, 20), 100 + rng:NextInteger(0, 30), 46), Enum.Material.Grass, { CanCollide = false })
	end
	-- hanging vines
	for _ = 1, 3 do
		local vx, vz = x + rng:NextNumber(-4, 4), z + rng:NextNumber(-4, 4)
		local len = rng:NextNumber(5, 10)
		t:Part(Vector3.new(0.25, len, 0.25), Vector3.new(vx, y + h - len / 2 - 1, vz), Color3.fromRGB(60, 110, 50), Enum.Material.Grass, { CanCollide = false, NoBullets = true, CastShadow = false })
	end
end

local function palm(b, x, z, rng)
	local y = gy(b, x, z)
	local h = 12 + rng:NextNumber() * 6
	local t = b:Sub("Palm")
	t:Column(Vector3.new(x, y - 1, z), h, 1.2, Color3.fromRGB(120, 100, 70), Enum.Material.Wood)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		t:Part(Vector3.new(1.8, 0.2, 8), CFrame.new(x, y + h, z) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -3.6) * CFrame.Angles(math.rad(-22), 0, 0), Color3.fromRGB(50, 130, 60), Enum.Material.Grass, { CanCollide = false, NoBullets = true })
	end
end

local function fern(b, x, z, rng)
	local y = gy(b, x, z)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2 + rng:NextNumber()
		b:Part(Vector3.new(1.2, 0.2, 4), CFrame.new(x, y + 0.8, z) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -1.6) * CFrame.Angles(math.rad(25), 0, 0), Color3.fromRGB(60, 140 + rng:NextInteger(-20, 20), 60), Enum.Material.Grass, { CanCollide = false, NoBullets = true, CastShadow = false })
	end
	b:Ball(3 + rng:NextNumber() * 2, Vector3.new(x, y + 0.8, z), Color3.fromRGB(46, 110, 50), Enum.Material.Grass, { CanCollide = false, NoBullets = true, CastShadow = false })
end

local function greatPyramid(b)
	local sub = b:Sub("GreatPyramid")
	local tunnelTop = 7
	for i = 0, 5 do
		local half = 28 - i * 4
		local y0, y1 = i * TIER_H, (i + 1) * TIER_H
		local color = (i % 2 == 0) and STONE or STONE_LIGHT
		if y0 < tunnelTop then
			sub:Box(-half, y0, -half, half, y1, -3, color, COBBLE)
			sub:Box(-half, y0, 3, half, y1, half, color, COBBLE)
			if y1 > tunnelTop then
				sub:Box(-half, tunnelTop, -3, half, y1, 3, color, COBBLE)
			end
		else
			sub:Box(-half, y0, -half, half, y1, half, color, COBBLE)
		end
		-- moss lip on each tier
		sub:Box(-half - 0.1, y1 - 0.4, -half - 0.1, half + 0.1, y1, half + 0.1, MOSS, Enum.Material.Grass, { CastShadow = false })
		-- carved panel band on the east/west faces
		if i == 2 then
			for z = -half + 4, half - 4, 6 do
				if math.abs(z) > 6 then
					sub:Part(Vector3.new(0.3, 2.6, 4), Vector3.new(half + 0.1, y0 + 2.2, z), STONE_DARK, SLATE, { CanCollide = false })
					sub:Part(Vector3.new(0.3, 2.6, 4), Vector3.new(-half - 0.1, y0 + 2.2, z), STONE_DARK, SLATE, { CanCollide = false })
				end
			end
		end
	end
	local topY = 6 * TIER_H
	-- tunnel lighting
	for _, x in ipairs({ -18, 0, 18 }) do
		sub:Light(Vector3.new(x, 5.5, 0), Color3.fromRGB(255, 160, 80), 14, 1.2)
	end
	-- stairways facing both teams
	for _, s in ipairs({ -1, 1 }) do
		sub:Stairs(Vector3.new(0, 0.2, 42 * s), Vector3.new(0, topY + 0.1, 8 * s), 10, STONE_LIGHT, COBBLE)
		-- balustrades
		for _, x in ipairs({ -5.8, 5.8 }) do
			sub:Ramp(Vector3.new(x, 1.6, 42 * s), Vector3.new(x, topY + 1.6, 8 * s), 1.6, STONE_DARK, COBBLE, { CanCollide = false })
		end
		sub:Part(Vector3.new(3, 3, 4), Vector3.new(-6.5, 1.5, 43 * s), JADE, SLATE) -- serpent heads at the foot
		sub:Part(Vector3.new(3, 3, 4), Vector3.new(6.5, 1.5, 43 * s), JADE, SLATE)
	end
	-- shrine on top
	local x0, x1, z0, z1 = -7, 7, -6, 6
	local h = 8
	sub:Wall(Vector3.new(x0, topY, z0 + 0.6), Vector3.new(x1, topY, z0 + 0.6), h, 1.2, TEMPLE_RED, SLATE, { { c = 7, w = 4, b = 0, t = 6.5 } })
	sub:Wall(Vector3.new(x0, topY, z1 - 0.6), Vector3.new(x1, topY, z1 - 0.6), h, 1.2, TEMPLE_RED, SLATE, { { c = 7, w = 4, b = 0, t = 6.5 } })
	sub:Wall(Vector3.new(x0 + 0.6, topY, z0 + 1.2), Vector3.new(x0 + 0.6, topY, z1 - 1.2), h, 1.2, TEMPLE_RED, SLATE, { { c = 4.8, w = 2.5, b = 2.5, t = 5 } })
	sub:Wall(Vector3.new(x1 - 0.6, topY, z0 + 1.2), Vector3.new(x1 - 0.6, topY, z1 - 1.2), h, 1.2, TEMPLE_RED, SLATE, { { c = 4.8, w = 2.5, b = 2.5, t = 5 } })
	sub:Box(x0 - 1, topY + h, z0 - 1, x1 + 1, topY + h + 1.2, z1 + 1, STONE_DARK, SLATE)
	-- roof comb (lattice)
	for x = -6, 6, 3 do
		sub:Box(x - 0.6, topY + h + 1.2, -0.6, x + 0.6, topY + h + 8, 0.6, TEMPLE_RED, SLATE)
	end
	sub:Box(-6.6, topY + h + 4, -0.5, 6.6, topY + h + 5, 0.5, TEMPLE_RED, SLATE)
	sub:Box(-6.6, topY + h + 7.6, -0.5, 6.6, topY + h + 8.6, 0.5, JADE, SLATE)
	local brazier = sub:Part(Vector3.new(1.4, 1.2, 1.4), Vector3.new(0, topY + 0.6, 0), STONE_DARK, SLATE)
	local f = Instance.new("Fire")
	f.Size = 3
	f.Parent = brazier
	sub:Light(Vector3.new(0, topY + 3, 0), Color3.fromRGB(255, 150, 70), 18, 1.4)
end

local function ballCourt(b)
	local sub = b:Sub("BallCourt")
	local H = 8
	sub:Box(66, 0, -30, 90, 0.4, 30, STONE_LIGHT, COBBLE) -- alley floor
	for _, side in ipairs({ { 54, 66, 1 }, { 90, 102, -1 } }) do
		local x0, x1, dir = side[1], side[2], side[3]
		sub:Box(x0, 0, -30, x1, H, 30, STONE, COBBLE)
		sub:Box(x0 - 0.1, H - 0.4, -30.1, x1 + 0.1, H, 30.1, MOSS, Enum.Material.Grass, { CastShadow = false })
		-- sloped inner face (walkable)
		local innerX = dir > 0 and x1 or x0
		sub:Ramp(Vector3.new(innerX + 6 * dir, 0.4, 0) + Vector3.new(0, 0, 0), Vector3.new(innerX, 4, 0), 58, STONE_LIGHT, COBBLE, nil, 1)
		-- vertical upper wall with the stone ring
		sub:Box(innerX - 0.4 * dir, 4, -30, innerX + 0.01 * dir, H, 30, STONE_LIGHT, COBBLE)
		local ring = sub:Cyl(1.2, 5, CFrame.new(innerX + 0.5 * dir, 6.2, 0), STONE_DARK, SLATE)
		ring.Name = "CourtRing"
		sub:Cyl(1.4, 2.4, CFrame.new(innerX + 0.5 * dir, 6.2, 0), Color3.fromRGB(20, 22, 18), SLATE, { CanCollide = false })
		-- low parapet on top with gaps
		local px = dir > 0 and x0 or x1
		sub:Box(px - 0.6, H, -30, px + 0.6, H + 2.5, -8, STONE_DARK, COBBLE)
		sub:Box(px - 0.6, H, 8, px + 0.6, H + 2.5, 30, STONE_DARK, COBBLE)
		-- stairs up at both ends
		local sx = (x0 + x1) / 2
		sub:Stairs(Vector3.new(sx, 0.2, -40), Vector3.new(sx, H + 0.1, -30), 6, STONE_DARK, COBBLE)
		sub:Stairs(Vector3.new(sx, 0.2, 40), Vector3.new(sx, H + 0.1, 30), 6, STONE_DARK, COBBLE)
		-- small shrine block on top for cover
		sub:Box(sx - 3, H, -3, sx + 3, H + 4, 3, TEMPLE_RED, SLATE)
	end
	for _, z in ipairs({ -18, 0, 18 }) do
		sub:Column(Vector3.new(78, 0.4, z), 0.3, 3, JADE, SLATE)
	end
end

local function cenote(b)
	local cx, cz = -78, 0
	local terrain = workspace.Terrain
	local center = b:WorldPos(Vector3.new(cx, -6, cz))
	terrain:FillCylinder(CFrame.new(center), 22, 16, Enum.Material.Air)
	terrain:FillCylinder(CFrame.new(b:WorldPos(Vector3.new(cx, -16, cz))), 6, 15.5, Enum.Material.Water)
	-- cave tunnel east toward the pyramid and an open trench at its mouth
	b:TerrainBox(-63, -10, -4, -46, -3, 4, Enum.Material.Air)
	b:TerrainBox(-48, -10, -4.5, -27, 12, 4.5, Enum.Material.Air)
	local sub = b:Sub("Cenote")
	-- island and walkway
	sub:Box(cx - 5, -14, cz - 5, cx + 5, -10, cz + 5, STONE, COBBLE)
	sub:Box(cx + 4, -11, -3, -60, -10, 3, STONE_DARK, COBBLE)
	-- ramps down from the rim (north and south)
	sub:Ramp(Vector3.new(cx, 0.4, cz - 17), Vector3.new(cx, -10, cz - 5), 6, STONE_DARK, COBBLE)
	sub:Ramp(Vector3.new(cx, 0.4, cz + 17), Vector3.new(cx, -10, cz + 5), 6, STONE_DARK, COBBLE)
	-- tunnel floor, frame and lights
	sub:Box(-64, -11, -4, -46, -10, 4, STONE_DARK, COBBLE)
	sub:Ramp(Vector3.new(-46, -10, 0), Vector3.new(-28, 0.4, 0), 8, STONE_DARK, COBBLE)
	for _, x in ipairs({ -62, -48 }) do
		sub:Box(x - 1, -10, -4.5, x + 1, -3, -3.5, STONE_LIGHT, COBBLE)
		sub:Box(x - 1, -10, 3.5, x + 1, -3, 4.5, STONE_LIGHT, COBBLE)
		sub:Box(x - 1, -3.6, -4.5, x + 1, -2.6, 4.5, STONE_LIGHT, COBBLE)
	end
	sub:Light(Vector3.new(-55, -5, 0), Color3.fromRGB(120, 220, 180), 16, 1)
	sub:Light(Vector3.new(cx, -8, cz), Color3.fromRGB(120, 220, 180), 20, 1)
	-- trench walls lined with stone
	sub:Box(-48, -10, -5.5, -27, 0.5, -4.5, STONE, COBBLE)
	sub:Box(-48, -10, 4.5, -27, 0.5, 5.5, STONE, COBBLE)
	-- rim stones
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		if math.abs(math.sin(a)) < 0.9 then
			sub:Part(Vector3.new(3, 2, 4), CFrame.new(cx + math.cos(a) * 17.5, 0.8, cz + math.sin(a) * 17.5) * CFrame.Angles(0, -a, 0), STONE_DARK, COBBLE)
		end
	end
end

local function sideTemple(b, cx, cz, facing)
	local sub = b:Sub("SideTemple")
	local y = gy(b, cx, cz)
	local f = facing -- +1 => stairs face +Z
	for i = 0, 2 do
		local half = 12 - i * 3
		sub:Box(cx - half, y - 2 + i * TIER_H, cz - half, cx + half, y + (i + 1) * TIER_H, cz + half, (i % 2 == 0) and STONE or STONE_LIGHT, COBBLE)
		sub:Box(cx - half - 0.1, y + (i + 1) * TIER_H - 0.4, cz - half - 0.1, cx + half + 0.1, y + (i + 1) * TIER_H, cz + half + 0.1, MOSS, Enum.Material.Grass, { CastShadow = false })
	end
	local top = y + 3 * TIER_H
	sub:Stairs(Vector3.new(cx, y + 0.2, cz + 20 * f), Vector3.new(cx, top + 0.1, cz + 6 * f), 6, STONE_LIGHT, COBBLE)
	-- small shrine; the wall facing the stairs has a doorway
	local nearZ0, nearZ1 = cz + 2.8, cz + 4
	local farZ0, farZ1 = cz - 4, cz - 2.8
	if f < 0 then
		nearZ0, nearZ1, farZ0, farZ1 = cz - 4, cz - 2.8, cz + 2.8, cz + 4
	end
	sub:Box(cx - 5, top, farZ0, cx + 5, top + 6, farZ1, TEMPLE_RED, SLATE)
	sub:Box(cx - 5, top, cz - 2.8, cx - 3.8, top + 6, cz + 2.8, TEMPLE_RED, SLATE)
	sub:Box(cx + 3.8, top, cz - 2.8, cx + 5, top + 6, cz + 2.8, TEMPLE_RED, SLATE)
	sub:Box(cx - 5, top, nearZ0, cx - 1.6, top + 6, nearZ1, TEMPLE_RED, SLATE)
	sub:Box(cx + 1.6, top, nearZ0, cx + 5, top + 6, nearZ1, TEMPLE_RED, SLATE)
	sub:Box(cx - 1.6, top + 4.6, nearZ0, cx + 1.6, top + 6, nearZ1, TEMPLE_RED, SLATE)
	sub:Box(cx - 5.6, top + 6, cz - 4.6, cx + 5.6, top + 7, cz + 4.6, STONE_DARK, SLATE)
	for x = -4, 4, 2 do
		sub:Box(cx + x - 0.4, top + 7, cz - 0.4, cx + x + 0.4, top + 11, cz + 0.4, TEMPLE_RED, SLATE)
	end
end

local function ruins(b, cx, cz, rng)
	local sub = b:Sub("Ruins")
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local r = 12 + rng:NextNumber(-2, 4)
		local x, z = cx + math.cos(a) * r, cz + math.sin(a) * r
		local y = gy(b, x, z)
		local h = rng:NextNumber(3, 8)
		local len = rng:NextNumber(6, 12)
		local cf = CFrame.new(x, y + h / 2 - 0.5, z) * CFrame.Angles(0, -a + math.pi / 2, 0)
		sub:Part(Vector3.new(len, h, 2), cf, STONE, COBBLE)
		sub:Part(Vector3.new(len + 0.2, 0.6, 2.2), cf * CFrame.new(0, h / 2, 0), MOSS, Enum.Material.Grass, { CanCollide = false })
	end
	for _ = 1, 4 do
		local x, z = cx + rng:NextNumber(-9, 9), cz + rng:NextNumber(-9, 9)
		sub:Part(Vector3.new(3, 2, 3), CFrame.new(x, gy(b, x, z) + 0.8, z) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber() * 6, 0), STONE_DARK, COBBLE)
	end
	stela(sub, cx, cz, rng:NextNumber() * 360, rng)
	local altarY = gy(b, cx + 5, cz + 5)
	sub:Column(Vector3.new(cx + 5, altarY - 0.5, cz + 5), 3, 5, STONE_LIGHT, SLATE)
end

function Maya.Build(b)
	local B = MapKit.BOUNDS
	local rng = Random.new(5150)
	local terrain = workspace.Terrain

	-- jungle floor
	b:TerrainBox(-170, -24, -190, 170, 0, 190, Enum.Material.LeafyGrass)
	-- rolling jungle mounds away from the main structures
	for _, h in ipairs({ { -100, -40, 9 }, { 100, 50, 9 }, { -30, -90, 8 }, { 30, 90, 8 }, { 110, -100, 10 }, { -110, 100, 10 } }) do
		b:TerrainBall(Vector3.new(h[1], -h[3] + 4, h[2]), h[3], Enum.Material.Grass)
	end
	-- mud paths
	local function path(x0, z0, x1, z1)
		local a = b:WorldPos(Vector3.new(math.min(x0, x1), -6, math.min(z0, z1)))
		local c = b:WorldPos(Vector3.new(math.max(x0, x1), 20, math.max(z0, z1)))
		terrain:ReplaceMaterial(Region3.new(a, c):ExpandToGrid(4), 4, Enum.Material.LeafyGrass, Enum.Material.Mud)
	end
	path(-6, -112, 6, -44)
	path(-6, 44, 6, 112)
	path(70, -100, 82, 100)
	path(-82, -100, -70, 100)

	-- stone plaza around the pyramid (with a gap for the cenote trench)
	b:Slab(-40, -48, 40, 48, 0.4, 0.8, STONE_DARK, COBBLE, { { -48, -5.5, -27, 5.5 } })

	cenote(b)
	greatPyramid(b)
	ballCourt(b)

	for _, s in ipairs({ -1, 1 }) do
		sideTemple(b, -62 * s, -80 * s, s)
		ruins(b, 62 * s, -78 * s, rng)
		-- stelae along the approach and scattered cover
		stela(b, -14 * s, -60 * s, s > 0 and 0 or 180, rng)
		stela(b, 14 * s, -60 * s, s > 0 and 0 or 180, rng)
		for _, p in ipairs({ { -30, -70 }, { 36, -56 }, { 20, -96 }, { -44, -40 }, { 100, -64 } }) do
			local x, z = p[1] * s, p[2] * s
			b:Part(Vector3.new(6, 4, 3), CFrame.new(x, gy(b, x, z) + 1.5, z) * CFrame.Angles(0, rng:NextNumber() * 6, 0), STONE, COBBLE)
		end
	end

	-- spawns
	local redSpawns, redZone = MapKit.SpawnBase(b, "Red", { floorColor = STONE_DARK, floorMat = COBBLE, wallColor = STONE, wallMat = COBBLE })
	local blueSpawns, blueZone = MapKit.SpawnBase(b, "Blue", { floorColor = STONE_DARK, floorMat = COBBLE, wallColor = STONE, wallMat = COBBLE })

	-- jungle vegetation
	local function blocked(x, z)
		if math.abs(x) < 46 and math.abs(z) < 52 then
			return true -- pyramid + plaza + stairs
		end
		if x > 50 and x < 106 and math.abs(z) < 44 then
			return true -- ball court
		end
		if (x + 78) ^ 2 + z ^ 2 < 22 ^ 2 then
			return true -- cenote
		end
		if math.abs(z) > 108 and math.abs(x) < 30 then
			return true -- bases
		end
		if math.abs(x) < 8 then
			return true
		end
		for _, c in ipairs({ { -62, -80 }, { 62, 80 } }) do
			if math.abs(x - c[1]) < 16 and math.abs(z - c[2]) < 26 then
				return true
			end
		end
		for _, c in ipairs({ { 62, -78 }, { -62, 78 } }) do
			if math.abs(x - c[1]) < 16 and math.abs(z - c[2]) < 16 then
				return true
			end
		end
		return false
	end
	local veg = b:Sub("Jungle")
	local placed, tries = 0, 0
	while placed < 120 and tries < 1500 do
		tries += 1
		local x = rng:NextNumber(B.x0 + 4, B.x1 - 4)
		local z = rng:NextNumber(B.z0 + 4, B.z1 - 4)
		if not blocked(x, z) then
			local r = rng:NextNumber()
			if r < 0.55 then
				jungleTree(veg, x, z, rng)
			elseif r < 0.8 then
				palm(veg, x, z, rng)
			else
				fern(veg, x, z, rng)
			end
			if rng:NextNumber() < 0.6 then
				fern(veg, x + rng:NextNumber(-5, 5), z + rng:NextNumber(-5, 5), rng)
			end
			placed += 1
		end
	end
	for i = 1, 70 do
		local side = i % 4
		local x, z
		if side == 0 then
			x, z = rng:NextNumber(-160, 160), rng:NextNumber(146, 175)
		elseif side == 1 then
			x, z = rng:NextNumber(-160, 160), rng:NextNumber(-175, -146)
		elseif side == 2 then
			x, z = rng:NextNumber(126, 160), rng:NextNumber(-170, 170)
		else
			x, z = rng:NextNumber(-160, -126), rng:NextNumber(-170, 170)
		end
		jungleTree(veg, x, z, rng)
	end

	b:Boundary(B.x0, B.z0, B.x1, B.z1, -20, 120)
	return {
		Spawns = { Red = redSpawns, Blue = blueSpawns },
		SpawnZones = { Red = redZone, Blue = blueZone },
		Podium = MapKit.PODIUM,
		KillY = -28,
		Bounds = { -172, -26, -192, 172, 40, 192 },
	}
end

function Maya.BuildPreview(b)
	b:Box(-3, 0, -3, 3, 0.3, 3, Color3.fromRGB(60, 120, 60), Enum.Material.Grass)
	for i = 0, 4 do
		local w = 3.4 - i * 0.6
		b:Box(-w / 2, 0.3 + i * 0.4, -w / 2, w / 2, 0.7 + i * 0.4, w / 2, (i % 2 == 0) and STONE or STONE_LIGHT, COBBLE)
	end
	b:Box(-0.4, 2.3, -0.3, 0.4, 2.8, 0.3, TEMPLE_RED, SLATE)
	b:Box(-0.25, 0.5, 1.7, 0.25, 2.2, 2.2, STONE_LIGHT, COBBLE)
	local rng = Random.new(9)
	for _ = 1, 8 do
		local x, z = rng:NextNumber(-2.7, 2.7), rng:NextNumber(-2.7, 2.7)
		if math.abs(x) > 1.9 or math.abs(z) > 1.9 then
			b:Ball(0.9, Vector3.new(x, 1.1, z), Color3.fromRGB(40, 120, 50), Enum.Material.Grass)
			b:Box(x - 0.05, 0.3, z - 0.05, x + 0.05, 0.8, z + 0.05, Color3.fromRGB(90, 70, 50), Enum.Material.Wood)
		end
	end
end

return Maya
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">ModernCity</string><ProtectedString name="Source"><![CDATA[--[[
	MAP 2 - MODERN CITY "Downtown District"
	Point-symmetric layout (every feature on Red's half is mirrored on Blue's half):
	  * Central avenue (wide, broken up by cars, a bus stop and a fountain plaza)
	  * Two narrow cross streets and back alleys for flanking
	  * Enterable office (3 floors + roof), corner shops with glass fronts, a 4-storey tower
	    (best high ground, but exposed from rooftops), a two-level parking garage
	  * Open parking lots with cars for mid-range fights
]]

local MapKit = require(script.Parent.Parent.MapKit)

local ModernCity = {}

local ASPHALT = Color3.fromRGB(46, 47, 52)
local SIDEWALK = Color3.fromRGB(150, 150, 146)
local LINE = Color3.fromRGB(235, 225, 190)
local GLASS = Color3.fromRGB(110, 150, 180)

local CAR_COLORS = {
	Color3.fromRGB(190, 40, 40), Color3.fromRGB(30, 60, 140), Color3.fromRGB(230, 230, 232),
	Color3.fromRGB(30, 30, 34), Color3.fromRGB(200, 170, 40), Color3.fromRGB(70, 120, 90),
}

local function car(b, x, z, rotY, color)
	local sub = b:Sub("Car")
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(rotY), 0)
	sub:Part(Vector3.new(5.6, 2.2, 11), cf * CFrame.new(0, 1.9, 0), color, Enum.Material.SmoothPlastic, { Reflectance = 0.1 })
	sub:Part(Vector3.new(5.2, 2, 6), cf * CFrame.new(0, 4, 0.6), GLASS, Enum.Material.Glass, { Transparency = 0.25 })
	sub:Part(Vector3.new(5.3, 0.3, 5.6), cf * CFrame.new(0, 5.05, 0.6), color, Enum.Material.SmoothPlastic)
	for _, wx in ipairs({ -2.6, 2.6 }) do
		for _, wz in ipairs({ -3.6, 3.6 }) do
			sub:Cyl(1, 2.4, cf * CFrame.new(wx, 1.2, wz), Color3.fromRGB(20, 20, 22), Enum.Material.SmoothPlastic)
		end
	end
	sub:Part(Vector3.new(1.2, 0.5, 0.2), cf * CFrame.new(-1.8, 2.3, -5.55), Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
	sub:Part(Vector3.new(1.2, 0.5, 0.2), cf * CFrame.new(1.8, 2.3, -5.55), Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
	sub:Part(Vector3.new(1.2, 0.5, 0.2), cf * CFrame.new(-1.8, 2.3, 5.55), Color3.fromRGB(200, 20, 20), Enum.Material.Neon)
	sub:Part(Vector3.new(1.2, 0.5, 0.2), cf * CFrame.new(1.8, 2.3, 5.55), Color3.fromRGB(200, 20, 20), Enum.Material.Neon)
end

local function lamp(b, x, z, rotY)
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(rotY), 0)
	b:Part(Vector3.new(0.6, 14, 0.6), cf * CFrame.new(0, 7.5, 0), Color3.fromRGB(50, 52, 58), Enum.Material.Metal)
	b:Part(Vector3.new(0.5, 0.5, 4), cf * CFrame.new(0, 14.3, -1.8), Color3.fromRGB(50, 52, 58), Enum.Material.Metal)
	local head = b:Part(Vector3.new(1.4, 0.4, 1.8), cf * CFrame.new(0, 14, -3.6), Color3.fromRGB(255, 240, 210), Enum.Material.Neon, { CastShadow = false })
	local l = Instance.new("SpotLight")
	l.Face = Enum.NormalId.Bottom
	l.Angle = 100
	l.Range = 26
	l.Brightness = 1.4
	l.Color = Color3.fromRGB(255, 220, 170)
	l.Parent = head
end

local function planterTree(b, x, z)
	b:Box(x - 2, 0, z - 2, x + 2, 1.6, z + 2, Color3.fromRGB(110, 110, 112), Enum.Material.Concrete)
	b:Box(x - 1.7, 1.6, z - 1.7, x + 1.7, 1.8, z + 1.7, Color3.fromRGB(70, 50, 34), Enum.Material.Ground)
	b:Column(Vector3.new(x, 1.6, z), 6, 0.7, Color3.fromRGB(80, 60, 44), Enum.Material.Wood)
	b:Ball(6, Vector3.new(x, 8.6, z), Color3.fromRGB(60, 120, 60), Enum.Material.Grass, { CanCollide = false })
end

local function bench(b, x, z, rotY)
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(rotY), 0)
	b:Part(Vector3.new(5, 0.4, 1.6), cf * CFrame.new(0, 1.6, 0), Color3.fromRGB(120, 86, 56), Enum.Material.Wood)
	b:Part(Vector3.new(5, 1.4, 0.3), cf * CFrame.new(0, 2.5, 0.75), Color3.fromRGB(120, 86, 56), Enum.Material.Wood)
	b:Part(Vector3.new(0.3, 1.6, 1.4), cf * CFrame.new(-2.2, 0.8, 0), Color3.fromRGB(40, 40, 44), Enum.Material.Metal)
	b:Part(Vector3.new(0.3, 1.6, 1.4), cf * CFrame.new(2.2, 0.8, 0), Color3.fromRGB(40, 40, 44), Enum.Material.Metal)
end

local function billboard(b, x, y, z, rotY, text, color)
	local cf = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(rotY), 0)
	local p = b:Part(Vector3.new(16, 7, 0.6), cf, Color3.fromRGB(20, 20, 26), Enum.Material.SmoothPlastic)
	b:Part(Vector3.new(16.4, 0.3, 0.8), cf * CFrame.new(0, -3.6, 0), color, Enum.Material.Neon)
	local lbl = require(script.Parent.Parent.Builder).Label(p, Enum.NormalId.Front, text, color, { PixelsPerStud = 10 })
	lbl.Font = Enum.Font.GothamBlack
end

-- shop with a glass front facing `side`
local function shop(b, x0, z0, x1, z1, side, color, name, signColor)
	local sub = b:Building({
		name = "Shop",
		x0 = x0, z0 = z0, x1 = x1, z1 = z1, y = 0.5,
		floors = 1, floorH = 11, wall = 1,
		color = color, mat = Enum.Material.Brick,
		floorColor = Color3.fromRGB(190, 186, 176), floorMat = Enum.Material.Marble,
		doors = { { side = side, at = 0.5, w = 7, h = 8 }, { side = side == "N" and "S" or "N", at = 0.25, w = 5, h = 8 } },
		windows = { spacing = 8, w = 5, h = 4.5, b = 2.5, groundFloor = true },
		glass = true, roof = false, stairs = false,
	})
	-- shop sign
	local cx = (x0 + x1) / 2
	local zFace = side == "N" and z0 - 0.4 or z1 + 0.4
	local sign = sub:Box(cx - 7, 9, zFace - 0.3, cx + 7, 11, zFace + 0.3, Color3.fromRGB(20, 20, 24), Enum.Material.SmoothPlastic)
	local Builder = require(script.Parent.Parent.Builder)
	Builder.Label(sign, side == "N" and Enum.NormalId.Front or Enum.NormalId.Back, name, signColor, { PixelsPerStud = 12 })
	-- counters and shelves as cover
	sub:Box(cx - 6, 0.7, (z0 + z1) / 2 - 1, cx + 2, 4, (z0 + z1) / 2 + 1, Color3.fromRGB(80, 70, 60), Enum.Material.Wood)
	sub:Box(x1 - 4, 0.7, z0 + 3, x1 - 2, 7, z1 - 3, Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
	return sub
end

local function garage(b, s)
	-- two-level open parking deck with a ramp, mirrored by s
	local sub = b:Sub("Garage")
	local function X(x)
		return x * s
	end
	local function Z(z)
		return z * s
	end
	local x0, x1, z0, z1 = X(62), X(104), Z(-98), Z(-58)
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minZ, maxZ = math.min(z0, z1), math.max(z0, z1)
	local deckY = 11
	local concrete = Color3.fromRGB(140, 140, 138)
	-- deck with a hole for the ramp
	local rx0, rx1 = X(66), X(74)
	local rz0, rz1 = Z(-96), Z(-74)
	sub:Slab(minX, minZ, maxX, maxZ, deckY, 1.2, concrete, Enum.Material.Concrete, { { rx0, rz0, rx1, rz1 } })
	-- pillars
	for x = 78, 100, 11 do
		for _, z in ipairs({ -94, -78, -62 }) do
			sub:Box(X(x) - 0.8, 0, Z(z) - 0.8, X(x) + 0.8, deckY - 1.2, Z(z) + 0.8, concrete, Enum.Material.Concrete)
		end
	end
	-- ramp up to the deck
	local rx = (rx0 + rx1) / 2
	sub:Ramp(Vector3.new(rx, 0.2, rz1), Vector3.new(rx, deckY, rz0), 8, concrete, Enum.Material.Concrete)
	-- deck parapets with gaps
	sub:Box(minX, deckY, minZ, maxX, deckY + 3, minZ + 0.6, concrete, Enum.Material.Concrete)
	sub:Box(minX, deckY, maxZ - 0.6, minX + (maxX - minX) * 0.4, deckY + 3, maxZ, concrete, Enum.Material.Concrete)
	sub:Box(minX + (maxX - minX) * 0.6, deckY, maxZ - 0.6, maxX, deckY + 3, maxZ, concrete, Enum.Material.Concrete)
	local farX = s > 0 and maxX or minX
	sub:Box(farX - 0.3, deckY, minZ, farX + 0.3, deckY + 3, maxZ, concrete, Enum.Material.Concrete)
	-- ladder on the inner side as a second way up
	sub:Ladder(Vector3.new((s > 0 and minX or maxX) - 1.2 * s, 0, Z(-66)), deckY + 1, concrete)
	-- cars on both levels
	car(sub, X(84), Z(-88), 0, CAR_COLORS[1])
	car(sub, X(96), Z(-86), 6, CAR_COLORS[3])
	car(sub, X(92), Z(-66), 180, CAR_COLORS[4])
	car(sub, X(78), Z(-66), 180, CAR_COLORS[2])
	-- deck cars sit on the slab
	local deck = sub:Sub("DeckCars")
	for _, d in ipairs({ { 86, -90, 0 }, { 97, -84, 10 }, { 84, -64, 180 } }) do
		car(deck, X(d[1]), Z(d[2]), d[3], CAR_COLORS[(d[1] % 6) + 1])
	end
	for _, d in ipairs(deck.Folder:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = d.CFrame + Vector3.new(0, deckY, 0)
		end
	end
	for x = 80, 100, 10 do
		for _, z in ipairs({ -95, -61 }) do
			sub:Box(X(x) - 0.15, 0.02, Z(z) - 3, X(x) + 0.15, 0.06, Z(z) + 3, LINE, Enum.Material.SmoothPlastic, { CastShadow = false })
		end
	end
end

function ModernCity.Build(b)
	local B = MapKit.BOUNDS
	local Builder = require(script.Parent.Parent.Builder)

	-- ground: asphalt everywhere, sidewalks around blocks
	b:Box(B.x0 - 30, -2, B.z0 - 30, B.x1 + 30, 0, B.z1 + 30, ASPHALT, Enum.Material.Asphalt)
	local blocks = {
		{ -112, -100, -24, -56 }, { 24, -100, 112, -56 },
		{ -112, -36, -24, 36 }, { 24, -36, 112, 36 },
		{ -112, 56, -24, 100 }, { 24, 56, 112, 100 },
	}
	for _, bl in ipairs(blocks) do
		b:Box(bl[1], 0, bl[2], bl[3], 0.5, bl[4], SIDEWALK, Enum.Material.Concrete)
		b:Box(bl[1] - 0.3, 0, bl[2] - 0.3, bl[3] + 0.3, 0.55, bl[2] + 0.3, Color3.fromRGB(120, 120, 118), Enum.Material.Concrete)
	end
	-- road markings: avenue centre line, crosswalks
	for z = -110, 110, 10 do
		if math.abs(z) > 14 then
			b:Box(-0.25, 0, z - 2.5, 0.25, 0.04, z + 2.5, LINE, Enum.Material.SmoothPlastic, { CastShadow = false })
		end
	end
	for _, z in ipairs({ -52, 52 }) do
		for x = -20, 20, 3 do
			b:Box(x - 0.8, 0, z - 3, x + 0.8, 0.04, z + 3, Color3.fromRGB(240, 240, 240), Enum.Material.SmoothPlastic, { CastShadow = false })
		end
	end

	-- central fountain plaza (blocks the full-length avenue sight line)
	local plaza = b:Sub("Plaza")
	plaza:Column(Vector3.new(0, 0, 0), 0.6, 30, Color3.fromRGB(180, 178, 170), Enum.Material.Marble)
	plaza:Column(Vector3.new(0, 0.6, 0), 2.4, 18, Color3.fromRGB(200, 198, 190), Enum.Material.Marble)
	plaza:Column(Vector3.new(0, 0.8, 0), 2.4, 16.4, Color3.fromRGB(80, 140, 190), Enum.Material.Glass, { Transparency = 0.3, CanCollide = false, NoBullets = true })
	plaza:Column(Vector3.new(0, 3, 0), 7, 3, Color3.fromRGB(190, 188, 180), Enum.Material.Marble)
	plaza:Box(-2.5, 10, -2.5, 2.5, 12, 2.5, Color3.fromRGB(200, 170, 70), Enum.Material.Foil)
	plaza:Box(-1.2, 12, -1.2, 1.2, 17, 1.2, Color3.fromRGB(200, 170, 70), Enum.Material.Foil)
	for _, p in ipairs({ { -12, -10 }, { 12, 10 }, { 12, -10 }, { -12, 10 } }) do
		planterTree(plaza, p[1], p[2])
	end

	-- avenue cover
	for _, s in ipairs({ -1, 1 }) do
		car(b, -7 * s, -70 * s, 8 * s, CAR_COLORS[1 + (s > 0 and 0 or 3)])
		car(b, 8 * s, -30 * s, -5, CAR_COLORS[2 + (s > 0 and 0 or 3)])
		car(b, -6 * s, -96 * s, 90, CAR_COLORS[3])
		-- bus stop shelter
		local bx, bz = 19 * s, -78 * s
		b:Box(bx - 1, 0.5, bz - 7, bx + 1, 8, bz - 6.6, Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
		b:Box(bx - 1, 0.5, bz + 6.6, bx + 1, 8, bz + 7, Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
		b:Box(bx - 1.6, 8, bz - 7.4, bx + 1.6, 8.5, bz + 7.4, Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
		b:Box(bx + 0.8 * s - 0.15, 0.5, bz - 6.6, bx + 0.8 * s + 0.15, 7.5, bz + 6.6, GLASS, Enum.Material.Glass, { Transparency = 0.5 })
		bench(b, bx, bz, s > 0 and -90 or 90)
		-- jersey barriers
		for _, x in ipairs({ -10, 10 }) do
			b:Box(x * s - 4, 0, -112 * s - 0.8, x * s + 4, 3, -112 * s + 0.8, Color3.fromRGB(190, 190, 186), Enum.Material.Concrete)
		end
		-- lamps along the avenue
		for z = -100, -20, 26 do
			lamp(b, -21 * s, z * s, s > 0 and -90 or 90)
			lamp(b, 21 * s, (z + 13) * s, s > 0 and 90 or -90)
		end
		-- cross-street cover
		car(b, -60 * s, -46 * s, 90, CAR_COLORS[5])
		car(b, 70 * s, -44 * s, 92, CAR_COLORS[6])
		MapKit.Barrel(b, Vector3.new(-40 * s, 0, -42 * s), Color3.fromRGB(220, 110, 30))
		MapKit.Barrel(b, Vector3.new(-37 * s, 0, -43 * s), Color3.fromRGB(220, 110, 30))
		for i = 0, 3 do
			b:Part(Vector3.new(0.9, 1.6, 0.9), Vector3.new((30 + i * 3) * s, 0.8, -50 * s), Color3.fromRGB(255, 120, 20), Enum.Material.SmoothPlastic)
		end
	end

	-- buildings (point-symmetric pairs)
	local office = Color3.fromRGB(176, 182, 190)
	for _, s in ipairs({ -1, 1 }) do
		local function X(x)
			return x * s
		end
		local function Z(z)
			return z * s
		end
		local function rect(ax, az, bx, bz)
			return math.min(X(ax), X(bx)), math.min(Z(az), Z(bz)), math.max(X(ax), X(bx)), math.max(Z(az), Z(bz))
		end
		local nearSide = s > 0 and "S" or "N" -- the side facing the map centre
		local innerSide = s > 0 and "E" or "W" -- the side facing the avenue

		-- office (3 floors + roof) on the Red-near-left / Blue-near-right block
		local x0, z0, x1, z1 = rect(-104, -98, -64, -62)
		local _, roofY = b:Building({
			name = "Office", x0 = x0, z0 = z0, x1 = x1, z1 = z1, y = 0.5,
			floors = 3, floorH = 11, wall = 1,
			color = office, mat = Enum.Material.Concrete,
			floorColor = Color3.fromRGB(150, 150, 156), floorMat = Enum.Material.SmoothPlastic,
			trimColor = Color3.fromRGB(70, 74, 84),
			doors = { { side = nearSide, at = 0.5, w = 7, h = 8 }, { side = innerSide, at = 0.5, w = 6, h = 8 } },
			windows = { spacing = 8, w = 4.5, h = 4, b = 3.5 },
			glass = true, roof = true, stairSide = s < 0 and "W" or "E",
		})
		billboard(b, X(-84), roofY + 6, Z(-80), s < 0 and 0 or 180, "NOVA BANK", Color3.fromRGB(80, 200, 255))
		b:Box(X(-84) - 0.5, roofY, Z(-80) - 0.5, X(-84) + 0.5, roofY + 2.6, Z(-80) + 0.5, Color3.fromRGB(40, 40, 44), Enum.Material.Metal)

		-- corner shops
		local sx0, sz0, sx1, sz1 = rect(-58, -96, -28, -66)
		shop(b, sx0, sz0, sx1, sz1, nearSide, Color3.fromRGB(150, 70, 60), s < 0 and "QUICKMART" or "CAFE 24", Color3.fromRGB(255, 200, 80))

		-- the tower (4 floors) on the middle-left/right block
		local tx0, tz0, tx1, tz1 = rect(-82, -22, -42, 22)
		b:Building({
			name = "Tower", x0 = tx0, z0 = tz0, x1 = tx1, z1 = tz1, y = 0.5,
			floors = 4, floorH = 11, wall = 1,
			color = Color3.fromRGB(70, 82, 100), mat = Enum.Material.Glass,
			floorColor = Color3.fromRGB(120, 124, 132), floorMat = Enum.Material.SmoothPlastic,
			trimColor = Color3.fromRGB(40, 44, 54),
			doors = {
				{ side = innerSide, at = 0.5, w = 8, h = 9 },
				{ side = innerSide == "E" and "W" or "E", at = 0.5, w = 6, h = 8 },
				{ side = "N", at = 0.7, w = 5, h = 8 },
				{ side = "S", at = 0.3, w = 5, h = 8 },
			},
			windows = { spacing = 7, w = 4, h = 4, b = 3.5 },
			glass = true, roof = true,
		})
		-- alley behind the tower with dumpsters
		for _, z in ipairs({ -26, 6 }) do
			b:Box(X(-104) - 3, 0.5, Z(z) - 2, X(-104) + 3, 5, Z(z) + 2, Color3.fromRGB(40, 90, 60), Enum.Material.Metal)
		end
		b:Box(X(-96) - 0.5, 0.5, Z(-30), X(-96) + 0.5, 9, Z(-12), Color3.fromRGB(120, 60, 50), Enum.Material.Brick)

		-- shopping arcade (2 floors) on the middle-right/left block
		local ax0, az0, ax1, az1 = rect(42, -26, 100, 26)
		b:Building({
			name = "Arcade", x0 = ax0, z0 = az0, x1 = ax1, z1 = az1, y = 0.5,
			floors = 2, floorH = 12, wall = 1,
			color = Color3.fromRGB(205, 196, 180), mat = Enum.Material.Limestone,
			floorColor = Color3.fromRGB(200, 196, 188), floorMat = Enum.Material.Marble,
			trimColor = Color3.fromRGB(150, 120, 80),
			doors = {
				{ side = innerSide == "E" and "W" or "E", at = 0.5, w = 10, h = 10 },
				{ side = "N", at = 0.5, w = 8, h = 9 },
				{ side = "S", at = 0.5, w = 8, h = 9 },
			},
			windows = { spacing = 9, w = 5, h = 4, b = 3 },
			glass = true, roof = true, stairSide = s < 0 and "E" or "W",
		})
		-- arcade interior: kiosks splitting the hall
		for _, z in ipairs({ -12, 12 }) do
			b:Box(X(64) - 3, 0.7, Z(z) - 2, X(64) + 3, 4.5, Z(z) + 2, Color3.fromRGB(150, 110, 70), Enum.Material.Wood)
			b:Box(X(80) - 2, 0.7, Z(z) - 4, X(80) + 2, 6, Z(z) + 4, Color3.fromRGB(210, 210, 214), Enum.Material.Metal)
		end
		billboard(b, X(71), 32, Z(0), s < 0 and 90 or -90, "PIXEL PLAZA", Color3.fromRGB(255, 90, 180))
		b:Box(X(71) - 0.5, 25.5, Z(0) - 0.5, X(71) + 0.5, 28.6, Z(0) + 0.5, Color3.fromRGB(40, 40, 44), Enum.Material.Metal)

		-- parking garage (opposite corner of the same half)
		garage(b, -s)
		-- small kiosk + newsstand near the garage
		shop(b, math.min(X(-58), X(-30)), math.min(Z(62), Z(92)), math.max(X(-58), X(-30)), math.max(Z(62), Z(92)), s > 0 and "N" or "S", Color3.fromRGB(70, 90, 140), s < 0 and "BYTE SHOP" or "BURGER LAB", Color3.fromRGB(120, 230, 255))
		-- parked cars in the lot between garage and centre
		for i, x in ipairs({ 40, 56, 72, 88 }) do
			car(b, X(x), Z(46), 90 + (i % 2) * 180, CAR_COLORS[(i % #CAR_COLORS) + 1])
		end
	end

	-- spawns
	local redSpawns, redZone = MapKit.SpawnBase(b, "Red", { floorColor = Color3.fromRGB(150, 150, 146), wallColor = Color3.fromRGB(110, 112, 118) })
	local blueSpawns, blueZone = MapKit.SpawnBase(b, "Blue", { floorColor = Color3.fromRGB(150, 150, 146), wallColor = Color3.fromRGB(110, 112, 118) })

	-- skyline backdrop outside the play area
	local rng = Random.new(42)
	local skyline = b:Sub("Skyline")
	for i = 1, 26 do
		local side = i % 2 == 0 and 1 or -1
		local x = side * rng:NextNumber(135, 175)
		local z = rng:NextNumber(-160, 160)
		local h = rng:NextNumber(40, 120)
		local w = rng:NextNumber(16, 30)
		skyline:Box(x - w / 2, 0, z - w / 2, x + w / 2, h, z + w / 2, Color3.fromRGB(60 + rng:NextInteger(0, 40), 66 + rng:NextInteger(0, 40), 80 + rng:NextInteger(0, 40)), Enum.Material.Glass, { CanQuery = false })
	end
	for i = 1, 16 do
		local side = i % 2 == 0 and 1 or -1
		local z = side * rng:NextNumber(150, 175)
		local x = rng:NextNumber(-120, 120)
		local h = rng:NextNumber(30, 90)
		skyline:Box(x - 10, 0, z - 10, x + 10, h, z + 10, Color3.fromRGB(80, 86, 96), Enum.Material.Concrete, { CanQuery = false })
	end
	local _ = Builder

	b:Boundary(B.x0, B.z0, B.x1, B.z1, -2, 120)
	return {
		Spawns = { Red = redSpawns, Blue = blueSpawns },
		SpawnZones = { Red = redZone, Blue = blueZone },
		Podium = MapKit.PODIUM,
		KillY = -30,
	}
end

function ModernCity.BuildPreview(b)
	b:Box(-3, 0, -3, 3, 0.3, 3, Color3.fromRGB(46, 47, 52), Enum.Material.Asphalt)
	local rng = Random.new(3)
	for _, p in ipairs({ { -2, -2 }, { 2, -2 }, { -2, 0 }, { 2, 0 }, { -2, 2 }, { 2, 2 } }) do
		local h = rng:NextNumber(0.8, 3)
		b:Box(p[1] - 0.8, 0.3, p[2] - 0.7, p[1] + 0.8, 0.3 + h, p[2] + 0.7, Color3.fromRGB(80 + rng:NextInteger(0, 60), 100, 130), Enum.Material.Glass)
	end
	b:Box(-0.1, 0.3, -3, 0.1, 0.32, 3, Color3.fromRGB(230, 220, 180), Enum.Material.Neon)
	b:Column(Vector3.new(0, 0.3, 0), 0.3, 1, Color3.fromRGB(200, 198, 190), Enum.Material.Marble)
end

return ModernCity
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">PodiumBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	PodiumBuilder
	Builds the results stage (gold / silver / bronze) for a match and puts the top-3 players'
	avatars on it with emotes, a crown and confetti for the winner.

	Stage space: avatars face -Z, the results camera looks at the stage from -Z.
	2nd place is on the viewer's left (+X), 3rd on the viewer's right (-X).
]]

local Players = game:GetService("Players")

local Builder = require(script.Parent.Builder)

local PodiumBuilder = {}
PodiumBuilder.__index = PodiumBuilder

local GOLD = Color3.fromRGB(255, 196, 46)
local SILVER = Color3.fromRGB(200, 208, 220)
local BRONZE = Color3.fromRGB(205, 127, 50)

PodiumBuilder.Slots = {
	{ Place = 1, X = 0, Height = 7, Color = GOLD },
	{ Place = 2, X = 11, Height = 4.8, Color = SILVER },
	{ Place = 3, X = -11, Height = 3.2, Color = BRONZE },
}

-- R15 / R6 emotes from Roblox's default Animate script.
local EMOTES = {
	R15 = { "rbxassetid://507770677", "rbxassetid://507770239", "rbxassetid://507771019" }, -- cheer, wave, dance
	R6 = { "rbxassetid://129423030", "rbxassetid://128777973", "rbxassetid://182435998" },
}

function PodiumBuilder.new(parent: Instance, cf: CFrame)
	local self = setmetatable({}, PodiumBuilder)
	local model = Instance.new("Model")
	model.Name = "Podium"
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent
	self.Model = model
	self.CFrame = cf
	self.Avatars = {}
	self.Effects = {}

	local b = Builder.new(model, cf)
	-- stage
	b:Box(-34, -2, -18, 34, 0, 16, Color3.fromRGB(22, 24, 30), Enum.Material.SmoothPlastic)
	b:Box(-34, 0, -18, 34, 0.15, -17.4, Color3.fromRGB(255, 140, 40), Enum.Material.Neon)
	-- backdrop
	local back = b:Box(-34, 0, 14, 34, 30, 16, Color3.fromRGB(16, 18, 24), Enum.Material.SmoothPlastic)
	-- Front (-Z) is the face toward the results camera
	local title = Builder.Label(back, Enum.NormalId.Front, "MATCH RESULTS", Color3.fromRGB(255, 255, 255), { PixelsPerStud = 8 })
	title.Size = UDim2.fromScale(1, 0.18)
	title.Position = UDim2.fromScale(0, 0.06)
	for i = -3, 3 do
		b:Box(i * 10 - 0.3, 0, 13.6, i * 10 + 0.3, 30, 14, Color3.fromRGB(255, 140, 40), Enum.Material.Neon, { CastShadow = false })
	end

	-- blocks
	for _, slot in ipairs(PodiumBuilder.Slots) do
		local block = b:Box(slot.X - 5, 0, -5, slot.X + 5, slot.Height, 5, slot.Color, Enum.Material.Foil, { Reflectance = 0.2 })
		block.Name = "Place" .. slot.Place
		local front = b:Box(slot.X - 5.05, 0, -5.05, slot.X + 5.05, slot.Height, -5, slot.Color, Enum.Material.Neon, { Transparency = 0.85, CastShadow = false })
		Builder.Label(front, Enum.NormalId.Front, tostring(slot.Place), Color3.fromRGB(20, 20, 24), { PixelsPerStud = 10 })
		local trim = b:Box(slot.X - 5.2, slot.Height - 0.2, -5.2, slot.X + 5.2, slot.Height + 0.1, 5.2, Color3.fromRGB(255, 255, 255), Enum.Material.Neon, { CastShadow = false })
		trim.Transparency = 0.4
	end

	-- lights
	b:Light(Vector3.new(0, 22, -12), GOLD, 40, 3, true)
	b:Light(Vector3.new(14, 18, -12), Color3.fromRGB(180, 200, 255), 30, 1.5)
	b:Light(Vector3.new(-14, 18, -12), Color3.fromRGB(255, 180, 120), 30, 1.5)

	-- confetti emitters (enabled during the show)
	for _, x in ipairs({ -20, 0, 20 }) do
		local p = b:Part(Vector3.new(1, 1, 1), Vector3.new(x, 26, -2), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false })
		local e = Instance.new("ParticleEmitter")
		e.Enabled = false
		e.Rate = 60
		e.Lifetime = NumberRange.new(3, 5)
		e.Speed = NumberRange.new(4, 10)
		e.SpreadAngle = Vector2.new(70, 70)
		e.Acceleration = Vector3.new(0, -6, 0)
		e.Drag = 1
		e.RotSpeed = NumberRange.new(-200, 200)
		e.Rotation = NumberRange.new(0, 360)
		e.Size = NumberSequence.new(0.35)
		e.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 200, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 255, 120)),
		})
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Parent = p
		table.insert(self.Effects, e)
	end
	return self
end

local function stripModel(model: Model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ForceField") or d.Name == "EquippedWeapon" then
			d:Destroy()
		elseif d:IsA("BallSocketConstraint") or (d:IsA("Attachment") and (d.Name == "RagA0" or d.Name == "RagA1")) then
			d:Destroy()
		elseif d:IsA("Motor6D") then
			d.Enabled = true
		end
	end
end

local function createAvatar(entry): Model?
	local model
	if entry.UserId and entry.UserId > 0 then
		local ok, result = pcall(function()
			return Players:CreateHumanoidModelFromUserId(entry.UserId)
		end)
		if ok then
			model = result
		end
	end
	if not model then
		local player = Players:GetPlayerByUserId(entry.UserId)
		local humanoid = player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local desc
		if humanoid then
			pcall(function()
				desc = humanoid:GetAppliedDescription()
			end)
		end
		local ok, result = pcall(function()
			return Players:CreateHumanoidModelFromDescription(desc or Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
		end)
		if ok then
			model = result
		end
	end
	if model then
		stripModel(model)
	end
	return model
end

-- entries: { {Place, UserId, DisplayName, Kills}, ... } (up to 3)
function PodiumBuilder:Show(entries)
	self:Clear()
	for _, entry in ipairs(entries) do
		local slot = PodiumBuilder.Slots[entry.Place]
		if slot then
			task.spawn(function()
				local avatar = createAvatar(entry)
				if not avatar or not self.Model.Parent then
					return
				end
				avatar.Name = "Avatar" .. entry.Place
				local humanoid = avatar:FindFirstChildOfClass("Humanoid")
				local root = avatar:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not humanoid or not root then
					avatar:Destroy()
					return
				end
				humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
				root.Anchored = true
				local standY = slot.Height + humanoid.HipHeight + root.Size.Y / 2
				-- face the camera (-Z in stage space)
				local cf = self.CFrame * CFrame.new(slot.X, standY, 0) * CFrame.Angles(0, 0, 0)
				avatar:PivotTo(cf)
				avatar.Parent = self.Model
				table.insert(self.Avatars, avatar)

				-- name tag
				local head = avatar:FindFirstChild("Head")
				if head then
					local bb = Instance.new("BillboardGui")
					bb.Size = UDim2.fromOffset(220, 64)
					bb.StudsOffset = Vector3.new(0, 3.2, 0)
					bb.AlwaysOnTop = true
					bb.LightInfluence = 0
					bb.Parent = head
					local name = Instance.new("TextLabel")
					name.BackgroundTransparency = 1
					name.Size = UDim2.new(1, 0, 0.55, 0)
					name.Font = Enum.Font.GothamBlack
					name.TextScaled = true
					name.TextColor3 = slot.Color
					name.TextStrokeTransparency = 0.4
					name.Text = entry.DisplayName
					name.Parent = bb
					local kills = Instance.new("TextLabel")
					kills.BackgroundTransparency = 1
					kills.Position = UDim2.fromScale(0, 0.55)
					kills.Size = UDim2.new(1, 0, 0.45, 0)
					kills.Font = Enum.Font.GothamBold
					kills.TextScaled = true
					kills.TextColor3 = Color3.new(1, 1, 1)
					kills.TextStrokeTransparency = 0.5
					kills.Text = string.format("#%d  -  %d KILLS", entry.Place, entry.Kills)
					kills.Parent = bb
				end

				-- winner extras
				if entry.Place == 1 then
					local hl = Instance.new("Highlight")
					hl.FillTransparency = 0.85
					hl.FillColor = slot.Color
					hl.OutlineColor = slot.Color
					hl.DepthMode = Enum.HighlightDepthMode.Occluded
					hl.Parent = avatar
					if head and head:IsA("BasePart") then
						local crown = Instance.new("Part")
						crown.Name = "Crown"
						crown.Shape = Enum.PartType.Cylinder
						crown.Size = Vector3.new(0.6, 1.5, 1.5)
						crown.Color = slot.Color
						crown.Material = Enum.Material.Neon
						crown.CanCollide = false
						crown.CanQuery = false
						crown.Massless = true
						crown.CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.45, 0) * CFrame.Angles(0, 0, math.pi / 2)
						local w = Instance.new("WeldConstraint")
						w.Part0 = head
						w.Part1 = crown
						w.Parent = crown
						crown.Parent = avatar
						local sparkle = Instance.new("Sparkles")
						sparkle.SparkleColor = slot.Color
						sparkle.Parent = crown
					end
				end

				-- emote (falls back to a celebratory hop if the animation can't load)
				local rig = humanoid.RigType == Enum.HumanoidRigType.R15 and "R15" or "R6"
				local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
				local played = false
				pcall(function()
					local anim = Instance.new("Animation")
					anim.AnimationId = EMOTES[rig][entry.Place]
					local track = animator:LoadAnimation(anim)
					track.Looped = true
					track:Play(0.3)
					played = true
				end)
				task.spawn(function()
					local t0 = os.clock()
					while avatar.Parent do
						local t = os.clock() - t0
						local hop = played and 0 or math.max(0, math.sin(t * 5)) * 0.8
						local turn = entry.Place == 1 and math.sin(t * 1.2) * 0.35 or math.sin(t * 0.8 + entry.Place) * 0.12
						root.CFrame = cf * CFrame.new(0, hop, 0) * CFrame.Angles(0, turn, 0)
						task.wait(1 / 20)
					end
				end)
			end)
		end
	end
	for _, e in ipairs(self.Effects) do
		e.Enabled = true
	end
	task.delay(6, function()
		for _, e in ipairs(self.Effects) do
			e.Enabled = false
		end
	end)
end

function PodiumBuilder:Clear()
	for _, a in ipairs(self.Avatars) do
		a:Destroy()
	end
	self.Avatars = {}
	for _, e in ipairs(self.Effects) do
		e.Enabled = false
	end
end

function PodiumBuilder:Destroy()
	self:Clear()
	self.Model:Destroy()
end

return PodiumBuilder
]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX0000001B"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	Main (server bootstrap)
	Decides what this server is and wires the services together.

	Roles:
	  Lobby server  - builds the hub, runs map queues, hosts Local matches (Studio / small games)
	  Match server  - a reserved server created by a lobby (Teleport mode): runs one match
]]

local Players = game:GetService("Players")
-- Before anything else: never let Roblox drop a default character into the empty world
-- while the lobby is still being built (we spawn characters ourselves).
Players.CharacterAutoLoads = false
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net) -- creates the remotes
local MapData = require(ReplicatedStorage.Shared.MapData)

local Services = script.Parent.Services
local PlayerDataManager = require(Services.PlayerDataManager)
local SpawnManager = require(Services.SpawnManager)
local WeaponServer = require(Services.WeaponServer)
local CombatServer = require(Services.CombatServer)
local MatchManager = require(Services.MatchManager)
local SkinShopServer = require(Services.SkinShopServer)
local LobbyService = require(Services.LobbyService)
local MatchRegistry = require(Services.MatchRegistry)

-- MODE / ROLE ------------------------------------------------------------------------
local mode = Config.Matchmaking.Mode
if mode == "Auto" then
	mode = (RunService:IsStudio() or game.PlaceId == 0) and "Local" or "Teleport"
end
local isReserved = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
local isMatchPlace = Config.Matchmaking.MatchPlaceId ~= nil and game.PlaceId == Config.Matchmaking.MatchPlaceId
local role = (mode == "Teleport" and (isReserved or isMatchPlace)) and "Match" or "Lobby"
workspace:SetAttribute("ServerRole", role)
workspace:SetAttribute("MatchmakingMode", mode)
print(string.format("[Main] mode=%s role=%s", mode, role))

-- global lighting baseline (each client applies map-specific lighting locally;
-- Lighting.Technology is set in the place file because scripts cannot change it)
Lighting.GlobalShadows = true
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.6

do
	local effects = Instance.new("Folder")
	effects.Name = "Effects"
	effects.Parent = workspace
end

-- INIT ---------------------------------------------------------------------------------
PlayerDataManager.Init()
SpawnManager.Init()
WeaponServer.Init()
CombatServer.Init()
MatchManager.Init()
SkinShopServer.Init()

CombatServer.GetMatchOf = MatchManager.GetMatchOf
SkinShopServer.IsInLobby = function(player)
	return role == "Lobby" and MatchManager.GetMatchOf(player) == nil
end

SpawnManager.ResolveSpawn = function(player)
	local m = MatchManager.GetMatchOf(player)
	if m and (m.State == "Warmup" or m.State == "Live") then
		return m:GetSpawnCFrame(player), "Match"
	end
	if role == "Lobby" then
		return LobbyService.GetSpawnCFrame(), "Lobby"
	end
	return CFrame.new(0, 80, 0), "Lobby"
end

SpawnManager.OnSpawned(function(player, _character, context)
	if context == "Match" then
		WeaponServer.Arm(player)
	else
		WeaponServer.Disarm(player)
	end
end)

SpawnManager.OnDied(function(player)
	local m = MatchManager.GetMatchOf(player)
	if m then
		m:OnDeath(player)
	elseif role == "Lobby" then
		SpawnManager.ScheduleRespawn(player, 2)
	end
end)

-- lobby kill plane (local-mode lobby has walls, but guard against glitches)
task.spawn(function()
	while true do
		task.wait(1)
		for _, p in ipairs(Players:GetPlayers()) do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 and not MatchManager.GetMatchOf(p) and root.Position.Y < -80 then
				hum.Health = 0
			end
		end
	end
end)

if role == "Lobby" then
	LobbyService.Init(mode)
	MatchManager.ReturnToLobby = LobbyService.SendToLobby

	local function onJoin(player)
		-- spawn immediately; queues and the skin shop wait for the profile on their own
		Net.Event("MatchState"):FireClient(player, { State = "Lobby" })
		SpawnManager.Spawn(player)
	end
	Players.PlayerAdded:Connect(function(p)
		task.spawn(onJoin, p)
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onJoin, p)
	end
else
	-- MATCH SERVER ---------------------------------------------------------------------
	local match = nil
	local accessCode = nil
	local lobbyPlace = Config.Matchmaking.LobbyPlaceId or game.PlaceId

	local function ensureMatch(mapId)
		if not match or match.Closed then
			match = MatchManager.Create(mapId, CFrame.new())
		end
		return match
	end

	local function sendToLobby(player: Player)
		if not player.Parent then
			return
		end
		Net.Event("Notify"):FireClient(player, "Returning to the lobby...", "info")
		PlayerDataManager.SaveAndRelease(player)
		local ok, err = pcall(function()
			TeleportService:TeleportAsync(lobbyPlace, { player })
		end)
		if not ok then
			warn("[Main] return-to-lobby teleport failed: " .. tostring(err))
			PlayerDataManager.Reacquire(player)
			Net.Event("Notify"):FireClient(player, "Could not reach the lobby, keeping you in this match.", "error")
			if match and not match.Closed then
				match:AddPlayer(player)
			end
		end
	end
	MatchManager.ReturnToLobby = sendToLobby

	TeleportService.TeleportInitFailed:Connect(function(player)
		PlayerDataManager.Reacquire(player)
		if match and not match.Closed and player.Parent then
			match:AddPlayer(player)
		end
	end)

	local function onJoin(player: Player)
		local data = PlayerDataManager.WaitForData(player, 45)
		if not data or not player.Parent then
			return
		end
		local joinData = player:GetJoinData()
		local td = joinData and joinData.TeleportData
		local mapId = (type(td) == "table" and MapData.IsValid(td.MapId)) and td.MapId or (match and match.MapId) or MapData.Order[1]
		if type(td) == "table" and type(td.Code) == "string" then
			accessCode = accessCode or td.Code
		end
		local m = ensureMatch(mapId)
		if not m:HasRoom(1) then
			Net.Event("Notify"):FireClient(player, "That match just filled up - sending you back to the lobby.", "error")
			sendToLobby(player)
			return
		end
		m:AddPlayer(player)
	end
	Players.PlayerAdded:Connect(function(p)
		task.spawn(onJoin, p)
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onJoin, p)
	end

	MatchManager.OnMatchClosed = function()
		MatchRegistry.Remove(game.PrivateServerId)
	end

	-- publish this server so lobbies can fill free slots
	task.spawn(function()
		while true do
			if match and not match.Closed and accessCode then
				MatchRegistry.Publish(game.PrivateServerId, {
					MapId = match.MapId,
					Code = accessCode,
					Count = match:Count(),
					Max = Config.Match.MaxPlayers,
					Joinable = match:HasRoom(1),
				})
			end
			task.wait(Config.Matchmaking.RegistryHeartbeat)
		end
	end)

	game:BindToClose(function()
		MatchRegistry.Remove(game.PrivateServerId)
	end)
end
]]></ProtectedString><token name="RunContext">0</token></Properties></Item><Item class="Folder" referent="RBX0000001C"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">CombatServer</string><ProtectedString name="Source"><![CDATA[--[[
	CombatServer
	Validates every shot and knife attack, applies damage and credits kills.

	Shot validation (client sends: slot, origin, direction, claimed hit part, hit position):
	  1. WeaponServer.TryConsumeShot: alive, armed, right slot, ammo, fire rate, reload, draw time.
	  2. Origin must be near the shooter's head on the server.
	  3. Direction must be a unit vector and point at the claimed hit position.
	  4. Target must be an enemy in the same match, alive and not spawn protected.
	  5. Claimed hit must be close to where the server sees that body part (lag tolerance).
	  6. No map geometry may block the line from origin to the hit position.
	  7. Damage is computed here from WeaponData (never sent by the client).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Util = require(ReplicatedStorage.Shared.Util)
local WeaponData = require(ReplicatedStorage.WeaponModules.WeaponData)
local WeaponServer = require(script.Parent.WeaponServer)
local SpawnManager = require(script.Parent.SpawnManager)
local RateLimiter = require(script.Parent.RateLimiter)

local CombatServer = {}

-- Hooks wired by MatchManager
CombatServer.GetMatchOf = function(_player: Player): any
	return nil
end

local HEAD_PARTS = { Head = true }
local LIMB_PARTS = {
	LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
	RightUpperArm = true, RightLowerArm = true, RightHand = true,
	LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
	RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
	["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true,
}

local MAX_ORIGIN_OFFSET = 9 -- studs between claimed origin and server head (movement + latency)
local MAX_HIT_OFFSET = 7 -- studs between claimed hit and server body-part position
local MAX_ANGLE = math.rad(6)

local lastAttacker: { [Humanoid]: { player: Player, weapon: string, headshot: boolean, time: number } } = {}

local function aliveHumanoid(character: Model?): Humanoid?
	local h = character and character:FindFirstChildOfClass("Humanoid")
	if h and h.Health > 0 then
		return h
	end
	return nil
end

local function headOf(character: Model): BasePart?
	local head = character:FindFirstChild("Head")
	return head and head:IsA("BasePart") and head or nil
end

local function worldParams(extraIgnore: { Instance })
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { workspace:FindFirstChild("Effects") }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	for _, i in ipairs(extraIgnore) do
		table.insert(ignore, i)
	end
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	return params
end

local function matchPlayers(match): { Player }
	local list = {}
	for p in pairs(match.Players) do
		table.insert(list, p)
	end
	return list
end

-- Applies damage from attacker to victim. Returns (damageDealt, killed).
function CombatServer.ApplyDamage(attacker: Player, victim: Player, amount: number, weaponId: string, headshot: boolean, fromPos: Vector3)
	local match = CombatServer.GetMatchOf(attacker)
	if not match or match ~= CombatServer.GetMatchOf(victim) or match.State ~= "Live" then
		return 0, false
	end
	if attacker == victim then
		return 0, false
	end
	local aStat, vStat = match.Players[attacker], match.Players[victim]
	if not aStat or not vStat or aStat.Team == vStat.Team then
		return 0, false -- no friendly fire
	end
	if SpawnManager.IsProtected(victim) then
		return 0, false
	end
	local humanoid = aliveHumanoid(victim.Character)
	if not humanoid then
		return 0, false
	end
	amount = math.max(1, math.floor(amount + 0.5))
	local before = humanoid.Health
	lastAttacker[humanoid] = { player = attacker, weapon = weaponId, headshot = headshot, time = os.clock() }
	humanoid:TakeDamage(amount)
	local killed = before > 0 and humanoid.Health <= 0
	Net.Event("Damaged"):FireClient(victim, fromPos, amount)
	if killed then
		match:OnKill(attacker, victim, weaponId, headshot)
		Net.FireList("KillFeed", matchPlayers(match), {
			Killer = attacker.DisplayName,
			KillerTeam = aStat.Team,
			Victim = victim.DisplayName,
			VictimTeam = vStat.Team,
			Weapon = WeaponData.Get(weaponId) and WeaponData.Get(weaponId).Name or weaponId,
			Headshot = headshot,
		})
		Net.Event("Died"):FireClient(victim, {
			Killer = attacker.DisplayName,
			KillerUserId = attacker.UserId,
			Weapon = WeaponData.Get(weaponId) and WeaponData.Get(weaponId).Name or weaponId,
			Headshot = headshot,
		})
	end
	return before - math.max(humanoid.Health, 0), killed
end

local function onFire(player: Player, payload)
	if type(payload) ~= "table" or not RateLimiter.Check(player, "Fire", 25, 30) then
		return
	end
	local slot, origin, dir, hitPart, hitPos = payload.Slot, payload.Origin, payload.Direction, payload.Hit, payload.Position
	if type(slot) ~= "string" or not Util.IsValidVector3(origin) or not Util.IsValidVector3(dir) then
		return
	end
	if math.abs(dir.Magnitude - 1) > 0.02 then
		return
	end
	local match = CombatServer.GetMatchOf(player)
	if not match or match.State ~= "Live" then
		return
	end
	local character = player.Character
	if not aliveHumanoid(character) then
		return
	end
	local head = headOf(character)
	if not head or (head.Position - origin).Magnitude > MAX_ORIGIN_OFFSET then
		return
	end

	local ok, weapon = WeaponServer.TryConsumeShot(player, slot)
	if not ok then
		return
	end

	-- default visual end point: server raycast along the direction
	local params = worldParams({})
	local worldHit = workspace:Raycast(origin, dir * weapon.Range, params)
	local endPos = worldHit and worldHit.Position or (origin + dir * weapon.Range)

	local dealt, killed, headshot = 0, false, false
	if typeof(hitPart) == "Instance" and hitPart:IsA("BasePart") and Util.IsValidVector3(hitPos) then
		local victimChar = Util.GetCharacterFromPart(hitPart)
		local victim = victimChar and Players:GetPlayerFromCharacter(victimChar)
		if victim and victim ~= player and aliveHumanoid(victimChar) then
			local toHit = hitPos - origin
			local dist = toHit.Magnitude
			local angleOk = dist > 0.1 and dir:Angle(toHit.Unit) <= MAX_ANGLE
			local nearPart = (hitPart.Position - hitPos).Magnitude <= (hitPart.Size.Magnitude / 2 + MAX_HIT_OFFSET)
			local inRange = dist <= weapon.Range
			local blocked = false
			if angleOk and nearPart and inRange then
				local los = workspace:Raycast(origin, toHit.Unit * math.max(0, dist - 1.5), params)
				blocked = los ~= nil
			end
			if angleOk and nearPart and inRange and not blocked then
				headshot = HEAD_PARTS[hitPart.Name] == true
				local mult = headshot and weapon.HeadMultiplier or (LIMB_PARTS[hitPart.Name] and weapon.LimbMultiplier or 1)
				local damage = weapon.Damage * mult * (weapon.RangeModifier ^ (dist / 100))
				dealt, killed = CombatServer.ApplyDamage(player, victim, damage, weapon.Id, headshot, origin)
				endPos = hitPos
			end
		end
	end

	if dealt > 0 then
		Net.Event("HitConfirm"):FireClient(player, { Damage = dealt, Headshot = headshot, Killed = killed })
	end

	-- broadcast the shot to the other players of this match for tracers / sound
	local others = {}
	for p in pairs(match.Players) do
		if p ~= player then
			table.insert(others, p)
		end
	end
	Net.FireList("ShotFx", others, player, weapon.Id, origin, endPos, dealt > 0)
end

local function onMelee(player: Player, heavy, look)
	if type(heavy) ~= "boolean" or not Util.IsValidVector3(look) or not RateLimiter.Check(player, "Melee", 6, 6) then
		return
	end
	if look.Magnitude < 0.5 then
		return
	end
	look = look.Unit
	local match = CombatServer.GetMatchOf(player)
	if not match or match.State ~= "Live" then
		return
	end
	local character = player.Character
	if not aliveHumanoid(character) then
		return
	end
	local ok, knife = WeaponServer.TryMelee(player, heavy)
	if not ok then
		return
	end
	local attack = heavy and knife.Stab or knife.Slash
	local head = headOf(character)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not head or not root then
		return
	end
	local origin = head.Position
	local best, bestDist, bestPart = nil, attack.Range + 1.5, nil
	for p in pairs(match.Players) do
		if p ~= player and match.Players[p].Team ~= match.Players[player].Team then
			local vc = p.Character
			local vRoot = vc and vc:FindFirstChild("HumanoidRootPart") :: BasePart?
			if vRoot and aliveHumanoid(vc) then
				local to = vRoot.Position - origin
				local d = to.Magnitude
				if d < bestDist and to.Unit:Dot(look) > 0.35 then
					best, bestDist, bestPart = p, d, vRoot
				end
			end
		end
	end
	if not best or not bestPart then
		return
	end
	local params = worldParams({})
	local los = workspace:Raycast(origin, (bestPart.Position - origin), params)
	if los then
		return
	end
	local damage = attack.Damage
	local victimRoot = bestPart
	local backstab = heavy and victimRoot.CFrame.LookVector:Dot(root.CFrame.LookVector) > 0.5
	if backstab then
		damage = knife.Stab.BackstabDamage
	end
	local dealt, killed = CombatServer.ApplyDamage(player, best, damage, "Knife", false, origin)
	if dealt > 0 then
		Net.Event("HitConfirm"):FireClient(player, { Damage = dealt, Headshot = false, Killed = killed, Melee = true })
	end
end

function CombatServer.GetLastAttacker(humanoid: Humanoid)
	local info = lastAttacker[humanoid]
	lastAttacker[humanoid] = nil
	return info
end

function CombatServer.Init()
	Net.Event("Fire").OnServerEvent:Connect(onFire)
	Net.Event("Melee").OnServerEvent:Connect(onMelee)
	-- clear stale references
	task.spawn(function()
		while true do
			task.wait(30)
			local t = os.clock()
			for h, info in pairs(lastAttacker) do
				if not h.Parent or t - info.time > 30 then
					lastAttacker[h] = nil
				end
			end
		end
	end)
end

return CombatServer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">LobbyService</string><ProtectedString name="Source"><![CDATA[--[[
	LobbyService
	Map queues. Standing on a pad queues you for that map (one queue at a time); stepping
	off removes you. When a queue's countdown ends the group is sent to a match:
	  Local mode    -> a match running in this server (built on demand, reused while it has room)
	  Teleport mode -> an open reserved server for that map (via MatchRegistry) or a new one
]]

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Util = require(ReplicatedStorage.Shared.Util)
local MapData = require(ReplicatedStorage.Shared.MapData)
local LobbyBuilder = require(script.Parent.Parent.Builders.LobbyBuilder)
local MatchManager = require(script.Parent.MatchManager)
local MatchRegistry = require(script.Parent.MatchRegistry)
local SpawnManager = require(script.Parent.SpawnManager)
local PlayerDataManager = require(script.Parent.PlayerDataManager)

local LobbyService = {}
LobbyService.Mode = "Local"

local lobby
local queues: { [string]: { Players: { Player }, EndsAt: number? } } = {}
local playerQueue: { [Player]: string } = {}
local teleporting: { [Player]: boolean } = {}

function LobbyService.GetSpawnCFrame(): CFrame
	return lobby and lobby.SpawnCFrame or CFrame.new(0, 5, 0)
end

function LobbyService.GetZone(mapId: string)
	return lobby and lobby.Zones[mapId]
end

local function leaveQueue(player: Player)
	local mapId = playerQueue[player]
	if not mapId then
		return
	end
	playerQueue[player] = nil
	local q = queues[mapId]
	local i = table.find(q.Players, player)
	if i then
		table.remove(q.Players, i)
	end
	if #q.Players == 0 then
		q.EndsAt = nil
	end
	player:SetAttribute("QueuedMap", nil)
end

local function joinQueue(player: Player, mapId: string)
	if playerQueue[player] == mapId then
		return
	end
	leaveQueue(player)
	local q = queues[mapId]
	if #q.Players >= Config.Match.MaxPlayers then
		return
	end
	table.insert(q.Players, player)
	playerQueue[player] = mapId
	if not q.EndsAt then
		q.EndsAt = workspace:GetServerTimeNow() + Config.Lobby.QueueCountdown
	end
	player:SetAttribute("QueuedMap", mapId)
end

local function broadcastLobbyState()
	local state = {}
	for mapId, q in pairs(queues) do
		state[mapId] = {
			Waiting = #q.Players,
			EndsAt = q.EndsAt,
			InMatch = LobbyService.Mode == "Local" and MatchManager.CountForMap(mapId) or nil,
		}
	end
	Net.Event("LobbyState"):FireAllClients(state)
end

local function updateSigns()
	local now = workspace:GetServerTimeNow()
	for mapId, zone in pairs(lobby.Zones) do
		local q = queues[mapId]
		local waiting = #q.Players
		local inMatch = LobbyService.Mode == "Local" and MatchManager.CountForMap(mapId) or 0
		zone.Count.Text = string.format("WAITING: %d / %d%s", waiting, Config.Match.MaxPlayers, inMatch > 0 and ("   |   IN MATCH: " .. inMatch) or "")
		if q.EndsAt and waiting > 0 then
			if waiting < Config.Lobby.MinPlayersToLaunch then
				zone.Status.Text = string.format("Need %d more player(s)", Config.Lobby.MinPlayersToLaunch - waiting)
			else
				zone.Status.Text = string.format("LAUNCHING IN %d", math.max(0, math.ceil(q.EndsAt - now)))
			end
		else
			zone.Status.Text = "Step onto the pad to queue"
		end
	end
end

-- TELEPORT ---------------------------------------------------------------------------

local function teleportGroup(mapId: string, group: { Player })
	local placeId = Config.Matchmaking.MatchPlaceId or game.PlaceId
	for _, p in ipairs(group) do
		teleporting[p] = true
		leaveQueue(p)
		Net.Event("Notify"):FireClient(p, "Finding a " .. MapData.Get(mapId).Name .. " server...", "info")
	end
	local code = MatchRegistry.FindOpen(mapId, #group)
	if not code then
		local ok, result = pcall(function()
			return TeleportService:ReserveServer(placeId)
		end)
		if ok then
			code = result
		else
			warn("[Lobby] ReserveServer failed, falling back to a local match: " .. tostring(result))
		end
	end
	if not code then
		for _, p in ipairs(group) do
			teleporting[p] = nil
		end
		LobbyService.LaunchLocal(mapId, group)
		return
	end
	-- release the data lock first so the match server can load the profile immediately
	local ready = {}
	for _, p in ipairs(group) do
		if p.Parent then
			PlayerDataManager.SaveAndRelease(p)
			table.insert(ready, p)
		end
	end
	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = code
	options:SetTeleportData({ MapId = mapId, Code = code })
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(placeId, ready, options)
	end)
	if not ok then
		warn("[Lobby] TeleportAsync failed: " .. tostring(err))
		for _, p in ipairs(ready) do
			teleporting[p] = nil
			PlayerDataManager.Reacquire(p)
			Net.Event("Notify"):FireClient(p, "Teleport failed - starting the match on this server instead.", "error")
		end
		LobbyService.LaunchLocal(mapId, ready)
	end
end

function LobbyService.LaunchLocal(mapId: string, group: { Player })
	local valid = {}
	for _, p in ipairs(group) do
		leaveQueue(p)
		if p.Parent and not MatchManager.GetMatchOf(p) then
			table.insert(valid, p)
		end
	end
	if #valid == 0 then
		return
	end
	local match = MatchManager.FindOrCreateLocal(mapId, #valid)
	for _, p in ipairs(valid) do
		match:AddPlayer(p)
	end
end

local function launch(mapId: string)
	local q = queues[mapId]
	local group = {}
	for i = 1, math.min(#q.Players, Config.Match.MaxPlayers) do
		table.insert(group, q.Players[i])
	end
	q.EndsAt = nil
	if LobbyService.Mode == "Teleport" then
		task.spawn(teleportGroup, mapId, group)
	else
		LobbyService.LaunchLocal(mapId, group)
	end
end

-- Return a player from a local match to the lobby (keeps all persistent progress).
function LobbyService.SendToLobby(player: Player)
	if not player.Parent then
		return
	end
	leaveQueue(player)
	Net.Event("MatchState"):FireClient(player, { State = "Lobby" })
	SpawnManager.Spawn(player)
	-- step off the pad area so returning players are not instantly re-queued
	player:SetAttribute("QueueCooldownUntil", workspace:GetServerTimeNow() + 3)
end

local function tick()
	local now = workspace:GetServerTimeNow()
	for _, player in ipairs(Players:GetPlayers()) do
		local inZone = nil
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local cooldown = player:GetAttribute("QueueCooldownUntil")
		local eligible = root and hum and hum.Health > 0
			and not teleporting[player]
			and not MatchManager.GetMatchOf(player)
			and PlayerDataManager.IsLoaded(player)
			and not (type(cooldown) == "number" and now < cooldown)
		if eligible then
			for mapId, zone in pairs(lobby.Zones) do
				if Util.InBox(root.Position, zone.CFrame, zone.Size) then
					inZone = mapId
					break
				end
			end
		end
		if inZone then
			if playerQueue[player] ~= inZone then
				joinQueue(player, inZone)
			end
		elseif playerQueue[player] then
			leaveQueue(player)
		end
	end

	for mapId, q in pairs(queues) do
		local n = #q.Players
		if n > 0 and q.EndsAt then
			if n >= Config.Match.MaxPlayers or (now >= q.EndsAt and n >= Config.Lobby.MinPlayersToLaunch) then
				launch(mapId)
			elseif now >= q.EndsAt then
				q.EndsAt = now + Config.Lobby.QueueCountdown -- not enough players yet, keep waiting
			end
		end
	end
end

function LobbyService.Init(mode: string)
	LobbyService.Mode = mode
	for _, mapId in ipairs(MapData.Order) do
		queues[mapId] = { Players = {}, EndsAt = nil }
	end
	lobby = LobbyBuilder.Build(workspace)

	lobby.SkinShopPrompt.Triggered:Connect(function(player)
		if not MatchManager.GetMatchOf(player) then
			Net.Event("OpenSkinShop"):FireClient(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		leaveQueue(player)
		teleporting[player] = nil
	end)

	TeleportService.TeleportInitFailed:Connect(function(player, result, message)
		if teleporting[player] then
			teleporting[player] = nil
			PlayerDataManager.Reacquire(player)
			Net.Event("Notify"):FireClient(player, "Teleport failed (" .. tostring(message or result) .. "). Please try again.", "error")
		end
	end)

	task.spawn(function()
		local t = 0
		while true do
			task.wait(0.2)
			local ok, err = pcall(tick)
			if not ok then
				warn("[Lobby] tick error: " .. tostring(err))
			end
			t += 1
			if t % 2 == 0 then
				updateSigns()
			end
			if t % 5 == 0 then
				broadcastLobbyState()
			end
		end
	end)
end

return LobbyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">MatchManager</string><ProtectedString name="Source"><![CDATA[--[[
	MatchManager
	A Match owns one built map, its players (stats + team), and the round loop:

	  Starting -> Warmup (short countdown, shop open) -> Live (exactly Config.Match.Duration)
	           -> Results (podium cinematic) -> PostMatch (Return to Lobby / Play Again)
	           -> next round with everyone who stayed (stats reset, teams rebalanced)

	In "Local" mode several matches can run in one server, each map at its own offset.
	In "Teleport" mode a reserved server runs exactly one match.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Util = require(ReplicatedStorage.Shared.Util)
local MapData = require(ReplicatedStorage.Shared.MapData)
local MapLoader = require(script.Parent.Parent.Builders.MapLoader)
local TeamManager = require(script.Parent.TeamManager)
local SpawnManager = require(script.Parent.SpawnManager)
local WeaponServer = require(script.Parent.WeaponServer)
local RewardManager = require(script.Parent.RewardManager)
local RateLimiter = require(script.Parent.RateLimiter)

local MatchManager = {}

-- Wired by Main: sends a player back to the lobby (respawn in lobby or teleport).
MatchManager.ReturnToLobby = function(_player: Player) end
MatchManager.OnMatchClosed = function(_match) end

local matches: { [string]: any } = {}
local playerMatch: { [Player]: any } = {}
local usedSlots: { [number]: boolean } = {}
local joinCounter = 0

local function serverNow()
	return workspace:GetServerTimeNow()
end

local Match = {}
Match.__index = Match

function MatchManager.Create(mapId: string, origin: CFrame, slot: number?)
	local self = setmetatable({}, Match)
	self.Key = HttpService:GenerateGUID(false)
	self.MapId = mapId
	self.Players = {}
	self.State = "Starting"
	self.EndsAt = 0
	self.Round = 0
	self.Id = ""
	self.Choices = {}
	self.Closed = false
	self.Slot = slot
	self.World = MapLoader.Load(mapId, origin)
	matches[self.Key] = self
	task.spawn(function()
		self:Loop()
	end)
	return self
end

-- Local mode: reuse a match of this map with free room, or build a new one at a free offset.
function MatchManager.FindOrCreateLocal(mapId: string, groupSize: number)
	for _, m in pairs(matches) do
		if m.MapId == mapId and m:HasRoom(groupSize) then
			return m
		end
	end
	local slot = 1
	while usedSlots[slot] do
		slot += 1
	end
	usedSlots[slot] = true
	local origin = CFrame.new(slot * Config.Matchmaking.LocalMapSpacing, 0, 0)
	return MatchManager.Create(mapId, origin, slot)
end

function MatchManager.GetMatchOf(player: Player)
	return playerMatch[player]
end

function MatchManager.GetMatches()
	return matches
end

function MatchManager.CountForMap(mapId: string): number
	local n = 0
	for _, m in pairs(matches) do
		if m.MapId == mapId then
			n += m:Count()
		end
	end
	return n
end

-- MATCH ------------------------------------------------------------------------------

function Match:Count(): number
	local n = 0
	for _ in pairs(self.Players) do
		n += 1
	end
	return n
end

function Match:PlayerList(): { Player }
	local list = {}
	for p in pairs(self.Players) do
		table.insert(list, p)
	end
	return list
end

function Match:HasRoom(n: number): boolean
	return not self.Closed and self:Count() + n <= Config.Match.MaxPlayers
end

function Match:Broadcast(eventName: string, ...)
	Net.FireList(eventName, self:PlayerList(), ...)
end

function Match:Notify(text: string, kind: string?)
	self:Broadcast("Notify", text, kind or "info")
end

function Match:StatePayload()
	local red, blue = TeamManager.Count(self)
	local redKills, blueKills = 0, 0
	local roster = {}
	for p, stat in pairs(self.Players) do
		if stat.Team == "Red" then
			redKills += stat.Kills
		else
			blueKills += stat.Kills
		end
		table.insert(roster, { UserId = p.UserId, Name = p.DisplayName, Team = stat.Team, Kills = stat.Kills, Deaths = stat.Deaths })
	end
	local map = MapData.Get(self.MapId)
	return {
		Key = self.Key,
		MapId = self.MapId,
		MapName = map and map.Name or self.MapId,
		State = self.State,
		EndsAt = self.EndsAt,
		Round = self.Round,
		Red = red,
		Blue = blue,
		RedKills = redKills,
		BlueKills = blueKills,
		Roster = roster,
		SpawnZones = self.World.SpawnZones,
	}
end

function Match:SendState(only: Player?)
	local payload = self:StatePayload()
	if only then
		Net.Event("MatchState"):FireClient(only, payload)
	else
		self:Broadcast("MatchState", payload)
	end
end

function Match:AddPlayer(player: Player)
	if playerMatch[player] == self or self.Closed then
		return
	end
	if playerMatch[player] then
		playerMatch[player]:RemovePlayer(player)
	end
	joinCounter += 1
	local stat = { Team = nil, Kills = 0, Deaths = 0, JoinOrder = joinCounter }
	self.Players[player] = stat
	playerMatch[player] = self
	TeamManager.SetTeam(player, stat, TeamManager.PickTeam(self))
	player:SetAttribute("MatchKey", self.Key)
	player:SetAttribute("MapId", self.MapId)
	player:SetAttribute("Kills", 0)
	player:SetAttribute("Deaths", 0)
	WeaponServer.ResetLoadout(player)
	WeaponServer.Disarm(player)
	self:SendState()

	if self.State == "Warmup" or self.State == "Live" then
		SpawnManager.Spawn(player)
		Net.Event("Notify"):FireClient(player, "You joined " .. Config.Teams[stat.Team].Name, stat.Team)
	else
		SpawnManager.CancelRespawn(player)
		if player.Character then
			player.Character:Destroy()
			player.Character = nil
		end
		if self.LastResults then
			Net.Event("Results"):FireClient(player, self.LastResults)
		end
		if self.State == "PostMatch" then
			Net.Event("PostMatchPrompt"):FireClient(player, { EndsAt = self.EndsAt })
		end
	end
end

function Match:RemovePlayer(player: Player)
	if not self.Players[player] then
		return
	end
	self.Players[player] = nil
	self.Choices[player] = nil
	if playerMatch[player] == self then
		playerMatch[player] = nil
	end
	for _, attr in ipairs({ "MatchKey", "MapId", "Team", "TeamColor", "Kills", "Deaths", "ProtectedUntil" }) do
		player:SetAttribute(attr, nil)
	end
	if player.Parent then
		WeaponServer.Disarm(player)
	end
	self:SendState()
end

function Match:GetSpawnCFrame(player: Player): CFrame
	local stat = self.Players[player]
	local team = stat and stat.Team or "Red"
	local spawns = self.World.Spawns[team]
	local enemies = {}
	for p, s in pairs(self.Players) do
		local root = s.Team ~= team and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if root then
			table.insert(enemies, root.Position)
		end
	end
	local best, bestScore = spawns[math.random(1, #spawns)], -1
	if #enemies > 0 then
		for _, cf in ipairs(spawns) do
			local nearest = math.huge
			for _, e in ipairs(enemies) do
				nearest = math.min(nearest, (cf.Position - e).Magnitude)
			end
			local score = nearest + math.random() * 8
			if score > bestScore then
				best, bestScore = cf, score
			end
		end
	end
	return best
end

function Match:IsInSpawnZone(player: Player): boolean
	local stat = self.Players[player]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local zone = stat and self.World.SpawnZones[stat.Team]
	if not root or not zone then
		return false
	end
	return Util.InBox(root.Position, zone.CFrame, zone.Size + Vector3.new(2, 6, 2))
end

function Match:OnKill(killer: Player, _victim: Player, _weaponId: string, _headshot: boolean)
	local stat = self.Players[killer]
	if stat and self.State == "Live" then
		stat.Kills += 1
		killer:SetAttribute("Kills", stat.Kills)
		self:SendState()
	end
end

function Match:OnDeath(player: Player)
	local stat = self.Players[player]
	if not stat then
		return
	end
	WeaponServer.OnDeath(player)
	if self.State ~= "Live" and self.State ~= "Warmup" then
		return
	end
	if self.State == "Live" then
		stat.Deaths += 1
		player:SetAttribute("Deaths", stat.Deaths)
	end
	-- auto-balance: move this player if their team is too big
	local over = TeamManager.OverfullTeam(self)
	if over and over == stat.Team then
		TeamManager.SetTeam(player, stat, TeamManager.Other(stat.Team))
		Net.Event("Notify"):FireClient(player, "Teams auto-balanced: you are now on " .. Config.Teams[stat.Team].Name, stat.Team)
	end
	self:SendState()
	SpawnManager.ScheduleRespawn(player, Config.Match.RespawnDelay)
end

function Match:OnChoice(player: Player, choice: string)
	if not self.Players[player] or (self.State ~= "PostMatch" and self.State ~= "Results") then
		return
	end
	if choice == "Lobby" then
		self:RemovePlayer(player)
		MatchManager.ReturnToLobby(player)
	elseif choice == "Continue" then
		self.Choices[player] = "Continue"
		Net.Event("Notify"):FireClient(player, "You'll stay for the next match.", "info")
	end
end

function Match:WaitUntil(t: number, stopIf: (() -> boolean)?)
	while serverNow() < t and not self.Closed do
		if stopIf and stopIf() then
			return
		end
		task.wait(0.25)
	end
end

function Match:CheckOutOfBounds()
	for p in pairs(self.Players) do
		local char = p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 and root.Position.Y < self.World.KillY then
			hum.Health = 0
		end
	end
end

function Match:PlayRound()
	self.Round += 1
	self.Id = HttpService:GenerateGUID(false)
	self.Choices = {}
	self.LastResults = nil
	for p, stat in pairs(self.Players) do
		stat.Kills = 0
		stat.Deaths = 0
		p:SetAttribute("Kills", 0)
		p:SetAttribute("Deaths", 0)
		WeaponServer.ResetLoadout(p)
	end
	TeamManager.Rebalance(self)

	self.State = "Warmup"
	self.EndsAt = serverNow() + Config.Match.PreRoundCountdown
	self:SendState()
	for p in pairs(self.Players) do
		SpawnManager.Spawn(p)
	end
	self:WaitUntil(self.EndsAt, function()
		return self:Count() == 0
	end)
	if self.Closed or self:Count() == 0 then
		return
	end

	self.State = "Live"
	self.EndsAt = serverNow() + Config.Match.Duration
	self:SendState()
	self:Notify("Match started! Most kills in 10 minutes wins.", "start")
	while serverNow() < self.EndsAt and not self.Closed do
		task.wait(0.5)
		if self:Count() == 0 then
			return
		end
		self:CheckOutOfBounds()
	end
	if self.Closed then
		return
	end
	self:FinishRound()
end

function Match:FinishRound()
	self.State = "Results"
	self.EndsAt = serverNow() + Config.Match.ResultsDuration
	for p in pairs(self.Players) do
		SpawnManager.CancelRespawn(p)
		WeaponServer.Disarm(p)
		local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
		end
	end

	local ranking = RewardManager.Rank(self)
	RewardManager.Grant(self.Id, ranking)

	local podium, rankings = {}, {}
	for _, e in ipairs(ranking) do
		local row = {
			Place = e.Place,
			UserId = e.UserId,
			Name = e.Name,
			DisplayName = e.DisplayName,
			Team = e.Team,
			Kills = e.Kills,
			Deaths = e.Deaths,
			Points = e.Points,
		}
		table.insert(rankings, row)
		if e.Place <= 3 then
			table.insert(podium, row)
		end
	end
	self.World.Podium:Show(podium)

	self.LastResults = {
		MatchId = self.Id,
		MapId = self.MapId,
		PodiumCFrame = self.World.PodiumCFrame,
		Duration = Config.Match.ResultsDuration,
		Podium = podium,
		Rankings = rankings,
	}
	self:SendState()
	self:Broadcast("Results", self.LastResults)
	self:WaitUntil(self.EndsAt)
	if self.Closed then
		return
	end

	self.State = "PostMatch"
	self.EndsAt = serverNow() + Config.Match.PostMatchChoiceDuration
	self:SendState()
	self:Broadcast("PostMatchPrompt", { EndsAt = self.EndsAt })
	self:WaitUntil(self.EndsAt, function()
		if self:Count() == 0 then
			return true
		end
		for p in pairs(self.Players) do
			if self.Choices[p] ~= "Continue" then
				return false
			end
		end
		return true
	end)
	self.World.Podium:Clear()
end

function Match:Loop()
	task.wait(0.5)
	while not self.Closed do
		if self:Count() == 0 then
			local waited = 0
			while self:Count() == 0 and waited < 45 and not self.Closed do
				task.wait(1)
				waited += 1
			end
			if self:Count() == 0 then
				self:Close()
				return
			end
		end
		local ok, err = pcall(function()
			self:PlayRound()
		end)
		if not ok then
			warn("[Match] round error: " .. tostring(err))
			task.wait(2)
		end
	end
end

function Match:Close()
	if self.Closed then
		return
	end
	self.Closed = true
	self.State = "Closed"
	for _, p in ipairs(self:PlayerList()) do
		self:RemovePlayer(p)
		MatchManager.ReturnToLobby(p)
	end
	matches[self.Key] = nil
	if self.Slot then
		usedSlots[self.Slot] = nil
	end
	MatchManager.OnMatchClosed(self)
	task.delay(1, function()
		self.World.Destroy()
	end)
end

-- INIT -------------------------------------------------------------------------------

function MatchManager.Init()
	Net.Event("PostMatchChoice").OnServerEvent:Connect(function(player, choice)
		if type(choice) ~= "string" or not RateLimiter.Check(player, "PostChoice", 2, 3) then
			return
		end
		local m = playerMatch[player]
		if m then
			m:OnChoice(player, choice)
		end
	end)

	WeaponServer.CanChangeLoadout = function(player)
		local m = playerMatch[player]
		if not m then
			return false, "You are not in a match."
		end
		if m.State ~= "Warmup" and m.State ~= "Live" then
			return false, "The match is over."
		end
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then
			return false, "You are dead."
		end
		if not m:IsInSpawnZone(player) then
			return false, "Return to your spawn to change weapons."
		end
		return true
	end

	Players.PlayerRemoving:Connect(function(player)
		local m = playerMatch[player]
		if m then
			m:RemovePlayer(player)
		end
	end)
end

return MatchManager
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">MatchRegistry</string><ProtectedString name="Source"><![CDATA[--[[
	MatchRegistry
	Cross-server discovery of running matches (Teleport mode only) through MemoryStoreService.
	Match servers publish { MapId, Code, Count, Max, Joinable } every few seconds with a short
	expiry, so crashed servers disappear automatically. Lobby servers read it to place new
	groups into running matches with free slots before reserving a new server.
]]

local MemoryStoreService = game:GetService("MemoryStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local MatchRegistry = {}

local map
local ok, err = pcall(function()
	map = MemoryStoreService:GetSortedMap("FPS_OpenMatches_v1")
end)
if not ok then
	warn("[MatchRegistry] MemoryStore unavailable: " .. tostring(err))
end

function MatchRegistry.Publish(serverId: string, entry)
	if not map then
		return
	end
	pcall(function()
		map:SetAsync(serverId, entry, Config.Matchmaking.RegistryExpiry)
	end)
end

function MatchRegistry.Remove(serverId: string)
	if not map then
		return
	end
	pcall(function()
		map:RemoveAsync(serverId)
	end)
end

-- Returns the reserved-server access code of a joinable match for mapId with room for `need`.
function MatchRegistry.FindOpen(mapId: string, need: number): string?
	if not map then
		return nil
	end
	local found = nil
	pcall(function()
		local items = map:GetRangeAsync(Enum.SortDirection.Ascending, 100)
		local best = -1
		for _, item in ipairs(items) do
			local v = item.value
			if type(v) == "table" and v.MapId == mapId and v.Joinable and type(v.Code) == "string" then
				local count = tonumber(v.Count) or 0
				local max = tonumber(v.Max) or Config.Match.MaxPlayers
				-- prefer the fullest match that still fits the group (keeps matches lively)
				if count + need <= max and count > best then
					best = count
					found = v.Code
				end
			end
		end
	end)
	return found
end

return MatchRegistry
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">PlayerDataManager</string><ProtectedString name="Source"><![CDATA[--[[
	PlayerDataManager
	Persistent progress (points, skins, settings, lifetime stats) in DataStoreService.

	Safety rules:
	  * Data is loaded with UpdateAsync and a session lock, so two servers never write the same
	    profile at once (e.g. while teleporting between lobby and match servers).
	  * If loading fails, the player is NEVER given a default profile that could overwrite their
	    real data. Live servers kick with a friendly message; Studio uses a temporary profile
	    that is flagged as unsaveable.
	  * Saves retry with exponential backoff, run on leave, on an autosave timer and on shutdown.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Net = require(ReplicatedStorage.Shared.Net)

local PlayerDataManager = {}

local DATA = Config.Data
local JOB_ID = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))

PlayerDataManager.Template = {
	Version = 1,
	Points = 0,
	OwnedSkins = {},
	EquippedSkins = {},
	Stats = { Kills = 0, Deaths = 0, Matches = 0, Wins = 0, Podiums = 0 },
	Settings = {
		MasterVolume = 0.8,
		MusicVolume = 0.6,
		SfxVolume = 0.9,
		MouseSensitivity = 1,
		TouchSensitivity = 1,
		CrosshairColor = "Green",
		CrosshairSize = 8,
		CrosshairGap = 4,
		CrosshairThickness = 2,
		CrosshairDot = false,
		Effects = "High",
	},
	ProcessedMatches = {},
}

type Profile = {
	Data: any,
	CanSave: boolean,
	Saving: boolean,
	Released: boolean,
	LastSave: number,
}

local profiles: { [Player]: Profile } = {}
local loadedEvent = Instance.new("BindableEvent")
PlayerDataManager.ProfileLoaded = loadedEvent.Event
local changedEvent = Instance.new("BindableEvent")
PlayerDataManager.Changed = changedEvent.Event

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(DATA.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore unavailable: " .. tostring(result))
	end
end

local function keyFor(player: Player)
	return "u_" .. player.UserId
end

local function lockIsForeign(lock): boolean
	return type(lock) == "table"
		and lock.JobId ~= JOB_ID
		and type(lock.Time) == "number"
		and os.time() - lock.Time < DATA.SessionLockTimeout
end

-- Public snapshot sent to the owning client.
function PlayerDataManager.Snapshot(data)
	return {
		Points = data.Points,
		OwnedSkins = data.OwnedSkins,
		EquippedSkins = data.EquippedSkins,
		Stats = data.Stats,
		Settings = data.Settings,
	}
end

local function replicate(player: Player)
	local profile = profiles[player]
	if not profile or not player.Parent then
		return
	end
	player:SetAttribute("Points", profile.Data.Points)
	Net.Event("ProfileUpdate"):FireClient(player, PlayerDataManager.Snapshot(profile.Data))
	changedEvent:Fire(player, profile.Data)
end
PlayerDataManager.Replicate = replicate

local function loadProfile(player: Player)
	local key = keyFor(player)
	local loaded = nil
	local lastError = nil

	if store then
		-- Studio without API access fails every call: fall back to the temporary profile fast
		local attempts = RunService:IsStudio() and 2 or DATA.LoadAttempts
		for attempt = 1, attempts do
			if not player.Parent then
				return
			end
			local foreign = false
			local stealing = attempt == attempts
			local ok, err = pcall(function()
				store:UpdateAsync(key, function(old)
					if old and lockIsForeign(old.Lock) and not stealing then
						foreign = true
						return nil -- cancel write, wait for the other server to release
					end
					local data = type(old) == "table" and old or Util.DeepCopy(PlayerDataManager.Template)
					Util.Reconcile(data, PlayerDataManager.Template)
					data.Lock = { JobId = JOB_ID, Time = os.time() }
					loaded = Util.DeepCopy(data)
					return data
				end)
			end)
			if ok and loaded then
				break
			end
			loaded = nil
			lastError = ok and (foreign and "session locked by another server" or "no data") or err
			warn(string.format("[PlayerData] load attempt %d for %s failed: %s", attempt, player.Name, tostring(lastError)))
			if attempt < attempts then
				task.wait(RunService:IsStudio() and 0.5 or (foreign and 4 or math.min(2 ^ attempt, 10)))
			end
		end
	end

	if not player.Parent then
		return
	end

	local profile: Profile
	if loaded then
		loaded.Lock = nil
		profile = { Data = loaded, CanSave = true, Saving = false, Released = false, LastSave = os.clock() }
	elseif RunService:IsStudio() then
		warn("[PlayerData] Using a TEMPORARY, unsaved profile for " .. player.Name
			.. " (enable Studio API access in Game Settings > Security to test saving). Reason: "
			.. tostring(lastError or "DataStore unavailable"))
		local data = Util.DeepCopy(PlayerDataManager.Template)
		data.Points = 500 -- generous test balance so the skin shop can be tried in Studio
		profile = { Data = data, CanSave = false, Saving = false, Released = false, LastSave = os.clock() }
	else
		player:Kick("We couldn't load your saved progress (Roblox data services are having trouble). Your data is safe - please rejoin in a minute.")
		return
	end

	profiles[player] = profile
	player:SetAttribute("DataLoaded", true)
	replicate(player)
	loadedEvent:Fire(player, profile.Data)
end

-- Save the profile. `release` drops the session lock (leaving / teleporting).
function PlayerDataManager.Save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	while profile.Saving do
		task.wait(0.1)
	end
	profile.Saving = true
	local snapshot = Util.DeepCopy(profile.Data)
	local success = false
	for attempt = 1, DATA.SaveAttempts do
		local blocked = false
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(old)
				if old and lockIsForeign(old.Lock) then
					blocked = true
					return nil -- another server owns this profile now; never overwrite it
				end
				local data = Util.DeepCopy(snapshot)
				data.Lock = (not release) and { JobId = JOB_ID, Time = os.time() } or nil
				return data
			end)
		end)
		if ok then
			success = not blocked
			if blocked then
				warn("[PlayerData] save for " .. player.Name .. " skipped: profile is locked by another server")
				profile.CanSave = false
			end
			break
		end
		warn(string.format("[PlayerData] save attempt %d for %s failed: %s", attempt, player.Name, tostring(err)))
		task.wait(math.min(2 ^ attempt, 8))
	end
	profile.Saving = false
	profile.LastSave = os.clock()
	if release and success then
		profile.Released = true
	end
	return success
end

-- Called before teleporting so the destination server can lock the profile immediately.
function PlayerDataManager.SaveAndRelease(player: Player): boolean
	return PlayerDataManager.Save(player, true)
end

-- After a failed teleport the player stays here: take the lock back.
function PlayerDataManager.Reacquire(player: Player)
	local profile = profiles[player]
	if profile then
		profile.Released = false
		task.spawn(PlayerDataManager.Save, player, false)
	end
end

function PlayerDataManager.Get(player: Player)
	local profile = profiles[player]
	return profile and profile.Data
end

function PlayerDataManager.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

function PlayerDataManager.WaitForData(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 30)
	while player.Parent and not profiles[player] and os.clock() < deadline do
		task.wait(0.1)
	end
	return PlayerDataManager.Get(player)
end

-- Mutate through this so the client is always told about changes.
function PlayerDataManager.Update(player: Player, mutator: (any) -> ()): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	mutator(profile.Data)
	replicate(player)
	return true
end

-- Grant match rewards exactly once per (player, matchId). Returns points granted or nil.
function PlayerDataManager.ApplyMatchResult(player: Player, matchId: string, points: number, kills: number, deaths: number, place: number?)
	local profile = profiles[player]
	if not profile or type(matchId) ~= "string" then
		return nil
	end
	local data = profile.Data
	if table.find(data.ProcessedMatches, matchId) then
		return nil
	end
	table.insert(data.ProcessedMatches, matchId)
	while #data.ProcessedMatches > DATA.ProcessedMatchHistory do
		table.remove(data.ProcessedMatches, 1)
	end
	data.Points += math.max(0, math.floor(points))
	data.Stats.Kills += kills
	data.Stats.Deaths += deaths
	data.Stats.Matches += 1
	if place and place <= 3 then
		data.Stats.Podiums += 1
	end
	if place == 1 then
		data.Stats.Wins += 1
	end
	replicate(player)
	task.spawn(PlayerDataManager.Save, player, false)
	return points
end

function PlayerDataManager.CanSave(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.CanSave
end

function PlayerDataManager.Init()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(loadProfile, player)
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(loadProfile, p)
	end

	Players.PlayerRemoving:Connect(function(player)
		local profile = profiles[player]
		if profile then
			if not profile.Released then
				PlayerDataManager.Save(player, true)
			end
			profiles[player] = nil
		end
	end)

	Net.Function("GetProfile").OnServerInvoke = function(player)
		local data = PlayerDataManager.WaitForData(player, 20)
		return data and PlayerDataManager.Snapshot(data) or nil
	end

	-- autosave
	task.spawn(function()
		while true do
			task.wait(DATA.AutosaveInterval)
			for player, profile in pairs(profiles) do
				if profile.CanSave and not profile.Released and player.Parent then
					task.spawn(PlayerDataManager.Save, player, false)
					task.wait(0.5)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player, profile in pairs(profiles) do
			if profile.CanSave and not profile.Released then
				pending += 1
				task.spawn(function()
					PlayerDataManager.Save(player, true)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return PlayerDataManager
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">RateLimiter</string><ProtectedString name="Source"><![CDATA[--[[
	RateLimiter
	Token bucket per player per key. Used to throttle every client -> server remote.
]]

local Players = game:GetService("Players")

local RateLimiter = {}

local buckets: { [Player]: { [string]: { tokens: number, last: number } } } = {}

-- Returns true when the request is allowed. `rate` tokens per second, `burst` max tokens.
function RateLimiter.Check(player: Player, key: string, rate: number, burst: number): boolean
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local now = os.clock()
	local b = perPlayer[key]
	if not b then
		b = { tokens = burst, last = now }
		perPlayer[key] = b
	end
	b.tokens = math.min(burst, b.tokens + (now - b.last) * rate)
	b.last = now
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

return RateLimiter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">RewardManager</string><ProtectedString name="Source"><![CDATA[--[[
	RewardManager
	Ranks a finished match and pays placement points exactly once.
	Ranking: kills (desc) -> deaths (asc) -> join order (asc, stable).
	De-duplication happens twice: per match id here, and per (player, match id) in the
	persistent profile, so leaving/rejoining or replaying remotes can never pay twice.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local PlayerDataManager = require(script.Parent.PlayerDataManager)

local RewardManager = {}

local paidMatches: { [string]: boolean } = {}

function RewardManager.Rank(match)
	local list = {}
	for player, stat in pairs(match.Players) do
		if player.Parent then
			table.insert(list, {
				Player = player,
				UserId = player.UserId,
				Name = player.Name,
				DisplayName = player.DisplayName,
				Team = stat.Team,
				Kills = stat.Kills,
				Deaths = stat.Deaths,
				JoinOrder = stat.JoinOrder,
			})
		end
	end
	table.sort(list, function(a, b)
		if a.Kills ~= b.Kills then
			return a.Kills > b.Kills
		end
		if a.Deaths ~= b.Deaths then
			return a.Deaths < b.Deaths
		end
		return a.JoinOrder < b.JoinOrder
	end)
	for i, e in ipairs(list) do
		e.Place = i
	end
	return list
end

function RewardManager.PointsFor(place: number): number
	return Config.Rewards.Placement[place] or Config.Rewards.Other
end

-- Mutates ranking entries with .Points (what was actually granted).
function RewardManager.Grant(matchId: string, ranking)
	if paidMatches[matchId] then
		for _, e in ipairs(ranking) do
			e.Points = 0
		end
		return
	end
	paidMatches[matchId] = true
	for _, e in ipairs(ranking) do
		local points = RewardManager.PointsFor(e.Place)
		local granted = PlayerDataManager.ApplyMatchResult(e.Player, matchId, points, e.Kills, e.Deaths, e.Place)
		e.Points = granted or 0
	end
end

return RewardManager
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">SkinShopServer</string><ProtectedString name="Source"><![CDATA[--[[
	SkinShopServer
	Server side of the cosmetic skin shop and player settings.
	All prices, ownership and balances are checked here; the client only sends ids.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local SkinData = require(ReplicatedStorage.Shared.SkinData)
local WeaponData = require(ReplicatedStorage.WeaponModules.WeaponData)
local PlayerDataManager = require(script.Parent.PlayerDataManager)
local RateLimiter = require(script.Parent.RateLimiter)

local SkinShopServer = {}

-- Set by Main: returns true while the player is in the lobby (shop is a lobby feature).
SkinShopServer.IsInLobby = function(_player)
	return true
end

local busy: { [Player]: boolean } = {}

local function result(ok, message, player)
	local data = PlayerDataManager.Get(player)
	return { Ok = ok, Message = message, Profile = data and PlayerDataManager.Snapshot(data) }
end

local function buySkin(player: Player, skinId)
	if type(skinId) ~= "string" or #skinId > 64 then
		return result(false, "Invalid item.", player)
	end
	if not RateLimiter.Check(player, "BuySkin", 2, 4) then
		return result(false, "Slow down.", player)
	end
	if busy[player] then
		return result(false, "Purchase already in progress.", player)
	end
	local skin = SkinData.Get(skinId)
	if not skin then
		return result(false, "That skin does not exist.", player)
	end
	if not SkinShopServer.IsInLobby(player) then
		return result(false, "The skin shop is only available in the lobby.", player)
	end
	local data = PlayerDataManager.Get(player)
	if not data then
		return result(false, "Your data is still loading.", player)
	end
	if data.OwnedSkins[skinId] then
		return result(false, "You already own this skin.", player)
	end
	if data.Points < skin.Price then
		return result(false, string.format("Not enough points (%d / %d).", data.Points, skin.Price), player)
	end

	busy[player] = true
	-- Deduct and grant in one synchronous step (no yields in between => no double spend).
	PlayerDataManager.Update(player, function(d)
		d.Points -= skin.Price
		d.OwnedSkins[skinId] = true
		d.EquippedSkins[skin.Weapon] = skinId
	end)
	busy[player] = nil
	task.spawn(PlayerDataManager.Save, player, false)
	return result(true, "Purchased " .. skin.Name .. "!", player)
end

local function equipSkin(player: Player, weaponId, skinId)
	if type(weaponId) ~= "string" or not WeaponData.Get(weaponId) then
		return result(false, "Invalid weapon.", player)
	end
	if skinId ~= nil and type(skinId) ~= "string" then
		return result(false, "Invalid skin.", player)
	end
	if not RateLimiter.Check(player, "EquipSkin", 4, 8) then
		return result(false, "Slow down.", player)
	end
	local data = PlayerDataManager.Get(player)
	if not data then
		return result(false, "Your data is still loading.", player)
	end
	if skinId then
		local skin = SkinData.Get(skinId)
		if not skin or skin.Weapon ~= weaponId then
			return result(false, "That skin does not fit this weapon.", player)
		end
		if not data.OwnedSkins[skinId] then
			return result(false, "You do not own this skin.", player)
		end
	end
	PlayerDataManager.Update(player, function(d)
		d.EquippedSkins[weaponId] = skinId
	end)
	return result(true, skinId and "Skin equipped." or "Default finish equipped.", player)
end

local CROSSHAIR_COLORS = { Green = true, White = true, Cyan = true, Yellow = true, Red = true, Pink = true }
local EFFECTS = { Low = true, Medium = true, High = true }
local NUMERIC = {
	MasterVolume = { 0, 1 },
	MusicVolume = { 0, 1 },
	SfxVolume = { 0, 1 },
	MouseSensitivity = { 0.1, 4 },
	TouchSensitivity = { 0.1, 4 },
	CrosshairSize = { 2, 24 },
	CrosshairGap = { 0, 16 },
	CrosshairThickness = { 1, 6 },
}

local function saveSettings(player: Player, settings)
	if type(settings) ~= "table" then
		return false
	end
	if not RateLimiter.Check(player, "SaveSettings", 1, 3) then
		return false
	end
	local clean = {}
	for key, range in pairs(NUMERIC) do
		local v = settings[key]
		if type(v) == "number" and v == v then
			clean[key] = math.clamp(v, range[1], range[2])
		end
	end
	if CROSSHAIR_COLORS[settings.CrosshairColor] then
		clean.CrosshairColor = settings.CrosshairColor
	end
	if EFFECTS[settings.Effects] then
		clean.Effects = settings.Effects
	end
	if type(settings.CrosshairDot) == "boolean" then
		clean.CrosshairDot = settings.CrosshairDot
	end
	return PlayerDataManager.Update(player, function(d)
		for k, v in pairs(clean) do
			d.Settings[k] = v
		end
	end)
end

function SkinShopServer.Init()
	Net.Function("BuySkin").OnServerInvoke = buySkin
	Net.Function("EquipSkin").OnServerInvoke = equipSkin
	Net.Function("SaveSettings").OnServerInvoke = saveSettings
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		busy[p] = nil
	end)
end

return SkinShopServer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">SpawnManager</string><ProtectedString name="Source"><![CDATA[--[[
	SpawnManager
	Owns character spawning for the whole server (CharacterAutoLoads is off).
	Main wires ResolveSpawn so a character appears either in the lobby or at the correct team
	base of the player's match. Also handles spawn protection, team vests and ragdoll deaths.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local SpawnManager = {}

-- Set by Main. Returns (CFrame, context) where context is "Lobby" | "Match".
SpawnManager.ResolveSpawn = function(_player: Player): (CFrame?, string)
	return CFrame.new(0, 10, 0), "Lobby"
end

local spawnHooks = {}
local deathHooks = {}

function SpawnManager.OnSpawned(fn)
	table.insert(spawnHooks, fn)
end

function SpawnManager.OnDied(fn)
	table.insert(deathHooks, fn)
end

local respawnTokens: { [Player]: number } = {}

local pendingSpawn: { [Player]: { CFrame: CFrame?, Context: string } } = {}

function SpawnManager.Spawn(player: Player)
	respawnTokens[player] = (respawnTokens[player] or 0) + 1
	local token = respawnTokens[player]
	if not player.Parent then
		return
	end
	local spawnCf, spawnContext = SpawnManager.ResolveSpawn(player)
	pendingSpawn[player] = { CFrame = spawnCf, Context = spawnContext }
	task.spawn(function()
		-- With StreamingEnabled the floor must reach the client before the character does,
		-- otherwise it can fall through (or hang in empty space) for a moment.
		if spawnCf then
			pcall(function()
				player:RequestStreamAroundAsync(spawnCf.Position, 3)
			end)
		end
		if respawnTokens[player] ~= token or not player.Parent then
			return
		end
		local ok, err = pcall(function()
			player:LoadCharacter()
		end)
		if not ok then
			warn("[Spawn] LoadCharacter failed for " .. player.Name .. ": " .. tostring(err))
		end
	end)
end

-- Respawn after a delay unless something else spawns/moves the player first.
function SpawnManager.ScheduleRespawn(player: Player, delay: number)
	respawnTokens[player] = (respawnTokens[player] or 0) + 1
	local token = respawnTokens[player]
	task.delay(delay, function()
		if respawnTokens[player] == token and player.Parent then
			SpawnManager.Spawn(player)
		end
	end)
end

function SpawnManager.CancelRespawn(player: Player)
	respawnTokens[player] = (respawnTokens[player] or 0) + 1
end

function SpawnManager.IsProtected(player: Player): boolean
	local untilT = player:GetAttribute("ProtectedUntil")
	return type(untilT) == "number" and workspace:GetServerTimeNow() < untilT
end

function SpawnManager.EndProtection(player: Player)
	if player:GetAttribute("ProtectedUntil") then
		player:SetAttribute("ProtectedUntil", nil)
		local char = player.Character
		local ff = char and char:FindFirstChild("SpawnShield")
		if ff then
			ff:Destroy()
		end
	end
end

function SpawnManager.GiveProtection(player: Player, seconds: number)
	local char = player.Character
	if not char then
		return
	end
	local ff = Instance.new("ForceField")
	ff.Name = "SpawnShield"
	ff.Visible = true
	ff.Parent = char
	local untilT = workspace:GetServerTimeNow() + seconds
	player:SetAttribute("ProtectedUntil", untilT)
	task.delay(seconds, function()
		if player:GetAttribute("ProtectedUntil") == untilT then
			SpawnManager.EndProtection(player)
		end
	end)
end

local function addTeamVest(character: Model, color: Color3)
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local function piece(size, offset)
		local p = Instance.new("Part")
		p.Name = "TeamVest"
		p.Size = size
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CFrame = torso.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = torso
		w.Part1 = p
		w.Parent = p
		p.Parent = character
	end
	local s = torso.Size
	piece(Vector3.new(s.X + 0.12, s.Y * 0.45, s.Z + 0.12), CFrame.new(0, s.Y * 0.05, 0))
	local arm = character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")
	if arm and arm:IsA("BasePart") then
		local p = Instance.new("Part")
		p.Name = "TeamBand"
		p.Size = Vector3.new(arm.Size.X + 0.1, 0.35, arm.Size.Z + 0.1)
		p.Color = color
		p.Material = Enum.Material.Neon
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CFrame = arm.CFrame * CFrame.new(0, arm.Size.Y * 0.2, 0)
		local w = Instance.new("WeldConstraint")
		w.Part0 = arm
		w.Part1 = p
		w.Parent = p
		p.Parent = character
	end
end

function SpawnManager.Ragdoll(character: Model, impulse: Vector3?)
	for _, m in ipairs(character:GetDescendants()) do
		if m:IsA("Motor6D") and m.Name ~= "Root" and m.Name ~= "RootJoint" and m.Part0 and m.Part1 then
			local a0 = Instance.new("Attachment")
			a0.Name = "RagA0"
			a0.CFrame = m.C0
			a0.Parent = m.Part0
			local a1 = Instance.new("Attachment")
			a1.Name = "RagA1"
			a1.CFrame = m.C1
			a1.Parent = m.Part1
			local bs = Instance.new("BallSocketConstraint")
			bs.Attachment0 = a0
			bs.Attachment1 = a1
			bs.LimitsEnabled = true
			bs.UpperAngle = 55
			bs.TwistLimitsEnabled = true
			bs.TwistLowerAngle = -40
			bs.TwistUpperAngle = 40
			bs.Parent = m.Part0
			m.Enabled = false
		end
	end
	for _, p in ipairs(character:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and not p:GetAttribute("Role") then
			p.CanCollide = true
		end
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.CanCollide = false
		if impulse then
			root:ApplyImpulse(impulse * root.AssemblyMass)
		end
	end
end

local RunService = game:GetService("RunService")

-- CharacterAdded fires before the engine has parented the character and placed it on its
-- default spawn. Moving it any earlier gets overridden (that left players hanging in the air),
-- so wait until it is in the world and one frame has passed.
local function waitUntilPlaced(character: Model)
	local deadline = os.clock() + 5
	while not character:IsDescendantOf(workspace) and os.clock() < deadline do
		character.AncestryChanged:Wait()
	end
	RunService.Heartbeat:Wait()
end

local function placeCharacter(character: Model, cf: CFrame)
	local target = cf + Vector3.new(0, 3, 0)
	character:PivotTo(target)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart
	if not humanoid or not root then
		return
	end
	local pending = pendingSpawn[player]
	pendingSpawn[player] = nil
	local cf, context
	if pending then
		cf, context = pending.CFrame, pending.Context
	else
		cf, context = SpawnManager.ResolveSpawn(player)
	end
	humanoid.BreakJointsOnDeath = false
	humanoid.MaxHealth = Config.Player.MaxHealth
	humanoid.Health = Config.Player.MaxHealth
	humanoid.WalkSpeed = Config.Player.BaseWalkSpeed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.Player.JumpPower
	player:SetAttribute("BaseWalkSpeed", Config.Player.BaseWalkSpeed)
	player:SetAttribute("Context", context)
	if cf then
		placeCharacter(character, cf) -- early placement (helps streaming) ...
		waitUntilPlaced(character)
		if player.Character ~= character then
			return
		end
		placeCharacter(character, cf) -- ... and the one that sticks
	end

	if context == "Match" then
		local team = player:GetAttribute("Team")
		local info = team and Config.Teams[team]
		if info then
			addTeamVest(character, info.Color)
		end
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		SpawnManager.GiveProtection(player, Config.Match.SpawnProtection)
	else
		player:SetAttribute("ProtectedUntil", nil)
	end

	humanoid.Died:Connect(function()
		SpawnManager.Ragdoll(character, nil)
		for _, fn in ipairs(deathHooks) do
			task.spawn(fn, player, character, humanoid)
		end
	end)

	for _, fn in ipairs(spawnHooks) do
		task.spawn(fn, player, character, context)
	end
	Net.Event("Spawned"):FireClient(player, context)
end

function SpawnManager.Init()
	Players.CharacterAutoLoads = false
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		respawnTokens[player] = nil
		pendingSpawn[player] = nil
	end)
end

return SpawnManager
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">TeamManager</string><ProtectedString name="Source"><![CDATA[--[[
	TeamManager
	Red/Blue assignment and balancing for a match. Teams are stored per match (not with the
	global Teams service) so several matches can run in one server without mixing.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local TeamManager = {}

function TeamManager.Count(match)
	local red, blue = 0, 0
	for _, stat in pairs(match.Players) do
		if stat.Team == "Red" then
			red += 1
		elseif stat.Team == "Blue" then
			blue += 1
		end
	end
	return red, blue
end

-- Smaller team, random on ties.
function TeamManager.PickTeam(match): string
	local red, blue = TeamManager.Count(match)
	if red < blue then
		return "Red"
	elseif blue < red then
		return "Blue"
	end
	return math.random() < 0.5 and "Red" or "Blue"
end

function TeamManager.SetTeam(player: Player, stat, team: string)
	stat.Team = team
	player:SetAttribute("Team", team)
	local info = Config.Teams[team]
	if info then
		player:SetAttribute("TeamColor", info.Color)
	end
end

-- Fresh, shuffled, alternating split for a new round.
function TeamManager.Rebalance(match)
	local list = {}
	for player in pairs(match.Players) do
		table.insert(list, player)
	end
	Util.Shuffle(list)
	local first = math.random() < 0.5 and "Red" or "Blue"
	local second = first == "Red" and "Blue" or "Red"
	for i, player in ipairs(list) do
		TeamManager.SetTeam(player, match.Players[player], (i % 2 == 1) and first or second)
	end
end

-- If teams are uneven by more than the allowed amount, returns the team that should lose a player.
function TeamManager.OverfullTeam(match): string?
	local red, blue = TeamManager.Count(match)
	if red - blue > Config.Match.MaxTeamImbalance then
		return "Red"
	elseif blue - red > Config.Match.MaxTeamImbalance then
		return "Blue"
	end
	return nil
end

function TeamManager.Other(team: string): string
	return team == "Red" and "Blue" or "Red"
end

return TeamManager
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">WeaponServer</string><ProtectedString name="Source"><![CDATA[--[[
	WeaponServer
	Authoritative weapon state per player: loadout, equipped slot, ammo, reloads, fire-rate
	budget and the third-person weapon model. CombatServer asks this module whether a shot
	is legal (TryConsumeShot) before any damage is applied.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local WeaponData = require(ReplicatedStorage.WeaponModules.WeaponData)
local WeaponModels = require(ReplicatedStorage.WeaponModules.WeaponModels)
local PlayerDataManager = require(script.Parent.PlayerDataManager)
local RateLimiter = require(script.Parent.RateLimiter)
local SpawnManager = require(script.Parent.SpawnManager)

local WeaponServer = {}

-- Hooks wired by MatchManager
WeaponServer.CanChangeLoadout = function(_player: Player): (boolean, string?)
	return false, "Not in a match."
end
WeaponServer.IsCombatAllowed = function(_player: Player): boolean
	return false
end

type SlotAmmo = { Mag: number, Reserve: number }
type State = {
	Loadout: { Primary: string?, Secondary: string, Melee: string },
	Ammo: { [string]: SlotAmmo },
	Equipped: string?,
	EquippedAt: number,
	LastFire: number,
	ShotTimes: { number },
	ReloadToken: number,
	ReloadingUntil: number,
	Burst: boolean,
	Armed: boolean,
	Model: Model?,
}

local states: { [Player]: State } = {}

local function now()
	return os.clock()
end

local function defaultLoadout()
	return { Primary = nil, Secondary = "USP", Melee = "Knife" }
end

local function getState(player: Player): State
	local s = states[player]
	if not s then
		s = {
			Loadout = defaultLoadout(),
			Ammo = {},
			Equipped = nil,
			EquippedAt = 0,
			LastFire = 0,
			ShotTimes = {},
			ReloadToken = 0,
			ReloadingUntil = 0,
			Burst = false,
			Armed = false,
			Model = nil,
		}
		states[player] = s
	end
	return s
end
WeaponServer.GetState = getState

local function skinFor(player: Player, weaponId: string): string?
	local data = PlayerDataManager.Get(player)
	return data and data.EquippedSkins[weaponId] or nil
end

local function sendState(player: Player)
	local s = getState(player)
	local skins = {}
	for _, id in pairs(s.Loadout) do
		skins[id] = skinFor(player, id)
	end
	Net.Event("WeaponState"):FireClient(player, {
		Loadout = s.Loadout,
		Equipped = s.Equipped,
		Ammo = s.Ammo,
		Armed = s.Armed,
		Skins = skins,
		Burst = s.Burst,
	})
end
WeaponServer.SendState = sendState

local function refill(s: State)
	s.Ammo = {}
	for slot, id in pairs(s.Loadout) do
		local w = WeaponData.Get(id)
		if w and w.MagSize then
			s.Ammo[slot] = { Mag = w.MagSize, Reserve = w.Reserve }
		end
	end
end

-- Arm pose ------------------------------------------------------------------------------
local function findMotor(character: Model, names: { string }): Motor6D?
	for _, n in ipairs(names) do
		local m = character:FindFirstChild(n, true)
		if m and m:IsA("Motor6D") then
			return m
		end
	end
	return nil
end

local function setPose(character: Model, weaponId: string?)
	local isR15 = character:FindFirstChild("UpperTorso") ~= nil
	local right = findMotor(character, isR15 and { "RightShoulder" } or { "Right Shoulder" })
	local left = findMotor(character, isR15 and { "LeftShoulder" } or { "Left Shoulder" })
	for _, m in ipairs({ right, left }) do
		if m and m:GetAttribute("BaseC0") == nil then
			m:SetAttribute("BaseC0", m.C0)
		end
	end
	local w = weaponId and WeaponData.Get(weaponId)
	local twoHanded = w and (w.Category == "Rifle" or w.Category == "Sniper" or w.Category == "Pistol")
	local function pose(m: Motor6D?, angle: number, yaw: number)
		if not m then
			return
		end
		local base = m:GetAttribute("BaseC0") :: CFrame
		if angle == 0 then
			m.C0 = base
		elseif isR15 then
			m.C0 = base * CFrame.Angles(math.rad(angle), math.rad(yaw), 0)
		else
			m.C0 = base * CFrame.Angles(0, 0, math.rad(angle * (m == right and 1 or -1)))
		end
	end
	if not w then
		pose(right, 0, 0)
		pose(left, 0, 0)
	elseif w.Category == "Melee" then
		pose(right, 35, 0)
		pose(left, 0, 0)
	else
		pose(right, 88, 0)
		pose(left, twoHanded and 80 or 0, twoHanded and -35 or 0)
	end
end

local function attachModel(player: Player, s: State)
	if s.Model then
		s.Model:Destroy()
		s.Model = nil
	end
	local character = player.Character
	local id = s.Equipped and s.Loadout[s.Equipped]
	if not character or not id then
		return
	end
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local model = WeaponModels.Build(id, skinFor(player, id))
	model.Name = "EquippedWeapon"
	local handle = model.PrimaryPart :: BasePart
	local offset = (hand.Name == "RightHand" and CFrame.new(0, -0.15, 0) or CFrame.new(0, -0.95, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
	model:PivotTo(hand.CFrame * offset)
	local weld = Instance.new("Weld")
	weld.Part0 = hand
	weld.Part1 = handle
	weld.C0 = offset
	weld.Parent = handle
	model.Parent = character
	s.Model = model
	setPose(character, id)
end

local function applySpeed(player: Player, s: State)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local id = s.Equipped and s.Loadout[s.Equipped]
	local w = id and WeaponData.Get(id)
	local speed = Config.Player.BaseWalkSpeed * (w and w.MoveSpeed or 1)
	humanoid.WalkSpeed = speed
	player:SetAttribute("BaseWalkSpeed", speed)
end

local function equip(player: Player, slot: string)
	local s = getState(player)
	if not s.Armed or not s.Loadout[slot] then
		return false
	end
	if s.Equipped == slot then
		return true
	end
	s.Equipped = slot
	s.EquippedAt = now()
	s.ReloadToken += 1
	s.ReloadingUntil = 0
	s.Burst = false
	attachModel(player, s)
	applySpeed(player, s)
	player:SetAttribute("EquippedWeapon", s.Loadout[slot])
	return true
end

-- Public API -----------------------------------------------------------------------------

function WeaponServer.Arm(player: Player)
	local s = getState(player)
	s.Armed = true
	refill(s)
	s.Equipped = nil
	equip(player, s.Loadout.Primary and "Primary" or "Secondary")
	sendState(player)
end

function WeaponServer.Disarm(player: Player)
	local s = getState(player)
	s.Armed = false
	s.Equipped = nil
	s.ReloadToken += 1
	if s.Model then
		s.Model:Destroy()
		s.Model = nil
	end
	player:SetAttribute("EquippedWeapon", nil)
	if player.Character then
		setPose(player.Character, nil)
	end
	sendState(player)
end

function WeaponServer.ResetLoadout(player: Player)
	local s = getState(player)
	s.Loadout = defaultLoadout()
end

-- Drop the third-person model on death (falls with the ragdoll, then cleans up).
function WeaponServer.OnDeath(player: Player)
	local s = getState(player)
	s.Armed = false
	s.ReloadToken += 1
	local model = s.Model
	s.Model = nil
	if model and model.PrimaryPart then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Weld") and d.Name ~= "MagWeld" then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.CanCollide = true
				d.Massless = false
			end
		end
		model.Parent = workspace
		game:GetService("Debris"):AddItem(model, 6)
	end
	sendState(player)
end

-- Called by CombatServer for every shot request. Returns (ok, weaponData, reason).
function WeaponServer.TryConsumeShot(player: Player, slot: string)
	local s = states[player]
	if not s or not s.Armed then
		return false, nil, "unarmed"
	end
	if s.Equipped ~= slot or (slot ~= "Primary" and slot ~= "Secondary") then
		return false, nil, "slot"
	end
	local w = WeaponData.Get(s.Loadout[slot])
	if not w or not w.MagSize then
		return false, nil, "weapon"
	end
	local t = now()
	if t < s.EquippedAt + w.EquipTime * 0.75 then
		return false, w, "drawing"
	end
	if t < s.ReloadingUntil - 0.15 then
		return false, w, "reloading"
	end
	local ammo = s.Ammo[slot]
	if not ammo or ammo.Mag <= 0 then
		return false, w, "empty"
	end
	local burst = s.Burst and w.AltFire == "Burst"
	local interval = burst and (60 / w.BurstRPM) or (60 / w.RPM)
	if t - s.LastFire < interval * 0.7 then
		return false, w, "rate"
	end
	-- sliding one-second window guards against sustained speed hacks
	local window = s.ShotTimes
	while window[1] and t - window[1] > 1 do
		table.remove(window, 1)
	end
	local maxPerSecond = burst and (w.BurstCount * 3 + 1) or (math.ceil(w.RPM / 60 * 1.15) + 1)
	if #window >= maxPerSecond then
		return false, w, "rate"
	end
	table.insert(window, t)
	s.LastFire = t
	ammo.Mag -= 1
	SpawnManager.EndProtection(player)
	return true, w, nil
end

function WeaponServer.TryMelee(player: Player, heavy: boolean)
	local s = states[player]
	if not s or not s.Armed or s.Equipped ~= "Melee" then
		return false, nil
	end
	local w = WeaponData.Get("Knife")
	local t = now()
	if t < s.EquippedAt + w.EquipTime * 0.75 then
		return false, w
	end
	local cd = heavy and w.Stab.Cooldown or w.Slash.Cooldown
	if t - s.LastFire < cd * 0.8 then
		return false, w
	end
	s.LastFire = t
	SpawnManager.EndProtection(player)
	return true, w
end

function WeaponServer.GetEquippedId(player: Player): string?
	local s = states[player]
	return s and s.Equipped and s.Loadout[s.Equipped] or nil
end

function WeaponServer.GetModel(player: Player): Model?
	local s = states[player]
	return s and s.Model
end

-- Remotes --------------------------------------------------------------------------------

local function onEquip(player: Player, slot)
	if type(slot) ~= "string" or not RateLimiter.Check(player, "Equip", 10, 12) then
		return
	end
	if slot ~= "Primary" and slot ~= "Secondary" and slot ~= "Melee" then
		return
	end
	if equip(player, slot) then
		sendState(player)
	end
end

local function onReload(player: Player, slot)
	if type(slot) ~= "string" or not RateLimiter.Check(player, "Reload", 4, 6) then
		return
	end
	local s = states[player]
	if not s or not s.Armed or s.Equipped ~= slot then
		return
	end
	local w = WeaponData.Get(s.Loadout[slot])
	local ammo = s.Ammo[slot]
	if not w or not ammo or not w.MagSize then
		return
	end
	if ammo.Mag >= w.MagSize or ammo.Reserve <= 0 or now() < s.ReloadingUntil then
		Net.Event("AmmoUpdate"):FireClient(player, slot, ammo.Mag, ammo.Reserve, false)
		return
	end
	s.ReloadToken += 1
	local token = s.ReloadToken
	s.ReloadingUntil = now() + w.ReloadTime
	task.delay(w.ReloadTime, function()
		if s.ReloadToken ~= token or not s.Armed or s.Equipped ~= slot then
			return
		end
		local need = w.MagSize - ammo.Mag
		local take = math.min(need, ammo.Reserve)
		ammo.Mag += take
		ammo.Reserve -= take
		s.ReloadingUntil = 0
		Net.Event("AmmoUpdate"):FireClient(player, slot, ammo.Mag, ammo.Reserve, true)
	end)
end

local function onScope(player: Player, scoped)
	if type(scoped) ~= "boolean" or not RateLimiter.Check(player, "Scope", 10, 10) then
		return
	end
	local s = states[player]
	if not s or not s.Armed then
		return
	end
	local id = s.Equipped and s.Loadout[s.Equipped]
	local w = id and WeaponData.Get(id)
	if not w then
		return
	end
	if w.AltFire == "Burst" then
		s.Burst = scoped
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and w.ScopedMoveSpeed then
		humanoid.WalkSpeed = Config.Player.BaseWalkSpeed * (scoped and w.ScopedMoveSpeed or w.MoveSpeed)
	end
end

local function onSetLoadout(player: Player, request)
	if type(request) ~= "table" or not RateLimiter.Check(player, "Loadout", 2, 4) then
		return { Ok = false, Message = "Invalid request." }
	end
	local ok, reason = WeaponServer.CanChangeLoadout(player)
	if not ok then
		return { Ok = false, Message = reason or "You can only change weapons in your spawn." }
	end
	local pistol, primary = request.Secondary, request.Primary
	if pistol == nil then
		pistol = "USP"
	end
	if type(pistol) ~= "string" or not WeaponData.IsPistol(pistol) then
		return { Ok = false, Message = "Pick one pistol." }
	end
	if primary ~= nil and (type(primary) ~= "string" or not WeaponData.IsPrimary(primary)) then
		return { Ok = false, Message = "Pick one rifle OR one sniper." }
	end
	local s = getState(player)
	s.Loadout = { Primary = primary, Secondary = pistol, Melee = "Knife" }
	if s.Armed then
		refill(s)
		s.Equipped = nil
		equip(player, primary and "Primary" or "Secondary")
	end
	sendState(player)
	return { Ok = true, Message = "Loadout confirmed.", Loadout = s.Loadout }
end

function WeaponServer.Init()
	Net.Event("EquipSlot").OnServerEvent:Connect(onEquip)
	Net.Event("Reload").OnServerEvent:Connect(onReload)
	Net.Event("ScopeState").OnServerEvent:Connect(onScope)
	Net.Function("SetLoadout").OnServerInvoke = onSetLoadout
	Players.PlayerRemoving:Connect(function(player)
		local s = states[player]
		if s and s.Model then
			s.Model:Destroy()
		end
		states[player] = nil
	end)
end

return WeaponServer
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000003C"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool><float name="CameraMaxZoomDistance">22</float></Properties><Item class="StarterPlayerScripts" referent="RBX00000029"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000002A"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[--[[
	ClientMain (client bootstrap)
	Initialises every client controller in dependency order and feeds server state into
	ClientState (profile, match state).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Sounds = require(ReplicatedStorage.Shared.Sounds)

local Controllers = script.Parent:WaitForChild("Controllers")
local ClientState = require(Controllers.ClientState)

local order = {
	"SettingsController",
	"LightingController",
	"CameraController",
	"InputController",
	"Toast",
	"EffectsController",
	"WeaponController",
	"WeaponShopUI",
	"HUDController",
	"MobileControls",
	"SkinShopUI",
	"LobbyUI",
	"ResultsUI",
}

-- server state -> ClientState
Net.Event("ProfileUpdate").OnClientEvent:Connect(function(profile)
	if type(profile) == "table" then
		ClientState.SetProfile(profile)
	end
end)
Net.Event("MatchState").OnClientEvent:Connect(function(payload)
	if type(payload) == "table" then
		ClientState.SetMatch(payload)
	end
end)

for _, name in ipairs(order) do
	local module = Controllers:FindFirstChild(name)
	if module then
		local ok, err = pcall(function()
			local controller = require(module)
			if controller.Init then
				controller.Init()
			end
		end)
		if not ok then
			warn("[ClientMain] " .. name .. " failed to start: " .. tostring(err))
		end
	end
end

task.spawn(function()
	local ok, profile = pcall(function()
		return Net.Function("GetProfile"):InvokeServer()
	end)
	if ok and type(profile) == "table" then
		ClientState.SetProfile(profile)
	end
end)

-- route every character sound (footsteps, jumps...) through the SFX volume group
local function hookCharacter(character: Model)
	local group = Sounds.GetGroup("SFX")
	local function apply(d)
		if d:IsA("Sound") then
			d.SoundGroup = group
		end
	end
	for _, d in ipairs(character:GetDescendants()) do
		apply(d)
	end
	character.DescendantAdded:Connect(apply)
end
local function hookPlayer(p: Player)
	if p.Character then
		hookCharacter(p.Character)
	end
	p.CharacterAdded:Connect(hookCharacter)
end
for _, p in ipairs(Players:GetPlayers()) do
	hookPlayer(p)
end
Players.PlayerAdded:Connect(hookPlayer)

-- teammates get name tags, enemies don't (enemy names would make hiding pointless)
local function updateNameTags()
	local myTeam = Players.LocalPlayer:GetAttribute("Team")
	for _, p in ipairs(Players:GetPlayers()) do
		local hum = p ~= Players.LocalPlayer and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			local team = p:GetAttribute("Team")
			if myTeam == nil then
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
			elseif team == myTeam then
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
				hum.NameDisplayDistance = 120
			else
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
		end
	end
end
task.spawn(function()
	while true do
		task.wait(1)
		updateNameTags()
	end
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000002B"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[--[[
	CameraController
	First-person in matches, third person in the lobby, death cam, FOV (sniper zoom),
	mouse sensitivity and cursor visibility. ResultsUI takes the camera over with SetCinematic.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)
local ClientState = require(script.Parent.ClientState)

local CameraController = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local BASE_FOV = 78
local targetFov = BASE_FOV
local cinematic = false
local dead = false

CameraController.BaseFov = BASE_FOV

function CameraController.SetFov(fov: number?)
	targetFov = fov or BASE_FOV
end

function CameraController.GetZoomScale(): number
	return camera.FieldOfView / BASE_FOV
end

function CameraController.SetCinematic(on: boolean)
	cinematic = on
	if on then
		camera.CameraType = Enum.CameraType.Scriptable
	else
		camera.CameraType = Enum.CameraType.Custom
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			camera.CameraSubject = hum
		end
	end
	CameraController.Refresh()
end

function CameraController.IsCinematic(): boolean
	return cinematic
end

function CameraController.Refresh()
	if cinematic then
		player.CameraMode = Enum.CameraMode.Classic
		return
	end
	if ClientState.InMatch and not dead then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 0.5
	elseif ClientState.InMatch and dead then
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = 14
		player.CameraMinZoomDistance = 10
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = 22
		player.CameraMinZoomDistance = 6
	end
end

local function onCharacter(character: Model)
	dead = false
	targetFov = BASE_FOV
	local hum = character:WaitForChild("Humanoid", 10) :: Humanoid
	if hum then
		camera.CameraSubject = hum
		hum.Died:Connect(function()
			dead = true
			targetFov = BASE_FOV
			CameraController.Refresh()
		end)
	end
	CameraController.Refresh()
end

-- Put the camera behind the character, looking where it faces (spawns face the map pads in
-- the lobby and the enemy side in matches). Called once the server has placed the character.
function CameraController.FaceForward()
	if cinematic then
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		return
	end
	flat = flat.Unit
	local target = root.Position + Vector3.new(0, 2, 0)
	camera.CFrame = CFrame.lookAt(target - flat * 14 + Vector3.new(0, 4, 0), target + flat * 10)
end

function CameraController.Init()
	Net.Event("Spawned").OnClientEvent:Connect(function()
		CameraController.Refresh()
		CameraController.FaceForward()
	end)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)
	ClientState.MatchChanged:Connect(function()
		CameraController.Refresh()
	end)

	RunService.RenderStepped:Connect(function(dt)
		-- smooth FOV changes (scope in/out)
		if not cinematic then
			camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(1, dt * 18)
		end
		-- mouse sensitivity scaled by zoom so scoped aiming feels consistent
		local sens = ClientState.Settings.MouseSensitivity or 1
		UserInputService.MouseDeltaSensitivity = sens * math.clamp(camera.FieldOfView / BASE_FOV, 0.15, 1)
		-- custom crosshair replaces the cursor in first person
		local hideCursor = ClientState.InMatch and not dead and not cinematic and not ClientState.IsMenuOpen()
		UserInputService.MouseIconEnabled = not hideCursor
	end)
end

return CameraController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">ClientState</string><ProtectedString name="Source"><![CDATA[--[[
	ClientState
	Single source of truth on the client for profile, settings, match state and which menus
	are open. Controllers listen to its signals instead of talking to each other directly.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage.Shared.Signal)

local ClientState = {}

ClientState.Player = Players.LocalPlayer
ClientState.Profile = nil
ClientState.Settings = {
	MasterVolume = 0.8,
	MusicVolume = 0.6,
	SfxVolume = 0.9,
	MouseSensitivity = 1,
	TouchSensitivity = 1,
	CrosshairColor = "Green",
	CrosshairSize = 8,
	CrosshairGap = 4,
	CrosshairThickness = 2,
	CrosshairDot = false,
	Effects = "High",
}
ClientState.Match = nil -- last MatchState payload (nil / State="Lobby" while in the lobby)
ClientState.Lobby = nil -- last LobbyState payload
ClientState.InMatch = false
ClientState.Alive = false
ClientState.Menus = {}

ClientState.ProfileChanged = Signal.new()
ClientState.SettingsChanged = Signal.new()
ClientState.MatchChanged = Signal.new()
ClientState.MenuChanged = Signal.new()
ClientState.LobbyChanged = Signal.new()

ClientState.CrosshairColors = {
	Green = Color3.fromRGB(80, 255, 120),
	White = Color3.fromRGB(255, 255, 255),
	Cyan = Color3.fromRGB(60, 230, 255),
	Yellow = Color3.fromRGB(255, 230, 60),
	Red = Color3.fromRGB(255, 70, 70),
	Pink = Color3.fromRGB(255, 110, 220),
}
ClientState.CrosshairOrder = { "Green", "White", "Cyan", "Yellow", "Red", "Pink" }

function ClientState.SetProfile(profile)
	ClientState.Profile = profile
	if profile and profile.Settings then
		for k, v in pairs(profile.Settings) do
			ClientState.Settings[k] = v
		end
		ClientState.SettingsChanged:Fire(ClientState.Settings)
	end
	ClientState.ProfileChanged:Fire(profile)
end

function ClientState.SetMatch(payload)
	ClientState.Match = payload
	ClientState.InMatch = payload ~= nil and payload.State ~= "Lobby" and payload.State ~= "Closed"
	ClientState.MatchChanged:Fire(payload)
end

function ClientState.SetMenu(name: string, open: boolean)
	if (ClientState.Menus[name] == true) == open then
		return
	end
	ClientState.Menus[name] = open or nil
	ClientState.MenuChanged:Fire(name, open)
end

function ClientState.IsMenuOpen(name: string?): boolean
	if name then
		return ClientState.Menus[name] == true
	end
	return next(ClientState.Menus) ~= nil
end

function ClientState.Team(): string?
	return ClientState.Player:GetAttribute("Team")
end

function ClientState.IsLive(): boolean
	return ClientState.InMatch and ClientState.Match ~= nil and ClientState.Match.State == "Live"
end

function ClientState.IsTouch(): boolean
	local UIS = game:GetService("UserInputService")
	return UIS.TouchEnabled and not UIS.MouseEnabled
end

return ClientState
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[--[[
	EffectsController
	Purely visual/audio bullet effects: tracers, muzzle flashes, impact sparks and marks,
	and other players' gunshots (from the server's ShotFx broadcast).
]]

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local WeaponData = require(ReplicatedStorage.WeaponModules.WeaponData)
local ClientState = require(script.Parent.ClientState)

local EffectsController = {}

local folder = Instance.new("Folder")
folder.Name = "LocalEffects"
folder.Parent = workspace.CurrentCamera
EffectsController.Folder = folder

local function lowFx()
	return ClientState.Settings.Effects == "Low"
end

function EffectsController.Tracer(from: Vector3, to: Vector3, color: Color3?)
	local dist = (to - from).Magnitude
	if dist < 1 then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color or Color3.fromRGB(255, 225, 150)
	p.Size = Vector3.new(0.07, 0.07, math.min(dist, 30))
	-- a short streak that travels along the path
	local dir = (to - from).Unit
	local start = CFrame.lookAt(from + dir * (p.Size.Z / 2), to)
	p.CFrame = start
	p.Parent = folder
	local travel = math.max(0, dist - p.Size.Z)
	local t = math.clamp(dist / 900, 0.03, 0.15)
	TweenService:Create(p, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = start + dir * travel, Transparency = 0.6 }):Play()
	Debris:AddItem(p, t + 0.02)
end

function EffectsController.MuzzleFlash(attachmentOrPos: any, suppressed: boolean?)
	local pos = typeof(attachmentOrPos) == "Instance" and attachmentOrPos.WorldPosition or attachmentOrPos
	local flash = Instance.new("Part")
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.CanTouch = false
	flash.CastShadow = false
	flash.Shape = Enum.PartType.Ball
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(255, 200, 110)
	flash.Size = Vector3.one * (suppressed and 0.18 or 0.45)
	flash.Transparency = suppressed and 0.5 or 0.1
	flash.CFrame = CFrame.new(pos)
	flash.Parent = folder
	if not suppressed and not lowFx() then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 180, 90)
		light.Range = 10
		light.Brightness = 3
		light.Parent = flash
	end
	Debris:AddItem(flash, 0.045)
end

function EffectsController.Impact(pos: Vector3, normal: Vector3?, hitCharacter: boolean)
	local n = normal or Vector3.yAxis
	Sounds.Play(hitCharacter and "FleshImpact" or "BulletImpact", pos, { Volume = 0.7 })
	if hitCharacter then
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.one * 0.2
		p.CFrame = CFrame.new(pos)
		p.Parent = folder
		if not lowFx() then
			local e = Instance.new("ParticleEmitter")
			e.Color = ColorSequence.new(Color3.fromRGB(170, 20, 20))
			e.Size = NumberSequence.new(0.25, 0)
			e.Lifetime = NumberRange.new(0.2, 0.4)
			e.Speed = NumberRange.new(4, 9)
			e.SpreadAngle = Vector2.new(40, 40)
			e.Acceleration = Vector3.new(0, -30, 0)
			e.Rate = 0
			e.Parent = p
			e:Emit(8)
		end
		Debris:AddItem(p, 0.6)
		return
	end
	-- bullet mark
	local mark = Instance.new("Part")
	mark.Anchored = true
	mark.CanCollide = false
	mark.CanQuery = false
	mark.CanTouch = false
	mark.CastShadow = false
	mark.Shape = Enum.PartType.Cylinder
	mark.Size = Vector3.new(0.03, 0.28, 0.28)
	mark.Color = Color3.fromRGB(25, 25, 25)
	mark.Material = Enum.Material.SmoothPlastic
	mark.CFrame = CFrame.lookAt(pos, pos + n) * CFrame.Angles(0, math.pi / 2, 0)
	mark.Parent = folder
	Debris:AddItem(mark, 8)
	if not lowFx() then
		local att = Instance.new("Attachment")
		att.WorldPosition = pos
		att.Parent = workspace.Terrain
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(255, 220, 160))
		e.Size = NumberSequence.new(0.18, 0)
		e.Lifetime = NumberRange.new(0.1, 0.25)
		e.Speed = NumberRange.new(6, 14)
		e.SpreadAngle = Vector2.new(35, 35)
		e.EmissionDirection = Enum.NormalId.Top
		e.Rate = 0
		e.LightEmission = 1
		e.Parent = att
		att.WorldCFrame = CFrame.lookAt(pos, pos + n) * CFrame.Angles(-math.pi / 2, 0, 0)
		e:Emit(5)
		Debris:AddItem(att, 0.5)
	end
end

local function onShotFx(shooter: Player, weaponId: string, origin: Vector3, endPos: Vector3, hit: boolean)
	if typeof(origin) ~= "Vector3" or typeof(endPos) ~= "Vector3" then
		return
	end
	local w = WeaponData.Get(weaponId)
	if not w then
		return
	end
	local from = origin
	local character = shooter and shooter.Character
	local model = character and character:FindFirstChild("EquippedWeapon")
	local muzzle = model and model:FindFirstChild("Muzzle", true)
	if muzzle and muzzle:IsA("Attachment") then
		from = muzzle.WorldPosition
		EffectsController.MuzzleFlash(muzzle, w.Suppressed)
	end
	EffectsController.Tracer(from, endPos)
	EffectsController.Impact(endPos, (from - endPos).Unit, hit)
	Sounds.Play(w.Sound, from, { Volume = w.Suppressed and 0.6 or 1.2 })
end

function EffectsController.Init()
	Net.Event("ShotFx").OnClientEvent:Connect(onShotFx)
end

return EffectsController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">HUDController</string><ProtectedString name="Source"><![CDATA[--[[
	HUDController
	In-match HUD: timer + team counts/score, your team & kills, health, weapon & ammo,
	weapon slots, dynamic crosshair, hit markers, damage direction, kill feed, death screen,
	warmup countdown, spawn protection, shop hint, scoreboard (Tab) and the sniper scope.
	Also owns the top-bar Shop / Settings / Scoreboard buttons (used on phones and PCs).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Util = require(ReplicatedStorage.Shared.Util)
local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local WeaponData = require(ReplicatedStorage.WeaponModules.WeaponData)
local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local InputController = require(script.Parent.InputController)
local WeaponController = require(script.Parent.WeaponController)
local CameraController = require(script.Parent.CameraController)
local WeaponShopUI = require(script.Parent.WeaponShopUI)
local SettingsController = require(script.Parent.SettingsController)

local HUDController = {}

local T = UIKit.T
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local hud, topbar, scopeGui
local ui = {}
local deathInfo = nil
local lastCountdown = -1
local lastState = nil
local scoreboardOpen = false

local function teamColor(team)
	return team and Config.Teams[team] and Config.Teams[team].Color or T.Sub
end

-- TOP BAR BUTTONS (outside the scaled HUD so they line up with Roblox's own buttons) ---------
local function buildTopbar()
	topbar = Instance.new("ScreenGui")
	topbar.Name = "TopbarButtons"
	topbar.ResetOnSpawn = false
	topbar.IgnoreGuiInset = true
	topbar.DisplayOrder = 60
	topbar.Parent = UIKit.PlayerGui
	local holder = UIKit.New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(400, 44), Parent = topbar })
	UIKit.New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center, Parent = holder })
	local function place()
		local x, y, h = 104, 4, 44
		local ok, inset = pcall(function()
			return GuiService.TopbarInset
		end)
		if ok and inset and inset.Width > 0 then
			x = inset.Min.X + 8
			h = math.max(32, inset.Height - 8)
			y = inset.Min.Y + (inset.Height - h) / 2
		end
		holder.Position = UDim2.fromOffset(x, y)
		holder.Size = UDim2.fromOffset(400, h)
	end
	place()
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(place)
	end)
	local function topButton(name, text, w, onClick)
		local b = UIKit.Button({
			Name = name,
			Text = text,
			TextSize = 14,
			Size = UDim2.new(0, w, 1, 0),
			BackgroundColor3 = Color3.fromRGB(18, 20, 26),
			BackgroundTransparency = 0.25,
			Corner = UDim.new(1, 0),
			Parent = holder,
		}, onClick)
		return b
	end
	ui.ShopButton = topButton("Shop", "SHOP (B)", 104, function()
		WeaponShopUI.Toggle()
	end)
	ui.ScoreButton = topButton("Score", "SCORE", 80, function()
		HUDController.SetScoreboard(not scoreboardOpen)
	end)
	ui.GearButton = topButton("Settings", "SETTINGS", 96, function()
		SettingsController.Toggle()
	end)
	if ClientState.IsTouch() then
		ui.ShopButton.Text = "SHOP"
	end
end

-- MAIN HUD ---------------------------------------------------------------------------
local function buildHud()
	hud = UIKit.Screen("HUD", 5)
	local touch = ClientState.IsTouch()

	-- top centre: timer + teams
	local top = UIKit.New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(460, 64), Parent = hud })
	local function teamBox(team, x, anchor)
		local f = UIKit.New("Frame", {
			AnchorPoint = Vector2.new(anchor, 0),
			Position = UDim2.new(x, 0, 0, 0),
			Size = UDim2.fromOffset(150, 52),
			BackgroundColor3 = T.Panel,
			BackgroundTransparency = 0.15,
			Corner = 8,
			Parent = top,
		})
		UIKit.New("Frame", { BackgroundColor3 = teamColor(team), Size = UDim2.new(1, 0, 0, 3), BorderSizePixel = 0, Parent = f })
		local score = UIKit.Label({ Text = "0", Font = UIKit.FontBlack, TextSize = 26, TextColor3 = teamColor(team), TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 28), Parent = f })
		local count = UIKit.Label({ Text = "", TextSize = 12, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 16), Parent = f })
		return score, count
	end
	ui.RedScore, ui.RedCount = teamBox("Red", 0, 0)
	ui.BlueScore, ui.BlueCount = teamBox("Blue", 1, 1)
	local timerBox = UIKit.New("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(140, 60), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.1, Corner = 8, Stroke = { Color = T.Stroke }, Parent = top })
	ui.Timer = UIKit.Label({ Text = "10:00", Font = UIKit.FontBlack, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 34), Parent = timerBox })
	ui.Phase = UIKit.Label({ Text = "", TextSize = 11, TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 16), Parent = timerBox })

	-- player panel (bottom-left on PC, top-left on touch so the thumbstick stays free)
	local pp = UIKit.New("Frame", {
		AnchorPoint = touch and Vector2.new(0, 0) or Vector2.new(0, 1),
		Position = touch and UDim2.new(0, 16, 0, 64) or UDim2.new(0, 20, 1, -20),
		Size = UDim2.fromOffset(300, 92),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.15,
		Corner = 10,
		Parent = hud,
	})
	ui.TeamPill = UIKit.Label({ Text = "RED TEAM", TextSize = 12, Font = UIKit.FontBlack, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0, BackgroundColor3 = T.Red, TextColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(100, 22), Corner = 6, Parent = pp })
	ui.Kills = UIKit.Label({ Text = "KILLS 0", TextSize = 16, Font = UIKit.FontBlack, Position = UDim2.fromOffset(124, 10), Size = UDim2.fromOffset(90, 22), Parent = pp })
	ui.Deaths = UIKit.Label({ Text = "DEATHS 0", TextSize = 13, TextColor3 = T.Sub, Position = UDim2.fromOffset(214, 10), Size = UDim2.fromOffset(80, 22), Parent = pp })
	ui.HealthText = UIKit.Label({ Text = "100", Font = UIKit.FontBlack, TextSize = 34, Position = UDim2.fromOffset(12, 38), Size = UDim2.fromOffset(70, 40), Parent = pp })
	local hpTrack = UIKit.New("Frame", { Position = UDim2.fromOffset(84, 54), Size = UDim2.fromOffset(200, 12), BackgroundColor3 = T.Panel3, Corner = 6, Parent = pp })
	ui.HealthFill = UIKit.New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Good, Corner = 6, Parent = hpTrack })
