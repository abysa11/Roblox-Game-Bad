	-- centre messages
	ui.BigText = UIKit.Label({ Text = "", Font = UIKit.FontBlack, TextSize = 46, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.5, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.32), Size = UDim2.fromOffset(800, 60), Parent = hud })
	ui.SubText = UIKit.Label({ Text = "", TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.6, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.32, 44), Size = UDim2.fromOffset(800, 26), Parent = hud })
	ui.Protection = UIKit.Label({ Text = "SPAWN PROTECTION", TextSize = 14, Font = UIKit.FontBlack, TextColor3 = Color3.fromRGB(140, 220, 255), TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 60), Size = UDim2.fromOffset(300, 20), Visible = false, Parent = hud })
	ui.ShopHint = UIKit.Label({
		Text = touch and "In spawn: tap SHOP to change weapons" or "In spawn: press B to open the weapon shop",
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundTransparency = 0.3,
		BackgroundColor3 = T.Panel,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, touch and -96 or -30),
		Size = UDim2.fromOffset(380, 30),
		Corner = 8,
		Visible = false,
		Parent = hud,
	})

	-- death screen
	ui.Death = UIKit.New("Frame", { BackgroundColor3 = Color3.fromRGB(60, 0, 0), BackgroundTransparency = 0.65, Size = UDim2.fromScale(1, 1), Visible = false, Parent = hud })
	ui.DeathTitle = UIKit.Label({ Text = "ELIMINATED", Font = UIKit.FontBlack, TextSize = 52, TextColor3 = T.Bad, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.38), Size = UDim2.fromOffset(700, 60), Parent = ui.Death })
	ui.DeathBy = UIKit.Label({ Text = "", TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.38, 50), Size = UDim2.fromOffset(700, 28), Parent = ui.Death })
	ui.DeathTimer = UIKit.Label({ Text = "", TextSize = 16, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.38, 84), Size = UDim2.fromOffset(700, 22), Parent = ui.Death })

	-- scoreboard
	local sb = UIKit.New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(760, 460), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.05, Corner = 12, Visible = false, Parent = hud })
	ui.Scoreboard = sb
	ui.ScoreTitle = UIKit.Label({ Text = "SCOREBOARD", Font = UIKit.FontBlack, TextSize = 20, Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -40, 0, 26), Parent = sb })
	ui.ScoreCols = {}
	for i, team in ipairs({ "Red", "Blue" }) do
		local col = UIKit.New("Frame", { BackgroundColor3 = T.Panel2, Position = UDim2.new((i - 1) * 0.5, i == 1 and 16 or 8, 0, 50), Size = UDim2.new(0.5, -24, 1, -66), Corner = 8, Parent = sb })
		UIKit.New("Frame", { BackgroundColor3 = teamColor(team), Size = UDim2.new(1, 0, 0, 3), BorderSizePixel = 0, Parent = col })
		UIKit.Label({ Text = Config.Teams[team].Name:upper(), TextSize = 14, Font = UIKit.FontBlack, TextColor3 = teamColor(team), Position = UDim2.fromOffset(12, 8), Size = UDim2.new(0.6, 0, 0, 20), Parent = col })
		UIKit.Label({ Text = "K      D", TextSize = 12, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(0.6, 0, 0, 10), Size = UDim2.new(0.4, -14, 0, 18), Parent = col })
		local rows = UIKit.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), Parent = col })
		UIKit.New("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = rows })
		ui.ScoreCols[team] = rows
	end

	-- sniper scope (circle cut-out made with a huge UIStroke)
	scopeGui = UIKit.Screen("Scope", 4, true)
	scopeGui.Enabled = false
	local ring = UIKit.New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.9, 0.9), Corner = UDim.new(0.5, 0), Parent = scopeGui })
	UIKit.New("UIAspectRatioConstraint", { AspectRatio = 1, Parent = ring })
	-- the stroke fills the corners between the circle and its square; big frames cover the rest
	UIKit.New("UIStroke", { Thickness = 400, Color = Color3.new(0, 0, 0), ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = ring })
	for _, f in ipairs({
		{ Vector2.new(1, 0.5), UDim2.new(0, 1, 0.5, 0), UDim2.fromOffset(4000, 8000) },
		{ Vector2.new(0, 0.5), UDim2.new(1, -1, 0.5, 0), UDim2.fromOffset(4000, 8000) },
		{ Vector2.new(0.5, 1), UDim2.new(0.5, 0, 0, 1), UDim2.new(1, 0, 0, 4000) },
		{ Vector2.new(0.5, 0), UDim2.new(0.5, 0, 1, -1), UDim2.new(1, 0, 0, 4000) },
	}) do
		UIKit.New("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = f[1], Position = f[2], Size = f[3], Parent = ring })
	end
	UIKit.New("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 2), Parent = ring })
	UIKit.New("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 1, 0), Parent = ring })
	UIKit.New("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(255, 60, 60), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), Corner = 2, Parent = ring })
end

-- UPDATERS -----------------------------------------------------------------------------

local function refreshScoreboard()
	local m = ClientState.Match
	if not m or not m.Roster then
		return
	end
	for team, rows in pairs(ui.ScoreCols) do
		for _, c in ipairs(rows:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local list = {}
		for _, r in ipairs(m.Roster) do
			if r.Team == team then
				table.insert(list, r)
			end
		end
		table.sort(list, function(a, b)
			if a.Kills ~= b.Kills then
				return a.Kills > b.Kills
			end
			return a.Deaths < b.Deaths
		end)
		for i, r in ipairs(list) do
			local row = UIKit.New("Frame", { LayoutOrder = i, BackgroundColor3 = r.UserId == player.UserId and T.Panel3 or T.Panel2, BackgroundTransparency = 0, Size = UDim2.new(1, 0, 0, 28), Parent = rows })
			UIKit.Label({ Text = r.Name, TextSize = 14, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.6, -12, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
			UIKit.Label({ Text = string.format("%d     %d", r.Kills, r.Deaths), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(0.6, 0, 0, 0), Size = UDim2.new(0.4, -14, 1, 0), Parent = row })
		end
	end
	ui.ScoreTitle.Text = string.format("SCOREBOARD  -  %s", (m.MapName or ""):upper())
end

function HUDController.SetScoreboard(open: boolean)
	scoreboardOpen = open
	if ui.Scoreboard then
		ui.Scoreboard.Visible = open and ClientState.InMatch
		if open then
			refreshScoreboard()
		end
	end
end

local function refreshMatch()
	local m = ClientState.Match
	if not m or not ClientState.InMatch then
		return
	end
	ui.RedScore.Text = tostring(m.RedKills or 0)
	ui.BlueScore.Text = tostring(m.BlueKills or 0)
	ui.RedCount.Text = string.format("RED  ·  %d PLAYERS", m.Red or 0)
	ui.BlueCount.Text = string.format("BLUE  ·  %d PLAYERS", m.Blue or 0)
	local team = ClientState.Team()
	ui.TeamPill.Text = team and Config.Teams[team].Name:upper() or "NO TEAM"
	ui.TeamPill.BackgroundColor3 = teamColor(team)
	if m.State ~= lastState then
		if m.State == "Live" and lastState == "Warmup" then
			Sounds.Play("MatchStart")
			ui.BigText.Text = "FIGHT!"
			ui.SubText.Text = "Most kills in 10 minutes wins"
			task.delay(2, function()
				if ClientState.Match and ClientState.Match.State == "Live" then
					ui.BigText.Text = ""
					ui.SubText.Text = ""
				end
			end)
		end
		lastState = m.State
	end
	if scoreboardOpen then
		refreshScoreboard()
	end
end

local function refreshWeapon()
	local info = WeaponController.GetInfo()
	local w = info.Weapon
	if not info.Armed or not w then
		ui.WeaponName.Text = ""
		ui.Ammo.Text = ""
		ui.Reserve.Text = ""
		ui.Mode.Text = ""
	else
		ui.WeaponName.Text = w.Name:upper()
		if w.MagSize then
			ui.Ammo.Text = tostring(info.Mag or 0)
			ui.Ammo.TextColor3 = (info.Mag or 0) <= math.ceil(w.MagSize * 0.2) and T.Bad or T.Text
			ui.Reserve.Text = "/ " .. tostring(info.Reserve or 0)
		else
			ui.Ammo.Text = "∞"
			ui.Ammo.TextColor3 = T.Text
			ui.Reserve.Text = "MELEE"
		end
		if w.AltFire == "Burst" then
			ui.Mode.Text = info.Burst and "BURST (RMB)" or "SEMI (RMB: BURST)"
		elseif w.ScopeLevels then
			ui.Mode.Text = "RMB: SCOPE"
		elseif w.FireMode == "Melee" then
			ui.Mode.Text = "LMB SLASH · RMB STAB"
		else
			ui.Mode.Text = w.FireMode:upper()
		end
	end
	for i, slot in ipairs({ "Primary", "Secondary", "Melee" }) do
		local label = ui.Slots[slot]
		if label then
			local id = info.Loadout and info.Loadout[slot]
			local wd = id and WeaponData.Get(id)
			label.Text = string.format("%d  %s", i, wd and wd.Name or "-")
			label.BackgroundColor3 = (info.Slot == slot) and T.Accent or T.Panel2
			label.TextColor3 = (info.Slot == slot) and Color3.new(0, 0, 0) or (wd and T.Text or T.Sub)
		end
	end
end

local function addKillFeed(entry)
	local row = UIKit.New("Frame", { BackgroundColor3 = T.Panel, BackgroundTransparency = 0.2, Size = UDim2.fromOffset(380, 28), Corner = 6, Parent = ui.KillFeed })
	local involved = entry.Killer == player.DisplayName or entry.Victim == player.DisplayName
	if involved then
		UIKit.New("UIStroke", { Color = T.Accent, Thickness = 1, Parent = row })
	end
	UIKit.New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), Parent = row })
	UIKit.New("UIPadding", { PaddingRight = UDim.new(0, 10), Parent = row })
	local function part(text, color, order, size)
		local l = UIKit.Label({ Text = text, TextSize = size or 14, TextColor3 = color, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), LayoutOrder = order, Parent = row })
		return l
	end
	part(entry.Killer, teamColor(entry.KillerTeam), 1)
	part("[" .. tostring(entry.Weapon) .. "]", T.Sub, 2, 12)
	if entry.Headshot then
		part("HS", T.Gold, 3, 12)
	end
	part(entry.Victim, teamColor(entry.VictimTeam), 4)
	task.delay(6, function()
		row:Destroy()
	end)
	local children = {}
	for _, c in ipairs(ui.KillFeed:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(children, c)
		end
	end
	if #children > 6 then
		children[1]:Destroy()
	end
end

local function showHitMarker(info)
	local color = info.Killed and T.Bad or (info.Headshot and T.Gold or Color3.new(1, 1, 1))
	for _, l in ipairs(ui.HitMarker:GetChildren()) do
		l.BackgroundColor3 = color
	end
	ui.HitMarker.Visible = true
	ui.HitMarker.Size = UDim2.fromOffset(44, 44)
	UIKit.Tween(ui.HitMarker, 0.15, { Size = UDim2.fromOffset(30, 30) })
	local token = os.clock()
	ui.HitMarker:SetAttribute("Token", token)
	task.delay(info.Killed and 0.4 or 0.2, function()
		if ui.HitMarker:GetAttribute("Token") == token then
			ui.HitMarker.Visible = false
		end
	end)
	if info.Killed then
		Sounds.Play("KillConfirm")
	elseif info.Melee then
		Sounds.Play("KnifeHit")
	else
		Sounds.Play(info.Headshot and "HeadshotMarker" or "HitMarker")
	end
end

local function showDamage(fromPos: Vector3, amount: number)
	Sounds.Play("Hurt", nil, { Volume = 0.6 })
	if typeof(fromPos) ~= "Vector3" then
		return
	end
	local camCF = camera.CFrame
	local look = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
	local to = Vector3.new(fromPos.X - camCF.Position.X, 0, fromPos.Z - camCF.Position.Z)
	if look.Magnitude < 0.01 or to.Magnitude < 0.01 then
		return
	end
	look, to = look.Unit, to.Unit
	local angle = math.deg(math.atan2(look:Cross(to).Y, look:Dot(to)))
	local r = math.rad(-angle - 90)
	local ind = UIKit.New("Frame", {
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, math.cos(r) * 110, 0.5, math.sin(r) * 110),
		Size = UDim2.fromOffset(60, 8),
		Rotation = math.deg(r) + 90,
		BackgroundColor3 = T.Bad,
		BackgroundTransparency = math.clamp(0.6 - amount / 100, 0, 0.6),
		Corner = 4,
		Parent = ui.DamageRoot,
	})
	UIKit.Tween(ind, 1, { BackgroundTransparency = 1 })
	task.delay(1, function()
		ind:Destroy()
	end)
end

local function updateCrosshair()
	local s = ClientState.Settings
	local color = ClientState.CrosshairColors[s.CrosshairColor] or Color3.new(1, 1, 1)
	local info = WeaponController.GetInfo()
	local w = info.Weapon
	local spread = WeaponController.GetSpread()
	local pxPerDeg = (camera.ViewportSize.Y / 2) / math.tan(math.rad(camera.FieldOfView / 2)) * math.rad(1)
	local gap = s.CrosshairGap + math.min(spread * pxPerDeg * 0.9, 90)
	local len, thick = s.CrosshairSize, s.CrosshairThickness
	local sniperHip = w and w.Category == "Sniper"
	local show = info.Armed and not CameraController.IsCinematic() and WeaponController.GetScopeLevel() == 0
	ui.Crosshair.Visible = show
	local lines = ui.CrossLines
	local positions = {
		{ UDim2.fromOffset(0, -(gap + len / 2)), UDim2.fromOffset(thick, len) },
		{ UDim2.fromOffset(0, gap + len / 2), UDim2.fromOffset(thick, len) },
		{ UDim2.fromOffset(-(gap + len / 2), 0), UDim2.fromOffset(len, thick) },
		{ UDim2.fromOffset(gap + len / 2, 0), UDim2.fromOffset(len, thick) },
	}
	for i, l in ipairs(lines) do
		l.Position = UDim2.fromScale(0.5, 0.5) + positions[i][1]
		l.Size = positions[i][2]
		l.BackgroundColor3 = color
		l.Visible = not sniperHip
	end
	ui.CrossDot.Visible = s.CrosshairDot or sniperHip
	ui.CrossDot.BackgroundColor3 = color
	ui.CrossDot.Size = UDim2.fromOffset(thick + 1, thick + 1)
	scopeGui.Enabled = info.Armed and WeaponController.GetScopeLevel() > 0 and not CameraController.IsCinematic()
end

local function frame()
	local inMatch = ClientState.InMatch and not CameraController.IsCinematic()
	hud.Enabled = inMatch
	ui.ShopButton.Visible = ClientState.InMatch
	ui.ScoreButton.Visible = ClientState.InMatch
	ui.GearButton.Visible = ClientState.InMatch
	if not inMatch then
		scopeGui.Enabled = false
		return
	end
	local m = ClientState.Match
	local remaining = m and (m.EndsAt or 0) - workspace:GetServerTimeNow() or 0
	if m and m.State == "Warmup" then
		ui.Timer.Text = Util.FormatTime(Config.Match.Duration)
		ui.Phase.Text = "WARMUP"
		local n = math.max(0, math.ceil(remaining))
		ui.BigText.Text = "MATCH STARTS IN " .. n
		ui.SubText.Text = "Change your loadout in the spawn now"
		if n ~= lastCountdown and n > 0 then
			lastCountdown = n
			Sounds.Play("CountdownTick")
		end
	elseif m and m.State == "Live" then
		ui.Timer.Text = Util.FormatTime(remaining)
		ui.Timer.TextColor3 = remaining <= 30 and T.Bad or T.Text
		ui.Phase.Text = "TEAM DEATHMATCH"
		lastCountdown = -1
	else
		ui.Timer.Text = "0:00"
		ui.Phase.Text = m and m.State and m.State:upper() or ""
	end

	-- health
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hp = hum and math.max(0, math.ceil(hum.Health)) or 0
	local maxHp = hum and hum.MaxHealth or 100
	ui.HealthText.Text = tostring(hp)
	ui.HealthFill.Size = UDim2.fromScale(math.clamp(hp / maxHp, 0, 1), 1)
	ui.HealthFill.BackgroundColor3 = hp > 60 and T.Good or (hp > 25 and T.Gold or T.Bad)
	ui.HealthText.TextColor3 = hp > 25 and T.Text or T.Bad
	ui.Kills.Text = "KILLS " .. tostring(player:GetAttribute("Kills") or 0)
	ui.Deaths.Text = "DEATHS " .. tostring(player:GetAttribute("Deaths") or 0)

	-- protection, shop hint, reload
	local prot = player:GetAttribute("ProtectedUntil")
	ui.Protection.Visible = type(prot) == "number" and workspace:GetServerTimeNow() < prot
	ui.ShopHint.Visible = WeaponShopUI.InSpawn() and not ClientState.IsMenuOpen("WeaponShop")
	local info = WeaponController.GetInfo()
	ui.ReloadBar.Visible = info.Reloading
	ui.ReloadFill.Size = UDim2.fromScale(info.ReloadProgress, 1)
	ui.ShopButton.BackgroundColor3 = WeaponShopUI.InSpawn() and T.Accent or Color3.fromRGB(18, 20, 26)
	ui.ShopButton.TextColor3 = WeaponShopUI.InSpawn() and Color3.new(0, 0, 0) or T.Sub

	-- death screen
	local dead = not hum or hum.Health <= 0
	ui.Death.Visible = dead and deathInfo ~= nil
	if ui.Death.Visible then
		local left = math.max(0, math.ceil(deathInfo.RespawnAt - os.clock()))
		ui.DeathTimer.Text = (m and m.State == "Live") and ("Respawning in " .. left) or ""
	end

	updateCrosshair()
end

function HUDController.Init()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
	buildTopbar()
	buildHud()
	hud.Enabled = false

	ClientState.MatchChanged:Connect(refreshMatch)
	WeaponController.Changed:Connect(refreshWeapon)
	player:GetAttributeChangedSignal("Team"):Connect(refreshMatch)

	Net.Event("HitConfirm").OnClientEvent:Connect(function(info)
		if type(info) == "table" then
			showHitMarker(info)
		end
	end)
	Net.Event("Damaged").OnClientEvent:Connect(showDamage)
	Net.Event("KillFeed").OnClientEvent:Connect(function(entry)
		if type(entry) == "table" then
			addKillFeed(entry)
		end
	end)
	Net.Event("Died").OnClientEvent:Connect(function(info)
		deathInfo = { RespawnAt = os.clock() + Config.Match.RespawnDelay }
		ui.DeathBy.Text = string.format("Killed by %s with %s%s", info.Killer or "?", info.Weapon or "?", info.Headshot and "  (HEADSHOT)" or "")
		Sounds.Play("Death")
	end)
	Net.Event("Spawned").OnClientEvent:Connect(function(context)
		if context == "Match" then
			Sounds.Play("Respawn")
		end
		deathInfo = nil
	end)
	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid", 10) :: Humanoid
		if hum then
			hum.Died:Connect(function()
				if not deathInfo then
					deathInfo = { RespawnAt = os.clock() + Config.Match.RespawnDelay }
					ui.DeathBy.Text = "You died"
				end
			end)
		end
	end)

	InputController.Action:Connect(function(name, began)
		if name == "Scoreboard" and ClientState.InMatch and not ClientState.IsTouch() then
			HUDController.SetScoreboard(began)
		elseif name == "Settings" and began then
			SettingsController.Toggle()
		end
	end)

	RunService.RenderStepped:Connect(frame)
	refreshWeapon()
end

return HUDController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">InputController</string><ProtectedString name="Source"><![CDATA[--[[
	InputController
	Turns keyboard / mouse / gamepad / touch-button input into named actions so gameplay code
	never cares which device is used.

	Actions (fired with began = true/false):
	  Fire, Alt (scope / burst toggle / knife stab), Reload, Slot1, Slot2, Slot3,
	  NextWeapon, PrevWeapon, LastWeapon, Shop, Scoreboard, Settings
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Signal)
local ClientState = require(script.Parent.ClientState)

local InputController = {}
InputController.Action = Signal.new()

local KEYS = {
	[Enum.KeyCode.R] = "Reload",
	[Enum.KeyCode.One] = "Slot1",
	[Enum.KeyCode.Two] = "Slot2",
	[Enum.KeyCode.Three] = "Slot3",
	[Enum.KeyCode.Q] = "LastWeapon",
	[Enum.KeyCode.B] = "Shop",
	[Enum.KeyCode.Tab] = "Scoreboard",
	[Enum.KeyCode.P] = "Settings",
	-- gamepad
	[Enum.KeyCode.ButtonR2] = "Fire",
	[Enum.KeyCode.ButtonL2] = "Alt",
	[Enum.KeyCode.ButtonX] = "Reload",
	[Enum.KeyCode.ButtonY] = "NextWeapon",
	[Enum.KeyCode.DPadUp] = "Slot3",
	[Enum.KeyCode.ButtonSelect] = "Scoreboard",
	[Enum.KeyCode.DPadDown] = "Shop",
}

-- Actions that should work even when a menu is open
local MENU_SAFE = { Shop = true, Settings = true, Scoreboard = true }

local held = {}

function InputController.Trigger(name: string, began: boolean)
	if began then
		if held[name] then
			return
		end
		held[name] = true
	else
		if not held[name] then
			return
		end
		held[name] = nil
	end
	if began and ClientState.IsMenuOpen() and not MENU_SAFE[name] then
		held[name] = nil
		return
	end
	InputController.Action:Fire(name, began)
end

function InputController.IsHeld(name: string): boolean
	return held[name] == true
end

function InputController.ReleaseAll()
	for name in pairs(held) do
		InputController.Trigger(name, false)
	end
end

function InputController.Init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not processed then
				InputController.Trigger("Fire", true)
			end
			return
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			if not processed then
				InputController.Trigger("Alt", true)
			end
			return
		end
		local action = KEYS[input.KeyCode]
		if action and (not processed or action == "Scoreboard") then
			InputController.Trigger(action, true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			InputController.Trigger("Fire", false)
			return
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			InputController.Trigger("Alt", false)
			return
		end
		local action = KEYS[input.KeyCode]
		if action then
			InputController.Trigger(action, false)
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseWheel and not processed and ClientState.InMatch then
			local name = input.Position.Z > 0 and "PrevWeapon" or "NextWeapon"
			InputController.Action:Fire(name, true)
		end
	end)
	ClientState.MenuChanged:Connect(function(_, open)
		if open then
			-- stop firing etc. when a menu pops up
			for name in pairs(held) do
				if not MENU_SAFE[name] then
					InputController.Trigger(name, false)
				end
			end
		end
	end)
end

return InputController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">LightingController</string><ProtectedString name="Source"><![CDATA[--[[
	LightingController
	Applies per-map lighting locally (several maps can share one server in Local mode) and
	the player's Effects Quality setting (shadows, post-processing, fire and particles).
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapData = require(ReplicatedStorage.Shared.MapData)
local ClientState = require(script.Parent.ClientState)

local LightingController = {}

local atmosphere, cc, bloom, rays, sky
local currentPreset = MapData.LobbyLighting

local function ensureEffects()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	cc = Lighting:FindFirstChild("FPS_CC") or Instance.new("ColorCorrectionEffect")
	cc.Name = "FPS_CC"
	cc.Parent = Lighting
	bloom = Lighting:FindFirstChild("FPS_Bloom") or Instance.new("BloomEffect")
	bloom.Name = "FPS_Bloom"
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	rays = Lighting:FindFirstChild("FPS_Rays") or Instance.new("SunRaysEffect")
	rays.Name = "FPS_Rays"
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
	sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	sky.Parent = Lighting
end

local function applyQuality()
	local q = ClientState.Settings.Effects
	Lighting.GlobalShadows = q ~= "Low"
	bloom.Enabled = q ~= "Low"
	rays.Enabled = q == "High"
	atmosphere.Density = (currentPreset.AtmosphereDensity or 0.3) * (q == "Low" and 0.5 or 1)
	local maps = workspace:FindFirstChild("Maps")
	local function setEffect(d)
		if d:IsA("Fire") or d:IsA("Sparkles") then
			d.Enabled = q ~= "Low"
		elseif d:IsA("ParticleEmitter") and not d:FindFirstAncestor("Podium") then
			d.Enabled = q ~= "Low"
		elseif d:IsA("PointLight") or d:IsA("SpotLight") then
			d.Shadows = q == "High" and d:GetAttribute("WantsShadows") == true
		end
	end
	if maps then
		for _, d in ipairs(maps:GetDescendants()) do
			setEffect(d)
		end
	end
	return setEffect
end

local function applyPreset(preset)
	currentPreset = preset
	Lighting.ClockTime = preset.ClockTime
	Lighting.Brightness = preset.Brightness
	Lighting.Ambient = preset.Ambient
	Lighting.OutdoorAmbient = preset.OutdoorAmbient
	Lighting.FogColor = preset.FogColor
	Lighting.FogEnd = preset.FogEnd
	Lighting.FogStart = 0
	atmosphere.Color = preset.AtmosphereColor
	atmosphere.Decay = preset.AtmosphereDecay
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2
	cc.TintColor = preset.Tint
	cc.Saturation = preset.Saturation or 0.08
	cc.Contrast = 0.06
	applyQuality()
end

function LightingController.Init()
	ensureEffects()
	applyPreset(MapData.LobbyLighting)
	ClientState.MatchChanged:Connect(function(payload)
		if ClientState.InMatch and payload and payload.MapId then
			local map = MapData.Get(payload.MapId)
			if map and currentPreset ~= map.Lighting then
				applyPreset(map.Lighting)
			end
		elseif currentPreset ~= MapData.LobbyLighting then
			applyPreset(MapData.LobbyLighting)
		end
	end)
	ClientState.SettingsChanged:Connect(function()
		applyQuality()
	end)
	-- streamed-in map content picks up the current quality too
	task.spawn(function()
		local maps = workspace:WaitForChild("Maps", 60)
		if maps then
			maps.DescendantAdded:Connect(function(d)
				if d:IsA("Fire") or d:IsA("ParticleEmitter") or d:IsA("Sparkles") or d:IsA("PointLight") or d:IsA("SpotLight") then
					task.defer(function()
						if d.Parent then
							local q = ClientState.Settings.Effects
							if d:IsA("Fire") or d:IsA("Sparkles") then
								d.Enabled = q ~= "Low"
							elseif d:IsA("ParticleEmitter") and not d:FindFirstAncestor("Podium") then
								d.Enabled = q ~= "Low"
							end
						end
					end)
				end
			end)
		end
	end)
end

return LightingController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">LobbyUI</string><ProtectedString name="Source"><![CDATA[--[[
	LobbyUI
	Main-menu overlay shown in the hub: player profile (avatar, name, points, lifetime stats),
	live map queue list, queue status banner, Skin Shop and Settings buttons.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Config = require(ReplicatedStorage.Shared.Config)
local MapData = require(ReplicatedStorage.Shared.MapData)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local CameraController = require(script.Parent.CameraController)
local SkinShopUI = require(script.Parent.SkinShopUI)
local SettingsController = require(script.Parent.SettingsController)

local LobbyUI = {}

local T = UIKit.T
local player = Players.LocalPlayer
local screen
local ui = {}
local lastQueued = nil

local function build()
	screen = UIKit.Screen("MainMenu", 3)
	local touch = ClientState.IsTouch()

	-- profile card
	local card = UIKit.New("Frame", { Position = UDim2.fromOffset(16, 60), Size = UDim2.fromOffset(320, 112), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, Corner = 12, Parent = screen })
	UIKit.New("Frame", { BackgroundColor3 = T.Accent, Size = UDim2.new(0, 3, 1, -20), Position = UDim2.fromOffset(0, 10), BorderSizePixel = 0, Parent = card })
	local avatar = UIKit.New("ImageLabel", { BackgroundColor3 = T.Panel3, Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(84, 84), Corner = 10, Parent = card })
	task.spawn(function()
		if player.UserId > 0 then
			local ok, url = pcall(function()
				return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
			end)
			if ok then
				avatar.Image = url
			end
		end
	end)
	UIKit.Label({ Text = player.DisplayName, Font = UIKit.FontBlack, TextSize = 20, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(110, 14), Size = UDim2.fromOffset(200, 24), Parent = card })
	UIKit.Label({ Text = "@" .. player.Name, TextSize = 12, Font = UIKit.FontRegular, TextColor3 = T.Sub, Position = UDim2.fromOffset(110, 38), Size = UDim2.fromOffset(200, 16), Parent = card })
	ui.Points = UIKit.Label({ Text = "0 POINTS", Font = UIKit.FontBlack, TextSize = 18, TextColor3 = T.Gold, Position = UDim2.fromOffset(110, 58), Size = UDim2.fromOffset(200, 22), Parent = card })
	ui.Stats = UIKit.Label({ Text = "", TextSize = 12, TextColor3 = T.Sub, Position = UDim2.fromOffset(110, 82), Size = UDim2.fromOffset(200, 16), Parent = card })

	-- map queue list
	-- bottom-right, above the buttons: the top-right corner belongs to Roblox's player list
	local maps = UIKit.New("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -84),
		Size = UDim2.fromOffset(300, 46 + #MapData.Order * 46),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.1,
		Corner = 12,
		Visible = not touch,
		Parent = screen,
	})
	UIKit.Label({ Text = "SELECT A MAP", Font = UIKit.FontBlack, TextSize = 14, Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(200, 18), Parent = maps })
	UIKit.Label({ Text = "Walk onto a pad", TextSize = 11, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -150, 0, 12), Size = UDim2.fromOffset(136, 14), Parent = maps })
	ui.MapRows = {}
	for i, id in ipairs(MapData.Order) do
		local m = MapData.Get(id)
		local row = UIKit.New("Frame", { BackgroundColor3 = T.Panel2, Position = UDim2.fromOffset(10, 38 + (i - 1) * 46), Size = UDim2.new(1, -20, 0, 40), Corner = 8, Parent = maps })
		UIKit.New("Frame", { BackgroundColor3 = m.Color, Size = UDim2.new(0, 4, 1, -12), Position = UDim2.fromOffset(6, 6), Corner = 2, Parent = row })
		UIKit.Label({ Text = m.Name, TextSize = 14, Position = UDim2.fromOffset(18, 3), Size = UDim2.new(1, -110, 0, 18), Parent = row })
		UIKit.Label({ Text = m.Subtitle, TextSize = 10, TextColor3 = m.Color, Position = UDim2.fromOffset(18, 21), Size = UDim2.new(1, -110, 0, 14), Parent = row })
		local count = UIKit.Label({ Text = "0 waiting", TextSize = 12, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -100, 0, 0), Size = UDim2.fromOffset(90, 40), Parent = row })
		ui.MapRows[id] = { Row = row, Count = count }
	end

	-- queue banner
	ui.Queue = UIKit.New("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, touch and -150 or -24), Size = UDim2.fromOffset(520, 70), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.05, Corner = 12, Visible = false, Parent = screen })
	ui.QueueStroke = UIKit.New("UIStroke", { Color = T.Accent, Thickness = 2, Parent = ui.Queue })
	ui.QueueTitle = UIKit.Label({ Text = "", Font = UIKit.FontBlack, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 26), Parent = ui.Queue })
	ui.QueueSub = UIKit.Label({ Text = "", TextSize = 13, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 20), Parent = ui.Queue })

	ui.Hint = UIKit.Label({ Text = "Walk onto one of the five map pads to queue for a match.", TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.6, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, touch and -150 or -30), Size = UDim2.fromOffset(600, 22), Parent = screen })

	-- buttons
	local buttons = UIKit.New("Frame", {
		AnchorPoint = touch and Vector2.new(1, 0) or Vector2.new(1, 1),
		Position = touch and UDim2.new(1, -16, 0, 60) or UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(touch and 150 or 360, touch and 112 or 54),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	UIKit.New("UIListLayout", { FillDirection = touch and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8), Parent = buttons })
	UIKit.Button({ Text = "SKIN SHOP", TextSize = 16, BackgroundColor3 = Color3.fromRGB(110, 60, 220), Size = UDim2.fromOffset(touch and 150 or 170, touch and 52 or 54), Parent = buttons }, function()
		SkinShopUI.Open()
	end)
	UIKit.Button({ Text = "SETTINGS", TextSize = 16, Size = UDim2.fromOffset(touch and 150 or 170, touch and 52 or 54), Parent = buttons }, function()
		SettingsController.Open()
	end)
end

local function refreshProfile()
	local p = ClientState.Profile
	if not p or not ui.Points then
		return
	end
	ui.Points.Text = string.format("%d POINTS", p.Points or 0)
	local s = p.Stats or {}
	local kd = (s.Deaths or 0) > 0 and (s.Kills or 0) / s.Deaths or (s.Kills or 0)
	ui.Stats.Text = string.format("K/D %.2f  ·  %d matches  ·  %d wins", kd, s.Matches or 0, s.Wins or 0)
end

local function refreshQueue()
	local queued = player:GetAttribute("QueuedMap")
	local lobby = ClientState.Lobby or {}
	for id, row in pairs(ui.MapRows) do
		local q = lobby[id] or {}
		local text = string.format("%d waiting", q.Waiting or 0)
		if (q.InMatch or 0) > 0 then
			text = text .. string.format("\n%d in match", q.InMatch)
		end
		row.Count.Text = text
		row.Row.BackgroundColor3 = (queued == id) and T.Panel3 or T.Panel2
	end
	if queued then
		local map = MapData.Get(queued)
		local q = lobby[queued] or {}
		ui.Queue.Visible = true
		ui.Hint.Visible = false
		ui.QueueStroke.Color = map and map.Color or T.Accent
		local left = q.EndsAt and math.max(0, math.ceil(q.EndsAt - workspace:GetServerTimeNow())) or nil
		local waiting = q.Waiting or 1
		ui.QueueTitle.Text = string.format("QUEUED: %s", map and map.Name:upper() or queued)
		if waiting < Config.Lobby.MinPlayersToLaunch then
			ui.QueueSub.Text = string.format("%d / %d players  ·  waiting for more players  ·  step off the pad to leave", waiting, Config.Match.MaxPlayers)
		else
			ui.QueueSub.Text = string.format("%d / %d players  ·  launching in %s  ·  step off the pad to leave", waiting, Config.Match.MaxPlayers, left and (left .. "s") or "...")
		end
	else
		ui.Queue.Visible = false
		ui.Hint.Visible = true
	end
	if queued ~= lastQueued then
		if queued then
			Sounds.Play("QueueJoin")
		end
		lastQueued = queued
	end
end

function LobbyUI.Init()
	build()
	ClientState.ProfileChanged:Connect(refreshProfile)
	Net.Event("LobbyState").OnClientEvent:Connect(function(state)
		if type(state) == "table" then
			ClientState.Lobby = state
			ClientState.LobbyChanged:Fire(state)
		end
	end)
	RunService.Heartbeat:Connect(function()
		local show = not ClientState.InMatch and not CameraController.IsCinematic()
			and workspace:GetAttribute("ServerRole") ~= "Match"
		screen.Enabled = show
		if show then
			refreshQueue()
		end
	end)
	refreshProfile()
end

return LobbyUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">MobileControls</string><ProtectedString name="Source"><![CDATA[--[[
	MobileControls
	Dedicated touch layout for matches (not a shrunk PC UI):
	  * Roblox's dynamic thumbstick (left) for movement + its jump button
	  * Aim pad: drag anywhere on the right side to look, using your Touch Aim Sensitivity
	  * FIRE (right, drag on it to keep aiming while shooting) + a second FIRE on the left
	  * AIM / ALT (scope, burst toggle, knife stab), RELOAD, SWITCH weapon, KNIFE
	  * SHOP / SCORE / SETTINGS live in the top bar (HUDController)
]]

local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local InputController = require(script.Parent.InputController)
local WeaponController = require(script.Parent.WeaponController)
local CameraController = require(script.Parent.CameraController)

local MobileControls = {}

local T = UIKit.T
local camera = workspace.CurrentCamera
local controls, aimGui
local buttons = {}
local tracked: { [InputObject]: boolean } = {}

local function rotateCamera(delta: Vector3)
	local k = 0.22 * (ClientState.Settings.TouchSensitivity or 1) * CameraController.GetZoomScale()
	local cf = camera.CFrame
	local pitch, yaw = cf:ToEulerAnglesYXZ()
	pitch = math.clamp(pitch - math.rad(delta.Y * k), math.rad(-80), math.rad(80))
	yaw -= math.rad(delta.X * k)
	camera.CFrame = CFrame.new(cf.Position) * CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
end

local function holdButton(props, action: string?, onPress: (() -> ())?, aims: boolean?)
	local p = {
		Text = props.Text,
		Font = UIKit.FontBlack,
		TextSize = props.TextSize or 14,
		TextColor3 = T.Text,
		AutoButtonColor = false,
		BackgroundColor3 = props.Color or Color3.fromRGB(20, 22, 28),
		BackgroundTransparency = 0.35,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = props.Position,
		Size = props.Size,
		Corner = UDim.new(1, 0),
		Stroke = { Color = Color3.new(1, 1, 1), Thickness = 2, Transparency = 0.6 },
		Parent = controls,
	}
	local btn = UIKit.New("TextButton", p)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		btn.BackgroundTransparency = 0.1
		if aims then
			tracked[input] = true
		end
		if action then
			InputController.Trigger(action, true)
		end
		if onPress then
			onPress()
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		btn.BackgroundTransparency = 0.35
		tracked[input] = nil
		if action then
			InputController.Trigger(action, false)
		end
	end)
	return btn
end

local function build()
	-- aim pad sits *below* Roblox's TouchGui so the jump button keeps priority
	aimGui = UIKit.Screen("MobileAimPad", -5, true)
	local pad = UIKit.New("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 60),
		Size = UDim2.new(0.55, 0, 1, -60),
		Parent = aimGui,
	})
	pad.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			tracked[input] = true
		end
	end)
	pad.InputEnded:Connect(function(input)
		tracked[input] = nil
	end)

	controls = UIKit.Screen("MobileControls", 6, true)
	-- the controls are laid out in scale so they stay thumb-reachable on every screen size
	buttons.Fire = holdButton({ Text = "FIRE", TextSize = 18, Color = Color3.fromRGB(150, 30, 30), Position = UDim2.new(0.86, 0, 0.56, 0), Size = UDim2.fromOffset(104, 104) }, "Fire", nil, true)
	buttons.Fire2 = holdButton({ Text = "FIRE", TextSize = 13, Color = Color3.fromRGB(150, 30, 30), Position = UDim2.new(0.1, 0, 0.42, 0), Size = UDim2.fromOffset(68, 68) }, "Fire", nil, true)
	buttons.Alt = holdButton({ Text = "AIM", Position = UDim2.new(0.75, 0, 0.42, 0), Size = UDim2.fromOffset(72, 72) }, "Alt", nil, true)
	buttons.Reload = holdButton({ Text = "R", TextSize = 18, Position = UDim2.new(0.94, 0, 0.36, 0), Size = UDim2.fromOffset(60, 60) }, "Reload")
	buttons.Switch = holdButton({ Text = "SWAP", TextSize = 12, Position = UDim2.new(0.94, 0, 0.2, 0), Size = UDim2.fromOffset(60, 60) }, nil, function()
		WeaponController.Cycle(1)
	end)
	buttons.Knife = holdButton({ Text = "KNIFE", TextSize = 12, Position = UDim2.new(0.84, 0, 0.24, 0), Size = UDim2.fromOffset(60, 60) }, nil, function()
		local info = WeaponController.GetInfo()
		if info.Slot == "Melee" then
			WeaponController.Equip(info.Loadout.Primary and "Primary" or "Secondary")
		else
			WeaponController.Equip("Melee")
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if tracked[input] and input.UserInputType == Enum.UserInputType.Touch then
			rotateCamera(input.Delta)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		tracked[input] = nil
	end)
end

local function refresh()
	local show = ClientState.InMatch and not CameraController.IsCinematic() and not ClientState.IsMenuOpen()
	controls.Enabled = show
	aimGui.Enabled = show
	if not show then
		tracked = {}
		InputController.ReleaseAll()
	end
	local info = WeaponController.GetInfo()
	local w = info.Weapon
	if w then
		buttons.Alt.Text = w.ScopeLevels and "SCOPE" or (w.AltFire == "Burst" and (info.Burst and "SEMI" or "BURST") or (w.Category == "Melee" and "STAB" or "-"))
		buttons.Fire.Text = w.Category == "Melee" and "SLASH" or "FIRE"
		buttons.Knife.Text = info.Slot == "Melee" and "GUN" or "KNIFE"
	end
	buttons.Reload.Visible = w ~= nil and w.MagSize ~= nil
end

function MobileControls.Init()
	if not UserInputService.TouchEnabled then
		return
	end
	build()
	refresh()
	ClientState.MatchChanged:Connect(refresh)
	ClientState.MenuChanged:Connect(refresh)
	WeaponController.Changed:Connect(refresh)
	game:GetService("RunService").Heartbeat:Connect(function()
		local cinematic = CameraController.IsCinematic()
		if controls.Enabled == cinematic and ClientState.InMatch then
			refresh()
		end
	end)
end

return MobileControls
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">ResultsUI</string><ProtectedString name="Source"><![CDATA[--[[
	ResultsUI
	End-of-match presentation:
	  fade out -> cinematic camera flies to the podium -> 3rd, 2nd, 1st revealed one by one
	  (cards with avatar, name, kills, place, points) -> push-in on the winner -> full ranking ->
	  post-match menu with working RETURN TO LOBBY / PLAY AGAIN buttons.
	Podium music plays throughout. Everyone in the match sees the same results.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local CameraController = require(script.Parent.CameraController)

local ResultsUI = {}

local T = UIKit.T
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local screen, fade, cardsRow, rankPanel, rankList, menu, menuTimer, menuStatus, youText, title
local lobbyBtn, againBtn
local active = false
local showToken = 0
local music: any = nil -- Sound or sequenced-music handle (both have :Destroy())
local camConn: RBXScriptConnection? = nil
local postEndsAt = 0

local PLACE_COLORS = { T.Gold, T.Silver, T.Bronze }
local PLACE_NAMES = { "1ST", "2ND", "3RD" }

local function build()
	screen = UIKit.Screen("ResultsUI", 25, true)
	screen.Enabled = false
	fade = UIKit.New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 50, Parent = screen })

	title = UIKit.Label({ Text = "MATCH OVER", Font = UIKit.FontBlack, TextSize = 44, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.6, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 56), Size = UDim2.fromOffset(800, 50), Parent = screen })
	youText = UIKit.Label({ Text = "", TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.6, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 108), Size = UDim2.fromOffset(800, 24), Parent = screen })

	cardsRow = UIKit.New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.fromOffset(760, 190), Parent = screen })

	rankPanel = UIKit.New("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -20, 0.45, 0), Size = UDim2.fromOffset(330, 380), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.08, Corner = 10, Visible = false, Parent = screen })
	UIKit.Label({ Text = "FULL RESULTS", Font = UIKit.FontBlack, TextSize = 16, Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -28, 0, 20), Parent = rankPanel })
	UIKit.Label({ Text = "#   PLAYER                         K    D    PTS", TextSize = 11, TextColor3 = T.Sub, Position = UDim2.fromOffset(14, 34), Size = UDim2.new(1, -28, 0, 14), Parent = rankPanel })
	rankList = UIKit.New("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(8, 52), Size = UDim2.new(1, -16, 1, -60), ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = rankPanel })
	UIKit.New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = rankList })

	menu = UIKit.New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(520, 220), BackgroundColor3 = T.Panel, Corner = 12, Stroke = { Color = T.Stroke }, Visible = false, ZIndex = 10, Parent = screen })
	UIKit.New("Frame", { BackgroundColor3 = T.Accent, Size = UDim2.new(1, 0, 0, 3), BorderSizePixel = 0, ZIndex = 10, Parent = menu })
	UIKit.Label({ Text = "WHAT NEXT?", Font = UIKit.FontBlack, TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 30), ZIndex = 10, Parent = menu })
	menuTimer = UIKit.Label({ Text = "", TextSize = 14, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 0, 18), ZIndex = 10, Parent = menu })
	-- Modal so the mouse is free in first person
	lobbyBtn = UIKit.Button({ Text = "RETURN TO LOBBY", TextSize = 16, Modal = true, Position = UDim2.fromOffset(24, 90), Size = UDim2.new(0.5, -36, 0, 64), ZIndex = 10, Parent = menu }, function()
		Net.Event("PostMatchChoice"):FireServer("Lobby")
		menuStatus.Text = "Returning to the lobby..."
		lobbyBtn.Active = false
		againBtn.Active = false
	end)
	againBtn = UIKit.Button({ Text = "PLAY AGAIN", TextSize = 16, BackgroundColor3 = T.Accent, TextColor3 = Color3.new(0, 0, 0), Position = UDim2.new(0.5, 12, 0, 90), Size = UDim2.new(0.5, -36, 0, 64), ZIndex = 10, Parent = menu }, function()
		Net.Event("PostMatchChoice"):FireServer("Continue")
		menuStatus.Text = "You'll stay on this map. Waiting for the next match..."
		UIKit.SetButtonColor(againBtn, T.Good)
	end)
	menuStatus = UIKit.Label({ Text = "", TextSize = 13, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -44), Size = UDim2.new(1, 0, 0, 30), TextWrapped = true, ZIndex = 10, Parent = menu })
end

local function makeCard(entry, slotIndex)
	-- slotIndex: 1 = left (2nd), 2 = centre (1st), 3 = right (3rd)
	local big = entry.Place == 1
	local w, h = big and 260 or 220, big and 190 or 160
	local x = ({ 0.17, 0.5, 0.83 })[slotIndex]
	local color = PLACE_COLORS[entry.Place] or T.Text
	local card = UIKit.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(x, 0, 1, 40),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.05,
		Corner = 12,
		Stroke = { Color = color, Thickness = big and 3 or 2 },
		Parent = cardsRow,
	})
	if big then
		UIKit.New("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(70, 56, 20), Color3.fromRGB(20, 22, 28)), Rotation = 90, Parent = card })
	end
	UIKit.Label({ Text = PLACE_NAMES[entry.Place] or "", Font = UIKit.FontBlack, TextSize = big and 30 or 24, TextColor3 = color, Position = UDim2.fromOffset(14, 10), Size = UDim2.fromOffset(90, 34), Parent = card })
	local img = UIKit.New("ImageLabel", { BackgroundColor3 = T.Panel3, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(big and 84 or 70, big and 84 or 70), Corner = UDim.new(1, 0), Image = "", Parent = card })
	UIKit.New("UIStroke", { Color = color, Thickness = 2, Parent = img })
	if entry.UserId and entry.UserId > 0 then
		task.spawn(function()
			local ok, url = pcall(function()
				return Players:GetUserThumbnailAsync(entry.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
			end)
			if ok and img.Parent then
				img.Image = url
			end
		end)
	end
	UIKit.Label({ Text = entry.DisplayName, Font = UIKit.FontBlack, TextSize = big and 22 or 18, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.new(0, 14, 1, big and -92 or -82), Size = UDim2.new(1, -28, 0, 26), Parent = card })
	UIKit.Label({ Text = "@" .. entry.Name, TextSize = 12, TextColor3 = T.Sub, Font = UIKit.FontRegular, Position = UDim2.new(0, 14, 1, big and -66 or -58), Size = UDim2.new(1, -28, 0, 16), Parent = card })
	UIKit.Label({ Text = string.format("%d KILLS  ·  %d DEATHS", entry.Kills, entry.Deaths), TextSize = 14, Position = UDim2.new(0, 14, 1, big and -46 or -40), Size = UDim2.new(1, -28, 0, 18), Parent = card })
	UIKit.Label({ Text = string.format("+%d POINTS", entry.Points or 0), Font = UIKit.FontBlack, TextSize = 15, TextColor3 = T.Good, Position = UDim2.new(0, 14, 1, -24), Size = UDim2.new(1, -28, 0, 18), Parent = card })
	card.Visible = false
	return card
end

local function fillRanking(rankings)
	for _, c in ipairs(rankList:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, r in ipairs(rankings) do
		local mine = r.UserId == player.UserId
		local row = UIKit.New("Frame", { LayoutOrder = i, BackgroundColor3 = mine and T.Panel3 or T.Panel2, Size = UDim2.new(1, -6, 0, 26), Corner = 4, Parent = rankList })
		local teamColor = Config.Teams[r.Team] and Config.Teams[r.Team].Color or T.Text
		UIKit.Label({ Text = tostring(r.Place), TextSize = 13, TextColor3 = PLACE_COLORS[r.Place] or T.Sub, Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(24, 26), Parent = row })
		UIKit.Label({ Text = r.DisplayName, TextSize = 13, TextColor3 = teamColor, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -150, 1, 0), Parent = row })
		UIKit.Label({ Text = string.format("%d    %d    %d", r.Kills, r.Deaths, r.Points or 0), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -118, 0, 0), Size = UDim2.fromOffset(110, 26), Parent = row })
	end
end

local function stopCamera()
	if camConn then
		camConn:Disconnect()
		camConn = nil
	end
end

local function runCamera(podium: CFrame, duration: number)
	stopCamera()
	local t0 = os.clock()
	local focusLow = podium * CFrame.new(0, 6, 0)
	local winner = podium * CFrame.new(0, 10, 0)
	camConn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local cf
		if t < 4.5 then
			-- sweeping crane shot from the left, rising over the stage
			local e = math.clamp(t / 4.5, 0, 1)
			e = e * e * (3 - 2 * e)
			local angle = math.rad(-55 + 55 * e)
			local radius = 46 - 10 * e
			local pos = podium * CFrame.new(math.sin(angle) * radius, 16 - 6 * e, -math.cos(angle) * radius)
			cf = CFrame.lookAt(pos.Position, focusLow.Position)
		elseif t < duration * 0.62 then
			-- slow dolly along the podium
			local e = math.clamp((t - 4.5) / (duration * 0.62 - 4.5), 0, 1)
			local pos = podium * CFrame.new(-8 + 16 * e, 9, -32)
			cf = CFrame.lookAt(pos.Position, focusLow.Position)
		else
			-- push-in on the winner
			local e = math.clamp((t - duration * 0.62) / (duration * 0.38), 0, 1)
			e = 1 - (1 - e) ^ 3
			local pos = podium * CFrame.new(math.sin(t * 0.3) * 2, 12 - 1 * e, -30 + 12 * e)
			cf = CFrame.lookAt(pos.Position, winner.Position)
		end
		camera.CFrame = cf
		camera.FieldOfView = 60
	end)
end

local function close()
	if not active then
		return
	end
	active = false
	showToken += 1
	stopCamera()
	if music then
		music:Destroy()
		music = nil
	end
	screen.Enabled = false
	menu.Visible = false
	ClientState.SetMenu("Results", false)
	camera.FieldOfView = CameraController.BaseFov
	CameraController.SetCinematic(false)
end

local function show(payload)
	if type(payload) ~= "table" or typeof(payload.PodiumCFrame) ~= "CFrame" then
		return
	end
	showToken += 1
	local token = showToken
	active = true
	screen.Enabled = true
	menu.Visible = false
	rankPanel.Visible = false
	for _, c in ipairs(cardsRow:GetChildren()) do
		c:Destroy()
	end
	title.Text = "MATCH OVER"
	title.TextTransparency = 1
	youText.Text = ""
	lobbyBtn.Active = true
	againBtn.Active = true
	UIKit.SetButtonColor(againBtn, T.Accent)
	menuStatus.Text = ""

	-- your own result line
	for _, r in ipairs(payload.Rankings or {}) do
		if r.UserId == player.UserId then
			youText.Text = string.format("You placed #%d  ·  %d kills  ·  +%d points", r.Place, r.Kills, r.Points or 0)
		end
	end
	fillRanking(payload.Rankings or {})

	Sounds.Play("MatchEnd")
	fade.BackgroundTransparency = 1
	UIKit.Tween(fade, 0.6, { BackgroundTransparency = 0 })
	task.delay(0.65, function()
		if token ~= showToken then
			return
		end
		CameraController.SetCinematic(true)
		ClientState.SetMenu("Results", true)
		runCamera(payload.PodiumCFrame, payload.Duration or Config.Match.ResultsDuration)
		UIKit.Tween(fade, 0.8, { BackgroundTransparency = 1 })
		UIKit.Tween(title, 0.8, { TextTransparency = 0 })
		if music then
			music:Destroy()
		end
		music = Sounds.PlayMusic("Podium")
	end)

	-- cards revealed 3rd -> 2nd -> 1st
	local bySlot = {}
	for _, e in ipairs(payload.Podium or {}) do
		local slotIndex = e.Place == 1 and 2 or (e.Place == 2 and 1 or 3)
		bySlot[e.Place] = makeCard(e, slotIndex)
	end
	for i, place in ipairs({ 3, 2, 1 }) do
		task.delay(1.6 + i * 1.3, function()
			local card = bySlot[place]
			if token ~= showToken or not card then
				return
			end
			card.Visible = true
			local target = card.Position - UDim2.fromOffset(0, 40)
			UIKit.Tween(card, 0.5, { Position = target }, Enum.EasingStyle.Back)
			Sounds.Play("PodiumReveal", nil, { Pitch = place == 1 and 1.4 or 1 })
			if place == 1 then
				title.Text = (payload.Podium[1] and payload.Podium[1].DisplayName or "") .. " WINS!"
				title.TextColor3 = T.Gold
				Sounds.Play("KillConfirm", nil, { Pitch = 1.2 })
			end
		end)
	end
	task.delay(6.5, function()
		if token == showToken then
			rankPanel.Visible = true
		end
	end)
	if #(payload.Podium or {}) == 0 then
		title.Text = "MATCH OVER - NO PLAYERS"
	end
end

local function showMenu(info)
	if not active or type(info) ~= "table" then
		return
	end
	postEndsAt = info.EndsAt or (workspace:GetServerTimeNow() + Config.Match.PostMatchChoiceDuration)
	menu.Visible = true
	menu.Position = UDim2.fromScale(0.5, 0.42)
end

function ResultsUI.Init()
	build()
	Net.Event("Results").OnClientEvent:Connect(show)
	Net.Event("PostMatchPrompt").OnClientEvent:Connect(showMenu)
	ClientState.MatchChanged:Connect(function(m)
		if active and (not ClientState.InMatch or (m and (m.State == "Warmup" or m.State == "Live"))) then
			close()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if active and menu.Visible then
			local left = math.max(0, math.ceil(postEndsAt - workspace:GetServerTimeNow()))
			menuTimer.Text = string.format("Next match on this map starts in %ds  ·  undecided players stay", left)
		end
	end)
	player.CharacterAdded:Connect(function()
		-- returning to the lobby spawns a new character: make sure the cinematic is over
		if active and not ClientState.InMatch then
			close()
		end
	end)
end

return ResultsUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">SettingsController</string><ProtectedString name="Source"><![CDATA[--[[
	SettingsController
	Settings menu (volumes, mouse / touch sensitivity, crosshair, effects quality).
	Changes apply live; "Save" stores them in the player's profile through the server.
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local Util = require(ReplicatedStorage.Shared.Util)
local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)

local SettingsController = {}

local T = UIKit.T
local screen, window
local refreshers = {}
local dirty = false

local DEFAULTS = Util.DeepCopy(ClientState.Settings)

local function apply()
	local s = ClientState.Settings
	Sounds.SetVolumes(s.MasterVolume, s.MusicVolume, s.SfxVolume)
	ClientState.SettingsChanged:Fire(s)
end

local function pct(v)
	return math.floor(v * 100 + 0.5) .. "%"
end

local function slider(parent, y, label, key, min, max, step, fmt)
	local row = UIKit.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 40), Parent = parent })
	UIKit.Label({ Text = label, TextSize = 15, Size = UDim2.new(0.38, 0, 1, 0), Parent = row })
	local valueLabel = UIKit.Label({ Text = "", TextSize = 15, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.Accent, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.14, 0, 1, 0), Parent = row })
	local track = UIKit.New("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.new(0.4, 0, 0.5, -5),
		Size = UDim2.new(0.44, 0, 0, 10),
		BackgroundColor3 = T.Panel3,
		Corner = 5,
		Parent = row,
	})
	local fill = UIKit.New("Frame", { BackgroundColor3 = T.Accent, Size = UDim2.fromScale(0, 1), Corner = 5, Parent = track })
	local knob = UIKit.New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = T.Text, Corner = 10, Parent = track })
	local function refresh()
		local v = ClientState.Settings[key]
		local a = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		valueLabel.Text = type(fmt) == "function" and fmt(v) or string.format(fmt or "%.2f", v)
	end
	local dragging = false
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = min + (max - min) * a
		v = math.floor(v / step + 0.5) * step
		ClientState.Settings[key] = math.clamp(v, min, max)
		dirty = true
		refresh()
		apply()
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	table.insert(refreshers, refresh)
	refresh()
end

local function header(parent, y, text)
	UIKit.Label({ Text = text, TextSize = 13, TextColor3 = T.Sub, Font = UIKit.FontBlack, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 20), Parent = parent })
end

local function build()
	screen, window = nil, nil
	local close
	screen, window, close = UIKit.Window("SettingsUI", "SETTINGS", UDim2.fromOffset(640, 600), 40)

	local scroll = UIKit.New("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 60),
		Size = UDim2.new(1, -40, 1, -130),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.fromOffset(0, 640),
		Parent = window,
	})
	local y = 0
	header(scroll, y, "AUDIO")
	y += 24
	slider(scroll, y, "Master Volume", "MasterVolume", 0, 1, 0.05, pct)
	y += 42
	slider(scroll, y, "Music Volume", "MusicVolume", 0, 1, 0.05, pct)
	y += 42
	slider(scroll, y, "Effects Volume", "SfxVolume", 0, 1, 0.05, pct)
	y += 52
	header(scroll, y, "CONTROLS")
	y += 24
	slider(scroll, y, "Mouse Sensitivity", "MouseSensitivity", 0.1, 4, 0.05)
	y += 42
	slider(scroll, y, "Touch Aim Sensitivity", "TouchSensitivity", 0.1, 4, 0.05)
	y += 52
	header(scroll, y, "CROSSHAIR")
	y += 24
	slider(scroll, y, "Size", "CrosshairSize", 2, 24, 1, "%d")
	y += 42
	slider(scroll, y, "Gap", "CrosshairGap", 0, 16, 1, "%d")
	y += 42
	slider(scroll, y, "Thickness", "CrosshairThickness", 1, 6, 1, "%d")
	y += 44

	-- colour + dot
	local colorRow = UIKit.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 40), Parent = scroll })
	UIKit.Label({ Text = "Color", TextSize = 15, Size = UDim2.new(0.38, 0, 1, 0), Parent = colorRow })
	local colorBtn
	colorBtn = UIKit.Button({ Position = UDim2.new(0.4, 0, 0, 4), Size = UDim2.new(0.25, 0, 0, 32), TextSize = 14, Parent = colorRow }, function()
		local order = ClientState.CrosshairOrder
		local i = table.find(order, ClientState.Settings.CrosshairColor) or 1
		ClientState.Settings.CrosshairColor = order[(i % #order) + 1]
		dirty = true
		apply()
		for _, r in ipairs(refreshers) do
			r()
		end
	end)
	local dotBtn
	dotBtn = UIKit.Button({ Position = UDim2.new(0.68, 0, 0, 4), Size = UDim2.new(0.32, 0, 0, 32), TextSize = 14, Parent = colorRow }, function()
		ClientState.Settings.CrosshairDot = not ClientState.Settings.CrosshairDot
		dirty = true
		apply()
		for _, r in ipairs(refreshers) do
			r()
		end
	end)
	table.insert(refreshers, function()
		local c = ClientState.Settings.CrosshairColor
		colorBtn.Text = c:upper()
		colorBtn.TextColor3 = ClientState.CrosshairColors[c] or T.Text
		dotBtn.Text = ClientState.Settings.CrosshairDot and "CENTER DOT: ON" or "CENTER DOT: OFF"
	end)
	y += 52

	header(scroll, y, "GRAPHICS")
	y += 24
	local fxRow = UIKit.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 40), Parent = scroll })
	UIKit.Label({ Text = "Effects Quality", TextSize = 15, Size = UDim2.new(0.38, 0, 1, 0), Parent = fxRow })
	local fxButtons = {}
	for i, level in ipairs({ "Low", "Medium", "High" }) do
		fxButtons[level] = UIKit.Button({
			Text = level:upper(),
			TextSize = 13,
			Position = UDim2.new(0.4 + (i - 1) * 0.2, 0, 0, 4),
			Size = UDim2.new(0.19, 0, 0, 32),
			Parent = fxRow,
		}, function()
			ClientState.Settings.Effects = level
			dirty = true
			apply()
			for _, r in ipairs(refreshers) do
				r()
			end
		end)
	end
	table.insert(refreshers, function()
		for level, btn in pairs(fxButtons) do
			UIKit.SetButtonColor(btn, ClientState.Settings.Effects == level and T.Accent or T.Panel3)
		end
	end)
	y += 44
	UIKit.Label({
		Text = "Low disables shadows, fire/particles and post-processing for weaker phones and PCs. Your Roblox graphics quality slider still applies on top.",
		TextSize = 12,
		TextWrapped = true,
		TextColor3 = T.Sub,
		Font = UIKit.FontRegular,
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, 34),
		Parent = scroll,
	})
	scroll.CanvasSize = UDim2.fromOffset(0, y + 50)

	-- footer
	local status = UIKit.Label({ Text = "", TextSize = 13, TextColor3 = T.Sub, Position = UDim2.new(0, 20, 1, -52), Size = UDim2.new(0.4, 0, 0, 36), Parent = window })
	UIKit.Button({ Text = "RESET", Position = UDim2.new(1, -330, 1, -56), Size = UDim2.fromOffset(100, 40), Parent = window }, function()
		for k, v in pairs(DEFAULTS) do
			ClientState.Settings[k] = v
		end
		dirty = true
		apply()
		for _, r in ipairs(refreshers) do
			r()
		end
	end)
	UIKit.Button({ Text = "SAVE & CLOSE", BackgroundColor3 = T.Accent, TextColor3 = Color3.new(0, 0, 0), Position = UDim2.new(1, -220, 1, -56), Size = UDim2.fromOffset(200, 40), Parent = window }, function()
		status.Text = "Saving..."
		local ok, saved = pcall(function()
			return Net.Function("SaveSettings"):InvokeServer(ClientState.Settings)
		end)
		status.Text = (ok and saved) and "Saved" or "Could not save (will retry next time)"
		dirty = not (ok and saved)
		SettingsController.Close()
	end)
	close.Activated:Connect(function()
		SettingsController.Close()
	end)
	for _, r in ipairs(refreshers) do
		r()
	end
end

function SettingsController.Open()
	if not screen then
		build()
	end
	for _, r in ipairs(refreshers) do
		r()
	end
	screen.Enabled = true
	ClientState.SetMenu("Settings", true)
end

function SettingsController.Close()
	if screen then
		screen.Enabled = false
	end
	ClientState.SetMenu("Settings", false)
	if dirty then
		dirty = false
		task.spawn(function()
			pcall(function()
				Net.Function("SaveSettings"):InvokeServer(ClientState.Settings)
			end)
		end)
	end
end

function SettingsController.Toggle()
	if screen and screen.Enabled then
		SettingsController.Close()
	else
		SettingsController.Open()
	end
end

function SettingsController.Init()
	ClientState.SettingsChanged:Connect(function()
		local s = ClientState.Settings
		Sounds.SetVolumes(s.MasterVolume, s.MusicVolume, s.SfxVolume)
	end)
	apply()
end

return SettingsController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">SkinShopUI</string><ProtectedString name="Source"><![CDATA[--[[
	SkinShopUI
	Lobby cosmetic shop: browse skins per weapon, live 3D preview, prices and balance,
	purchase confirmation, equip / unequip. The server validates ownership and balance and
	guards against double spending; this UI also blocks repeat clicks while a request runs.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local SkinData = require(ReplicatedStorage.Shared.SkinData)
local WeaponData = require(ReplicatedStorage.WeaponModules.WeaponData)
local WeaponModels = require(ReplicatedStorage.WeaponModules.WeaponModels)
local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local Toast = require(script.Parent.Toast)

local SkinShopUI = {}

local T = UIKit.T
local screen, window
local ui = {}
local weaponId = "AK47"
local selectedSkin: string? = nil -- nil = default finish
local busy = false

local function profile()
	return ClientState.Profile or { Points = 0, OwnedSkins = {}, EquippedSkins = {} }
end

local function owns(id: string?)
	return id == nil or profile().OwnedSkins[id] == true
end

local function equippedFor(wid: string)
	return profile().EquippedSkins[wid]
end

local function refreshActions()
	local p = profile()
	ui.Points.Text = string.format("%d POINTS", p.Points or 0)
	local skin = selectedSkin and SkinData.Get(selectedSkin)
	local wd = WeaponData.Get(weaponId)
	ui.SkinName.Text = skin and skin.Name or "Factory Finish"
	ui.WeaponLabel.Text = wd.Name:upper()
	ui.Rarity.Text = skin and skin.Rarity:upper() or "DEFAULT"
	ui.Rarity.TextColor3 = skin and SkinData.Rarities[skin.Rarity].Color or T.Sub
	ui.Price.Text = skin and (owns(selectedSkin) and "OWNED" or string.format("%d POINTS", skin.Price)) or "FREE"

	local isEquipped = equippedFor(weaponId) == selectedSkin
	if not owns(selectedSkin) then
		local canAfford = (p.Points or 0) >= skin.Price
		ui.Buy.Visible = true
		ui.Equip.Visible = false
		ui.Buy.Text = canAfford and string.format("BUY  ·  %d", skin.Price) or string.format("NEED %d MORE", skin.Price - (p.Points or 0))
		ui.Buy.Active = canAfford and not busy
		UIKit.SetButtonColor(ui.Buy, canAfford and T.Good or T.Panel3)
		ui.Buy.TextColor3 = canAfford and Color3.new(0, 0, 0) or T.Sub
	else
		ui.Buy.Visible = false
		ui.Equip.Visible = true
		if isEquipped then
			ui.Equip.Text = selectedSkin and "UNEQUIP" or "EQUIPPED"
			ui.Equip.Active = selectedSkin ~= nil and not busy
			UIKit.SetButtonColor(ui.Equip, T.Panel3)
		else
			ui.Equip.Text = "EQUIP"
			ui.Equip.Active = not busy
			UIKit.SetButtonColor(ui.Equip, T.Accent)
		end
	end
end

local function refreshPreview()
	ui.SetPreview(WeaponModels.BuildStatic(weaponId, selectedSkin), WeaponModels.GetLength(weaponId))
end

local function refreshSkins()
	for _, c in ipairs(ui.SkinCards) do
		c:Destroy()
	end
	ui.SkinCards = {}
	local list = { false }
	for _, s in ipairs(SkinData.ForWeapon(weaponId)) do
		table.insert(list, s)
	end
	for i, s in ipairs(list) do
		local id = s and s.Id or nil
		local col, row = (i - 1) % 2, (i - 1) // 2
		local rarityColor = s and SkinData.Rarities[s.Rarity].Color or T.Sub
		local card = UIKit.Button({
			BackgroundColor3 = (id == selectedSkin) and T.Panel3 or T.Panel2,
			Position = UDim2.new(col * 0.5, col == 0 and 0 or 6, 0, row * 80),
			Size = UDim2.new(0.5, -6, 0, 72),
			Parent = ui.SkinGrid,
		}, function()
			selectedSkin = id
			refreshSkins()
			refreshPreview()
			refreshActions()
		end)
		UIKit.New("Frame", { BackgroundColor3 = rarityColor, Size = UDim2.new(1, 0, 0, 3), BorderSizePixel = 0, Parent = card })
		-- colour swatch
		local defaults = WeaponModels.GetDefaults(weaponId)
		UIKit.New("Frame", { BackgroundColor3 = s and s.Body or defaults.Body, Position = UDim2.fromOffset(10, 14), Size = UDim2.fromOffset(22, 22), Corner = 4, Parent = card })
		UIKit.New("Frame", { BackgroundColor3 = s and s.Accent or defaults.Accent, Position = UDim2.fromOffset(10, 40), Size = UDim2.fromOffset(22, 22), Corner = 4, Parent = card })
		UIKit.Label({ Text = s and s.Name or "Factory Finish", TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(42, 12), Size = UDim2.new(1, -50, 0, 18), Parent = card })
		UIKit.Label({ Text = s and s.Rarity:upper() or "DEFAULT", TextSize = 11, TextColor3 = rarityColor, Position = UDim2.fromOffset(42, 32), Size = UDim2.new(1, -50, 0, 14), Parent = card })
		local status
		if equippedFor(weaponId) == id then
			status = "EQUIPPED"
		elseif owns(id) then
			status = "OWNED"
		else
			status = string.format("%d PTS", s.Price)
		end
		UIKit.Label({ Text = status, TextSize = 12, TextColor3 = status == "EQUIPPED" and T.Good or (status == "OWNED" and T.Text or T.Gold), Position = UDim2.fromOffset(42, 48), Size = UDim2.new(1, -50, 0, 16), Parent = card })
		table.insert(ui.SkinCards, card)
	end
	ui.SkinGrid.CanvasSize = UDim2.fromOffset(0, math.ceil(#list / 2) * 80)
end

local function refreshWeapons()
	for wid, btn in pairs(ui.WeaponButtons) do
		UIKit.SetButtonColor(btn, wid == weaponId and T.Accent or T.Panel2)
		btn.TextColor3 = wid == weaponId and Color3.new(0, 0, 0) or T.Text
	end
end

local function refreshAll()
	refreshWeapons()
	refreshSkins()
	refreshPreview()
	refreshActions()
end

local function handleResult(ok, res)
	busy = false
	if ok and type(res) == "table" then
		if res.Profile then
			ClientState.SetProfile(res.Profile)
		end
		Toast.Show(res.Message or "", res.Ok and "success" or "error")
		if res.Ok then
			Sounds.Play("UIBuy")
		end
	else
		Toast.Show("Shop request failed, try again.", "error")
	end
	refreshAll()
end

local function confirmPurchase(skin)
	ui.ConfirmText.Text = string.format("Buy %s for %s?\n\n%d POINTS", skin.Name, WeaponData.Get(skin.Weapon).Name, skin.Price)
	ui.Confirm.Visible = true
	ui.ConfirmSkin = skin.Id
end

local function build()
	local close
	screen, window, close = UIKit.Window("SkinShop", "SKIN SHOP", UDim2.fromOffset(1000, 620), 30)
	ui.SkinCards, ui.WeaponButtons = {}, {}
	ui.Points = UIKit.Label({ Text = "", Font = UIKit.FontBlack, TextSize = 20, TextColor3 = T.Gold, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -64, 0, 16), Size = UDim2.fromOffset(260, 28), Parent = window })
	UIKit.Label({ Text = "Cosmetic only - skins never change weapon stats.", TextSize = 13, TextColor3 = T.Sub, Font = UIKit.FontRegular, Position = UDim2.fromOffset(20, 44), Size = UDim2.fromOffset(500, 18), Parent = window })

	-- weapon list
	local list = UIKit.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 74), Size = UDim2.fromOffset(170, 520), Parent = window })
	for i, wid in ipairs(WeaponData.SkinnableOrder) do
		ui.WeaponButtons[wid] = UIKit.Button({ Text = WeaponData.Get(wid).Name, TextSize = 14, Position = UDim2.fromOffset(0, (i - 1) * 50), Size = UDim2.new(1, 0, 0, 44), Parent = list }, function()
			weaponId = wid
			selectedSkin = equippedFor(wid)
			refreshAll()
		end)
	end

	-- preview
	local center = UIKit.New("Frame", { BackgroundColor3 = T.Panel2, Position = UDim2.fromOffset(206, 74), Size = UDim2.fromOffset(400, 520), Corner = 10, Parent = window })
	local _, setModel = UIKit.Preview(center, { Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 0, 300) })
	ui.SetPreview = setModel
	ui.WeaponLabel = UIKit.Label({ Text = "", TextSize = 13, TextColor3 = T.Sub, Position = UDim2.fromOffset(18, 322), Size = UDim2.new(1, -36, 0, 16), Parent = center })
	ui.SkinName = UIKit.Label({ Text = "", Font = UIKit.FontBlack, TextSize = 26, Position = UDim2.fromOffset(18, 340), Size = UDim2.new(1, -36, 0, 32), Parent = center })
	ui.Rarity = UIKit.Label({ Text = "", TextSize = 13, Position = UDim2.fromOffset(18, 374), Size = UDim2.new(1, -36, 0, 18), Parent = center })
	ui.Price = UIKit.Label({ Text = "", TextSize = 18, TextColor3 = T.Gold, Font = UIKit.FontBlack, Position = UDim2.fromOffset(18, 398), Size = UDim2.new(1, -36, 0, 24), Parent = center })
	ui.Buy = UIKit.Button({ Text = "BUY", TextSize = 18, Position = UDim2.new(0, 18, 1, -70), Size = UDim2.new(1, -36, 0, 52), Parent = center }, function()
		if busy or not selectedSkin then
			return
		end
		local skin = SkinData.Get(selectedSkin)
		if skin and (profile().Points or 0) >= skin.Price then
			confirmPurchase(skin)
		end
	end)
	ui.Equip = UIKit.Button({ Text = "EQUIP", TextSize = 18, Position = UDim2.new(0, 18, 1, -70), Size = UDim2.new(1, -36, 0, 52), Parent = center }, function()
		if busy then
			return
		end
		busy = true
		refreshActions()
		local target = selectedSkin
		if equippedFor(weaponId) == selectedSkin then
			target = nil -- unequip -> default finish
		end
		local ok, res = pcall(function()
			return Net.Function("EquipSkin"):InvokeServer(weaponId, target)
		end)
		if target == nil then
			selectedSkin = nil
		end
		handleResult(ok, res)
	end)

	-- skins grid
	UIKit.Label({ Text = "SKINS", TextSize = 13, TextColor3 = T.Sub, Font = UIKit.FontBlack, Position = UDim2.fromOffset(622, 74), Size = UDim2.fromOffset(200, 16), Parent = window })
	ui.SkinGrid = UIKit.New("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, Position = UDim2.fromOffset(622, 96), Size = UDim2.fromOffset(358, 498), Parent = window })

	-- confirmation dialog
	ui.Confirm = UIKit.New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 20, Parent = window })
	local box = UIKit.New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(420, 220), BackgroundColor3 = T.Panel, Corner = 12, Stroke = { Color = T.Gold }, ZIndex = 21, Parent = ui.Confirm })
	ui.ConfirmText = UIKit.Label({ Text = "", TextSize = 18, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(20, 20), Size = UDim2.new(1, -40, 0, 110), ZIndex = 22, Parent = box })
	UIKit.Button({ Text = "CANCEL", TextSize = 16, Position = UDim2.new(0, 20, 1, -70), Size = UDim2.new(0.5, -30, 0, 50), ZIndex = 22, Parent = box }, function()
		ui.Confirm.Visible = false
	end)
	ui.ConfirmBuy = UIKit.Button({ Text = "CONFIRM PURCHASE", TextSize = 15, BackgroundColor3 = T.Good, TextColor3 = Color3.new(0, 0, 0), Position = UDim2.new(0.5, 10, 1, -70), Size = UDim2.new(0.5, -30, 0, 50), ZIndex = 22, Parent = box }, function()
		if busy or not ui.ConfirmSkin then
			return
		end
		busy = true
		ui.Confirm.Visible = false
		refreshActions()
		local id = ui.ConfirmSkin
		ui.ConfirmSkin = nil
		local ok, res = pcall(function()
			return Net.Function("BuySkin"):InvokeServer(id)
		end)
		handleResult(ok, res)
	end)

	close.Activated:Connect(function()
		SkinShopUI.Close()
	end)
end

function SkinShopUI.Open()
	if ClientState.InMatch then
		Toast.Show("The skin shop is in the main lobby.", "error")
		return
	end
	if not screen then
		build()
	end
	selectedSkin = equippedFor(weaponId)
	ui.Confirm.Visible = false
	refreshAll()
	screen.Enabled = true
	ClientState.SetMenu("SkinShop", true)
end

function SkinShopUI.Close()
	if screen then
		screen.Enabled = false
	end
	ClientState.SetMenu("SkinShop", false)
end

function SkinShopUI.Init()
	Net.Event("OpenSkinShop").OnClientEvent:Connect(SkinShopUI.Open)
	ClientState.ProfileChanged:Connect(function()
		if screen and screen.Enabled and not busy then
			refreshActions()
		end
	end)
	ClientState.MatchChanged:Connect(function()
		if ClientState.InMatch then
			SkinShopUI.Close()
		end
	end)
end

return SkinShopUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">Toast</string><ProtectedString name="Source"><![CDATA[--[[
	Toast
	Short stacked notifications at the top of the screen (server Notify events + local messages).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)
local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local UIKit = require(script.Parent.UIKit)

local Toast = {}

local T = UIKit.T
local screen, list

local COLORS = {
	info = T.Accent,
	error = T.Bad,
	success = T.Good,
	start = T.Gold,
	Red = Config.Teams.Red.Color,
	Blue = Config.Teams.Blue.Color,
}

function Toast.Show(text: string, kind: string?)
	if not screen then
		return
	end
	local color = COLORS[kind or "info"] or T.Accent
	local item = UIKit.New("Frame", {
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.08,
		Size = UDim2.fromOffset(440, 40),
		Corner = 8,
		Stroke = { Color = color, Thickness = 1, Transparency = 0.3 },
		Parent = list,
	})
	UIKit.New("Frame", { BackgroundColor3 = color, Size = UDim2.new(0, 4, 1, -12), Position = UDim2.fromOffset(8, 6), Corner = 2, Parent = item })
	UIKit.Label({
		Text = text,
		TextSize = 15,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(22, 0),
		Size = UDim2.new(1, -30, 1, 0),
		Parent = item,
	})
	if kind == "error" then
		Sounds.Play("UIError")
	end
	task.delay(3.6, function()
		if item.Parent then
			UIKit.Tween(item, 0.3, { BackgroundTransparency = 1 })
			for _, d in ipairs(item:GetDescendants()) do
				if d:IsA("TextLabel") then
					UIKit.Tween(d, 0.3, { TextTransparency = 1 })
				elseif d:IsA("Frame") then
					UIKit.Tween(d, 0.3, { BackgroundTransparency = 1 })
				elseif d:IsA("UIStroke") then
					UIKit.Tween(d, 0.3, { Transparency = 1 })
				end
			end
			task.wait(0.32)
			item:Destroy()
		end
	end)
end

function Toast.Init()
	screen = UIKit.Screen("Toasts", 50)
	list = UIKit.New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.fromOffset(440, 300),
		Parent = screen,
	})
	UIKit.New("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	Net.Event("Notify").OnClientEvent:Connect(function(text, kind)
		if type(text) == "string" then
			Toast.Show(text, kind)
		end
	end)
end

return Toast
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[--[[
	UIKit
	Shared look & feel: a minimal dark competitive-FPS theme, element constructors,
	responsive scaling and the mouse-unlock helper for menus in first person.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage.Shared.Sounds)
local ClientState = require(script.Parent.ClientState)

local UIKit = {}

UIKit.T = {
	Bg = Color3.fromRGB(12, 13, 17),
	Panel = Color3.fromRGB(20, 22, 28),
	Panel2 = Color3.fromRGB(30, 33, 41),
	Panel3 = Color3.fromRGB(42, 46, 57),
	Stroke = Color3.fromRGB(58, 63, 76),
	Text = Color3.fromRGB(240, 242, 246),
	Sub = Color3.fromRGB(150, 156, 170),
	Accent = Color3.fromRGB(255, 140, 40),
	Good = Color3.fromRGB(70, 210, 120),
	Bad = Color3.fromRGB(235, 70, 70),
	Gold = Color3.fromRGB(255, 196, 46),
	Silver = Color3.fromRGB(200, 208, 220),
	Bronze = Color3.fromRGB(205, 127, 50),
	Red = Color3.fromRGB(232, 72, 77),
	Blue = Color3.fromRGB(62, 142, 247),
}

UIKit.Font = Enum.Font.GothamBold
UIKit.FontBlack = Enum.Font.GothamBlack
UIKit.FontRegular = Enum.Font.GothamMedium

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
UIKit.PlayerGui = playerGui

-- Generic constructor: UIKit.New("Frame", { Size = ..., Corner = 8, Stroke = {...}, Padding = 6 }, { children })
function UIKit.New(className: string, props, children)
	local inst = Instance.new(className)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Corner" then
			local c = Instance.new("UICorner")
			c.CornerRadius = typeof(v) == "UDim" and v or UDim.new(0, v)
			c.Parent = inst
		elseif k == "Stroke" then
			local s = Instance.new("UIStroke")
			s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			s.Color = v.Color or UIKit.T.Stroke
			s.Thickness = v.Thickness or 1
			s.Transparency = v.Transparency or 0
			s.Parent = inst
		elseif k == "Padding" then
			local p = Instance.new("UIPadding")
			local u = typeof(v) == "UDim" and v or UDim.new(0, v)
			p.PaddingLeft, p.PaddingRight, p.PaddingTop, p.PaddingBottom = u, u, u, u
			p.Parent = inst
		elseif k == "Gradient" then
			local g = Instance.new("UIGradient")
			g.Color = v.Color or ColorSequence.new(Color3.new(1, 1, 1))
			g.Rotation = v.Rotation or 90
			if v.Transparency then
				g.Transparency = v.Transparency
			end
			g.Parent = inst
		elseif k == "Parent" then
			parent = v
		else
			(inst :: any)[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UIKit.Screen(name: string, displayOrder: number?, ignoreInset: boolean?): ScreenGui
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = ignoreInset == true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder or 0
	gui.Parent = playerGui
	UIKit.AutoScale(gui)
	return gui
end

-- Scales a whole ScreenGui relative to a 1280x720 reference, with a floor for phones.
function UIKit.AutoScale(gui: ScreenGui)
	local scale = Instance.new("UIScale")
	scale.Parent = gui
	local camera = workspace.CurrentCamera
	local function update()
		local vp = camera.ViewportSize
		local s = math.min(vp.X / 1280, vp.Y / 720)
		if ClientState.IsTouch() then
			s = math.clamp(s * 1.25, 0.62, 1.2)
		else
			s = math.clamp(s, 0.7, 1.4)
		end
		scale.Scale = s
	end
	update()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	return scale
end

function UIKit.Label(props)
	local p = {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		TextColor3 = UIKit.T.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return UIKit.New("TextLabel", p)
end

function UIKit.Tween(obj: Instance, t: number, props, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- Button with hover / press feedback and click sound. `onClick` runs on Activated.
function UIKit.Button(props, onClick)
	local base = props.BackgroundColor3 or UIKit.T.Panel3
	local p = {
		AutoButtonColor = false,
		BackgroundColor3 = base,
		Font = UIKit.Font,
		TextColor3 = UIKit.T.Text,
		TextSize = 16,
		Corner = 8,
		Text = "",
	}
	for k, v in pairs(props) do
		p[k] = v
	end
	local btn = UIKit.New("TextButton", p)
	local hover = base:Lerp(Color3.new(1, 1, 1), 0.12)
	btn.MouseEnter:Connect(function()
		if btn.Active then
			UIKit.Tween(btn, 0.12, { BackgroundColor3 = btn:GetAttribute("Base") and (btn:GetAttribute("Base") :: Color3):Lerp(Color3.new(1, 1, 1), 0.12) or hover })
		end
	end)
	btn.MouseLeave:Connect(function()
		UIKit.Tween(btn, 0.12, { BackgroundColor3 = btn:GetAttribute("Base") or base })
	end)
	btn.Activated:Connect(function()
		if not btn.Active then
			return
		end
		Sounds.Play("UIClick")
		if onClick then
			onClick(btn)
		end
	end)
	return btn
end

-- Change a button's resting colour (keeps hover logic consistent).
function UIKit.SetButtonColor(btn: GuiButton, color: Color3)
	btn:SetAttribute("Base", color)
	btn.BackgroundColor3 = color
end

-- Dark full-screen dimmer + centred window; returns (screen, window, closeButton)
function UIKit.Window(name: string, title: string, size: UDim2, order: number?)
	local screen = UIKit.Screen(name, order or 20, true)
	screen.Enabled = false
	local dim = UIKit.New("TextButton", {
		Name = "Dim",
		Text = "",
		AutoButtonColor = false,
		Modal = true, -- frees the mouse while in first person
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		Parent = screen,
	})
	local window = UIKit.New("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = UIKit.T.Panel,
		Corner = 12,
		Stroke = { Color = UIKit.T.Stroke, Thickness = 1 },
		Parent = screen,
	})
	UIKit.New("Frame", {
		Name = "AccentBar",
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = UIKit.T.Accent,
		BorderSizePixel = 0,
		Parent = window,
	})
	UIKit.Label({
		Name = "Title",
		Text = title,
		Font = UIKit.FontBlack,
		TextSize = 24,
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -80, 0, 30),
		Parent = window,
	})
	local close = UIKit.Button({
		Name = "Close",
		Text = "X",
		TextSize = 18,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = UIKit.T.Panel3,
		Parent = window,
	})
	dim.Activated:Connect(function() end)
	return screen, window, close
end

-- Horizontal stat bar
function UIKit.StatBar(parent: Instance, label: string, value: number, y: number, width: number?)
	local row = UIKit.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 22), Parent = parent })
	UIKit.Label({ Text = label:upper(), TextSize = 12, TextColor3 = UIKit.T.Sub, Size = UDim2.new(0.4, 0, 1, 0), Parent = row })
	local track = UIKit.New("Frame", {
		Position = UDim2.new(0.4, 0, 0.5, -4),
		Size = UDim2.new(width or 0.6, 0, 0, 8),
		BackgroundColor3 = UIKit.T.Panel3,
		Corner = 4,
		Parent = row,
	})
	local fill = UIKit.New("Frame", {
		Size = UDim2.fromScale(math.clamp(value / 100, 0, 1), 1),
		BackgroundColor3 = UIKit.T.Accent,
		Corner = 4,
		Parent = track,
	})
	return row, fill
end

-- Rotating 3D preview of any model inside a ViewportFrame. Returns (viewport, setModel)
function UIKit.Preview(parent: Instance, props)
	local vp = UIKit.New("ViewportFrame", {
		BackgroundColor3 = UIKit.T.Bg,
		Ambient = Color3.fromRGB(150, 150, 160),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-1, -1.5, -1),
		Corner = 10,
		Parent = parent,
	})
	for k, v in pairs(props or {}) do
		(vp :: any)[k] = v
	end
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = vp
	vp.CurrentCamera = cam
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local current: Model? = nil
	local angle = 0
	local distance = 8
	local conn
	local function setModel(model: Model?, length: number?)
		if current then
			current:Destroy()
		end
		current = model
		if model then
			model:PivotTo(CFrame.new())
			model.Parent = world
			distance = (length or 3) * 2.4 + 1
		end
	end
	conn = game:GetService("RunService").RenderStepped:Connect(function(dt)
		if not vp.Parent then
			conn:Disconnect()
			return
		end
		if not vp.Visible or not current then
			return
		end
		local gui = vp:FindFirstAncestorOfClass("ScreenGui")
		if gui and not gui.Enabled then
			return
		end
		angle += dt * 0.6
		local center = Vector3.new(0, 0.2, -1.2)
		local pos = center + Vector3.new(math.sin(angle) * distance, distance * 0.25, math.cos(angle) * distance)
		cam.CFrame = CFrame.lookAt(pos, center)
	end)
	return vp, setModel
end

return UIKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">WeaponController</string><ProtectedString name="Source"><![CDATA[--[[
	WeaponController
	Client side of every weapon: first-person viewmodel with procedural animations (draw,
	idle sway, walk bob, fire kick, reload with magazine swap, bolt cycling, knife slash/stab),
	spread & recoil simulation, fire modes (semi, auto, burst, bolt), AWP scope and inputs.

	The client only predicts. Every shot / reload / swap is sent to the server, which owns
	ammo and damage and corrects us through WeaponState / AmmoUpdate.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Util = require(ReplicatedStorage.Shared.Util)
local Config = require(ReplicatedStorage.Shared.Config)
local WeaponData = require(ReplicatedStorage.WeaponModules.WeaponData)
local WeaponModels = require(ReplicatedStorage.WeaponModules.WeaponModels)
local ClientState = require(script.Parent.ClientState)
local InputController = require(script.Parent.InputController)
local CameraController = require(script.Parent.CameraController)
local EffectsController = require(script.Parent.EffectsController)

local WeaponController = {}
WeaponController.Changed = Signal.new() -- HUD refresh
WeaponController.Fired = Signal.new()
WeaponController.ScopeChanged = Signal.new()

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local rng = Random.new()

local SLOT_BY_INDEX = { "Primary", "Secondary", "Melee" }

local state = { Loadout = {}, Equipped = nil, Ammo = {}, Armed = false, Skins = {} }
local current: string? = nil -- locally equipped slot
local lastSlot: string? = nil

-- timing / animation state
local equipStart, equipDur = 0, 0.5
local reloading, reloadStart, reloadEnd, reloadToken = false, 0, 0, 0
local lastShot = 0
local semiReady = true
local burstQueue = 0
local burstMode = false
local bloom = 0
local sprayCount = 0
local scopeLevel, scopeStart, rescopeLevel = 0, 0, 0
local meleeKind, meleeStart = nil, 0
local boltStart = -10
local kick = 0
local pendingPitch, pendingYaw = 0, 0
local accumPitch, accumYaw = 0, 0
local swayX, swayY = 0, 0
local bobT = 0
local alive = false

-- viewmodel
local vmFolder = Instance.new("Folder")
vmFolder.Name = "Viewmodel"
vmFolder.Parent = camera
local vm = { Model = nil :: Model?, Id = nil, Skin = nil, MagWeld = nil :: Weld?, MagBase = CFrame.new(), Arms = {} }

local function weapon()
	local id = current and state.Loadout[current]
	return id and WeaponData.Get(id), id
end

local function now()
	return os.clock()
end

local function emitChanged()
	WeaponController.Changed:Fire()
end

-- VIEWMODEL --------------------------------------------------------------------------

local function makeArmPart(color: Color3, size: Vector3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = vmFolder
	return p
end

local function destroyViewmodel()
	if vm.Model then
		vm.Model:Destroy()
	end
	for _, p in ipairs(vm.Arms) do
		p:Destroy()
	end
	vm.Model, vm.Id, vm.Skin, vm.MagWeld = nil, nil, nil, nil
	vm.Arms = {}
end

local function buildViewmodel()
	local _, id = weapon()
	local skin = id and state.Skins[id] or nil
	if vm.Model and vm.Id == id and vm.Skin == skin then
		return
	end
	destroyViewmodel()
	if not id then
		return
	end
	local model = WeaponModels.Build(id, skin)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CastShadow = false
		end
	end
	model.PrimaryPart.Anchored = true
	model.Parent = vmFolder
	vm.Model, vm.Id, vm.Skin = model, id, skin
	local mag = model:FindFirstChild("Mag")
	vm.MagWeld = mag and mag:FindFirstChild("MagWeld") or nil
	vm.MagBase = vm.MagWeld and vm.MagWeld.C0 or CFrame.new()

	local teamColor = player:GetAttribute("TeamColor") or Color3.fromRGB(80, 80, 90)
	local skinColor = Color3.fromRGB(234, 184, 146)
	local char = player.Character
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
	if hand and hand:IsA("BasePart") then
		skinColor = hand.Color
	end
	vm.Arms = {
		makeArmPart(teamColor, Vector3.new(0.42, 0.42, 1)), -- right sleeve
		makeArmPart(skinColor, Vector3.new(0.34, 0.34, 0.5)), -- right hand
		makeArmPart(teamColor, Vector3.new(0.42, 0.42, 1)), -- left sleeve
		makeArmPart(skinColor, Vector3.new(0.34, 0.34, 0.5)), -- left hand
	}
end

local function placeArm(sleeve: BasePart, handPart: BasePart, shoulder: Vector3, hand: Vector3)
	local d = hand - shoulder
	local len = math.max(0.2, d.Magnitude - 0.25)
	sleeve.Size = Vector3.new(0.42, 0.42, len)
	sleeve.CFrame = CFrame.lookAt(shoulder, hand) * CFrame.new(0, 0, -len / 2)
	handPart.CFrame = CFrame.lookAt(hand, hand + d.Unit) * CFrame.new(0, 0, 0)
end

local function setViewmodelVisible(visible: boolean)
	vmFolder.Parent = visible and camera or nil
end

-- SCOPE --------------------------------------------------------------------------------

local function setScope(level: number)
	local w = weapon()
	if not w or not w.ScopeLevels then
		level = 0
	end
	if level == scopeLevel then
		return
	end
	scopeLevel = level
	scopeStart = now()
	if level > 0 then
		CameraController.SetFov(w.ScopeLevels[level])
		Sounds.Play("ScopeIn")
	else
		CameraController.SetFov(nil)
	end
	Net.Event("ScopeState"):FireServer(level > 0)
	WeaponController.ScopeChanged:Fire(level)
end

function WeaponController.GetScopeLevel()
	return scopeLevel
end

-- SPREAD / RECOIL ----------------------------------------------------------------------

local function movementInfo()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return 0, false
	end
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	return speed, hum.FloorMaterial == Enum.Material.Air
end

function WeaponController.GetSpread(): number
	local w = weapon()
	if not w or not w.Spread then
		return 0
	end
	local sp = w.Spread
	local speed, air = movementInfo()
	local moveFactor = math.clamp((speed - 2) / Config.Player.BaseWalkSpeed, 0, 1.2)
	local base = sp.Base
	local move = sp.Move * moveFactor
	if w.ScopedSpread and scopeLevel > 0 then
		local settle = math.clamp((now() - scopeStart) / w.ScopeTime, 0, 1)
		base = Util.Lerp(sp.Base * 0.5, w.ScopedSpread, settle)
		move = w.ScopedMoveSpread * moveFactor
	end
	if burstMode and w.BurstSpread then
		base += w.BurstSpread
	end
	return math.min(base + move + (air and sp.Air or 0) + bloom, sp.Max + (air and sp.Air or 0))
end

local function addRecoil(w)
	local r = w.Recoil
	sprayCount += 1
	local v = r.Vertical * (0.9 + rng:NextNumber() * 0.2)
	local h
	if r.Pattern == "Climb" then
		if sprayCount <= (r.SwayStart or 8) then
			h = rng:NextNumber(-1, 1) * r.Horizontal * 0.35
			v *= 1 + sprayCount * 0.04
		else
			h = math.sin(sprayCount * 0.55) * (r.SwayAmp or 0.8) + rng:NextNumber(-1, 1) * r.Horizontal * 0.4
			v *= 0.45
		end
	else
		h = rng:NextNumber(-1, 1) * r.Horizontal
	end
	pendingPitch += v
	pendingYaw += h
	kick = math.min(kick + (w.Category == "Sniper" and 2.2 or (w.Category == "Pistol" and 1.2 or 0.8)), 3)
end

-- SHOOTING -----------------------------------------------------------------------------

local function raycastParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local fx = workspace:FindFirstChild("Effects")
	if fx then
		table.insert(ignore, fx)
	end
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	return params
end

local function canAct()
	return state.Armed and alive and current ~= nil and ClientState.IsLive() and not ClientState.IsMenuOpen()
		and not CameraController.IsCinematic()
end

function WeaponController.Reload()
	local w, id = weapon()
	if not w or not w.MagSize or reloading or not state.Armed then
		return
	end
	local ammo = state.Ammo[current]
	if not ammo or ammo.Mag >= w.MagSize or ammo.Reserve <= 0 then
		return
	end
	rescopeLevel = 0
	setScope(0)
	reloading = true
	reloadStart = now()
	reloadEnd = reloadStart + w.ReloadTime
	reloadToken += 1
	local token = reloadToken
	local slot = current
	Net.Event("Reload"):FireServer(slot)
	Sounds.Play("MagOut", nil, { Volume = 0.8 })
	task.delay(w.ReloadTime * 0.62, function()
		if reloadToken == token and reloading then
			Sounds.Play("MagIn", nil, { Volume = 0.9 })
		end
	end)
	if w.Category == "Sniper" or w.Id == "Deagle" then
		task.delay(w.ReloadTime * 0.88, function()
			if reloadToken == token and reloading then
				Sounds.Play("BoltRack")
			end
		end)
	end
	-- predicted completion; the server's AmmoUpdate is authoritative and usually arrives first
	task.delay(w.ReloadTime + 0.5, function()
		if reloadToken == token and reloading and current == slot and state.Loadout[slot] == id then
			local take = math.min(w.MagSize - ammo.Mag, ammo.Reserve)
			ammo.Mag += take
			ammo.Reserve -= take
			reloading = false
			emitChanged()
		end
	end)
	emitChanged()
end

local function fireGun(w)
	local ammo = state.Ammo[current]
	if not ammo then
		return
	end
	if ammo.Mag <= 0 then
		Sounds.Play("DryFire")
		semiReady = false
		WeaponController.Reload()
		return
	end
	ammo.Mag -= 1
	lastShot = now()

	local spread = WeaponController.GetSpread()
	local camCF = camera.CFrame
	local origin = camCF.Position
	local dir = Util.SpreadDirection(camCF.LookVector, spread, rng)
	local result = workspace:Raycast(origin, dir * w.Range, raycastParams())
	local hitPos = result and result.Position or origin + dir * w.Range
	local hitPart = result and result.Instance
	local hitChar = hitPart and Util.GetCharacterFromPart(hitPart)
	local isPlayerHit = hitChar ~= nil and Players:GetPlayerFromCharacter(hitChar) ~= nil

	Net.Event("Fire"):FireServer({
		Slot = current,
		Origin = origin,
		Direction = dir,
		Hit = isPlayerHit and hitPart or nil,
		Position = hitPos,
	})

	-- local feedback
	local muzzle = vm.Model and vm.Model.PrimaryPart and vm.Model.PrimaryPart:FindFirstChild("Muzzle")
	local muzzlePos = muzzle and muzzle.WorldPosition or origin
	if scopeLevel == 0 then
		EffectsController.MuzzleFlash(muzzlePos, w.Suppressed)
	end
	EffectsController.Tracer(scopeLevel > 0 and (origin + camCF.UpVector * -0.3) or muzzlePos, hitPos)
	if result then
		EffectsController.Impact(hitPos, result.Normal, isPlayerHit)
	end
	Sounds.Play(w.Sound, nil, { Volume = w.Suppressed and 0.7 or 1 })
	addRecoil(w)
	bloom = math.min(bloom + w.Spread.PerShot, w.Spread.Max)
	WeaponController.Fired:Fire()

	if w.FireMode == "Bolt" then
		boltStart = now()
		rescopeLevel = scopeLevel
		setScope(0)
		local interval = 60 / w.RPM
		task.delay(0.35, function()
			Sounds.Play("BoltRack")
		end)
		task.delay(interval * 0.9, function()
			if rescopeLevel > 0 and current and state.Loadout[current] == w.Id and not reloading and alive then
				setScope(rescopeLevel)
			end
			rescopeLevel = 0
		end)
	end
	if ammo.Mag <= 0 and ammo.Reserve > 0 then
		task.delay(0.25, WeaponController.Reload)
	end
	emitChanged()
end

local function melee(heavy: boolean)
	local w = WeaponData.Get("Knife")
	local cd = heavy and w.Stab.Cooldown or w.Slash.Cooldown
	if now() - lastShot < cd then
		return
	end
	lastShot = now()
	meleeKind = heavy and "Stab" or "Slash"
	meleeStart = now()
	Sounds.Play(heavy and "KnifeStab" or "KnifeSlash")
	Net.Event("Melee"):FireServer(heavy, camera.CFrame.LookVector)
end

local function tryFire()
	local w = weapon()
	if not w or not canAct() then
		return
	end
	local t = now()
	if t < equipStart + equipDur then
		return
	end
	if w.FireMode == "Melee" then
		melee(false)
		return
	end
	if reloading then
		return
	end
	local interval = 60 / w.RPM
	if burstMode and w.AltFire == "Burst" then
		if burstQueue > 0 then
			if t - lastShot >= 60 / w.BurstRPM then
				burstQueue -= 1
				fireGun(w)
			end
			return
		end
		if semiReady and t - lastShot >= interval * 1.6 then
			semiReady = false
			burstQueue = w.BurstCount - 1
			fireGun(w)
		end
		return
	end
	if t - lastShot < interval then
		return
	end
	if w.FireMode == "Auto" then
		fireGun(w)
	elseif semiReady then
		semiReady = false
		fireGun(w)
	end
end

-- EQUIP ------------------------------------------------------------------------------

local function equipLocal(slot: string, tellServer: boolean)
	if not state.Loadout[slot] then
		return
	end
	if current ~= slot then
		lastSlot = current
	end
	current = slot
	reloading = false
	reloadToken += 1
	burstQueue = 0
	burstMode = false
	rescopeLevel = 0
	setScope(0)
	local w = WeaponData.Get(state.Loadout[slot])
	equipStart = now()
	equipDur = w and w.EquipTime or 0.5
	bloom = 0
	buildViewmodel()
	Sounds.Play(slot == "Melee" and "EquipKnife" or "EquipGun")
	if tellServer then
		Net.Event("EquipSlot"):FireServer(slot)
	end
	emitChanged()
end

function WeaponController.Equip(slot: string)
	if not state.Armed or not alive or slot == current or not state.Loadout[slot] then
		return
	end
	equipLocal(slot, true)
end

local function cycle(dir: number)
	local available = {}
	for _, s in ipairs(SLOT_BY_INDEX) do
		if state.Loadout[s] then
			table.insert(available, s)
		end
	end
	if #available == 0 then
		return
	end
	local i = table.find(available, current) or 1
	WeaponController.Equip(available[((i - 1 + dir) % #available) + 1])
end

function WeaponController.Cycle(dir: number)
	cycle(dir)
end

function WeaponController.Alt(began: boolean)
	local w = weapon()
	if not w or not began or not canAct() then
		return
	end
	if w.FireMode == "Melee" then
		melee(true)
	elseif w.ScopeLevels then
		if reloading or now() < equipStart + equipDur then
			return
		end
		rescopeLevel = 0
		setScope((scopeLevel + 1) % (#w.ScopeLevels + 1))
	elseif w.AltFire == "Burst" then
		burstMode = not burstMode
		burstQueue = 0
		Net.Event("ScopeState"):FireServer(burstMode)
		emitChanged()
	end
end

function WeaponController.IsBurst()
	return burstMode
end

-- PUBLIC STATE for HUD ------------------------------------------------------------------

function WeaponController.GetInfo()
	local w, id = weapon()
	local ammo = current and state.Ammo[current]
	return {
		Armed = state.Armed and alive,
		Slot = current,
		WeaponId = id,
		Weapon = w,
		Mag = ammo and ammo.Mag,
		Reserve = ammo and ammo.Reserve,
		Reloading = reloading,
		ReloadProgress = reloading and math.clamp((now() - reloadStart) / math.max(0.01, reloadEnd - reloadStart), 0, 1) or 0,
		Loadout = state.Loadout,
		Burst = burstMode,
	}
end

-- RENDER -----------------------------------------------------------------------------

local function easeOut(t)
	return 1 - (1 - t) ^ 3
end

local function renderStep(dt: number)
	-- camera recoil (applied after the default camera so it sticks)
	if pendingPitch ~= 0 or pendingYaw ~= 0 then
		local f = math.min(1, dt * 22)
		local dp, dy = pendingPitch * f, pendingYaw * f
		pendingPitch -= dp
		pendingYaw -= dy
		accumPitch += dp
		accumYaw += dy
		camera.CFrame = camera.CFrame * CFrame.Angles(math.rad(dp), math.rad(-dy), 0)
	end
	local w = weapon()
	local t = now()
	if w and w.Recoil and t - lastShot > 0.14 then
		sprayCount = 0
		if accumPitch > 0.01 then
			local back = math.min(accumPitch, w.Recoil.Recovery * 3 * dt)
			accumPitch -= back
			camera.CFrame = camera.CFrame * CFrame.Angles(math.rad(-back), 0, 0)
		end
		accumYaw *= (1 - math.min(1, dt * 4))
	end
	if w and w.Spread then
		bloom = math.max(0, bloom - w.Spread.Recovery * dt)
	end
	kick = kick * (1 - math.min(1, dt * 14))

	-- viewmodel
	local show = vm.Model ~= nil and state.Armed and alive and ClientState.InMatch and scopeLevel == 0 and not CameraController.IsCinematic()
	setViewmodelVisible(show)
	if not show or not w then
		return
	end
	local md = UserInputService:GetMouseDelta()
	swayX += ((-md.X * 0.0025) - swayX) * math.min(1, dt * 10)
	swayY += ((md.Y * 0.0025) - swayY) * math.min(1, dt * 10)
	local speed, air = movementInfo()
	bobT += dt * (speed > 1 and not air and speed * 0.55 or 0)
	local bobAmt = math.clamp(speed / 16, 0, 1) * (air and 0.2 or 1)
	local bob = CFrame.new(math.sin(bobT) * 0.035 * bobAmt, -math.abs(math.cos(bobT)) * 0.045 * bobAmt, 0)
	local idle = CFrame.new(0, math.sin(t * 1.6) * 0.012, 0)
	local sway = CFrame.Angles(swayY, swayX, swayX * 0.6)

	local e = easeOut(math.clamp((t - equipStart) / equipDur, 0, 1))
	local equipCF = CFrame.new(0, -1.1 * (1 - e), 0.25 * (1 - e)) * CFrame.Angles(math.rad(-55 * (1 - e)), math.rad(10 * (1 - e)), 0)

	local reloadCF = CFrame.new()
	local magDrop = 0
	if reloading then
		local p = math.clamp((t - reloadStart) / math.max(0.01, reloadEnd - reloadStart), 0, 1)
		local dip = math.sin(p * math.pi)
		reloadCF = CFrame.new(-0.08 * dip, -0.3 * dip, 0.05 * dip) * CFrame.Angles(math.rad(12 * dip), math.rad(-8 * dip), math.rad(28 * dip))
		if p > 0.12 and p < 0.75 then
			local q = (p - 0.12) / 0.63
			magDrop = math.sin(q * math.pi) * 1.4
		end
	end
	if vm.MagWeld then
		vm.MagWeld.C0 = vm.MagBase * CFrame.new(0, -magDrop, magDrop * 0.15)
	end

	local boltCF = CFrame.new()
	if t - boltStart < 0.9 then
		local p = (t - boltStart) / 0.9
		local s = math.sin(p * math.pi)
		boltCF = CFrame.new(0.05 * s, -0.08 * s, 0) * CFrame.Angles(0, 0, math.rad(-18 * s))
	end

	local meleeCF = CFrame.new()
	if meleeKind then
		local dur = meleeKind == "Stab" and 0.5 or 0.32
		local p = (t - meleeStart) / dur
		if p >= 1 then
			meleeKind = nil
		else
			local s = math.sin(p * math.pi)
			if meleeKind == "Slash" then
				meleeCF = CFrame.new(-0.5 * s, 0.15 * s, -0.4 * s) * CFrame.Angles(math.rad(-15 * s), math.rad(80 - 160 * easeOut(p)) * s, math.rad(-50 * s))
			else
				meleeCF = CFrame.new(-0.25 * s, 0.1 * s, -1.1 * s) * CFrame.Angles(math.rad(-25 * s), math.rad(10 * s), 0)
			end
		end
	end

	local kickCF = CFrame.new(0, kick * 0.03, kick * 0.12) * CFrame.Angles(math.rad(kick * 2.2), 0, 0)
	local base = camera.CFrame * (w.ViewOffset or CFrame.new(0.7, -0.8, -1.4))
	local final = base * sway * bob * idle * equipCF * reloadCF * boltCF * meleeCF * kickCF
	local handle = vm.Model.PrimaryPart
	handle.CFrame = final

	-- arms: shoulders are fixed in camera space, hands follow the weapon
	local camCF = camera.CFrame
	local rShoulder = camCF:PointToWorldSpace(Vector3.new(0.95, -1.5, 0.4))
	local lShoulder = camCF:PointToWorldSpace(Vector3.new(-0.95, -1.5, 0.4))
	local rHand = final.Position
	local leftAtt = handle:FindFirstChild("LeftHand") :: Attachment?
	local lHand = leftAtt and leftAtt.WorldPosition or rHand
	if reloading and vm.Model:FindFirstChild("Mag") then
		local magPart = vm.Model:FindFirstChild("Mag") :: BasePart
		local p = math.clamp((t - reloadStart) / math.max(0.01, reloadEnd - reloadStart), 0, 1)
		if p > 0.1 and p < 0.85 then
			lHand = lHand:Lerp(magPart.Position, math.sin((p - 0.1) / 0.75 * math.pi))
		end
	end
	if w.Category == "Melee" then
		lHand = camCF:PointToWorldSpace(Vector3.new(-0.9, -1.2, -0.6))
	end
	placeArm(vm.Arms[1], vm.Arms[2], rShoulder, rHand)
	placeArm(vm.Arms[3], vm.Arms[4], lShoulder, lHand)
end

local function heartbeat()
	if InputController.IsHeld("Fire") or burstQueue > 0 then
		tryFire()
	end
end

-- SERVER SYNC --------------------------------------------------------------------------

local function onWeaponState(payload)
	if type(payload) ~= "table" then
		return
	end
	local wasArmed = state.Armed
	state.Loadout = payload.Loadout or {}
	state.Armed = payload.Armed == true
	state.Skins = payload.Skins or {}
	state.Ammo = {}
	for slot, a in pairs(payload.Ammo or {}) do
		state.Ammo[slot] = { Mag = a.Mag, Reserve = a.Reserve }
	end
	if not state.Armed then
		current = nil
		reloading = false
		setScope(0)
		destroyViewmodel()
	elseif payload.Equipped and (payload.Equipped ~= current or not wasArmed) then
		equipLocal(payload.Equipped, false)
	else
		buildViewmodel()
	end
	emitChanged()
end

-- Server answer to a reload request (completed or rejected): authoritative ammo.
local function onAmmo(slot, mag, reserve)
	local a = state.Ammo[slot]
	if not a or type(mag) ~= "number" or type(reserve) ~= "number" then
		return
	end
	a.Mag, a.Reserve = mag, reserve
	if slot == current then
		reloading = false
	end
	emitChanged()
end

function WeaponController.Init()
	Net.Event("WeaponState").OnClientEvent:Connect(onWeaponState)
	Net.Event("AmmoUpdate").OnClientEvent:Connect(onAmmo)

	InputController.Action:Connect(function(name, began)
		if name == "Fire" then
			if not began then
				semiReady = true
			end
		elseif name == "Alt" then
			WeaponController.Alt(began)
		elseif not began then
			return
		elseif name == "Reload" then
			WeaponController.Reload()
		elseif name == "Slot1" or name == "Slot2" or name == "Slot3" then
			WeaponController.Equip(SLOT_BY_INDEX[tonumber(name:sub(5))])
		elseif name == "NextWeapon" then
			cycle(1)
		elseif name == "PrevWeapon" then
			cycle(-1)
		elseif name == "LastWeapon" then
			if lastSlot and state.Loadout[lastSlot] then
				WeaponController.Equip(lastSlot)
			end
		end
	end)

	local function onCharacter(char: Model)
		alive = true
		local hum = char:WaitForChild("Humanoid", 10) :: Humanoid
		if hum then
			hum.Died:Connect(function()
				alive = false
				reloading = false
				setScope(0)
				destroyViewmodel()
				emitChanged()
			end)
		end
		emitChanged()
	end
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)
	player:GetAttributeChangedSignal("TeamColor"):Connect(function()
		vm.Id = nil
		buildViewmodel()
	end)

	RunService:BindToRenderStep("FPSWeapon", Enum.RenderPriority.Camera.Value + 1, renderStep)
	RunService.Heartbeat:Connect(heartbeat)
end

return WeaponController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">WeaponShopUI</string><ProtectedString name="Source"><![CDATA[--[[
	WeaponShopUI
	Buy menu (B on keyboard, shop button on touch). Only opens inside your team's spawn while
	the match is in Warmup/Live, and closes itself when you leave the spawn, die or the match
	ends. Rules: one pistol + (one rifle OR one sniper). The knife is always carried.
	The server re-validates everything in SetLoadout.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Util = require(ReplicatedStorage.Shared.Util)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local WeaponData = require(ReplicatedStorage.WeaponModules.WeaponData)
local WeaponModels = require(ReplicatedStorage.WeaponModules.WeaponModels)
local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local Toast = require(script.Parent.Toast)
local InputController = require(script.Parent.InputController)
local WeaponController = require(script.Parent.WeaponController)

local WeaponShopUI = {}
WeaponShopUI.SpawnStateChanged = require(ReplicatedStorage.Shared.Signal).new()

local T = UIKit.T
local player = Players.LocalPlayer

local screen, window
local pending = { Primary = nil, Secondary = "USP" }
local category = "Pistol"
local selectedId = "USP"
local ui = {}
local inSpawn = false

function WeaponShopUI.InSpawn(): boolean
	return inSpawn
end

local function computeInSpawn(): boolean
	local m = ClientState.Match
	if not ClientState.InMatch or not m or (m.State ~= "Live" and m.State ~= "Warmup") then
		return false
	end
	local team = ClientState.Team()
	local zone = team and m.SpawnZones and m.SpawnZones[team]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not zone or not root or not hum or hum.Health <= 0 then
		return false
	end
	return Util.InBox(root.Position, zone.CFrame, zone.Size + Vector3.new(2, 6, 2))
end

local function isPendingSelected(id)
	return pending.Primary == id or pending.Secondary == id
end

local function refreshLoadoutBar()
	local p = pending.Primary and WeaponData.Get(pending.Primary)
	local s = WeaponData.Get(pending.Secondary or "USP")
	ui.PrimaryText.Text = "PRIMARY:  " .. (p and p.Name or "NONE")
	ui.SecondaryText.Text = "PISTOL:  " .. s.Name
	ui.KnifeText.Text = "MELEE:  KNIFE (always)"
	ui.ClearPrimary.Visible = pending.Primary ~= nil
end

local function refreshDetail()
	local w = WeaponData.Get(selectedId)
	if not w then
		return
	end
	ui.Name.Text = w.Name
	ui.Category.Text = w.Category:upper() .. (w.FireMode and ("  /  " .. w.FireMode:upper()) or "")
	ui.Desc.Text = w.Description
	local skins = ClientState.Profile and ClientState.Profile.EquippedSkins or {}
	ui.SetPreview(WeaponModels.BuildStatic(w.Id, skins[w.Id]), WeaponModels.GetLength(w.Id))
	for _, c in ipairs(ui.StatRows) do
		c:Destroy()
	end
	ui.StatRows = {}
	for i, stat in ipairs(WeaponData.DisplayStats(w)) do
		local row = UIKit.StatBar(ui.Stats, stat[1], stat[2], (i - 1) * 24, 0.6)
		table.insert(ui.StatRows, row)
	end
	if w.MagSize then
		ui.Specs.Text = string.format("DMG %d  |  %d RPM  |  MAG %d / %d  |  RELOAD %.1fs  |  SPEED %d%%", w.Damage, w.RPM, w.MagSize, w.Reserve, w.ReloadTime, math.floor(w.MoveSpeed * 100 + 0.5))
	else
		ui.Specs.Text = ""
	end
	local selected = isPendingSelected(w.Id)
	ui.Select.Text = selected and "SELECTED" or "SELECT"
	UIKit.SetButtonColor(ui.Select, selected and T.Good or T.Accent)
	ui.Select.TextColor3 = Color3.new(0, 0, 0)
end

local function refreshList()
	for _, c in ipairs(ui.Cards) do
		c:Destroy()
	end
	ui.Cards = {}
	for _, cat in ipairs(WeaponData.Categories) do
		UIKit.SetButtonColor(ui.Tabs[cat.Id], cat.Id == category and T.Accent or T.Panel3)
		ui.Tabs[cat.Id].TextColor3 = cat.Id == category and Color3.new(0, 0, 0) or T.Text
		if cat.Id == category then
			for i, id in ipairs(cat.Weapons) do
				local w = WeaponData.Get(id)
				local card = UIKit.Button({
					Name = id,
					Position = UDim2.fromOffset(0, (i - 1) * 66),
					Size = UDim2.new(1, 0, 0, 58),
					BackgroundColor3 = id == selectedId and T.Panel3 or T.Panel2,
					Parent = ui.List,
				}, function()
					selectedId = id
					refreshList()
					refreshDetail()
				end)
				UIKit.Label({ Text = w.Name, TextSize = 18, Font = UIKit.FontBlack, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -110, 0, 22), Parent = card })
				UIKit.Label({ Text = string.format("%d DMG  ·  %d RPM  ·  %d RND", w.Damage, w.RPM, w.MagSize), TextSize = 12, TextColor3 = T.Sub, Font = UIKit.FontRegular, Position = UDim2.fromOffset(14, 32), Size = UDim2.new(1, -110, 0, 16), Parent = card })
				if isPendingSelected(id) then
					UIKit.Label({
						Text = "SELECTED",
						TextSize = 11,
						TextColor3 = Color3.new(0, 0, 0),
						TextXAlignment = Enum.TextXAlignment.Center,
						BackgroundTransparency = 0,
						BackgroundColor3 = T.Good,
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -10, 0.5, 0),
						Size = UDim2.fromOffset(84, 22),
						Corner = 6,
						Parent = card,
					})
				end
				if id == selectedId then
					UIKit.New("Frame", { BackgroundColor3 = T.Accent, Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(4, 8), BorderSizePixel = 0, Parent = card })
				end
				table.insert(ui.Cards, card)
			end
		end
	end
end

local function build()
	local close
	screen, window, close = UIKit.Window("WeaponShop", "WEAPON SHOP", UDim2.fromOffset(980, 620), 30)
	ui.Cards, ui.StatRows, ui.Tabs = {}, {}, {}

	UIKit.Label({
		Text = "Pick one pistol and one rifle OR sniper. Your knife is always equipped.",
		TextSize = 13,
		TextColor3 = T.Sub,
		Font = UIKit.FontRegular,
		Position = UDim2.fromOffset(20, 44),
		Size = UDim2.new(1, -40, 0, 18),
		Parent = window,
	})

	-- tabs
	for i, cat in ipairs(WeaponData.Categories) do
		ui.Tabs[cat.Id] = UIKit.Button({
			Text = cat.Label,
			TextSize = 14,
			Position = UDim2.fromOffset(20 + (i - 1) * 118, 72),
			Size = UDim2.fromOffset(110, 36),
			Parent = window,
		}, function()
			category = cat.Id
			selectedId = cat.Weapons[1]
			refreshList()
			refreshDetail()
		end)
	end

	ui.List = UIKit.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 120), Size = UDim2.fromOffset(340, 380), Parent = window })

	-- detail panel
	local detail = UIKit.New("Frame", { BackgroundColor3 = T.Panel2, Position = UDim2.fromOffset(380, 72), Size = UDim2.new(1, -400, 0, 428), Corner = 10, Parent = window })
	local vp, setModel = UIKit.Preview(detail, { Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 0, 170) })
	ui.Preview = vp
	ui.SetPreview = setModel
	ui.Name = UIKit.Label({ Text = "", Font = UIKit.FontBlack, TextSize = 26, Position = UDim2.fromOffset(16, 190), Size = UDim2.new(0.6, 0, 0, 30), Parent = detail })
	ui.Category = UIKit.Label({ Text = "", TextSize = 12, TextColor3 = T.Accent, Position = UDim2.fromOffset(16, 220), Size = UDim2.new(0.6, 0, 0, 16), Parent = detail })
	ui.Desc = UIKit.Label({ Text = "", TextSize = 13, TextWrapped = true, Font = UIKit.FontRegular, TextColor3 = T.Sub, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(16, 240), Size = UDim2.new(0.5, -20, 0, 90), Parent = detail })
	ui.Stats = UIKit.New("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0, 236), Size = UDim2.new(0.5, -16, 0, 150), Parent = detail })
	ui.Specs = UIKit.Label({ Text = "", TextSize = 12, TextColor3 = T.Text, Font = UIKit.FontRegular, Position = UDim2.new(0, 16, 1, -36), Size = UDim2.new(1, -200, 0, 24), Parent = detail })
	ui.Select = UIKit.Button({
		Text = "SELECT",
		BackgroundColor3 = T.Accent,
		TextColor3 = Color3.new(0, 0, 0),
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -12),
		Size = UDim2.fromOffset(160, 40),
		Parent = detail,
	}, function()
		local w = WeaponData.Get(selectedId)
		if w.Category == "Pistol" then
			pending.Secondary = w.Id
		elseif pending.Primary == w.Id then
			pending.Primary = nil -- toggle off
		else
			pending.Primary = w.Id -- replaces any rifle OR sniper (only one primary)
		end
		refreshList()
		refreshDetail()
		refreshLoadoutBar()
	end)

	-- loadout bar
	local bar = UIKit.New("Frame", { BackgroundColor3 = T.Bg, Position = UDim2.new(0, 20, 1, -100), Size = UDim2.new(1, -40, 0, 80), Corner = 10, Stroke = { Color = T.Stroke }, Parent = window })
	UIKit.Label({ Text = "CURRENT LOADOUT", TextSize = 11, TextColor3 = T.Sub, Position = UDim2.fromOffset(16, 8), Size = UDim2.fromOffset(200, 14), Parent = bar })
	ui.PrimaryText = UIKit.Label({ Text = "", TextSize = 15, Position = UDim2.fromOffset(16, 28), Size = UDim2.fromOffset(250, 20), Parent = bar })
	ui.SecondaryText = UIKit.Label({ Text = "", TextSize = 15, Position = UDim2.fromOffset(16, 50), Size = UDim2.fromOffset(250, 20), Parent = bar })
	ui.KnifeText = UIKit.Label({ Text = "", TextSize = 13, TextColor3 = T.Sub, Position = UDim2.fromOffset(280, 50), Size = UDim2.fromOffset(220, 20), Parent = bar })
	ui.ClearPrimary = UIKit.Button({ Text = "CLEAR PRIMARY", TextSize = 12, Position = UDim2.fromOffset(280, 22), Size = UDim2.fromOffset(130, 26), Parent = bar }, function()
		pending.Primary = nil
		refreshList()
		refreshDetail()
		refreshLoadoutBar()
	end)
	ui.Status = UIKit.Label({ Text = "", TextSize = 13, TextColor3 = T.Sub, Position = UDim2.new(1, -470, 0, 10), Size = UDim2.fromOffset(240, 60), TextWrapped = true, Parent = bar })
	ui.Confirm = UIKit.Button({
		Text = "CONFIRM LOADOUT",
		BackgroundColor3 = T.Good,
		TextColor3 = Color3.new(0, 0, 0),
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(210, 50),
		Parent = bar,
	}, function()
		ui.Status.Text = "Confirming..."
		local ok, res = pcall(function()
			return Net.Function("SetLoadout"):InvokeServer({ Primary = pending.Primary, Secondary = pending.Secondary })
		end)
		if ok and type(res) == "table" and res.Ok then
			Sounds.Play("UIBuy")
			Toast.Show(res.Message or "Loadout confirmed.", "success")
			WeaponShopUI.Close()
		else
			local msg = (ok and type(res) == "table" and res.Message) or "Could not confirm loadout."
			ui.Status.Text = msg
			Toast.Show(msg, "error")
		end
	end)
	close.Activated:Connect(function()
		WeaponShopUI.Close()
	end)
end

function WeaponShopUI.Open()
	if not inSpawn then
		Toast.Show("You can only open the weapon shop inside your team's spawn.", "error")
		return
	end
	if not screen then
		build()
	end
	local info = WeaponController.GetInfo()
	pending.Primary = info.Loadout and info.Loadout.Primary or nil
	pending.Secondary = info.Loadout and info.Loadout.Secondary or "USP"
	ui.Status.Text = ""
	refreshList()
	refreshDetail()
	refreshLoadoutBar()
	screen.Enabled = true
	ClientState.SetMenu("WeaponShop", true)
end

function WeaponShopUI.Close()
	if screen and screen.Enabled then
		screen.Enabled = false
	end
	ClientState.SetMenu("WeaponShop", false)
end

function WeaponShopUI.Toggle()
	if screen and screen.Enabled then
		WeaponShopUI.Close()
	else
		WeaponShopUI.Open()
	end
end

function WeaponShopUI.Init()
	InputController.Action:Connect(function(name, began)
		if name == "Shop" and began and ClientState.InMatch then
			WeaponShopUI.Toggle()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local now = computeInSpawn()
			if now ~= inSpawn then
				inSpawn = now
				WeaponShopUI.SpawnStateChanged:Fire(inSpawn)
			end
			if not inSpawn and screen and screen.Enabled then
				WeaponShopUI.Close()
				Toast.Show("Weapon shop closed - you left your spawn.", "info")
			end
		end
	end)
	ClientState.MatchChanged:Connect(function(m)
		if screen and screen.Enabled and (not ClientState.InMatch or not m or (m.State ~= "Live" and m.State ~= "Warmup")) then
			WeaponShopUI.Close()
		end
	end)
end

return WeaponShopUI
